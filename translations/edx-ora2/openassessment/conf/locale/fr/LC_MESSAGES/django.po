msgid ""
"\n"
"                    Please respond to the question below. Your response will be saved automatically and %(start_tag)scannot be edited once submitted%(end_tag)s.\n"
"                "
msgstr ""
"\n"
"                    Veuillez répondre à la question ci-dessous. Votre réponse sera enregistrée automatiquement et %(start_tag)ne pourra pas être modifiée une fois soumise%(end_tag)s."

msgid "Enter your response to the question above."
msgstr "Entrez votre réponse à la question ci-dessus."

msgid "Could not parse serialized rubric"
msgstr "Impossible d&#39;analyser la rubrique sérialisée"

msgid ""
"If your assignment includes a learner training step, the rubric must have at"
" least one criterion, and that criterion must have at least one option."
msgstr ""
"Si votre mission comprend une étape de formation des apprenants, la rubrique"
" doit avoir au moins un critère, et ce critère doit avoir au moins une "
"option."

msgid "Example {example_number} has a validation error: {error}"
msgstr "L&#39;exemple {example_number} a une erreur de validation : {error}"

msgid ""
"Example {example_number} has an invalid option for \"{criterion_name}\": "
"\"{option_name}\""
msgstr ""
"L&#39;exemple {example_number} a une option non valide pour &quot; "
"{criterion_name} &quot; : &quot; {option_name} &quot;"

msgid "Example {example_number} has an extra option for \"{criterion_name}\""
msgstr ""
"L&#39;exemple {example_number} a une option supplémentaire pour &quot; "
"{criterion_name} &quot;"

msgid "Example {example_number} is missing an option for \"{criterion_name}\""
msgstr ""
"Dans l&#39;exemple {example_number} il manque une option pour &quot; "
"{criterion_name} &quot;"

