msgid "We could not execute your query; please try again."
msgstr ""
"ང་ཚོས་ཁྱེད་ཀྱི་འདྲི་རྩད་ལག་བསྟར་བྱེད་ཐུབ་མ་སོང་། ཡང་བསྐྱར་ཚོད་ལྟ་གནང་རོགས།"

msgid "Weight"
msgstr "སྦྱངས་འབྲས་བརྒྱ་ཆ།"

msgid "This assigns an integer value representing the weight of this problem"
msgstr "འདིས་དཀའ་ངལ་འདིའི་ལྗིད་ཚད་མཚོན་པའི་ཧྲིལ་གྲངས་རིན་ཐང་སྤྲོད་ཀྱི་ཡོད།"

msgid "Display Name"
msgstr "འཆར་སྟོན་བྱ་རྒྱུའི་མིང་།"

msgid "The display name for this component."
msgstr "ཆ་ཤས་འདིའི་བཀྲམ་སྟོན་མིང་།"

msgid "SQL Problem"
msgstr "SQL དཀའ་ངལ།"

msgid "Dataset"
msgstr "གྲངས་ཐོའི་ཆ་ཚན།"

msgid "Which initial dataset/database to be used for queries"
msgstr ""
"འདྲི་རྩད་ཀྱི་ཆེད་དུ་འགོ་འཛུགས་གྲངས་ཐོའི་ཆ་ཚན/གཞི་གྲངས་མཛོད་གང་ཞིག་བེད་སྤྱོད་གཏོང་དགོས་སམ།"

msgid "Answer Query"
msgstr "འདྲི་རྩད་ལན་འདེབས།"

msgid "A correct response SQL query"
msgstr "ལན་ཡང་དག་པའི་SQLའདྲི་རྩད།"

msgid "Verify Query"
msgstr "འདྲི་རྩད་བདེན་དཔང་བྱེད་པ།"

msgid ""
"A secondary verification SQL query, to be used if the answer_query modifies "
"the database (UPDATE, INSERT, DELETE, etc.). Only enter a single SELECT "
"query here, which is used for matching the answer"
msgstr ""
"གལ་ཏེ་ལན་_འདྲི་རྩད་ཀྱིས་གནས་སྡུད་གཞི་གྲངས་བསྒྱུར་བཅོས་བྱེད་ན་བེད་སྤྱོད་གཏོང་བའི་གཉིས་པ་བདེན་དཔང་SQLའདྲི་རྩད།"
" (UPDATE, INSERT, DELETE, etc.) འདིར་འདེམས་སྒྲུག་འདྲི་རྩད་གཅིག་ལས་མེད། "
"དེ་ནི་ལན་མཐུན་སྒྲིག་བྱེད་པར་བེད་སྤྱོད་བྱེད།"

msgid "Modification query statements"
msgstr "བཟོ་བཅོས་འདྲི་རྩད་གསལ་བསྒྲགས།"

msgid ""
"Optional SQL statements, to be executed after the user-submitted query, but "
"before the verify_query."
msgstr ""
"འདམ་ཀའི་SQLགསལ་བསྒྲགས། "
"བཀོལ་སྤྱོད་པས་ཕུལ་བའི་འདྲི་རྩད་ཀྱི་རྗེས་སུ་ལག་བསྟར་བྱེད་དགོས། "
"འོན་ཀྱང་བདེན་དཔང་_འདྲི་རྩད་ཀྱི་སྔོན་ལ།"

msgid "Is Ordered?"
msgstr "མངགས་ཉོ་བྱས་ཡོད་དམ།"

msgid "Should results be in order?"
msgstr "གྲུབ་འབྲས་གོ་རིམ་ལྡན་པ་ཞིག་ཡིན་དགོས་སམ།"

msgid "Prompt"
msgstr "དུས་བཀག"

msgid "Explanatory text to accompany the problem"
msgstr "དཀའ་རྙོག་དང་མཉམ་དུ་འགྲེལ་བརྗོད་ཡིག་ཆ།"

msgid "Submission Query"
msgstr "འབུལ་འདྲི་རྩད།"

msgid "A Submission Query"
msgstr "ཕུལ་བའི་འདྲི་རྩད།"

msgid ""
"\n"
"            %(score_weighted)s/%(max_score)s point (graded)\n"
"        "
msgstr ""

msgid "0 points (ungraded)"
msgstr "སྐར་མ་0(རིམ་པ་མ་བརྒྱབ་པ)"

msgid "Note:"
msgstr "དྲན་ཐོ:"

msgid ""
"Your queries are executed using SQLite, so you must conform to the SQL "
"constructs supported by SQLite."
msgstr ""
"ཁྱེད་ཀྱི་འདྲི་རྩད་དེ་ཚོ་SQLite བཀོལ་ནས་ལག་བསྟར་བྱེད་ཀྱི་ཡོད། "
"དེར་བརྟེན་ཁྱེད་ཀྱིས་SQLite གིས་རྒྱབ་སྐྱོར་བྱེད་པའི་SQL བཟོ་བཀོད་ལ་མཐུན་དགོས།"

msgid "Press ESC then TAB or click outside of the code editor to exit"
msgstr ""
"ESC དེ་ནས་ TAB "
"མནན་པའམ་ཡང་ན་ཨང་གྲངས་རྩོམ་སྒྲིག་ཆས་ཀྱི་ཕྱི་རོལ་དུ་མནན་ནས་ཕྱིར་ཐོན་དགོས།"

msgid "Submit"
msgstr "འབུལ་སྤྲོད།"

msgid "Show Answer"
msgstr "ལན་སྟོན།"

msgid "Correct"
msgstr "ཡང་དག་པ"

msgid "Incorrect"
msgstr "ནོར་བ།"

msgid "Unanswered"
msgstr "ལན་བཏབ་མེད་པ།"

msgid ""
"To check your data modification statement, we ran the following query after "
"your modification:"
msgstr ""
"ཁྱེད་ཀྱི་གཞི་གྲངས་བསྒྱུར་བཅོས་གསལ་བསྒྲགས་ཞིབ་བཤེར་བྱེད་ཆེད། "
"ང་ཚོས་ཁྱེད་ཀྱི་བསྒྱུར་བཅོས་བྱས་རྗེས་གཤམ་གྱི་འདྲི་རྩད་སྤེལ།"

msgid "Your Query Result:"
msgstr "ཁྱེད་ཀྱི་འདྲི་རྩད་གྲུབ་འབྲས།"

msgid "Expected Query Result:"
msgstr "རེ་སྒུག་འདྲི་རྩད་གྲུབ་འབྲས།"
