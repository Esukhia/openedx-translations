"སྔོན་སྒྲིག་ལྟར་ན་སློབ་མས་མཐའ་མའི་ཕུལ་བའི་སྐར་གྲངས་ཡིན།"

msgid "Last Score"
msgstr "སྐར་གྲངས་མཐའ་མ།"

msgid "First Score"
msgstr "སྐར་གྲངས་དང་པོ།"

msgid "Highest Score"
msgstr "སྐར་གྲངས་མཐོ་ཤོས།"

msgid "Average Score"
msgstr "ཆ་སྙོམས་སྐར་གྲངས།"

msgid "Date that this problem is due by"
msgstr "དྲི་བ་འདིའི་དུས་ཡུན་རྫོགས་པའི་ཟླ་ཚེས་སྒྲིག"

msgid "Amount of time after the due date that submissions will be accepted"
msgstr "འབུལ་སྤྲོད་ངོས་ལེན་གྱི་དུས་ཡུན་རྫོགས་རྗེས་དུས་ཚོད་ཀྱི་ཁ་གྲངས།"

msgid "Show Results"
msgstr "མཇུག་འབྲས་སྟོན།"

msgid ""
"Defines when to show whether a learner's answer to the problem is correct. "
"Configured on the subsection."
msgstr ""
"སློབ་གཉེར་བས་དྲི་བར་ལན་འདེབས་བྱས་པ་འགྲིག་སོང་ན་ནམ་སྟོན་གྱི་བཅད་མཚམས་བཟོས།"

msgid "Always"
msgstr "དུས་རྟག་ཏུ།"

msgid "Past Due"
msgstr "དུས་ཡུན་རྫོགས།"

msgid "Show Answer"
msgstr "ལན་སྟོན།"

msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings."
msgstr ""
"དྲི་བ་དེ་ལ་ལན་འདེབས་བྱས་པ་ནམ་སྟོན་གྱི་བཅད་མཚམས་བཟོས། "
"སྟོང་བར་འཇོག་པ་དེ་ཚད་མཐོའི་སྒྲིག་འགོད་ནང་ནས་སྒྲིག་ཐུབ།"

msgid "Answered"
msgstr "ལན་བཏབ་ཟིན་པ།"

msgid "Attempted or Past Due"
msgstr "ཚོད་ལྟ་བྱས་པ་དང་། ཡང་ན་དུས་ཡུན་རྫོགས་པ།"

msgid "Closed"
msgstr "སྒོ་བརྒྱབ་ཟིན།"

msgid "Finished"
msgstr "ཚར་སོང་།"

msgid "Correct or Past Due"
msgstr "འགྲིག་སོང་ངམ། ཡང་ན་དུས་ཡུན་རྫོགས་སོང་།"

msgid "After Some Number of Attempts"
msgstr "ཚོད་ལྟ་ཐེངས་འགར་བྱས་རྗེས།"

msgid "After All Attempts"
msgstr "ཚོད་ལྟ་ཆ་ཚང་བྱས་རྗེས།"

msgid "After All Attempts or Correct"
msgstr "ཚོད་ལྟ་ཆ་ཚང་བྱས་རྗེས་སམ་འགྲིག་སོང་རྗེས།"

msgid "Attempted"
msgstr "ཚོད་ལྟ་བྱས་ཟིན།"

msgid "Show Answer: Number of Attempts"
msgstr "དྲི་བ་སྟོན།: ཚོད་ལྟའི་གྲངས།"

msgid ""
"Number of times the student must attempt to answer the question before the "
"Show Answer button appears."
msgstr ""
"དྲི་བའི་ཐེབས་མ་སྟོན་བར་དུ་སློབ་ཕྲུག་གིས་དྲི་བར་ངེས་པར་དུ་ལན་འདེབས་ཐབས་ཐེངས་འགར་བྱོས།"

msgid "Whether to force the save button to appear on the page"
msgstr "གལ་སྲིད་ཤོག་ངོས་དེར་ཉར་ཚགས་ཐེབས་འཆར་བར་བཙན་སྐུལ་བྱེད་ན།"

msgid "Show Reset Button"
msgstr "བསྐྱར་སྒྲིག་ཐེབས་སྟོན།"

msgid ""
"Determines whether a 'Reset' button is shown so the user may reset their "
"answer. A default value can be set in Advanced Settings."
msgstr ""
"'བསྐྱར་སྒྲིག' གི་གནོན་ཐེབས་སྟོན་མི་སྟོན་གཏན་འཁེལ་བྱོས། "
"སྟོན་ན་སྤྱོད་མཁན་གྱིས་ཁོང་ཚོའི་ལན་འདེབས་བསྐྱར་སྒྲིག་བྱ་ཆོག "
"རྨང་གཞིའི་རིན་ཐང་དེ་ཚད་མཐོའི་སྒྲིག་འགོད་ནང་སྒྲིག་ཆོག"

msgid "Randomization"
msgstr "ཐོལ་བྱུང་ཅན།"

msgid ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "
msgstr ""
"Defines when to randomize the variables specified in the associated Python "
"script. For problems that do not randomize values, specify \"Never\". "

msgid "On Reset"
msgstr "བསྐྱར་སྒྲིག་སྒང་ལ"

msgid "Per Student"
msgstr "སློབ་ཕྲུག་རེ་རེ།"

msgid "XML data for the problem"
msgstr "དྲི་བ་དེའི་ XML གཞི་གྲངས། "

msgid "Dictionary with the correctness of current student answers"
msgstr ""
"ད་ལྟའི་སློབ་ཕྲུག་གིས་ལན་འདེབས་འགྲིག་པའི་རང་བཞིན་དང་འབྲེལ་བའི་ཚིག་མཛོད།"

msgid "List of correctness maps for each attempt"
msgstr "ཚོད་ལྟ་རེ་རེའི་ནོར་འཁྲུལ་ས་ཁྲའི་ཐོ་གཞུང་།"

msgid "Dictionary for maintaining the state of inputtypes"
msgstr "ནང་འཇུག་རེ་རེའི་གནས་བབ་ཉར་འཛིན་བྱེད་པའི་ཚིག་མཛོད།"

msgid "Dictionary with the current student responses"
msgstr "ད་ལྟའི་སློབ་ཕྲུག་གི་ལན་འདེབས་དང་འབྲེལ་བའི་ཚིག་མཛོད།"

msgid "List of student answers for each attempt"
msgstr "ཚོད་ལྟ་རེ་རེའི་སློབ་མའི་ལན་འདེབས་ཐོ་གཞུང་།"

msgid "Dictionary with the current student score"
msgstr "ད་ལྟའི་སློབ་ཕྲུག་གི་ཐོབ་སྐར་དང་འབྲེལ་བའི་ཚིག་མཛོད།"

msgid "List of scores for each attempt"
msgstr "ཚོད་ལྟ་རེ་རེའི་སྐར་གྲངས་ཐོ་གཞུང་།"

msgid "Whether or not the answers have been saved since last submit"
msgstr ""
"སྔ་མའི་འབུལ་སྤྲོད་བྱས་པ་ནས་བཟུང་ལན་འདེབས་བྱས་དང་མ་བྱས་ཅི་རིགས་པ་ཉར་ཚགས་བྱས་ཡོད།"

msgid "Whether the student has answered the problem"
msgstr "གལ་སྲིད་སློབ་ཕྲུག་དེས་དྲི་བར་ལན་འདེབས་བྱས་ཡོད་ན།"

msgid "Random seed for this student"
msgstr "སློབ་ཕྲུག་འདིའི་དོན་དུ་ཐོལ་བྱུང་འགོ་རྩོམ།"

msgid "Last submission time"
msgstr "སྔ་མའི་འབུལ་སྤྲོད་དུས་ཚོད།"

msgid "Timer Between Attempts"
msgstr "ཚོད་ལྟ་རེ་རེའི་བར་གྱི་དུས་ཡུན་སྒྲིག་ཆས།"

msgid ""
"Seconds a student must wait between submissions for a problem with multiple "
"attempts."
msgstr ""
"སློབ་མ་ཞིག་གིས་དྲི་བ་གཅིག་ལ་ལན་འདེབས་ཐེངས་གཉིས་པ་བྱ་རྒྱུ་དེ་ལན་འདེབས་དང་བོ་ཐག་གཅོད་མ་བྱས་བར་དུ་སྒུག་དགོས།"

msgid "Problem Weight"
msgstr "དྲི་བ་དཀའ་མོ།"

msgid ""
"Defines the number of points each problem is worth. If the value is not set,"
" each response field in the problem is worth one point."
msgstr ""
"དྲི་བ་རེ་རེའི་རིན་ཐང་གི་སྐར་གྲངས་གཏན་འཁེལ་བྱོས། "
"རིན་ཐང་གི་སྐར་གྲངས་མ་བསྒྲིག་ན་དྲི་བའི་སྡེ་ཚན་ནང་གི་ལན་འདེབས་རེ་རེ་ནི་རྩ་བའི་སྐར་གྲངས་གཅིག་ལ་བརྩི་འགྲོ།"

msgid "Markdown source of this module"
msgstr "མ་དཔེ་འདིའི་MD ཡི་ཁུངས།"

msgid ""
"Source code for LaTeX and Word problems. This feature is not well-supported."
msgstr ""
"LaTeX ཡི་ཁུངས་ཀྱི་ཨང་བརྡ་དང་Word དཀའ་ངལ་ལ། "
"ཁྱད་ཆོས་འདིས་རམ་འདེགས་ཡག་པོ་བྱེད་མི་ཐུབ།"

msgid "Enable LaTeX templates?"
msgstr "LaTeX མ་དཔེ་ཐུབ་པ་བྱ་རྒྱུ་ཡིན་ནམ།"

msgid "Matlab API key"
msgstr "Matlab API ཚིག་གནད།"

msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use by this course for the "
"specified duration. Please do not share the API key with other courses and "
"notify MathWorks immediately if you believe the key is exposed or "
"compromised. To obtain a key for your course, or to report an issue, please "
"contact moocsupport@mathworks.com"
msgstr ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use by this course for the "
"specified duration. Please do not share the API key with other courses and "
"notify MathWorks immediately if you believe the key is exposed or "
"compromised. To obtain a key for your course, or to report an issue, please "
"contact moocsupport@mathworks.com"

msgid ""
"We're sorry, there was an error with processing your request. Please try "
"reloading your page and trying again."
msgstr ""
"དགོངས་དག ཁྱེད་ཀྱིས་རེ་ཞུའི་བརྒྱུད་རིམ་ལ་གནད་དོན་ཞིག་བྱུང་སོང་། "
"ཁྱེད་ཀྱི་ཤོག་ངོས་བསྐྱར་ལེན་བྱས་ཏེ་བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid ""
"The state of this problem has changed since you loaded this page. Please "
"refresh your page."
msgstr ""
"ཁྱེད་ཀྱིས་ཤོག་ངོས་བསྐྱར་ལེན་བྱས་པས་དྲི་བ་འདིའི་གནས་བབ་འགྱུར་ལྡོག་བྱུང་སོང་། "
"ཁྱེད་ཀྱི་ཤོག་ངོས་བསྐྱར་སྐོར་ཞིག་བྱོས།"

msgid "Answer ID"
msgstr "དྲི་བའི་ ID"

msgid "Correct Answer"
msgstr "དྲི་བ་འགྲིག་པ།"

msgid "Submitting"
msgstr "འབུལ་སྤྲོད་བྱེད་བཞིན་ཡོད།"

msgid "Warning: The problem has been reset to its initial state!"
msgstr "ཉེན་བརྡ།: དྲི་བ་དེ་ཐོག་མའི་གནས་བབས་ལ་བསྐྱར་སྒྲིག་བྱས་ཡོད།"

msgid ""
"The problem's state was corrupted by an invalid submission. The submission "
"consisted of:"
msgstr ""
"ཚུལ་མཐུན་མ་ཡིན་པའི་འབུལ་སྤྲོད་ཅིག་གིས་དྲི་བའི་གནས་བབས་སྐྱོན་ཅན་བྱས་སོང་།"

msgid "If this error persists, please contact the course staff."
msgstr "གནད་དོན་འདི་ཡང་ཡང་བྱུང་ན་སློབ་ཚན་བཟོ་མཁན་ལ་འབྲེལ་བ་བྱོས།"

msgid "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"
msgstr "{previous_hints}{list_start_tag}{strong_text}{hint_text}</li>"

msgid "Hint ({hint_num} of {hints_count}): "
msgstr "བརྡ་སྟོན།  {hints_count}) ཡི་ ({hint_num}: "

msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"ཁྱེད་ཀྱི་ལན་འདེབས་རྣམས་སྔ་མོ་ནས་ཉར་ཚགས་བྱས་ཡོད། དེ་དག་ལ་རིམ་པ་བསྒྲིག་དགོས་ན་"
" '{button_name}' འདིའི་སྟེང་སྣུན།"

msgid "Partially Correct"
msgstr "འགའ་རེ་འགྲིག་པ།"

msgid "Answer submitted."
msgstr "ལན་འདེབས་འབུལ་སྤྲོད་བྱས་ཡོད།"

msgid "Problem is closed."
msgstr "དྲི་བ་སྒོ་བརྒྱབ་ཡོད།"

msgid "Problem must be reset before it can be submitted again."
msgstr ""
"དྲི་བ་བསྐྱར་དུ་འབུལ་སྤྲོད་ཐུབ་པ་མ་བྱས་སྔོན་དྲི་བ་ངེས་པར་བསྐྱར་སྒྲིག་བྱ་དགོས།"

msgid "You must wait at least {wait} seconds between submissions."
msgstr "འབུལ་སྤྲོད་སོ་སོའི་བར་ལ་ཁྱེད་ཀྱིས་དམའ་མཐའ་ཡང་ {wait} ལ་སྒུག་དགོས།"

msgid ""
"You must wait at least {wait_secs} between submissions. {remaining_secs} "
"remaining."
msgstr ""
"འབུལ་སྤྲོད་སོ་སོའི་བར་ལ་ཁྱེད་ཀྱིས་དམའ་མཐའ་ཡང་ {wait_secs} ལ་སྒུག་དགོས། "
"ད་དུང་ {remaining_secs} ལྷག་འདུག"

msgid "Problem needs to be reset prior to save."
msgstr "དྲི་བ་ཉར་ཚགས་བྱེད་པར་དེ་སྔ་མོ་ནས་ངེས་པར་བསྐྱར་སྒྲིག་བྱ་དགོས།"

msgid "Your answers have been saved."
msgstr "ཁྱེད་ཀྱི་ལན་འདེབས་རྣམས་ཉར་ཚགས་བྱས་ཡོད།"

msgid ""
"Your answers have been saved but not graded. Click '{button_name}' to grade "
"them."
msgstr ""
"ཁྱེད་ཀྱི་ལན་འདེབས་རྣམས་ཉར་ཚགས་བྱས་ཡོད། འོན་ཀྱང་རིམ་པ་བྱས་མེད། "
"རིམ་པ་བསྒྲིག་ན་ '{button_name}' འདིའི་ཐོག་སྣུན།"

msgid "You cannot select Reset for a problem that is closed."
msgstr "སྒོ་བརྒྱབ་ཟིན་པའི་དྲི་བ་ཡིན་ན་ཁྱེད་ཀྱིས་བསྐྱར་སྒྲིག་འདེམ་མི་ཐུབ།"

msgid "You must submit an answer before you can select Reset."
msgstr ""
"བསྐྱར་སྒྲིག་འདེམ་པར་སྔོན་ལ་ཁྱེད་ཀྱིས་ལན་འདེབས་ཤིག་ངེས་པར་འབུལ་སྤྲོད་བྱས་ཡོད་དགོས།"

msgid "Problem's definition does not support rescoring."
msgstr "དྲི་བའི་འགྲེལ་བཤད་ཀྱིས་ཐོབ་སྐར་སྒྲིག་པར་རམ་འདེགས་བྱེད་ཀྱི་མི་འདུག"

msgid "Problem must be answered before it can be graded again."
msgstr ""
"དེའི་རིམ་པ་བསྐྱར་དུ་སྒྲིག་ཐུབ་པར་སྔོན་ལ་དྲི་བ་ཞིག་ལ་ལན་ངེས་པར་འདེབས་དགོས།"

msgid "Conditional"
msgstr "ཆ་རྐྱེན་ཅན།"

msgid "List of urls of children that are references to external modules"
msgstr ""
"བྱིས་པའི་དྲ་ཐག་ཁག་གི་ཐོ་གཞུང་། དེ་དག་ནི་ཕྱིའི་མ་དཔེ་ཁག་གི་རྒྱུ་ཆ་ཡིན་པ།"

msgid "Source Components"
msgstr "ཡོང་ཁུངས་ཀྱི་གྲུབ་ཆ་རྣམས།"

msgid ""
"The component location IDs of all source components that are used to "
"determine whether a learner is shown the content of this conditional block. "
"Copy the component location ID of a component from its Settings dialog in "
"Studio."
msgstr ""
"སློབ་སྦྱོང་བྱེད་མཁན་ལ་ཆ་རྐྱེན་ཅན་གྱི་བཀག་སྡོམ་འདིའི་ནང་དོན་སྟོན་ཡོད་མེད་གཏན་འབེབས་བྱེད་པར་བེད་སྤྱོད་བྱེད་པའི་ཐོན་ཁུངས་ཆ་ཤས་ཚང་མའི་ཆ་ཤས་གནས་ཡུལ་IDs"
" ཡིན། སྒྲིག་བཀོད་ཌའི་ལོག་ནས་ཆ་ཤས་ཤིག་གི་ཆ་ཤས་གནས་ཡུལ་ID འདྲ་བཤུས་བྱེད།"

msgid "Conditional Attribute"
msgstr "ཆ་རྐྱེན་གྱི་ཁྱད་ཆོས།"

msgid ""
"The attribute of the source components that determines whether a learner is "
"shown the content of this conditional block."
msgstr ""
"སློབ་སྦྱོང་བྱེད་མཁན་ལ་ཆ་རྐྱེན་ཅན་གྱི་བཀག་སྡོམ་འདིའི་ནང་དོན་སྟོན་མིན་གཏན་འབེབས་བྱེད་པའི་འབྱུང་ཁུངས་ཆ་ཤས་ཀྱི་ཁྱད་ཆོས།"

msgid "Conditional Value"
msgstr "ཆ་རྐྱེན་གྱི་རིན་ཐང་།"

msgid ""
"The value that the conditional attribute of the source components must match"
" before a learner is shown the content of this conditional block."
msgstr ""
"སློབ་མ་ཞིག་ལ་ཆ་རྐྱེན་བཀག་སྡོམ་འདིའི་ནང་དོན་སྟོན་པའི་སྔོན་ལ་འབྱུང་ཁུངས་ཆ་ཤས་ཀྱི་ཆ་རྐྱེན་ཁྱད་ཆོས་མཐུན་དགོས་པའི་རིན་ཐང་།"

msgid "Blocked Content Message"
msgstr "ནང་དོན་བཀག་སྡོམ་བྱས་པའི་བརྡ་འཕྲིན།"

msgid ""
"The message that is shown to learners when not all conditions are met to "
"show the content of this conditional block. Include {link} in the text of "
"your message to give learners a direct link to required units. For example, "
"'You must complete {link} before you can access this unit'."
msgstr ""
"ཆ་རྐྱེན་ཚང་མ་མ་ཚང་བའི་སྐབས་སུ་སློབ་སྦྱོང་བྱེད་མཁན་ལ་སྟོན་པའི་བརྡ་འཕྲིན། "
"ཆ་རྐྱེན་ཅན་གྱི་བཀག་སྡོམ་འདིའི་ནང་དོན་སྟོན་དགོས། "
"ཁྱེད་རང་གི་བརྡ་འཕྲིན་གྱི་ཡིག་ཆའི་ནང་དུ་ {link} "
"བཀོད་ནས་སློབ་ཕྲུག་ཚོར་དགོས་མཁོའི་སྡེ་ཚན་ལ་ཐད་ཀར་འབྲེལ་བ་སྤྲོད་དགོས། དཔེར་ན་ "
"&#39;ཁྱེད་ཀྱིས་ཚད་གཞི་འདི་ལ་འཛུལ་མ་ཐུབ་གོང་ {link} ཚང་དགོས།&#39;"

msgid "You must complete {link} before you can access this unit."
msgstr ""
"ཁྱེད་ཀྱིས་ཡང་གསེས་འདི་བལྟ་སྔོག་བྱེད་པར་ཐོག་མར་ཁྱེད་ཀྱིས་ {link} "
"འདི་ཆ་ཚང་འགྲུབ་དགོས།"

msgid "This component has no source components configured yet."
msgstr "གྲུབ་ཆ་འདིའི་ཡོང་ཁུངས་ཀྱི་གྲུབ་ཆ་ད་དུང་སྒྲིག་འགོད་བྱས་མི་འདུག"

msgid "Configure list of sources"
msgstr "ཡོང་ཁུངས་ཀྱི་ཐོ་གཞུང་གོ་སྒྲིག"

msgid "LTI Passports"
msgstr "LTI ལག་དེབ།"

msgid ""
"Enter the passports for course LTI tools in the following format: "
"\"id:client_key:client_secret\"."
msgstr ""
"གཤམ་བཀོད་ཀྱི་རྣམ་སྒྲིག་ཁག་སྤྱད་དེ་ LTI "
"ལག་ཆ་དག་གི་ཡོང་ཁུངས་ཀྱི་ཆེད་དུ་ལག་དེབ་ནང་འཇུག་བྱོས། "
"\"id:client_key:client_secret\"."

msgid ""
"List of Textbook objects with (title, url) for textbooks used in this course"
msgstr ""
"སློབ་ཚན་འདིའི་ནང་བཀོལ་རྒྱུའི་བསླབ་དེབ་ཀྱི་ནང་དོན་ཁག་གི་ཐོ་གཞུང་ (title, url)"
" "

msgid "Slug that points to the wiki for this course"
msgstr "སློབ་ཚན་འདིའི་ཝེ་ཁེ་ལ་ཕྱོགས་པའི་དྲ་ཐག་གོ་རིམ།"

msgid "Date that enrollment for this class is opened"
msgstr "འཛིན་གྲྭ་འདིར་ཞུགས་ཐོ་འགོད་ཉིན་གྱི་ཟླ་ཚེས།"

msgid "Date that enrollment for this class is closed"
msgstr "འཛིན་གྲྭ་འདིར་ཞུགས་ཐོ་མཚམས་འཇོག་ཉིན་གྱི་ཟླ་ཚེས།"

msgid "Start time when this block is visible"
msgstr "ཚན་པ་འདི་སྟོན་དུས་ཆུ་ཚོད་འགོ་ཚུགས།"

msgid "Date that this class ends"
msgstr "འཛིན་གྲྭ་དེ་མཇུག་རྫོགས་དུས་ཀྱི་ཟླ་ཚེས།"

msgid "Date that certificates become available to learners"
msgstr "སློབ་གཉེར་བ་ཚོར་ལག་དེ་ཐོབ་དུས་ཀྱི་ཟླ་ཚེས།"

msgid "Cosmetic Course Display Price"
msgstr "མཛེས་བཟོའི་སློབ་ཚན་གྱི་རིན་གོང་འཆར་སྟོན།"

msgid ""
"The cost displayed to students for enrolling in the course. If a paid course"
" registration price is set by an administrator in the database, that price "
"will be displayed instead of this one."
msgstr ""
"The cost displayed to students for enrolling in the course. If a paid course"
" registration price is set by an administrator in the database, that price "
"will be displayed instead of this one."

msgid "Course Advertised Start"
msgstr "སློབ་ཚན་ཁྱབ་བསྒྲགས་འགོ་འཛུགས།"

msgid ""
"Enter the text that you want to use as the advertised starting time frame "
"for the course, such as \"Winter 2018\". If you enter null for this value, "
"the start date that you have set for this course is used."
msgstr ""
"Enter the text that you want to use as the advertised starting time frame "
"for the course, such as \"Winter 2018\". If you enter null for this value, "
"the start date that you have set for this course is used."

msgid "Pre-Requisite Courses"
msgstr "སྔོན་འགྲོའི་སློབ་ཚན།"

msgid "Pre-Requisite Course key if this course has a pre-requisite course"
msgstr ""
"སྔོན་འགྲོའི་སློབ་ཚན། "
"གལ་སྲིད་སློབ་ཚན་འདི་ལ་སྔོན་འགྲོའི་སློབ་ཚན་ཡོད་ན་དེ་ནི་གནད་དོན་གཙོ་བོ་ཡིན།"

msgid "Grading policy definition for this class"
msgstr "འཛིན་གྲྭ་འདིའི་རིམ་པ་དབྱེ་སྟངས་ཀྱི་སྲིད་བྱུས་འགྲེལ་བཤད།"

msgid "Show Calculator"
msgstr "བརྩི་ཆས་སྟོན།"

msgid ""
"Enter true or false. When true, students can see the calculator in the "
"course."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག "
"བདེན་པ་བཞག་ན་སློབ་ཕྲུག་གིས་སློབ་ཚན་འདིའི་བརྩི་ཆས་མཐོང་ཐུབ།"

msgid "Enter the name of the course as it should appear in the course list."
msgstr "སློབ་ཚན་གྱི་ཐོ་གཞུང་ནང་འཆར་རྒྱུའི་སློབ་ཚན་གྱི་མིང་ཕྲིས།"

msgid "Course Display Name"
msgstr "སློབ་ཚན་གྱི་འཆར་མིང་།"

msgid "Course Editor"
msgstr "སློབ་ཚན་རྩོམ་སྒྲིག་པ།"

msgid "Enter the method by which this course is edited (\"XML\" or \"Studio\")."
msgstr "སློབ་ཚན་འདི་རྩོམ་སྒྲིག་བྱས་པའི་ (\"XML\" or \"Studio\") ཐབས་ལམ་ཞོག"

msgid "Course Survey URL"
msgstr "སློབ་ཚན་བརྟག་དཔྱད་ཀྱི་དྲ་ཐག URL"

msgid ""
"Enter the URL for the end-of-course survey. If your course does not have a "
"survey, enter null."
msgstr ""
"སློབ་ཚན་གྱི་ཐ་མའི་བརྟག་དཔྱད་ཀྱི་དྲ་ཐག་ཞོག "
"ཁྱེད་ཀྱི་སློབ་ཚན་ལ་ཐ་མའི་བརྟད་དཔྱད་མེད་ན་བརྩིམེད་བཞག་ཆོག"

msgid "Discussion Blackout Dates"
msgstr "གླེང་མོལ་མེད་པའི་ཟླ་ཚེས།"

msgid ""
"Enter pairs of dates between which students cannot post to discussion "
"forums. Inside the provided brackets, enter an additional set of square "
"brackets surrounding each pair of dates you add. Format each pair of dates "
"as [\"YYYY-MM-DD\", \"YYYY-MM-DD\"]. To specify times as well as dates, "
"format each pair as [\"YYYY-MM-DDTHH:MM\", \"YYYY-MM-DDTHH:MM\"]. Be sure to"
" include the \"T\" between the date and time. For example, an entry defining"
" two blackout periods looks like this, including the outer pair of square "
"brackets: [[\"2015-09-15\", \"2015-09-21\"], [\"2015-10-01\", "
"\"2015-10-08\"]] "
msgstr ""
"Enter pairs of dates between which students cannot post to discussion "
"forums. Inside the provided brackets, enter an additional set of square "
"brackets surrounding each pair of dates you add. Format each pair of dates "
"as [\"YYYY-MM-DD\", \"YYYY-MM-DD\"]. To specify times as well as dates, "
"format each pair as [\"YYYY-MM-DDTHH:MM\", \"YYYY-MM-DDTHH:MM\"]. Be sure to"
" include the \"T\" between the date and time. For example, an entry defining"
" two blackout periods looks like this, including the outer pair of square "
"brackets: [[\"2015-09-15\", \"2015-09-21\"], [\"2015-10-01\", "
"\"2015-10-08\"]] "

msgid "Discussion Topic Mapping"
msgstr "གླེང་གཞིའི་ས་ཁྲ།"

msgid ""
"Enter discussion categories in the following format: \"CategoryName\": "
"{\"id\": \"i4x-InstitutionName-CourseNumber-course-CourseRun\"}. For "
"example, one discussion category may be \"Lydian Mode\": {\"id\": "
"\"i4x-UniversityX-MUS101-course-2015_T1\"}. The \"id\" value for each "
"category must be unique. In \"id\" values, the only special characters that "
"are supported are underscore, hyphen, and period. You can also specify a "
"category as the default for new posts in the Discussion page by setting its "
"\"default\" attribute to true. For example, \"Lydian Mode\": {\"id\": "
"\"i4x-UniversityX-MUS101-course-2015_T1\", \"default\": true}."
msgstr ""
"Enter discussion categories in the following format: \"CategoryName\": "
"{\"id\": \"i4x-InstitutionName-CourseNumber-course-CourseRun\"}. For "
"example, one discussion category may be \"Lydian Mode\": {\"id\": "
"\"i4x-UniversityX-MUS101-course-2015_T1\"}. The \"id\" value for each "
"category must be unique. In \"id\" values, the only special characters that "
"are supported are underscore, hyphen, and period. You can also specify a "
"category as the default for new posts in the Discussion page by setting its "
"\"default\" attribute to true. For example, \"Lydian Mode\": {\"id\": "
"\"i4x-UniversityX-MUS101-course-2015_T1\", \"default\": true}."

msgid "Discussions Plugin Settings"
msgstr "མཐུད་སྣེའི་སྒྲིག་འགོད་ཀྱི་གླེང་མོལ།"

msgid "Settings for discussions plugins."
msgstr "གླེང་མོལ་མཐུད་སྣེའི་སྒྲིག་འགོད།"

msgid "Course Announcement Date"
msgstr "སློབ་ཚན་གསལ་བསྒྲགས་ཀྱི་ཟླ་ཚེས།"

msgid "Enter the date to announce your course."
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན་གསལ་བསྒྲགས་ཀྱི་ཟླ་ཚེས་ཕྲིས།"

msgid "Cohort Configuration"
msgstr "རིགས་དབྱེའི་ཚོགས་པའི་གྲུབ་ཆ་གོ་སྒྲིག"

msgid ""
"Enter policy keys and values to enable the cohort feature, define automated "
"student assignment to groups, or identify any course-wide discussion topics "
"as private to cohort members."
msgstr ""
"Enter policy keys and values to enable the cohort feature, define automated "
"student assignment to groups, or identify any course-wide discussion topics "
"as private to cohort members."

msgid "Course Is New"
msgstr "སློབ་ཚན་གསར་པ་ཡིན།"

msgid ""
"Enter true or false. If true, the course appears in the list of new courses,"
" and a New! badge temporarily appears next to the course image."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག བདེན་པ་བཞག་ན། "
"སློབ་ཚན་དེ་སློབ་ཚན་གསར་པའི་ཐོ་གཞུང་ནང་སྟོན་ཡོང་ལ། "
"འཕྲལ་སེལ་གྱི་མཚོན་རྟགས་གསར་པ་ཞིག་སློབ་ཚན་དེའི་གཞུག་ལ་འཆར་ཡོང་།"

msgid "Mobile Course Available"
msgstr "ཁ་པར་སྒང་གི་སློབ་ཚན་ཡོད།"

msgid ""
"Enter true or false. If true, the course will be available to mobile "
"devices."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག "
"བདེན་པ་བཞག་ན་སློབ་ཚན་དེ་ཁ་པར་གྱི་ཁྱད་ཆོས་དང་མཐུན་པ་ཡིན།"

msgid "Video Upload Credentials"
msgstr "བརྙན་ནང་འཇུག་ཐུབ་པའི་ཚད་འཛིན།"

msgid ""
"Enter the unique identifier for your course's video files provided by "
"{platform_name}."
msgstr ""
"{platform_name} "
"འདིས་མཁོ་སྤྲོད་བྱས་པའི་ཁྱེད་ཀྱི་སློབ་ཚན་བརྙན་ལ་དམིགས་བསལ་ངོས་འཛིན་བྱེད་ཞོག"

msgid "Course Not Graded"
msgstr "སློབ་ཚན་གནས་རིམ་བྱས་མེད་པ།"

msgid "Enter true or false. If true, the course will not be graded."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག བདེན་པ་བཞག་ན་སློབ་ཚན་དེ་གནས་རིམ་མི་བྱེད།"

msgid "Disable Progress Graph"
msgstr "ཡར་རྒྱས་ཀྱི་རྩིས་རིས་སྒོ་ཁོག"

msgid "Enter true or false. If true, students cannot view the progress graph."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག "
"བདེན་པ་བཞག་ན་སློབ་ཕྲུག་གིས་ཡར་རྒྱས་ཀྱི་རྩིས་རིས་ལ་བལྟ་མི་ཐུབ།"

msgid "PDF Textbooks"
msgstr "སློབ་དེབ་ཀྱི་PDF"

msgid "List of dictionaries containing pdf_textbook configuration"
msgstr "སློབ་ཚན་གྱི་pdf བཀོད་སྒྲིག་ནང་འདུས་པའི་ཚིག་མཛོད་ཁག་གི་ཐོ་གཞུང་།"

msgid "HTML Textbooks"
msgstr "སློབ་དེབ་ཁག་གི་ HTML"

msgid ""
"For HTML textbooks that appear as separate tabs in the course, enter the "
"name of the tab (usually the title of the book) as well as the URLs and "
"titles of each chapter in the book."
msgstr ""
"For HTML textbooks that appear as separate tabs in the course, enter the "
"name of the tab (usually the title of the book) as well as the URLs and "
"titles of each chapter in the book."

msgid "Remote Gradebook"
msgstr "རྒང་རིང་གི་སྦྱངས་རིམ་དཔེ་ཆ།"

msgid ""
"Enter the remote gradebook mapping. Only use this setting when "
"REMOTE_GRADEBOOK_URL has been specified."
msgstr ""
"རྒྱང་རིང་ཚོད་འཛིན་གནས་ཚད་དཔེ་ཆའི་ས་ཁྲ་ཞོག "
"རྒྱང་རིང་ཚོད་འཛིན་གནས་ཚད་དཔེ་ཆའི་དྲ་ཐག་གཙོར་འདོན་བྱས་ན་ད་གཟོད་སྒྲིག་འགོད་འདི་སྤྱོད་ཐུབ་པ་ཡིན།"

msgid "Enable CCX"
msgstr "CCX བྱེད་ནུས་པ།"

msgid ""
"Allow course instructors to assign CCX Coach roles, and allow coaches to "
"manage Custom Courses on {platform_name}. When false, Custom Courses cannot "
"be created, but existing Custom Courses will be preserved."
msgstr ""
"Allow course instructors to assign CCX Coach roles, and allow coaches to "
"manage Custom Courses on {platform_name}. When false, Custom Courses cannot "
"be created, but existing Custom Courses will be preserved."

msgid "CCX Connector URL"
msgstr "CCX ལ་མཐུད་བྱེད་ཀྱི་དྲ་ཐག URL"

msgid ""
"URL for CCX Connector application for managing creation of CCXs. (optional)."
" Ignored unless 'Enable CCX' is set to 'true'."
msgstr ""
"URL for CCX Connector application for managing creation of CCXs. (optional)."
" Ignored unless 'Enable CCX' is set to 'true'."

msgid "Allow Anonymous Discussion Posts"
msgstr "དངོས་མིང་མི་གསལ་བའི་གླེང་མོལ་འཇོག་ཆོག་པ།"

msgid ""
"Enter true or false. If true, students can create discussion posts that are "
"anonymous to all users."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག "
"བདེན་པ་བཞག་ན་སློབ་ཕྲུག་ཚོས་མིང་མི་གསལ་བར་སྤྱོད་མཁན་ཡོངས་ལ་གླེང་མོལ་འཇོག་ཆོག"

msgid "Allow Anonymous Discussion Posts to Peers"
msgstr "རང་ཉིད་དང་གོ་བབ་མཚུངས་པའི་རིགས་ལ་མིང་མི་གསལ་བའི་གླེང་མོལ་སྤེལ་ཆོག"

msgid ""
"Enter true or false. If true, students can create discussion posts that are "
"anonymous to other students. This setting does not make posts anonymous to "
"course staff."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག "
"བདེན་པ་བཞག་ན་སློབ་ཕྲུག་གིས་རང་མིང་གསལ་མི་དགོས་པར་སློབ་ཕྲུག་གཞན་ལ་བགྲོ་གླེང་རིགས་སྤེལ་ཆོག"
" འོན་ཀྱང་། སྒྲིག་འགོད་འདི་སློབ་ཚན་ལས་བྱེད་པར་མིང་མི་གསལ་བ་བྱེད་མི་ཐུབ།"

msgid "Advanced Module List"
msgstr "ཚད་མཐོའི་གྲུབ་ཆའི་ཐོ་གཞུང་།"

msgid "Enter the names of the advanced modules to use in your course."
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན་ནང་སྤྱད་རྒྱུའི་ཚད་མཐོའི་ཚད་གཞིའི་མིང་ཞོག"

msgid ""
"True if timezones should be shown on dates in the course. Deprecated in "
"favor of due_date_display_format."
msgstr ""
"དུས་མཇུག་གི་ཟླ་ཚེས་འཆར་སྟོན་གྱི་རྣམ་པ་སྟོན་མི་འདོད་ན། བདེན་པ་བཞག་ན། "
"དུས་ཚོད་ཀྱི་རྣམ་པ་དེ་སློབ་ཚན་གྱི་ཟླ་ཚེས་ནང་སྟོན་ངེས་ཡིན། "

msgid "Due Date Display Format"
msgstr "དུས་བཅད་རྫོགས་པའི་དུས་ཚོད་འཆར་སྟོན་གྱི་རྣམ་སྒྲིག"

msgid ""
"Enter the format for due dates. The default is Mon DD, YYYY. Enter "
"\"%m-%d-%Y\" for MM-DD-YYYY, \"%d-%m-%Y\" for DD-MM-YYYY, \"%Y-%m-%d\" for "
"YYYY-MM-DD, or \"%Y-%d-%m\" for YYYY-DD-MM."
msgstr ""
"དུས་ཡུན་རྫོགས་པའི་ཟླ་ཚེས་ཀྱི་རྣམ་པ་ཞོག སྤྱིར་བཏང་གི་འགྲོ་སྟངས་ནི་ ཟླ་བ། "
"ཚེས་པ། ལོ་ཡིན།. MM-DD-YYYY, འདི་ནི་ \"%ཟླ་-%d-%ལོ་\" འདི་ལྟར་ཞོག, DD-MM-"
"YYYY, འདི་ནི་\"%d-%ཟླ་-%ལོ་\" ལྟར་ཡིན།, YYYY-MM-DD འདི་ནི་ \"%ལོ་-%ཟླ་-%d\" "
"འདི་ལྟར་དང་།, ཡང་ན་ YYYY-DD-MM \"%ལོ་-%d-%ཟླ་\" འདི་ལྟར་ཡིན།"

msgid "External Login Domain"
msgstr "ཕྱིའི་ནང་འཛུལ་གྱི་དྲ་གནས།"

msgid "Enter the external login method students can use for the course."
msgstr ""
"སློབ་ཕྲུག་གིས་སློབ་ཚན་འདིའི་ཆེད་བཀོལ་སྤྱོད་བྱ་ཐུབ་པའི་ཕྱིའི་ནང་འཛུལ་བྱེད་ཐབས་ཞོག"

msgid "Certificates Downloadable Before End"
msgstr "མཇུག་མ་རྫོགས་གོང་ལག་ཁྱེར་ཕབ་ལེན་བྱ་ཐུབ་པ།"

msgid ""
"Enter true or false. If true, students can download certificates before the "
"course ends, if they've met certificate requirements."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག བདེན་པ་བཞག་ན། བདེན་པ་བཞག་ན། "
"སློབ་ཕྲུག་གིས་ལག་ཁྱེར་གྱི་དགོས་མཁོའི་ཆ་རྐྱེན་ཁག་མཐུས་ཚང་བསྒྲུབས་ཡོད་ན་སློབ་ཚན་མཇུག་མ་རྫོགས་གོང་ལག་ཁྱེར་ཕབ་ལེན་བྱ་ཐུབ།"

msgid "Certificates Display Behavior"
msgstr "ལག་ཁྱེར་འཆར་སྟོན་གྱི་རྣམ་པ།"

msgid ""
"This field, together with certificate_available_date will determine when a "
"user can see their certificate for the course"
msgstr ""
"སྡེ་ཚན་འདི་དང་ལྷན་དུ། "
"ལག་འཁྱེར་དང་མཉམ་དུ་ཟླ་ཚེས་ཀྱང་སྤྱོད་མཁན་ཞིག་གིས་སློབ་ཚན་དེའི་ལག་འཁྱེར་ལ་བལྟ་ཐུབ་དུས་གཏན་འཁེལ་བྱེད་ཡོང་།"

msgid "Course About Page Image"
msgstr "སློབ་ཚན་སྐོར་གྱི་ཤོག་ངོས་འདྲ་པར།"

msgid ""
"Edit the name of the course image file. You must upload this file on the "
"Files & Uploads page. You can also set the course image on the Settings & "
"Details page."
msgstr ""
"སློབ་ཚན་དེ་དང་འབྲེལ་བའི་འདྲ་པར་གྱི་མིང་སྒྲིག "
"ཁྱེད་ཀྱིས་ཡིག་ཆ་འདི་ངེས་པར་དུ་ཡིག་ཆ་ & "
"ཡར་སྤྲོད་ཤོག་ངོས་གཉིས་ཀྱི་ནང་ཡར་སྤྲོད་བྱ་དགོས། "
"ད་དུང་ཁྱེད་ཀྱིས་སློབ་ཚན་དང་འབྲེལ་བའི་འདྲ་པར་དེ་སྒྲིག་འགོད་ & "
"ཞིབ་ཕྲའི་ཤོག་ངོས་གཉིས་ཀྱི་ནང་སྒྲིག་ཐུབ།"

msgid "Course Banner Image"
msgstr "སློབ་ཚན་གྱི་འཕྲེད་ཉལ་འདྲ་པར།"

msgid ""
"Edit the name of the banner image file. You can set the banner image on the "
"Settings & Details page."
msgstr ""
"འཕྲེད་ཉལ་འདྲ་པར་གྱི་མིང་རྩོམ་སྒྲིག "
"ཁྱེད་ཀྱིས་འཕྲེད་ཉལ་འདྲ་པར་དེ་སྒྲིག་འགོད་དང་ & "
"ཤོག་ངོས་ཀྱི་ཞིབ་ཕྲ་ཟེར་བ་གཉིས་ཀྱི་ནང་སྒྲིག་ཐུབ།"

msgid "Course Video Thumbnail Image"
msgstr "སློབ་ཚན་བརྙན་གྱི་གདོང་ཁེབ་འདྲ་པར"

msgid ""
"Edit the name of the video thumbnail image file. You can set the video "
"thumbnail image on the Settings & Details page."
msgstr ""
"སློབ་ཚན་བརྙན་གྱི་འདྲ་པར་གྱི་མིང་རྩོམ་སྒྲིག "
"ཁྱེད་ཀྱིས་སློབ་ཚན་བརྙན་གྱི་འདྲ་པར་དེ་སྒྲིག་འགོད་དང་ & "
"ཤོག་ངོས་ཀྱི་ཞིབ་ཕྲ་ཟེར་བ་གཉིས་ཀྱི་ནང་སྒྲིག་ཐུབ།"

msgid ""
"Use this setting only when generating PDF certificates. Between quotation "
"marks, enter the short name of the type of certificate that students receive"
" when they complete the course. For instance, \"Certificate\"."
msgstr ""
"PDF ཡི་རྣམ་པའི་ལག་ཁྱེར་བཟོས་དུས་ད་གཟོད་སྒྲིག་འགོད་འདི་བཀོལ་སྤྱོད་བྱེད། "
"ལུང་རྟགས་ཀྱི་བར་ལ་འཇུག་དགོས། མིང་ཐུང་ངུ་ཞིག་ཞོག "
"དེ་ནི་སློབ་མས་སློབ་ཚན་དེ་སློབ་མཐཪ་ཕྱིན་དུས་འཐོབ་རྒྱུའི་ལག་ཁྱེར་གྱི་གྲས་ཤིག་ཡིན་དགོས།"
" དཔེར་ན། \"ལག་ཁྱེར།\" ལྟ་བུ།"

msgid "Certificate Name (Short)"
msgstr "ལག་ཁྱེར་གྱི་མིང་། (ཐུང་ཐུང་།)"

msgid ""
"Use this setting only when generating PDF certificates. Between quotation "
"marks, enter the long name of the type of certificate that students receive "
"when they complete the course. For instance, \"Certificate of Achievement\"."
msgstr ""
"PDF ཡི་རྣམ་པའི་ལག་ཁྱེར་བཟོས་དུས་ད་གཟོད་སྒྲིག་འགོད་འདི་བཀོལ་སྤྱོད་བྱེད། "
"ལུང་རྟགས་ཀྱི་བར་ལ་འཇུག་དགོས། མིང་རིང་ཙམ་ཞིག་ཞོག "
"དེ་ནི་སློབ་མས་སློབ་ཚན་དེ་སློབ་མཐཪ་ཕྱིན་དུས་འཐོབ་རྒྱུའི་ལག་ཁྱེར་གྱི་གྲས་ཤིག་ཡིན་དགོས།"
" དཔེར་ན། \"གྲུབ་འབྲས་ཀྱི་ལག་ཁྱེར།\" ལྟ་བུ།"

msgid "Certificate Name (Long)"
msgstr "ལག་ཁྱེར་གྱི་མིང་། (རིང་པོ།)"

msgid "Certificate Web/HTML View Enabled"
msgstr "ལག་ཁྱེར་གྱི་དྲ་ཚིགས་/HTML འཆར་སྟོན་ནུས་པ།"

msgid "If true, certificate Web/HTML views are enabled for the course."
msgstr "བདེན་པ་བཞག་ན། སློབ་ཚན་འདིའི་ལག་ཁྱེར་གྱི་དྲ་ཚིགས་/HTMLའཆར་སྟོན་ནུས་པ།"

msgid "Certificate Web/HTML View Overrides"
msgstr "ལག་ཁྱེར་དྲ་ཚིགས་/HTML འཆར་སྟོན་ཟུར་འཇོག་བྱས་པ།"

msgid ""
"Enter course-specific overrides for the Web/HTML template parameters here "
"(JSON format)"
msgstr ""
"དྲ་ཚིགས་དེའི་Web/HTML  མཚོན་བྱེད་མ་དཔེ་ (JSON format) རྣམས་ཀྱི་ཆེད་དུ། "
"སློབ་ཚན་གྱི་དམིགས་བསལ་གྱི་འགོག་མཚམས་རྣམས་ཞོག"

msgid "Certificate Configuration"
msgstr "ལག་ཁྱེར་གྲུབ་ཆ་གོ་སྒྲིག"

msgid "Enter course-specific configuration information here (JSON format)"
msgstr ""
"སློབ་ཚན་གྱི་དམིགས་བསལ་ཆེད་སྤྱོད་བཀོད་སྒྲིག་གི་ཆ་འཕྲིན་ (JSON format) ཞོག"

msgid "CSS Class for Course Reruns"
msgstr "སློབ་ཚན་བསྐྱར་གཏོང་གི་ཆེད་དུ་ CSS ཡི་སྡེ་ཚན།"

msgid ""
"Allows courses to share the same css class across runs even if they have "
"different numbers."
msgstr ""
"གལ་སྲིད་ཁོང་ཚོའི་ཨང་གྲངས་མི་གཅིག་ན་ཡང་སློབ་ཚན་ཁག་css "
"འཛིན་གྲྭ་གཅིག་པ་ཚོར་བརྒྱུད་སྐུར་བྱེད་འཇུག"

msgid "Discussion Forum External Link"
msgstr "གླེང་མོལ་གླེང་སྟེགས་ཀྱི་ཕྱིའི་དྲ་ཐག"

msgid "Allows specification of an external link to replace discussion forums."
msgstr ""
"ཕྱིའི་དྲ་ཐག་གི་དམིགས་འཛིན་ཚད་གཞི་ཡིས་གླེང་མོལ་གླེང་སྟེགས་བརྗེ་ལེན་བྱེད་འཇུག་པ།"

msgid "Hide Progress Tab"
msgstr "ཡར་རྒྱས་རྟགས་ཀྱི་ཐེབས་སྦེད།"

msgid "Allows hiding of the progress tab."
msgstr "ཡར་རྒྱས་རྟགས་ཀྱི་ཐེབས་སྦེད་འཇུག་པ།"

msgid "Course Organization Display String"
msgstr "སློབ་ཚན་རྩ་འཛུགས་འཆར་སྟོན་གྱི་བང་རིམ།"

msgid ""
"Enter the course organization that you want to appear in the course. This "
"setting overrides the organization that you entered when you created the "
"course. To use the organization that you entered when you created the "
"course, enter null."
msgstr ""
"ཁྱེད་ཀྱིས་སློབ་ཚན་འདིའི་ནང་སྟོན་འདོད་པའི་སློབ་ཚན་རྩ་འཛུགས་དེ་ཞོག "
"སྒྲིག་འགོད་འདིས་ཁྱེད་ཀྱིས་སློབ་ཚན་བཟོས་དུས་ཁྱེད་ཀྱིས་ནང་འཇུག་བྱས་པའི་རྩ་འཛུགས་དེ་བཀག་འགྲོ་བ་ཡིན།"
" "
"ཁྱེད་ཀྱིས་ནང་འཇུག་བྱས་པའི་རྩ་འཛུགས་དེ་མུ་མཐུད་ནས་འཇོག་དགོས་ན་ཁྱེད་ཀྱིས་སློབ་ཚན་བཟོས་དུས་་མེད་ཟེར་བ་ཞོག"

msgid "Course Number Display String"
msgstr "སློབ་ཚན་ཨང་འཅར་སྟོན་གྱི་བང་རིམ།"

msgid ""
"Enter the course number that you want to appear in the course. This setting "
"overrides the course number that you entered when you created the course. To"
" use the course number that you entered when you created the course, enter "
"null."
msgstr ""
"ཁྱེད་ཀྱིས་སློབ་ཚན་འདིའི་ནང་སྟོན་འདོད་པའི་སློབ་ཚན་ཨང་དེ་ཞོག "
"སྒྲིག་འགོད་འདིས་ཁྱེད་ཀྱིས་སློབ་ཚན་བཟོས་དུས་ཁྱེད་ཀྱིས་ནང་འཇུག་བྱས་པའི་སློབ་ཚན་ཨང་དེ་བཀག་འགྲོ་བ་ཡིན།"
" "
"ཁྱེད་ཀྱིས་ནང་འཇུག་བྱས་པའི་སློབ་ཚན་ཨང་དེ་མུ་མཐུད་ནས་འཇོག་དགོས་ན་ཁྱེད་ཀྱིས་སློབ་ཚན་བཟོས་དུས་་མེད་ཟེར་བ་ཞོག"

msgid "Course Maximum Student Enrollment"
msgstr "སློབ་ཚན་ལ་ཞུགས་ཐོ་འགོད་མཁན་གྱི་སློབ་ཕྲུག་གི་མང་མཐའ།"

msgid ""
"Enter the maximum number of students that can enroll in the course. To allow"
" an unlimited number of students, enter null."
msgstr ""
"སློབ་ཕྲུག་ག་ཚོད་ཀྱིས་སློབ་ཚན་འདི་ལ་ཞུགས་ཐོ་འགོད་ཆོག་པའི་ཁ་གྲངས་ཕྲིས། "
"ཚད་བཅད་མེད་ན། མེད་ཕྲིས།"

msgid "Allow Public Wiki Access"
msgstr "སྤྱི་སྤྱོད་ཀྱི་ཝེ་ཁེ་བལྟ་ཀློག་ཆོག་པ།"

msgid ""
"Enter true or false. If true, students can view the course wiki even if "
"they're not enrolled in the course."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞོག བདེན་པ་བཞག་ན། "
"སློབ་ཕྲུག་གིས་སློབ་ཚན་དེར་ཐོ་འགོད་བྱས་མེད་རུང་སློབ་ཚན་དེའི་ཝེ་ཁེ་བལྟ་ཀློག་ཆོག"

msgid "Invitation Only"
msgstr "མགྲོན་བརྡ་གཏོང་རྒྱུ་ཁོ་ན།"

msgid "Whether to restrict enrollment to invitation by the course staff."
msgstr "སློབ་ཚན་ལས་བྱེད་ཀྱིས་གདན་འདྲེན་བྱས་པའི་ཞུགས་ཐོ་ལ་དམ་རྒྱ་བྱེད་དམ།"

msgid "Pre-Course Survey Name"
msgstr "སྔོན་འགྲོའི་སློབ་ཚན་གྱི་བརྟད་དཔྱད་ཀྱི་མིང་།"

msgid "Name of SurveyForm to display as a pre-course survey to the user."
msgstr ""
"སྤྱོད་མཁན་ལ་སྔོན་འགྲོའི་སློབ་ཚན་ཞིག་ཡིན་པ་སྟོན་པའི་བརྟག་དཔྱད་ཤོག་ངོས་ཀྱི་མིང་།"

msgid "Pre-Course Survey Required"
msgstr "སྔོན་འགྲོའི་སློབ་ཚན་བརྟག་དཔྱད་དགོས་ངེས།"

msgid ""
"Specify whether students must complete a survey before they can view your "
"course content. If you set this value to true, you must add a name for the "
"survey to the Course Survey Name setting above."
msgstr ""
"གལ་སྲིད་སློབ་མས་ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་ནང་དོན་ལ་མ་བལྟས་སྔོན་ཁོང་ཚོས་བརྟག་དཔྱད་དེ་ཆ་ཚང་ངེས་པར་དུ་ལེན་དགོས་མིན་གཏན་འབེབ་བྱོས།"
" "
"སྒྲིག་གནས་འདི་བདེན་པ་ཟེར་བ་བསྒྲིགས་ན་སྒང་གི་སློབ་ཚན་བརྟག་དཔྱད་ཀྱི་སྒྲིག་འགོད་ནང་བརྟག་དཔྱད་ཀྱི་མིང་ཞིག་ངེས་པར་འཇོག་དགོས།"

msgid "Course Visibility In Catalog"
msgstr "སློབ་ཚན་དེ་དཀར་ཆག་ནང་འཆར་ཐུབ་པ།"

msgid ""
"Defines the access permissions for showing the course in the course catalog."
" This can be set to one of three values: 'both' (show in catalog and allow "
"access to about page), 'about' (only allow access to about page), 'none' (do"
" not show in catalog and do not allow access to an about page)."
msgstr ""
"སློབ་ཚན་དཀར་ཆག་ནང་སློབ་ཚན་སྟོན་སྟངས་ཀྱི་ཆོག་མཆན་གཏན་འཁེལ་བྱོས།: "
"འདི་ནི་རིན་ཐང་གི་ཚད་གསུམ་གྱི་གང་རུང་ཞིག་ཡིན་ཆོག་སྟེ། 'རིགས་གཉིས་ཆོག' "
"(སློབ་ཚན་དཀར་ཆག་ནང་སྟོན་ཆོག་ལ་ཤོག་ངོས་ཀྱི་སྐོར་བལྟ་ཀློག་ཀྱང་ཆོག) "
"'ཤོག་ངོས་ཀྱི་སྐོར།' (ཤོག་ངོས་ཀྱི་སྐོར་ཁོ་ནར་བལྟ་ཆོག), 'གང་ཡང་མི་ཆོག' "
"(སློབ་ཚན་དཀར་ཆག་ནང་མི་སྟོན། ཤོག་ངོས་ཀྱི་སྐོར་ཡང་བལྟ་ཀློག་མི་ཆོག)"

msgid "Entrance Exam Enabled"
msgstr "ཚུད་རྒྱུགས་ནུས་ལྡན་བྱེད་པ།"

msgid ""
"Specify whether students must complete an entrance exam before they can view"
" your course content. Note, you must enable Entrance Exams for this course "
"setting to take effect."
msgstr ""
"སློབ་ཕྲུག་ཚོས་ཁྱེད་ཀྱི་སློབ་ཚན་ནང་དོན་བལྟ་ཀློག་ཐུབ་པར་ཁོང་ཚོས་ཐོག་མར་ཚུད་རྒྱུགས་ཆ་ཚང་ངེས་པར་ལེན་དགོས་མིན་གཏན་འཁེལ་བྱོས།"
" གསལ་འདེབས་བྱ་རྒྱུ་ནི། "
"སློབ་ཚན་འདིའི་སྒྲིག་འགོད་ཁག་གིས་བྱེད་ནུས་འདོན་པར་ཁྱེད་ཀྱིས་ངེས་པར་དུ་ནུས་ཚུད་རྒྱུགས་ནུས་ལྡན་བྱེད་དགོས།"

msgid "Entrance Exam Minimum Score (%)"
msgstr "ཚུགས་རྒྱུགས་ཀྱི་ཉུང་མཐའི་ཐོབ་སྐར། (%)"

msgid ""
"Specify a minimum percentage score for an entrance exam before students can "
"view your course content. Note, you must enable Entrance Exams for this "
"course setting to take effect."
msgstr ""
"སློབ་ཕྲུག་གིས་ཁྱེད་ཀྱི་སློབ་ཚན་ནང་དོན་ལ་མ་བལྟས་སྔོན་ཚུད་རྒྱུགས་ཀྱི་དམའ་མཐའི་ཐོབ་སྐར་གྱི་བརྒྱ་ཆ་ཞིག་གཏན་འཁེལ་བྱོས།"
" གསལ་འདེབས་བྱེད་རྒྱུར། "
"སློབ་ཚན་འདིའི་སྒྲིག་འགོད་ཀྱི་བྱེད་ནུས་འདོན་པར་ཁྱེད་ཀྱིས་ཚུད་རྒྱུགས་དེ་ངེས་པར་དུ་ནུས་ལྡན་བྱ་དགོས།"

msgid "Entrance Exam ID"
msgstr "ཚུད་རྒྱུགས་ཀྱི་ ID"

msgid "Content block identifier (location) of entrance exam."
msgstr "ཚུད་རྒྱུགས་ཀྱི་ (location) ནང་དོན་ཚན་པའི་ངོས་འཛིན་བྱེད།"

msgid "Social Media Sharing URL"
msgstr "དམིགས་བསལ་སྨྱན་གཟུགས་བརྒྱུད་སྐུར་གྱི་ URL"

msgid ""
"If dashboard social sharing and custom course URLs are enabled, you can "
"provide a URL (such as the URL to a course About page) that social media "
"sites can link to. URLs must be fully qualified. For example: "
"http://www.edx.org/course/Introduction-to-MOOCs-ITM001"
msgstr ""
"If dashboard social sharing and custom course URLs are enabled, you can "
"provide a URL (such as the URL to a course About page) that social media "
"sites can link to. URLs must be fully qualified. For example: "
"http://www.edx.org/course/Introduction-to-MOOCs-ITM001"

msgid "Course Language"
msgstr "སློབ་ཚན་སྐད་ཡིག"

msgid "Specify the language of your course."
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་སྐད་ཡིག་ངོས་འཛིན་བྱོས།"

msgid "Teams Configuration"
msgstr "ཚོགས་ཆུང་གི་གྲུབ་ཆ་གོ་སྒྲིག"

msgid ""
"Configure team sets, limit team sizes, and set visibility settings using "
"JSON. See <a target=\"&#95;blank\" "
"href=\"https://edx.readthedocs.io/projects/edx-partner-course-"
"staff/en/latest/course_features/teams/teams_setup.html#enable-and-configure-"
"teams\">teams configuration documentation</a> for help and examples."
msgstr ""
"ཚོགས་ཆུང་གི་རྣམ་པའི་སྒྲིག་གཞི། JSON "
"སྤྱད་དེ་ཚོགས་ཆུང་གི་ཆེ་ཆུང་ཚད་ངེས་ཅན་དང་འཆར་སྟོན་བྱ་མིན་སྒྲིག <a "
"target=\"&#95;blank\" href=\"https://edx.readthedocs.io/projects/edx-"
"partner-course-"
"staff/en/latest/course_features/teams/teams_setup.html#enable-and-configure-"
"teams\">ཚོགས་ཆུང་ཆེད་སྒྲིག་སྒྲིག་གཞི་དང་ </a> "
"རམ་འདེགས་དང་དཔེ་མཚོན་བཅས་ལ་གཟིགས།"

msgid "Enable Proctored Exams"
msgstr "དྲ་ལམ་རྒྱུགས་སྤྲོད་ཐུབ་པ།"

msgid ""
"Enter true or false. If this value is true, proctored exams are enabled in "
"your course. Note that enabling proctored exams will also enable timed "
"exams."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞོག སྒྲིག་གནས་བདེན་པ་བསྒྲིགས་ན། "
"ཁྱེད་ཀྱི་སློབ་ཚན་ལ་རྒྱུགས་ཞིབ་པས་ལྟ་རྟོག་འོག་ཡོད་པའི་རྒྱུགས་སྤྲོད་རྣམས་ཡོད། "
"ངེས་དགོས་པ་ཞིག་ནི་ལྟ་རྟོག་ཡོད་པའི་རྒྱུགས་སྤྲོད་ལ་དུས་ཚོད་ཀྱི་བཅད་པ་ཡང་ཡོད།"

msgid "Proctoring Provider"
msgstr "དྲ་ལམ་ཡིག་རྒྱུགས་མཁོ་སྤྲོད་པ།"

msgid ""
"Enter the proctoring provider you want to use for this course run. Choose "
"from the following options: {available_providers}."
msgstr ""
"ཁྱེད་ཀྱིས་འཇོག་འདོད་པའི་སློབ་ཚན་འདི་དོ་དམ་དང་འཆད་ཁྲིད་མཁན་ཞོག "
"གཤམ་བཀོད་ཀྱི་གདམ་ཁའི་ཁྲོད་ནས་འདེམ།: {available_providers}."

msgid "Proctortrack Exam Escalation Contact"
msgstr "དྲ་ཐོག་རྒྱུགས་སྤྲོད་རིམ་སྤར་གྱི་འབྲེལ་གཏུགས།"

msgid ""
"Required if 'proctortrack' is selected as your proctoring provider. Enter an"
" email address to be contacted by the support team whenever there are "
"escalations (e.g. appeals, delayed reviews, etc.)."
msgstr ""
"Required if 'proctortrack' is selected as your proctoring provider. Enter an"
" email address to be contacted by the support team whenever there are "
"escalations (e.g. appeals, delayed reviews, etc.)."

msgid "Allow Opting Out of Proctored Exams"
msgstr "དྲ་ལམ་རྒྱུགས་སྤྲོད་མེད་པའི་འདེམ་ཁ་སྤྲོད་པ།"

msgid ""
"Enter true or false. If this value is true, learners can choose to take "
"proctored exams without proctoring. If this value is false, all learners "
"must take the exam with proctoring. This setting only applies if proctored "
"exams are enabled for the course."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག བདེན་པ་བཞག་ན། "
"སློབ་གཉེར་པ་ཚོས་ལྟ་རྟོག་ཡོད་པའི་ཡིག་རྒྱུགས་ཁག་དོ་དམ་པའི་བལྟ་ཞིབ་མེད་པའི་ཐོག་ནས་ཡིག་རྒྱུགས་འདེམ་ཆོག"
" རྫུན་པ་བཞག་ན། "
"སློབ་གཉེར་པ་ཡོད་དོ་ཅོག་གིས་ཡིག་རྒྱུགས་རྣམས་ངེས་པར་དུ་དོ་དམ་བལྟ་ཞིབ་འོག་རྒྱུགས་སྤྲོད་བྱ་དགོས།"
" "
"སློབ་ཚན་དེའི་བལྟ་རྟོག་ཡོད་པའི་ཡིག་རྒྱུགས་ཁག་ནུས་ལྡན་བྱས་ན་ད་གཟོད་སྒྲིག་འགོད་འདི་འཇོག་དགོས་པ་ཡིན།"

msgid "Create Zendesk Tickets For Suspicious Proctored Exam Attempts"
msgstr "ལྟ་རྟོག་ཡོད་པའི་ཡིག་རྒྱུགས་དོགས་གཞི་ཆན་ཚོར་Zendesk Tickets ཞིག་བཟོས།"

msgid ""
"Enter true or false. If this value is true, a Zendesk ticket will be created"
" for suspicious attempts."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞོག སྒྲིག་གནས་བདེན་པ་བསྒྲིགས་ན། "
"ལྟ་རྟོག་ཡོད་པའི་ཡིག་རྒྱུགས་དོགས་གཞི་ཅན་གྱི་ཆེད་དུ་ Zendesk ticket "
"བཟོ་ཡོང་བ་ཡིན། "

msgid "Enable Timed Exams"
msgstr "དུས་བཅད་ཀྱི་རྒྱུགས་ནུས་ལྡན་བྱེད་པ།"

msgid ""
"Enter true or false. If this value is true, timed exams are enabled in your "
"course. Regardless of this setting, timed exams are enabled if Enable "
"Proctored Exams is set to true."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག འདིར་བདེན་པ་བཞག་ན། "
"ཁྱེད་ཀྱི་སློབ་ཚན་ནང་གི་དུས་ཡུན་ཚད་བཀག་ཅན་གྱི་ཡིག་རྒྱུགས་རྣམས་ནུས་ལྡན་བྱེད་འགྲོ།"
" "
"གལ་སྲིད་ལྟ་རྟོག་ཡོད་པའི་ཡིག་རྒྱུགས་རྣམས་བདེན་པ་བསྒྲིགས་ན་དུས་ཡུན་ཚད་བཀག་ཅན་གྱི་ཡིག་རྒྱུགས་རྣམས་ནུས་ལྡན་བྱེད་འགྲོ།"

msgid "Minimum Grade for Credit"
msgstr "ངོ་སོའི་ཕྱིར་དམའ་མཐའི་རིམ་པ།"

msgid ""
"The minimum grade that a learner must earn to receive credit in the course, "
"as a decimal between 0.0 and 1.0. For example, for 75%, enter 0.75."
msgstr ""
"The minimum grade that a learner must earn to receive credit in the course, "
"as a decimal between 0.0 and 1.0. For example, for 75%, enter 0.75."

msgid "Self Paced"
msgstr "རང་སྦྱོང་།"

msgid ""
"Set this to \"true\" to mark this course as self-paced. Self-paced courses "
"do not have due dates for assignments, and students can progress through the"
" course at any rate before the course ends."
msgstr ""
"འདི་ནི་རང་སྦྱོང་སློབ་ཚན་ཡིན་པའི་ནན་རྟགས་འགོད་ཕྱིར་འདི་ \"true\" ལ་སྒྲིག "
"རང་སྦྱོང་སློབ་ཚན་ལ་ལས་བྱའི་དུས་བཀག་མེད་པ་དང་། "
"སློབ་ཚན་མཇུག་མ་རྫོགས་བར་དུ་སློབ་ཕྲུག་ཚོས་དུས་ཚོད་ནམ་ཁོམ་ལ་སློབ་སྦྱོང་བྱ་ཆོག་པ་ཡིན།"

msgid "Enable Subsection Prerequisites"
msgstr "ནང་གསེས་སྡེ་ཚན་གྱི་སྔོན་འགྲོའི་དགོས་མཁོ་ནུས་ལྡན་བྱེད་པ།"

msgid ""
"Enter true or false. If this value is true, you can hide a subsection until "
"learners earn a minimum score in another, prerequisite subsection."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག སྒྲིག་གནས་འདི་བདེན་པ་བཞག་ན། "
"སློབ་གཉེར་བས་སྔོན་འགྲོའི་ནང་གསེས་སྡེ་ཚན་བཅས་གཞན་ནས་ཐོབ་སྐར་གང་འཚམ་མ་བླངས་བར་དུ་ཁྱེད་ཀྱིས་ནང་གསེས་སྡེ་ཚན་ཞིག་སྐུང་ཆོག"

msgid "Course Learning Information"
msgstr "སློབ་ཚན་སྦྱོང་སྟངས་ཀྱི་གནས་ཚུལ།"

msgid "Specify what student can learn from the course."
msgstr "སློབ་ཚན་དེ་ནས་སློབ་ཕྲུག་གིས་ཅི་ཞིག་བསླབ་ཐུབ་པ་ངོས་འཛིན་བྱོས།"

msgid "Course Visibility For Unenrolled Learners"
msgstr "ཞུགས་ཐོ་མ་བཀོད་པའི་སློབ་ཕྲུག་གིས་སློབ་ཚན་འདི་བལྟ་ཐུབ་ཚད།"

msgid ""
"Defines the access permissions for unenrolled learners. This can be set to "
"one of three values: 'private' (default visibility, only allowed for "
"enrolled students), 'public_outline' (allow access to course outline) and "
"'public' (allow access to both outline and course content)."
msgstr ""
"Defines the access permissions for unenrolled learners. This can be set to "
"one of three values: 'private' (default visibility, only allowed for "
"enrolled students), 'public_outline' (allow access to course outline) and "
"'public' (allow access to both outline and course content)."

msgid "Video Sharing Options"
msgstr "བརྙན་བརྒྱུད་སྐུར་གྱི་འདེམ་གསེས།"

msgid ""
"Specify the video sharing options for the course. This can be set to one of "
"three values: 'all-on', 'all-off' and 'per-video'. with 'per-video' as the "
"default."
msgstr ""
"སློབ་ཚན་འདིའི་བརྙན་བརྒྱུད་སྐུལ་གྱི་གདམ་གསེས་ཁག་གཏན་འཁེལ་བྱ་དགོས། "
"དེ་ནི་གདམ་གསེས་རིགས་གསུམ་ཡོད་པའི་གཅིག་སྒྲིག་ཆོག་སྟེ།  'ཚང་མ་-ཆོག', དང་ཡང་ན་ "
"'ཚང་མ་-མི་ཆོག'  'བརྙན་-རེ་རེ་བཞིན་ཆོག'. ལྟ་བུ་དང་། 'བརྙན་-རེ་རེ་བཞིན་ཆོག' "
"ནི་རྨང་གཞིའི་སྒྲིག་འགོད་ཡིན།"

msgid "Force Flexible Grading for Peer ORAs"
msgstr "Force Flexible Grading for Peer ORAs"

msgid ""
"Setting this flag will force on the flexible grading option for all peer-"
"graded ORAs in this course."
msgstr ""
"དར་རྟགས་འདི་བསྒྲིགས་ན་འདིས་སློབ་ཚན་འདིའི་ནང་གི་གནས་རིམ་བྱས་པའི་བརྟག་དཔྱད་དྲི་བ་ཡོངས་"
" flexible grading ཅན་ལ་བསྒྲིག་འགྲོ་བ་ཡིན།"

msgid "Course Instructor"
msgstr "སློབ་ཚན་ལམ་སྟོན་པ།"

msgid "Enter the details for Course Instructor"
msgstr "སློབ་ཚན་ལམ་སྟོན་པའི་ཞིབ་ཕྲ་ཁོད།"

msgid "Add Unsupported Problems and Tools"
msgstr "བེད་སྤྱོད་མེད་པའི་དྲི་བ་དང་ལག་ཆ་ཁག་ཞོག"

msgid ""
"Enter true or false. If true, you can add unsupported problems and tools to "
"your course in Studio. Unsupported problems and tools are not recommended "
"for use in courses due to non-compliance with one or more of the base "
"requirements, such as testing, accessibility, internationalization, and "
"documentation."
msgstr ""
"Enter true or false. If true, you can add unsupported problems and tools to "
"your course in Studio. Unsupported problems and tools are not recommended "
"for use in courses due to non-compliance with one or more of the base "
"requirements, such as testing, accessibility, internationalization, and "
"documentation."

msgid "Highlights Enabled for Messaging"
msgstr "འཕྲིན་ཐུང་གཏོང་བར་ནན་རྟགས་ནུས་ལྡན་བྱེད་པ།"

msgid ""
"Enter true or false. If true, any highlights associated with content in the "
"course will be messaged to learners at their scheduled time."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞོག བདེན་པ་བཞག་ན། "
"སློབ་ཚན་དེའི་ནང་ཡོད་པའི་ནང་དོན་དང་མཉམ་སྦྱོར་བྱས་པའི་ནན་རྟགས་རིགས་གང་ཡིན་རུང་སློབ་གཉེར་བར་ཐད་ཀར་ཁོང་ཚོའི་དུས་བཅད་ནང་གཏོང་འགྲོ་བ་ཡིན།"

msgid "Course-wide Custom JS"
msgstr "སློབ་ཚན་གྱི་རྒྱ་ཞེང་གི་རྨང་གཞི་ JS"

msgid ""
"Enter Javascript resource URLs you want to be loaded globally throughout the"
" course pages."
msgstr ""
"ཁྱེད་ཀྱིས་སློབ་ཚན་དེའི་སྤྱི་ཡོངས་བཀོལ་སྤྱོད་བྱ་རྒྱུའི་Javascript "
"ཡི་རྒྱུ་ཆའི་དྲ་ཐག URLs ཞོག"

msgid "Course-wide Custom CSS"
msgstr "སློབ་ཚན་གྱི་རྒྱ་ཞེང་གི་རྨང་གཞི་ CSS"

msgid ""
"Enter CSS resource URLs you want to be loaded globally throughout the course"
" pages."
msgstr ""
"ཁྱེད་ཀྱིས་སློབ་ཚན་དེའི་སྤྱི་ཡོངས་བཀོལ་སྤྱོད་བྱ་རྒྱུའི་CSS ཡི་རྒྱུ་ཆའི་དྲ་ཐག "
"URLs ཞོག"

msgid "Other Course Settings"
msgstr "སློབ་ཚན་གྱི་སྒྲིག་འགོད་གཞན་ཁག"

msgid ""
"Any additional information about the course that the platform needs or that "
"allows integration with external systems such as CRM software. Enter a "
"dictionary of values in JSON format, such as { \"my_custom_setting\": "
"\"value\", \"other_setting\": \"value\" }"
msgstr ""
"Any additional information about the course that the platform needs or that "
"allows integration with external systems such as CRM software. Enter a "
"dictionary of values in JSON format, such as { \"my_custom_setting\": "
"\"value\", \"other_setting\": \"value\" }"

msgid "Category"
msgstr "དཀར་ཆག"

msgid "Week 1"
msgstr "གཟའ་འཁོར། ༡"

msgid ""
"A category name for the discussion. This name appears in the left pane of "
"the discussion forum for the course."
msgstr ""
"བགྲོ་གླེང་དེའི་རིགས་ཚན་གྱི་མིང་། "
"མིང་འདི་སློབ་ཚན་དེའི་བགྲོ་གླེང་སྟེགས་བུ་གཡོན་པའི་ནང་འཆར་ཡོང་།"

msgid "Subcategory"
msgstr "ནང་གསེས་དཀར་ཆག"

msgid ""
"A subcategory name for the discussion. This name appears in the left pane of"
" the discussion forum for the course."
msgstr ""
"བགྲོ་གླེང་དེའི་རིགས་ཚན་ནང་གསེས་ཀྱི་མིང་། "
"མིང་འདི་སློབ་ཚན་དེའི་བགྲོ་གླེང་སྟེགས་བུ་གཡོན་པའི་ནང་འཆར་ཡོང་།"

msgid ""
"You are not signed in. To view the discussion content, {sign_in_link} or "
"{register_link}, and enroll in this course."
msgstr ""
"ཁྱེད་རང་ནང་འཛུལ་བྱས་མི་འདུག {sign_in_link} དང་ཡང་ན་ {register_link} "
"བྱས་ཏེ་སློབ་ཚན་ལ་ཞུགས་ཐོ་ཁོད།"

msgid "{assignment_type} = {weighted_percent:.2%} of a possible {weight:.2%}"
msgstr "{assignment_type} = {weighted_percent:.2%} of a possible {weight:.2%}"

msgid "Generated"
msgstr "བཟོས་ཡོད།"

msgid "{section_type} {index} Unreleased - 0% (?/?)"
msgstr "{section_type} {index} སྤེལ་མེད་པ་ - 0% (?/?)"

msgid "The lowest {drop_count} {section_type} scores are dropped."
msgstr "ཐོབ་སྐར་དམའ་ཤོས་ {drop_count} {section_type} ཁག་བཞག་ཡོད།"

msgid "{section_type} Average = {percent:.2%}"
msgstr "{section_type} ཆ་སྙོམས་ = {percent:.2%}"

msgid "{short_label} Avg"
msgstr "{short_label} ཆ་སྙོམས།"

msgid ""
"ERROR: \"{block_type}\" is an unknown component type. This component will be"
" hidden in LMS."
msgstr ""
"གནད་དོན་བྱུང་སོང་།: \"{block_type}\" "
"ནི་གསལ་ཁ་མེད་པའི་གྲུབ་ཆའི་རིགས་ཤིག་རེད།. གྲུབ་འདི་ནི་ LMS ཡི་ནང་ཡིབ་འགྲོ།"

msgid "Html contents to display for this block"
msgstr "ཚན་པ་འདི་སྟོན་བྱེད་ཀྱི་ནང་དོན་Html"

msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr ""
"LaTeX ཡིག་ཆའི་ཡོང་ཁུངས་ཀྱི་ཨང་བརྡ། ཁྱད་ཆོས་འདི་བེད་སྤྱོད་ཚད་ལྡན་བྱ་མི་ཐུབ།"

msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."

msgid "Editor"
msgstr "རྩོམ་སྒྲིག་པ།"

msgid "Visual"
msgstr "གཟུགས་སྟོན།"

msgid "Raw"
msgstr "མ་ཕྱི།"

msgid "Hide Page From Learners"
msgstr "ཤོག་ངོས་འདི་སློག་གཉེར་བར་སྦེད།"

msgid ""
"If you select this option, only course team members with the Staff or Admin "
"role see this page."
msgstr ""
"ཁྱེད་ཀྱིས་གདམ་ཁ་འདི་བདམས་ན། "
"སློབ་ཚན་ཚོགས་མི་དང་ལས་བྱེད་ཡང་ན་འཛིན་སྐྱོང་མི་སྣ་ཁོ་ནས་ཤོག་ངོས་འདི་ལ་བལྟ་ཐུབ།"

msgid "HTML for the additional pages"
msgstr "ཤོག་ངོས་སྣོན་མའི་HTML"

msgid "List of course update items"
msgstr "སློབ་ཚན་ཁ་གསབ་དངོས་རིགས་ཀྱི་ཐོ་གཞུང་།"

msgid "Count"
msgstr "གྲངས་བརྩི།"

msgid ""
"Enter the number of components to display to each student. Set it to -1 to "
"display all components."
msgstr ""
"སློབ་ཕྲུག་རེ་རེ་ལ་སྟོན་རྒྱུའི་གྲུབ་ཆ་རེ་རེའི་ཨང་གྲངས་ཞོག "
"གྲུབ་ཆ་ཚང་མ་སྟོན་པར་དེ་ -1 ལ་བསྒྲིག"

msgid ""
"Determines whether a 'Reset Problems' button is shown, so users may reset "
"their answers and reshuffle selected items."
msgstr ""
"&#39;དཀའ་ངལ་སླར་སྒྲིག་&#39; མཐེབ་སྟོན་ཡོད་མེད་གཏན་འབེབས་བྱེད། "
"དེར་བརྟེན་སྤྱོད་མཁན་གྱིས་ལན་སླར་སྒྲིག་དང་འདེམས་སྒྲུག་བྱས་པའི་རྣམ་གྲངས་བསྐྱར་སྒྲིག་བྱེད་ཆོག"

msgid ""
"The problem bank has been configured to show {count} problems. Please "
"specify a positive number of problems, or specify -1 to show all problems."
msgstr ""
"དེ་གི་སྐོར་དུ་བཅོས་ཡོད་པའི་འགྲེལ་བཤད་ནི་གང་ཡང་མེད། {count} "
"གྲུབ་ཐོབ་ཚུལ་གྱི་གནས་ཚུལ་སྟོན་དགོས། གྲུབ་ཐོབ་གྲངས་དང་པོ་གནད་དུ་བཀོད་དགོས། "
"ཡང་ན་ -1 གནད་དུ་བཀོད་ནས་གྲུབ་ཐོབ་ཚང་མ་སྟོན་དགོས།."

msgid ""
"The problem bank has been configured to show {count} problems, but only "
"{actual} have been selected."
msgstr ""
"དེ་གི་སྒྲིག་སྟངས་བྱས་ཡོད་པའི་འབྲི་དོན་གྱི་སྒོ་ལ་འདུག་པའི་འབྲི་དོན་གྱི་གྲངས་འདུག {count} ཡོད་པས།\n"
"དེ་ནས་གཅིག་རེད་ {actual} ཡོད།"

msgid "Any Type"
msgstr "རིགས་གང་ཡིན།"

msgid "Library"
msgstr "དཔེ་མཛོད།"

msgid "Select the library from which you want to draw content."
msgstr "ཁྱེད་ཀྱིས་ནང་དོན་ལེན་སའི་དཔེ་མཛོད་དེ་འདེམ།"

msgid "Library Version"
msgstr "དཔེ་མཛོད་ཀྱི་ཐོན་རིམ།"

msgid "Problem Type"
msgstr "དྲི་བའི་རིགས།"

msgid ""
"Choose a problem type to fetch from the library. If \"Any Type\" is selected"
" no filtering is applied."
msgstr ""
"དཔེ་མཛོད་ནས་ལེན་རྒྱུའི་དྲི་བའི་རིགས་ཤིག་འདེམ། གལ་སྲིད་ \"རིགས་གང་ཡིན།\" "
"ཟེར་བ་བདམས་ན་ཚགས་སྒྲིག་བྱེད་མི་དགོས་པར་གྱུར་འགྲོ།"

msgid "Source content library has not been specified."
msgstr "འབྱུང་ཁུངས་ནང་དོན་དཔེ་མཛོད་གཏན་འཁེལ་བྱས་མེད།"

msgid "Content libraries are not available in the current runtime."
msgstr "ནང་དོན་དཔེ་མཛོད་རྣམས་མིག་སྔའི་འཁོར་སྐྱོད་དུས་ཚོད་ནང་མེད།"

msgid "Source content library does not exist: {source_library_id}"
msgstr "འབྱུང་ཁུངས་ནང་དོན་དཔེ་མཛོད་མེད་པ། {source_library_id}"

msgid "This component is out of date. The library has new content."
msgstr ""
"གྲུབ་ཆ་འདིའི་དུས་ཚོད་ཡོལ་འདུག་པས། དཔེ་མཛོད་དེའི་ནང་ནང་དོན་གསར་བ་བཞག་ཡོད།"

msgid "{refresh_icon} Update now."
msgstr "{refresh_icon} རིམ་སྤར་བྱོས།"

msgid "Library is invalid, corrupt, or has been deleted."
msgstr "དཔེ་མཛོད་ཚུལ་མཐུན་ཞིག་མ་རེད། སྐྱོན་ཤོར་བ་དང་ཡང་སུབ་ཚར་འདུག"

msgid "Edit Library List."
msgstr "དཔེ་མཛོད་ཀྱི་ཐོ་གཞུང་སྒྲིག་སྦྱོར།"

msgid ""
"This course does not support content libraries. Contact your system "
"administrator for more information."
msgstr ""
"སློབ་ཚན་འདི་ནང་དོན་གྱི་དཔེ་མཛོད་ཁག་ལ་འབྲེལ་མི་འདུག "
"གནས་ཚུལ་ཞིབ་ཕྲ་ཤེས་ཆེད་ཁྱེད་ཀྱི་མ་ལག་འཛིན་སྐྱོང་བར་འབྲེལ་བ་བྱོས།"

msgid "A library has not yet been selected."
msgstr "དཔེ་མཛོད་ཅིག་ད་དུང་འདེམ་མི་འདུག"

msgid "Select a Library."
msgstr "དཔེ་མཛོད་ཅིག་འདེམ།"

msgid "There are no problems in the specified library of type {capa_type}."
msgstr "{capa_type} རིགས་ཀྱི་གསལ་བཀོད་བྱས་པའི་དཔེ་མཛོད་ནང་དཀའ་ངལ་མེད།"

msgid "Select another problem type."
msgstr "དྲི་བའི་རིགས་གཞན་ཞིག་འདེམ།"

msgid "Edit the library configuration."
msgstr "དཔེ་མཛོད་དེའི་ཆེད་སྒྲིག་རྩོམ་སྒྲིག"

msgid "Invalid Library"
msgstr "ཚུལ་མཐུན་མིན་པའི་དཔེ་མཛོད།"

msgid "No Library Selected"
msgstr "དཔེ་མཛོད་མི་འདེམ།"

msgid "Library Display Name"
msgstr "དཔེ་མཛོད་ཀྱི་འཆར་མིང་།"

msgid "Enter the names of the advanced components to use in your library."
msgstr "ཁྱེད་ཀྱི་དཔེ་མཛོད་ནང་བཀོལ་རྒྱུའི་ཚད་མཐོའི་གྲུབ་ཆའི་མིང་རྣམས་ཞོག"

msgid ""
"The display name for this component. Analytics reports may also use the "
"display name to identify this component."
msgstr ""
"གྲུབ་ཆ་འདིའི་འཆར་མིང་། "
"གྲུབ་ཆ་འདི་ངོས་འཛིན་བྱེད་པར་བརྟག་དཔྱད་སྙན་ཞུ་ཡིས་ཀྱང་འཆར་མིང་འདི་བཀོལ་སྤྱོད་བྱ་སྲིད།"

msgid "LTI ID"
msgstr "LTI ID"

msgid ""
"Enter the LTI ID for the external LTI provider.  This value must be the same"
" LTI ID that you entered in the LTI Passports setting on the Advanced "
"Settings page.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Enter the LTI ID for the external LTI provider.  This value must be the same"
" LTI ID that you entered in the LTI Passports setting on the Advanced "
"Settings page.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."

msgid "LTI URL"
msgstr "LTI URL"

msgid ""
"Enter the URL of the external tool that this component launches. This "
"setting is only used when Hide External Tool is set to False.{break_tag}See "
"{docs_anchor_open}the edX LTI documentation{anchor_close} for more details "
"on this setting."
msgstr ""
"Enter the URL of the external tool that this component launches. This "
"setting is only used when Hide External Tool is set to False.{break_tag}See "
"{docs_anchor_open}the edX LTI documentation{anchor_close} for more details "
"on this setting."

msgid "Custom Parameters"
msgstr "རྨང་གཞིའི་འཇལ་ཆས་ཁག"

msgid ""
"Add the key/value pair for any custom parameters, such as the page your "
"e-book should open to or the background color for this "
"component.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Add the key/value pair for any custom parameters, such as the page your "
"e-book should open to or the background color for this "
"component.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."

msgid "Open in New Page"
msgstr "ཤོག་ངོས་གསར་པའི་ནང་སྒོ་ཕྱེ།"

msgid ""
"Select True if you want students to click a link that opens the LTI tool in "
"a new window. Select False if you want the LTI content to open in an IFrame "
"in the current page. This setting is only used when Hide External Tool is "
"set to False.  "
msgstr ""
"Select True if you want students to click a link that opens the LTI tool in "
"a new window. Select False if you want the LTI content to open in an IFrame "
"in the current page. This setting is only used when Hide External Tool is "
"set to False.  "

msgid "Scored"
msgstr "ཐོབ་སྐར་བསྡོམས་ཟིན།"

msgid ""
"Select True if this component will receive a numerical score from the "
"external LTI system."
msgstr ""
"གལ་ཏེ་གྲུབ་ཆ་འདི་ལ་ཨང་གྲངས་ཅན་གྱི་ཐོབ་སྐར་ཕྱི་ལོགས་ཀྱི་LTI "
"མ་ལག་ནས་འབྱོར་དགོས་ན། བདེན་པ་ཟེར་བ་འདེམ།"

msgid "Weight"
msgstr "ལྗིད་ཚད།"

msgid ""
"Enter the number of points possible for this component.  The default value "
"is 1.0.  This setting is only used when Scored is set to True."
msgstr ""
"གྲུབ་ཆ་འདི་ལ་ཡོང་སྲིད་པའི་གྲངས་ཀ་དེ་ཞོག དེའི་རྨང་གཞིའི་ཨང་ནི་1.0 ཡིན། "
"སྒྲིག་འགོད་འདི་ནི་ཐོབ་སྐར་ལ་བདེན་པ་ཟེར་བ་བསྒྲིགས་སྐབས་ཁོ་ནར་བཀོལ་སྤྱོད་བྱེད།"

msgid ""
"The score kept in the xblock KVS -- duplicate of the published score in "
"django DB"
msgstr ""
"The score kept in the xblock KVS -- duplicate of the published score in "
"django DB"

msgid "Comment as returned from grader, LTI2.0 spec"
msgstr "རིམ་པ་བྱེད་ཆས་LTI2.0 spec ནས་ཕྱིར་ཡོང་བ་ལྟ་བུའི་མཆན།"

msgid "Hide External Tool"
msgstr "ཕྱིའི་ལག་ཆ་སྦེད།"

msgid ""
"Select True if you want to use this component as a placeholder for syncing "
"with an external grading  system rather than launch an external tool.  This "
"setting hides the Launch button and any IFrames for this component."
msgstr ""
"Select True if you want to use this component as a placeholder for syncing "
"with an external grading  system rather than launch an external tool.  This "
"setting hides the Launch button and any IFrames for this component."

msgid "Request user's username"
msgstr "སྤྱོད་མཁན་གྱི་སྤྱོད་མིང་རེ་ཞུ།"

msgid "Select True to request the user's username."
msgstr "སྤྱོད་མཁན་གྱི་སྤྱོད་མིང་རེ་ཞུ་བྱེད་པར་བདེན་པ་ཟེར་བ་འདེམ།"

msgid "Request user's email"
msgstr "སྤྱོད་མཁན་གྱི་གློག་འཕྲིན་རེ་ཞུ།"

msgid "Select True to request the user's email address."
msgstr "སྤྱོད་མཁན་གྱི་གློག་འཕྲིན་རེ་ཞུ་བྱེད་པར་བདེན་པ་ཟེར་བ་འདེམ།"

msgid "LTI Application Information"
msgstr "LTI སྙན་ཞིའི་གནས་ཚུལ།"

msgid ""
"Enter a description of the third party application. If requesting username "
"and/or email, use this text box to inform users why their username and/or "
"email will be forwarded to a third party application."
msgstr ""
"Enter a description of the third party application. If requesting username "
"and/or email, use this text box to inform users why their username and/or "
"email will be forwarded to a third party application."

msgid "Button Text"
msgstr "གནོན་ཐེབས་ཡི་གེ།"

msgid ""
"Enter the text on the button used to launch the third party application."
msgstr "མཉེན་ཆས་གཞན་པ་འཇོག་བྱེད་ཀྱི་གནོན་ཐེབས་ཐོག་ཡི་གེ་ཕྲིས།"

msgid "Accept grades past deadline"
msgstr "སྔ་མོའི་དུས་བཅད་ཀྱི་གནས་རིམ་ངོས་ལེན།"

msgid ""
"Select True to allow third party systems to post grades past the deadline."
msgstr ""
"གཞན་གྱི་མཉེན་ཆས་རིགས་དུས་བཀག་ལས་བརྒལ་ཏེ་རིམ་པ་འཕར་དུ་འཇུག་ཕྱིར་བདེན་པ་ཟེར་བ་འདེམ།"

msgid ""
"Could not parse custom parameter: {custom_parameter}. Should be \"x=y\" "
"string."
msgstr ""
"རྨང་གཞིའི་རྐྱེན་གྱི་ཡི་གེར་ཚིག་གཤིས་འཇོག་ཐུབ་མ་སོང་།: {custom_parameter} "
"ཕྲེང་བསྟར་ \"x=y\" འདི་འདྲ་ཡིན་སྲིད།"

msgid ""
"Could not parse LTI passport: {lti_passport}. Should be \"id:key:secret\" "
"string."
msgstr ""
"LTI ཡི་ལག་དེབ་རིགས་དབྱེ་བྱེད་ཐུབ་ས་མ་རེད།: {lti_passport}. ངེས་པར་དུ་ "
"\"id:key:secret\" ཕྲེང་བསྟར་ཡིན་དགོས།"

msgid "Due Date"
msgstr "དུས་བཅད་རྫོགས་དུས།"

msgid "Enter the default date by which problems are due."
msgstr "དུས་བཅད་རྫོགས་པའི་དྲི་བ་ཚོར་གཞུག་པའི་རྨང་གཞིའི་ཟླ་ཚེས་ཕྲིས།"

msgid "Number of Relative Weeks Due By"
msgstr "གཞུག་པའི་གཟའ་འཁོར་རྫོགས་དུས་དང་འབྲེལ་བའི་ཨང་གྲངས།"

msgid ""
"Enter the number of weeks the problems are due by relative to the learner's "
"enrollment date"
msgstr ""
"སློབ་གཉེར་བའི་ཞུགས་ཐོའི་དུས་ཚོད་ལ་གཞུག་སྟེ་དྲི་བའི་དུས་བཅད་རྫོགས་པའི་གཟའ་འཁོར་གྱི་གྲངས་ཀ་ཕྲིས།"

msgid "GIT URL"
msgstr "GIT URL"

msgid "Enter the URL for the course data GIT repository."
msgstr " སློབ་ཚན་གྱི་གཞི་གྲངས་ GIT ཉར་མཛོད་ཀྱི་ URL ཞོག"

msgid "XQA Key"
msgstr "XQA Key"

msgid "This setting is not currently supported."
msgstr "མིག་སྔར་སྒྲིག་འགོད་འདི་སྒྲིག་མི་ཐུབ།"

msgid "Enter the ids for the content groups this problem belongs to."
msgstr "དྲི་བ་འདི་གཏོགས་སའི་ནང་དོན་གྱི་སྡེ་ཚན་དེའི་ID རྣམས་ཞོག"

msgid ""
"Specify when the Show Answer button appears for each problem. Valid values "
"are \"always\", \"answered\", \"attempted\", \"closed\", \"finished\", "
"\"past_due\", \"correct_or_past_due\", \"after_all_attempts\", "
"\"after_all_attempts_or_correct\", \"attempted_no_past_due\", and \"never\"."
msgstr ""
"Specify when the Show Answer button appears for each problem. Valid values "
"are \"always\", \"answered\", \"attempted\", \"closed\", \"finished\", "
"\"past_due\", \"correct_or_past_due\", \"after_all_attempts\", "
"\"after_all_attempts_or_correct\", \"attempted_no_past_due\", and \"never\"."

msgid ""
"Specify when to show answer correctness and score to learners. Valid values "
"are \"always\", \"never\", and \"past_due\"."
msgstr ""
"སློབ་གཉེར་བ་རང་ལ་སྟོན་རྒྱུའི་ལན་འགྲིག་པ་དང་ཐོབ་སྐར་གཏན་འཁེལ་བྱོས། "
"ཚད་ལྡན་གྱི་རིན་ཐང་དག་ནི་ \"རྟག་ཏུ་\", \"རྦད་དེ་མེད།\", དང་ "
"\"དུས་ཡུན་རྫོགས།\""

msgid ""
"Specify the default for how often variable values in a problem are "
"randomized. This setting should be set to \"never\" unless you plan to "
"provide a Python script to identify and randomize values in most of the "
"problems in your course. Valid values are \"always\", \"onreset\", "
"\"never\", and \"per_student\"."
msgstr ""
"Specify the default for how often variable values in a problem are "
"randomized. This setting should be set to \"never\" unless you plan to "
"provide a Python script to identify and randomize values in most of the "
"problems in your course. Valid values are \"always\", \"onreset\", "
"\"never\", and \"per_student\"."

msgid "Days Early for Beta Users"
msgstr "Beta བཀོལ་མཁན་གྱི་ཐོག་མའི་ཉིན་གྲངས།"

msgid ""
"Enter the number of days before the start date that beta users can access "
"the course."
msgstr ""
"beta "
"བཀོལ་མཁན་གྱིས་སློབ་ཚན་བལྟ་ཀློག་འགོ་རྩོམ་པའི་ཟླ་ཚེས་མ་སླེབ་གོང་གི་ཉིན་གྲངས་ཕྲིས།"

msgid "Static Asset Path"
msgstr "མ་ཕྱིའི་དངོས་པོའི་ཁུངས་ལམ།"

msgid ""
"Enter the path to use for files on the Files & Uploads page. This value "
"overrides the Studio default, c4x://."
msgstr ""
"ཡིག་ཆ་ཟེར་བ་དེའི་སྒང་གི་ཡིག་ཆ་བཀོལ་སྤྱོད་བྱ་ཆེད་ལམ་ཁ་ཞོག & "
"ཤོག་ངོས་ཡར་སྤྲོད་བྱོས། རིན་ཐང་དེས་ལས་གནས་ཨ་མ་c4x://. ལ་དབང་འཛིན་བྱེད།"

msgid "Enable LaTeX Compiler"
msgstr "LaTeX Compiler ནུས་ལྡན་བྱེད།"

msgid ""
"Enter true or false. If true, you can use the LaTeX templates for HTML "
"components and advanced Problem components."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག བདེན་པ་བཞག་ན།  HTML "
"ཡི་གྲུབ་ཆ་དང་ཚད་མཐོའི་དྲི་བའི་གྲུབ་ཆ་རྣམས་ལ་ཁྱེད་ཀྱིས་LaTeX "
"མ་དཔེ་ཁག་བཀོལ་སྤྱོད་བྱ་ཆོག"

msgid ""
"Enter the maximum number of times a student can try to answer problems. By "
"default, Maximum Attempts is set to null, meaning that students have an "
"unlimited number of attempts for problems. You can override this course-wide"
" setting for individual problems. However, if the course-wide setting is a "
"specific number, you cannot set the Maximum Attempts for individual problems"
" to unlimited."
msgstr ""
"Enter the maximum number of times a student can try to answer problems. By "
"default, Maximum Attempts is set to null, meaning that students have an "
"unlimited number of attempts for problems. You can override this course-wide"
" setting for individual problems. However, if the course-wide setting is a "
"specific number, you cannot set the Maximum Attempts for individual problems"
" to unlimited."

msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use in this course for the "
"specified duration. Do not share the API key with other courses. Notify "
"MathWorks immediately if you believe the key is exposed or compromised. To "
"obtain a key for your course, or to report an issue, please contact "
"moocsupport@mathworks.com"
msgstr ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use in this course for the "
"specified duration. Do not share the API key with other courses. Notify "
"MathWorks immediately if you believe the key is exposed or compromised. To "
"obtain a key for your course, or to report an issue, please contact "
"moocsupport@mathworks.com"

msgid "Group Configurations"
msgstr "ཚོགས་ཆུང་གི་གྲུབ་ཆ་གོ་སྒྲིག"

msgid ""
"Enter the configurations that govern how students are grouped together."
msgstr ""
"སློབ་ཕྲུག་རྣམས་ཚོགས་པ་བཟོ་སྟངས་དབང་བསྒྱུར་བྱེད་ཀྱི་གྲུབ་ཆའི་གོ་སྒྲིག་ཞོག"

msgid "Enable video caching system"
msgstr "བརྙན་གྱི་ཁུངས་ཉར་མ་ལག་ནུས་ལྡན་བྱེད་པ།"

msgid ""
"Enter true or false. If true, video caching will be used for HTML5 videos."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག བདེན་པ་བཞག་ན་ བརྙན་གྱི་ཁུངས་ཉར་HTML5 "
"ཡི་བརྙན་ཆེད་དུ་བཀོལ་སྤྱོད་བྱེད།"

msgid "Enable video auto-advance"
msgstr "བརྙན་རང་འགུལ་གཏོང་ཆས་ནུས་ལྡན་བྱེད་པ།"

msgid ""
"Specify whether to show an auto-advance button in videos. If the student "
"clicks it, when the last video in a unit finishes it will automatically move"
" to the next unit and autoplay the first video."
msgstr ""
"བརྙན་གྱི་སྡེ་ཚན་ནང་ཚད་མཐོའི་རང་འགུལ་གནོན་ཐེབས་ཞིག་སྟོན་དགོས་མིན་གཏན་འཁེལ་བྱོས།"
" "
"སློབ་ཕྲུག་གིས་དེའི་སྒང་ལ་བསྣུན་ན་ཡང་གསེས་ཚན་པའི་སྔ་མའི་བརྙན་དེ་ཚར་མ་ཐག་རང་འགུལ་གྱིས་ཡང་གསེས་རྗེས་མའི་བརྙན་ལ་མཆོངས་ཏེ།"
" དེའི་ནང་གི་བརྙན་ཐོག་མ་དེ་སྟོན་ཡོང་བ་ཡིན།"

msgid "Video Pre-Roll"
msgstr "བརྙན་གྱི་འགོ་འདྲེན།"

msgid ""
"Identify a video, 5-10 seconds in length, to play before course videos. "
"Enter the video ID from the Video Uploads page and one or more transcript "
"files in the following format: {format}. For example, an entry for a video "
"with two transcripts looks like this: {example}"
msgstr ""
"སློབ་ཚན་གྱི་དངོས་གཞིའི་བརྙན་མ་སྟོན་སྔོནརིང་ཚད་སྐར་ཆ་ 5-10 "
"བར་གྱི་བརྙན་ཐུང་ཞིག་གཏན་འཁེལ་བྱོས། བརྙན་ནང་འཇུག་བྱ་ས་ནས་བརྙན་གྱི་ ID "
"དང་གཤམ་བཀོད་ཀྱི་རྣམ་སྒྲིག་ {format} "
"བཞག་ཡོད་པའི་བརྙན་ཡིག་གཅིག་དང་ཡང་ན་དེ་ལས་མང་ཞིག་ཞོག དཔེར་ན། "
"བརྙན་གཅིག་ལ་བརྙན་ཡིག་གཉིས་མཉམ་འཇོག་བྱས་པ་འདི་འདྲ་ཞིག {example}"

msgid "Show Reset Button for Problems"
msgstr "དྲི་བ་བསྐྱར་སྒྲིག་གི་གནོན་ཐེབས་སྟོན།"

msgid ""
"Enter true or false. If true, problems in the course default to always "
"displaying a 'Reset' button. You can override this in each problem's "
"settings. All existing problems are affected when this course-wide setting "
"is changed."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག བདེན་པ་བཞག་ན། "
"སློབ་ཚན་ནང་གི་དྲི་བ་འཆར་སྟོན་གྱི་རྨང་གཞིའི་གནོན་ཐེབས་ནི་རྒྱུན་དུ་ 'Reset' "
"སྟོན་ཡོང་། ཁྱེད་ཀྱིས་དྲི་བའི་སྒྲིག་འགོད་ཚང་མའི་ནང་འདི་ལྟར་ཉར་ཆོག་ཅིང་། "
"སློབ་ཚན་འདིའི་སྤྱིའི་སྒྲིག་འགོད་འགྱུར་བ་བཏང་ན་ད་སྔ་ཡོད་བསྡད་པའི་དྲི་བ་སྤྱི་ཡོངས་ལ་ཤུགས་རྐྱེན་གཏོང་འགྲོ་བ་ཡིན།"

msgid "Enable Student Notes"
msgstr "སློབ་ཕྲུག་གི་མཆན་དེབ་ནུས་ལྡན་བྱེད་པ།"

msgid ""
"Enter true or false. If true, students can use the Student Notes feature."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གང་རུང་ཞིག་ཞོག བདེན་པ་བཞག་ན། "
"སློབ་ཕྲུག་གིས་སློབ་ཕྲུག་མཆན་དེབ་ཀྱི་ཁྱད་ཆོས་བཀོལ་སྤྱོད་བྱ་ཐུབ།"

msgid ""
"Indicates whether Student Notes are visible in the course. Students can also"
" show or hide their notes in the courseware."
msgstr ""
"སློབ་ཚན་ནང་སློབ་ཕྲུག་གི་མཆན་དེབ་རྣམས་བསྟན་ཡོད་ན་དེ་སྟོན། "
"སློབ་ཕྲུག་གིས་ཀྱང་སློབ་ཚན་ནང་གི་མཆན་དེབ་དེ་སྦེད་པ་དང་ཡང་ན་སྟོན་པ་བྱེད་ཐུབ།"

msgid "Tag this block as part of an Entrance Exam section"
msgstr "ཚན་པ་འདི་ཚུད་རྒྱུགས་ཀྱི་སྡེ་ཚན་ཞིག་གི་ཆ་ཤས་ལྟར་བྱང་བུ་ཐོགས།"

msgid ""
"Enter true or false. If true, answer submissions for problem blocks will be "
"considered in the Entrance Exam scoring/gating algorithm."
msgstr ""
"བདེན་པ་དང་རྫུན་པ་གཉིས་ཀྱི་གང་རུང་ཞོག གལ་ཏེ་བདེན་པ་བཞག་ན།  answer submissions"
" for problem blocks will be considered in the Entrance Exam scoring/gating "
"algorithm."

msgid "Hide from Table of Contents"
msgstr "ནང་དོན་རེའུ་མིག་ལས་སྦས་པ།"

msgid ""
"Enter true or false. If true, this block will be hidden from the Table of "
"Contents."
msgstr ""
"བདེན་པའམ་རྫུན་མ་བླུགས། "
"གལ་ཏེ་བདེན་པ་ཡིན་ན་བཀག་སྡོམ་འདི་ནང་དོན་རེའུ་མིག་ནང་གསང་བ་བྱེད།"

msgid "Error while reading {}. Check file for XML errors."
msgstr ""
"ཀློག་བཞིན་པའི་སྐབས་གནད་དོན་{} བྱུང་། XML "
"ཡི་གནད་དོན་སེལ་ཕྱིར་ཡིག་ཆར་བརྟག་དཔྱད་བྱོས།"

msgid "Failed to import block: {} at location: {}"
msgstr "ཚན་པ་ནང་འདྲེན་བྱེད་ཐུབ་མ་སོང་ {} འདྲེན་གནས་ {}"

msgid "Enrollment Track Groups"
msgstr "ཞུགས་ཐོ་འགོད་ལམ་ཁག"

msgid "Partition for segmenting users by enrollment track"
msgstr "ཞུགས་ཐོ་འགོད་ཐབས་ལ་གཞུག་ཏེ་སྤྱོད་མཁན་རིགས་དབྱེ་བྱས་པའི་ཆ་ཤས།"

msgid "Whether this student has voted on the poll"
msgstr "སློབ་ཕྲུག་འདིས་བརྟག་དཔྱད་ལ་འོས་འཕངས་ཡོད་དམ་མེད།"

msgid "Student answer"
msgstr "སློབ་ཕྲུག་གི་ལན་འདེབས།"

msgid "Poll answers from all students"
msgstr "སློབ་ཕྲུག་ཡོངས་ཀྱིས་བཏབ་པའི་བརྟག་དཔྱད་བྱས་པའི་ལན།"

msgid "Poll answers from xml"
msgstr "xml ནང་ཡོང་བའི་བརྟག་དཔྱད་ཀྱི་ལན་འདེབས།"

msgid "Poll question"
msgstr "བརྟག་དཔྱད་དྲི་བ།"

msgid "Enter the date by which problems are due."
msgstr "དྲི་བ་གང་ཞིག་གི་དུས་བཅད་རྫོགས་པའི་ཟླ་ཚེས་ཞོག"

msgid "Hide sequence content After Due Date"
msgstr "དུས་བཀག་རྫོགས་རྗེས་ནང་དོན་བསྟར་སྒྲིག་དེ་སྐུང་།"

msgid ""
"If set, the sequence content is hidden for non-staff users after the due "
"date has passed."
msgstr ""
"གལ་སྲིད་དུས་བཀག་རྫོགས་རྗེས་ནང་དོན་བསྟར་སྒྲིག་དེ་ལས་བྱེད་མ་ཡིན་པའི་སྤྱོད་མཁན་རྣམས་ལ་བསྐུང་བ་བསྒྲིག་རྒྱུ་ཡིན་ན།"

msgid "Is Entrance Exam"
msgstr "ཚུད་རྒྱུགས་རེད་དམ།"

msgid ""
"Tag this course block as an Entrance Exam. Note, you must enable Entrance "
"Exams for this course setting to take effect."
msgstr ""
"སློབ་ཚན་འདི་ལ་འཛུལ་ཞུགས་ཡིག་རྒྱུགས་ཤིག་ཏུ་རྟགས་བཀོད། དྲན་ཐོ། "
"སློབ་ཚན་འདི་ལག་བསྟར་བྱེད་པར་ཁྱེད་ཀྱིས་འཛུལ་ཞུགས་ཡིག་རྒྱུགས་ལག་བསྟར་བྱེད་དགོས།"

msgid "Is Time Limited"
msgstr "དུས་ཚོད་ལ་བཅད་པ་ཡོད་དམ།"

msgid ""
"This setting indicates whether students have a limited time to view or "
"interact with this courseware component."
msgstr ""
"སྒྲིག་གཞི་འདིས་སློབ་མས་སློབ་ཚན་འདིའི་གྲུབ་ཆ་རྣམས་ལ་བལྟ་ཞིབ་བྱེད་པ་དང་ཡང་ན་རྒྱུས་ལོན་བྱེད་པར་དུས་ཚོད་ཀྱི་ཚད་ཡོད་པ་གསལ་བཤད་བྱས་ཡོད།"

msgid "Time Limit in Minutes"
msgstr "སྐར་མ་འགའི་ནང་ཚར་དགོས།"

msgid ""
"The number of minutes available to students for viewing or interacting with "
"this courseware component."
msgstr ""
"སློབ་མས་སློབ་ཚན་འདིའི་གྲུབ་ཆ་རྣམས་ལ་བལྟ་ཞིབ་བྱེད་པ་དང་ཡང་ན་རྒྱུས་ལོན་བྱེད་པར་སྐར་མ་འགའི་དུས་ཚོད་ཡོད།"

msgid "Is Proctoring Enabled"
msgstr "ལྟ་རྟོག་ཡོད་པའི་རྒྱུགས་ནུས་ལྡན་བྱས་ཡོད་དམ།"

msgid "This setting indicates whether this exam is a proctored exam."
msgstr ""
"སྒྲིག་གཞི་འདིས་རྒྱུགས་འདི་ནི་ལྟ་རྟོག་ཡོད་པའི་རྒྱུགས་ཡིན་མིན་གསལ་བཤད་བྱས་ཡོད།"

msgid "Software Secure Review Rules"
msgstr "མཉེན་ཆས་བདེ་འཇགས་ཀྱི་ཞིབ་བཤེར་གྱི་སྒྲིག་གཞི།"

msgid ""
"This setting indicates what rules the proctoring team should follow when "
"viewing the videos."
msgstr ""
"སྒྲིག་གཞི་འདིས་ཚོད་ལྟའི་ཚན་ཆུང་གིས་བརྙན་རིས་ལ་ལྟ་ཞིབ་བྱེད་སྐབས་སྒྲིག་སྲོལ་ཅི་ཞིག་བརྩི་སྲུང་བྱེད་དགོས་པ་གསལ་བཤད་བྱས་ཡོད།"

msgid "Is Practice Exam"
msgstr "དངོས་རྒྱུགས་རེད་དམ།"

msgid ""
"This setting indicates whether this exam is for testing purposes only. "
"Practice exams are not verified."
msgstr ""
"སྒྲིག་གཞི་འདིས་རྒྱུགས་སྤྲོད་འདི་ཚོད་ལྟ་ཁོ་ནའི་ཕྱིར་ཡིན་མིན་གསལ་བཤད་བྱས་ཡོད། "
"དངོས་རྒྱུགས་ཁག་གཏན་འཁེལ་བྱས་མེད།"

msgid "Is Onboarding Exam"
msgstr "རྒྱུགས་སྤྲོད་ཀྱི་མཐུན་རྐྱེན་གྲ་སྒྲིག་རེད་དམ།"

msgid "This setting indicates whether this exam is an onboarding exam."
msgstr ""
"སྒྲིག་གཞི་འདིས་རྒྱུགས་སྤྲོད་འདི་ནི་རྒྱུགས་སྤྲོད་ཀྱི་མཐུན་རྐྱེན་གྲ་སྒྲིག་ཡིན་མིན་གསལ་བཤད་བྱས་ཡོད།"

msgid ""
"This subsection is unlocked for learners when they meet the prerequisite "
"requirements."
msgstr ""
"སློབ་གཉེར་བས་སྔོན་འགྲོ་ཆ་རྐྱེན་ཁག་བསྒྲུབས་ཟིན་ན་ད་གཟོད་ནང་གསེས་འདིའི་ཟྭ་ཕྱེ་ཡོང་།"

msgid "This exam is hidden from the learner."
msgstr "རྒྱུགས་འདི་སློབ་གཉེར་བས་གསང་འདུག"

msgid ""
"Because the course has ended, this assignment is hidden from the learner."
msgstr ""
"རྒྱུ་མཚན་ནི་སློབ་ཚན་དེ་མཇུག་བསྒྲིལ་འདུག ལས་བྱ་འདི་སློབ་གཉེར་བས་གསང་འདུག"

msgid ""
"Because the due date has passed, this assignment is hidden from the learner."
msgstr "རྒྱུ་མཚན་ནི་དུས་བཀག་ཟིན་འདུག ལས་བྱ་འདི་སློབ་གཉེར་བས་གསང་འདུག"

msgid ""
"This section is a prerequisite. You must complete this section in order to "
"unlock additional content."
msgstr ""
"སྡེ་ཚན་འདི་སྔོན་འགྲོའི་ཆ་རྐྱེན་ཞིག་ཡིན། "
"སྡེ་ཚན་འདི་ཆ་ཚང་བསྒྲུབས་ན་ད་གཟོད་ནང་དོན་འཕར་མ་འདིའི་ཟྭ་ཕྱེ་ཡོང་།"

msgid ""
"A list summarizing what students should look forward to in this section."
msgstr ""
"སློབ་ཕྲུག་གིས་སྡེ་ཚན་འདིའི་ནང་ངེས་བར་བལྟ་དགོས་སའི་སྙིང་བསྡུས་ཀྱི་ཐོ་གཞུང་ཞིག"

msgid "Group ID {group_id}"
msgstr "ཚོགས་པའི་ ID {group_id}"

msgid "Not Selected"
msgstr "བདམས་མི་འདུག"

msgid "The display name for this component. (Not shown to learners)"
msgstr "གྲུབ་ཆ་འདིའི་ངོས་སུ་སྟོན་རྒྱུའི་མིང་། (སློབ་གཉེར་བར་མི་སྟོན།)"

msgid "Content Experiment"
msgstr "ཚོད་ལྟ་ཞིག་འཇུག་གི་ནང་དོན།"

msgid ""
"The configuration defines how users are grouped for this content experiment."
" Caution: Changing the group configuration of a student-visible experiment "
"will impact the experiment data."
msgstr ""
"བཀོད་སྒྲིག་འདིས་ནང་དོན་ཚོད་ལྟ་འདིའི་ཁྲོད་སྤྱོད་མཁན་རྣམས་ཁག་བགོས་ཇི་ལྟར་བྱས་པ་འགྲེལ་བརྗོད་བྱེད།"
" ཉེན་བརྡ། "
"སློབ་མས་མཐོང་ཐུབ་པའི་ནང་དོན་ཚོད་ལྟའི་བཀོད་སྒྲིག་ལ་འགྱུར་ལྡོག་བྱུང་ན་ནང་དོན་ཚོད་ལྟའི་གཞི་གྲངས་ལ་ཤུགས་རྐྱེན་ཐེབས་སྲིད།"

msgid "Group Configuration"
msgstr "ཚོགས་པ་བཀོད་སྒྲིག"

msgid "Which child block students in a particular group_id should see"
msgstr "དམིགས་བསལ་གྱི་སྡེ་ཚན་_id ཞིག་གི་སློབ་ཕྲུག་ཚན་པ་གང་ཞིག་གིས་མཐོང་ཐུབ་པ།"

msgid "{group_name} (inactive)"
msgstr "{group_name} (inactive)"

msgid "The experiment is not associated with a group configuration."
msgstr "ནང་དོན་ཚོད་ལྟ་དེ་ཚོགས་པ་ཞིག་གི་བཀོད་སྒྲིག་དང་མཉམ་སྦྲེལ་བྱས་མི་འདུག"

msgid "Select a Group Configuration"
msgstr "ཚོགས་པ་བཀོད་སྒྲིག་ཅིག་འདེམ།"

msgid ""
"The experiment uses a deleted group configuration. Select a valid group "
"configuration or delete this experiment."
msgstr ""
"ཚོད་ལྟ་དེས་བསུབ་ཟིན་པའི་ཚོགས་པའི་བཀོད་སྒྲིག་ཅིག་བཀོལ་བཞིན་འདུག "
"ཚུལ་མཐུན་གྱི་ཚོགས་པའི་བཀོད་སྒྲིག་ཅིག་འདེམ། ཡང་ན་ཚོད་ལྟ་འདི་སུབ།"

msgid ""
"The experiment uses a group configuration that is not supported for "
"experiments. Select a valid group configuration or delete this experiment."
msgstr ""
"ཚོད་ལྟ་དེས་ཚོད་ལྟ་ལ་རམ་འདེགས་བྱ་མི་ཐུབ་པའི་ཚོགས་པའི་བཀོད་སྒྲིག་ཅིག་བཀོལ་བཞིན་འདུག"
" ཚུལ་མཐུན་གྱི་ཚོགས་པའི་བཀོད་སྒྲིག་ཅིག་འདེམ། ཡང་ན་ཚོད་ལྟ་འདི་སུབ།"

msgid ""
"The experiment does not contain all of the groups in the configuration."
msgstr "བཀོད་སྒྲིག་དེའི་ནང་ཚོད་ལྟ་དེའི་ནང་ཚོགས་ཆུང་ཆ་ཚང་ཚུད་མི་འདུག"

msgid "Add Missing Groups"
msgstr "ཚུད་མེད་པའི་ཚོགས་ཆུང་རྣམས་སྣོན།"

msgid ""
"The experiment has an inactive group. Move content into active groups, then "
"delete the inactive group."
msgstr ""
"ཚོད་ལྟ་དེར་ནུས་ལྡན་མ་བྱས་པའི་ཚོགས་ཆུང་ཞིག་འདུག "
"ནང་དོན་དེ་ནུས་ལྡན་བྱས་པའི་ཚོགས་ཆུང་ཁག་གི་ནང་སྤོར། "
"དེའི་རྗེས་ནུས་ལྡན་མ་བྱས་པའི་ཚོགས་ཆུང་དེ་སུབ།"

msgid "This content experiment has issues that affect content visibility."
msgstr ""
"ནང་དོན་ཚོད་ལྟ་འདིར་ནང་དོན་འཆར་སྟོན་ལ་ཤུགས་རྐྱེན་གཏོང་བྱེད་ཀྱི་གནད་དོན་ཞིག་འདུག"

msgid "External Discussion"
msgstr "ཕྱི་ལོགས་ཀྱི་བགྲོ་གླེང་།"

msgid "Enable in-context discussions for the Unit"
msgstr "ཡང་གསེས་དེའི་སྐབས་བབ་ཀྱི་བགྲོ་གླེང་ནུས་ལྡན་བྱོས།"

msgid "Add discussion for the Unit."
msgstr "ཡང་གསེས་དེའི་ཆེད་བགྲོ་གླེང་ཞོག"

msgid ""
"Here's a fun clip from a class I'm taking on {social_account_handle} from {organization_name}.\n"
"\n"
msgstr ""
"འདི་ནི་འཛིན་གྲྭ་ནས་བླངས་པའི་བརྙན་ཐུང་ཞིག་སྟེ། {social_account_handle} བརྒྱུད་ནས་ངས་ལེན་བཞིན་པའི་ {organization_name} ཚོགས་པ་འདིའི་སློབ་ཚན།\n"
"\n"

msgid ""
"Here's a fun clip from a class I'm taking on {social_account_handle}.\n"
"\n"
msgstr ""
"འདི་ནི་འཛིན་གྲྭ་ནས་བླངས་པའི་བརྙན་ཐུང་ཞིག་སྟེ། {social_account_handle} བརྒྱུད་ནས་ངས་ལེན་བཞིན་པ་དེ་ཡིན།\n"
"\n"

msgid ""
"Here's a fun clip from a class I'm taking from {organization_name}.\n"
"\n"
msgstr ""
"ད་ལྟ་ངས་ {organization_name} ཚོགས་པ་འདིའི་འཛིན་གྲྭ་ནས་བླངས་པའི་བརྙན་ཐུང་ཞིག་ཡིན། \n"
"\n"

msgid ""
"Here's a fun clip from a class I'm taking on {platform_name}.\n"
"\n"
msgstr ""
"ད་ལྟ་ངས་ {platform_name} འདིའི་འཛིན་གྲྭ་ནས་བླངས་པའི་བརྙན་ཐུང་ཞིག་ཡིན།\n"
"\n"

msgid "Can't get transcript link from Youtube for {youtube_id}."
msgstr "བརྙན་མཛོད་ཀྱི་{youtube_id} འདིའི་བརྙན་ཡིག་གི་དྲ་ཐག་རེག་མ་སོང་།"

msgid ""
"Can't receive transcripts from Youtube for {youtube_id}. Status code: "
"{status_code}."
msgstr ""
"ང་ཚོས་ {youtube_id} ནང་བརྙན་ཡིག་རྙེད་མ་སོང་། གནས་བབ་ཨང་བརྡ།: {status_code}"

msgid "We support only SubRip (*.srt) transcripts format."
msgstr "བརྙན་ཡིག་གི་རྣམ་སྒྲིག་ནི་ (*.srt) ཁོ་ན་མ་གཏོགས་ངོས་ལེན་མི་བྱེད།"

msgid ""
"Something wrong with SubRip transcripts file during parsing. Inner message "
"is {error_message}"
msgstr ""
"SubRip བརྙན་ཡིག་ངོས་འཛིན་བྱེད་སྐབས་ནོར་འཁྲུལ་ཞིག་འདུག "
"ནང་གི་འཕྲིན་ནི་འདི་ལྟར་ {error_message}"

msgid "Something wrong with SubRip transcripts file during parsing."
msgstr "SubRip བརྙན་ཡིག་ངོས་འཛིན་བྱེད་སྐབས་ནོར་འཁྲུལ་ཞིག་འདུག"

msgid "{exception_message}: Can't find uploaded transcripts: {user_filename}"
msgstr ""
"{exception_message}: ནང་འཇུག་བྱས་པའི་བརྙན་ཡིག་རྙེད་མ་སོང་། ཡིག་ཆའི་མིང་།: "
"{user_filename}"

msgid "Basic"
msgstr "རྨང་གཞི།"

msgid ""
"The URL for your video. This can be a YouTube URL or a link to an .mp4, "
".ogg, or .webm video file hosted elsewhere on the Internet."
msgstr ""
"ཁྱེད་ཀྱི་བརྙན་གྱི་དྲ་ཐག  འདི་ནི་བརྙན་མཛོད་དམ་youtube "
"ཀྱི་དྲ་ཐག་ཡིན་པ་དང་ཡང་ན། བརྙན་གྱི་རྣམ་སྒྲིག་ .mp4, .ogg, or .webm "
"ཡི་བརྙན་དང་འབྲེལ་བ་ཡོད་པ་གང་ཞིག དྲ་ལམ་གཞན་ནས་བླངས་པ་ཡང་ཡིན་ཆོག"

msgid "Default Video URL"
msgstr "བརྙན་གྱི་རྩ་བའི་དྲ་ཐག"

msgid "Language is required."
msgstr "སྐད་ཡིག་ངེས་པར་དགོས།"

msgid "Component Display Name"
msgstr "གྲུབ་ཆ་དེའི་བསྟན་བྱའི་མིང་།"

msgid "Current position in the video."
msgstr "བརྙན་ནང་གི་ད་ལྟའི་ས་མཚམས།"

msgid ""
"Optional, for older browsers: the YouTube ID for the normal speed video."
msgstr ""
"གདམ་ང་ཅན། བཤེར་ཆས་རྙིང་བ་ཚོའི་ཆེད་དུ།: "
"བརྙན་གྱི་མགྱོགས་ཚད་རྒྱུན་ལྡན་ཡིན་པའི་བརྙན་མཛོད་ཀྱི་ID "

msgid "YouTube ID"
msgstr "བརྙན་མཛོད་ཀྱི་ID"

msgid "Optional, for older browsers: the YouTube ID for the .75x speed video."
msgstr ""
"གདམ་ང་ཅན། བཤེར་ཆས་རྙིང་བ་ཚོའི་ཆེད་དུ།: བརྙན་གྱི་མགྱོགས་ཚད་ .75x "
"ཡི་བརྙན་མཛོད་ཀྱི་ID"

msgid "YouTube ID for .75x speed"
msgstr "བརྙན་གྱི་མགྱོགས་ཚད་ .75x ཡི་བརྙན་མཛོད་ཀྱི་ID "

msgid ""
"Optional, for older browsers: the YouTube ID for the 1.25x speed video."
msgstr ""
"གདམ་ང་ཅན། བཤེར་ཆས་རྙིང་བ་ཚོའི་ཆེད་དུ།: བརྙན་གྱི་མགྱོགས་ཚད་ 1.25x "
"ཡི་བརྙན་མཛོད་ཀྱི་ID"

msgid "YouTube ID for 1.25x speed"
msgstr "བརྙན་གྱི་མགྱོགས་ཚད་ 1.25x ཡི་བརྙན་མཛོད་ཀྱི་ID"

msgid "Optional, for older browsers: the YouTube ID for the 1.5x speed video."
msgstr ""
"གདམ་ང་ཅན། བཤེར་ཆས་རྙིང་བ་ཚོའི་ཆེད་དུ།: བརྙན་གྱི་མགྱོགས་ཚད་ 1.5x "
"ཡི་བརྙན་མཛོད་ཀྱི་ID"

msgid "YouTube ID for 1.5x speed"
msgstr "བརྙན་གྱི་མགྱོགས་ཚད་ 1.5x ཡི་བརྙན་མཛོད་ཀྱི་ID"

msgid ""
"Time you want the video to start if you don't want the entire video to play."
" Not supported in the native mobile app: the full video file will play. "
"Formatted as HH:MM:SS. The maximum value is 23:59:59."
msgstr ""
"གལ་ཏེ་བརྙན་ཆ་ཚང་གཏོང་མི་དགོས་པ་ན་བརྙན་འགོ་རྩོམ་སའི་དུས་ཚོད། "
"ཁ་པར་ནང་འདིའི་ཁྱད་ཆོས་སྟོན་མི་ཐུབ་པས། བརྙན་ཆ་ཚང་གཏོང་ཡོང་། "
"རྣམ་སྒྲིག་ནི་འདི་ལྟར་ HH:MM:SS. ཆེས་རིང་བའི་ཚད་ནི་ 23:59:59 ཡིན།"

msgid "Video Start Time"
msgstr "བརྙན་འགོ་རྩོམ་པའི་དུས་ཚོད།"

msgid ""
"Time you want the video to stop if you don't want the entire video to play. "
"Not supported in the native mobile app: the full video file will play. "
"Formatted as HH:MM:SS. The maximum value is 23:59:59."
msgstr ""
"གལ་ཏེ་བརྙན་ཆ་ཚང་གཏོང་མི་དགོས་ན་བརྙན་མཚམས་བཀག་སའི་དུས་ཚོད། "
"ཁ་པར་ནང་བཀོལ་རྒྱུའི་མཉེན་ཆས་ནང་འདིའི་ཁྱད་ཆོས་མེད་པས། བརྙན་ཆ་ཚང་གཏོང་ཡོང་། "
"རྣམ་སྒྲིག་ནི་འདི་ལྟར་HH:MM:SS དང་། ཆེས་རིང་བའི་ཚད་ནི་23:59:59 ཡིན།"

msgid "Video Stop Time"
msgstr "བརྙན་མཚམས་བཀག་སའི་དུས་ཚོད།"

msgid ""
"Allow students to download versions of this video in different formats if "
"they cannot use the edX video player or do not have access to YouTube. You "
"must add at least one non-YouTube URL in the Video File URLs field."
msgstr ""
"གལ་སྲིད་སློབ་མས་edX "
"ཡི་བརྙན་གཏོང་ཆས་དང་བརྙན་མཛོད་གཉིས་ཀྱི་གང་ཡང་བཀོལ་མི་ཐུབ་ན་ཁོང་ཚོར་བརྙན་གྱི་རྣམ་སྒྲིག་འདྲ་མིན་ནང་བརྙན་དེ་ཕབ་ལེན་བྱེད་དུ་འཇུག།"
" "
"ཁྱེད་ཀྱིས་དྲ་ཐག་གི་སྡེ་ཚན་ནང་ཉུང་མཐར་བརྙན་མཛོད་ཀྱི་དྲ་ཐག་མ་ཡིན་པའི་བརྙན་གྱི་དྲ་ཐག་གཅིག་ངེས་པར་འཇོག་དགོས།"

msgid "Video Download Allowed"
msgstr "བརྙན་ཕབ་ལེན་བྱེད་བཅུགས་ཡོད།"

msgid ""
"The URL or URLs where you've posted non-YouTube versions of the video. Each "
"URL must end in .mpeg, .mp4, .ogg, or .webm and cannot be a YouTube URL. "
"(For browser compatibility, we strongly recommend .mp4 and .webm format.) "
"Students will be able to view the first listed video that's compatible with "
"the student's computer. To allow students to download these videos, set "
"Video Download Allowed to True."
msgstr ""
"The URL or URLs where you've posted non-YouTube versions of the video. Each "
"URL must end in .mpeg, .mp4, .ogg, or .webm and cannot be a YouTube URL. "
"(For browser compatibility, we strongly recommend .mp4 and .webm format.) "
"Students will be able to view the first listed video that's compatible with "
"the student's computer. To allow students to download these videos, set "
"Video Download Allowed to True."

msgid "Video File URLs"
msgstr "བརྙན་གྱི་དྲ་ཐག"

msgid ""
"By default, students can download an .srt or .txt transcript when you set "
"Download Transcript Allowed to True. If you want to provide a downloadable "
"transcript in a different format, we recommend that you upload a handout by "
"using the Upload a Handout field. If this isn't possible, you can post a "
"transcript file on the Files & Uploads page or on the Internet, and then add"
" the URL for the transcript here. Students see a link to download that "
"transcript below the video."
msgstr ""
"By default, students can download an .srt or .txt transcript when you set "
"Download Transcript Allowed to True. If you want to provide a downloadable "
"transcript in a different format, we recommend that you upload a handout by "
"using the Upload a Handout field. If this isn't possible, you can post a "
"transcript file on the Files & Uploads page or on the Internet, and then add"
" the URL for the transcript here. Students see a link to download that "
"transcript below the video."

msgid "Downloadable Transcript URL"
msgstr "ཕབ་ལེན་བྱ་ཆོག་པའི་བརྙན་ཡིག་གི་དྲ་ཐག"

msgid ""
"Allow students to download the timed transcript. A link to download the file"
" appears below the video. By default, the transcript is an .srt or .txt "
"file. If you want to provide the transcript for download in a different "
"format, upload a file by using the Upload Handout field."
msgstr ""
"སློབ་ཕྲུག་ལ་སྒྲ་མཚམས་ཕྱེས་ཟིན་པའི་བརྙན་ཡིག་ཕབ་ལེན་བྱ་ཆོག "
"བརྙན་ཡིག་ཕབ་ལེན་གྱི་དྲ་ཐག་ཅིག་བརྙན་འོག་རང་ལ་འཆར་ཡོང་། "
"བརྙན་ཡིག་གི་རྨང་གཞིའི་རྣམ་སྒྲིག་ནི་ srt དང་ཡང་ན་ .txt གང་རུང་ཡིན། "
"གལ་སྲིད་ཁྱེད་ཀྱིས་བརྙན་ཡིག་ཕབ་ལེན་དེ་རྣམ་སྒྲིག་འདྲ་མིན་ནང་ཕབ་ལེན་བྱེད་པའི་མཐུན་རྐྱེན་མཁོ་སྤྲོད་བྱ་འདོད་ཚེ།"
" ཁྲིད་ཆས་ནང་འཇུག་ཚན་པ་ Handout field བཀོལ་ནས་ཡིག་ཆ་ནང་འཇུག་བྱ་དགོས།"

msgid "Download Transcript Allowed"
msgstr "བརྙན་ཡིག་ཕབ་ལེན་བྱེད་བཅུགས་ཡོད།"

msgid ""
"The default transcript for the video, from the Default Timed Transcript "
"field on the Basic tab. This transcript should be in English. You don't have"
" to change this setting."
msgstr ""
"The default transcript for the video, from the Default Timed Transcript "
"field on the Basic tab. This transcript should be in English. You don't have"
" to change this setting."

msgid "Default Timed Transcript"
msgstr "རྨང་གཞིའི་བརྙན་ཡིག"

msgid "Specify whether the transcripts appear with the video by default."
msgstr "བརྙན་ཡིག་དེ་རྨང་གཞི་ནས་བརྙན་དང་ལྷན་དུ་འཆར་མིན་གསལ་བཤད་བྱོས།"

msgid "Show Transcript"
msgstr "བརྙན་ཡིག་སྟོན།"

msgid ""
"Add transcripts in different languages. Click below to specify a language "
"and upload an .srt transcript file for that language."
msgstr ""
"སྐད་ཡིག་འདྲ་མིན་ནང་ཡོད་པའི་བརྙན་ཡིག་རྣམས་སྣོན། "
"སྐད་ཡིག་གང་ཞིག་འདེམ་ཕྱིར་གཤམ་ལ་སྣུན། "
"བདམས་ཟིན་པའི་སྐད་ཡིག་དེའི་ཆེད་དུ་རྣམ་སྒྲིག་.srt "
"ཡིན་པའི་བརྙན་དེ་ནང་འཇུག་བྱོས།"

msgid "Transcript Languages"
msgstr "བརྙན་ཡིག་གི་སྐད་ཡིག"

msgid "Preferred language for transcript."
msgstr "བརྙན་ཡིག་གི་ཆེད་དུ་བདམས་པའི་སྐད་ཡིག"

msgid "Preferred language for transcript"
msgstr "བརྙན་ཡིག་གི་ཆེད་དུ་བདམས་པའི་སྐད་ཡིག"

msgid "Transcript file format to download by user."
msgstr "སྤྱོད་མཁན་གྱིས་ཕབ་ལེན་བྱ་རྒྱུའི་བརྙན་ཡིག་གི་རྣམ་སྒྲིག"

msgid "SubRip (.srt) file"
msgstr "བརྙན་ཡིག་ (.srt) ཡིག་ཆ།"

msgid "Text (.txt) file"
msgstr "ཡིག་རྐྱང་ (.txt) ཡིག་ཆ།"

msgid "The last speed that the user specified for the video."
msgstr "སྤྱོན་མཁན་གྱིས་མཐའ་དོན་གཏན་འཁེལ་བྱས་པའི་བརྙན་གྱི་མགྱོགས་ཚད།"

msgid "The default speed for the video."
msgstr "བརྙན་གྱི་རྨང་གཞིའི་མགྱོགས་ཚད།"

msgid ""
"Specify whether to advance automatically to the next unit when the video "
"ends."
msgstr ""
"བརྙན་དེ་མཇུག་རྫོགས་དུས་རང་འགུལ་གྱིས་རྗེས་མ་དེར་འགྲོ་དགོས་མིན་གཏན་འཁེལ་བྱོས།"

msgid "Specify whether YouTube is available for the user."
msgstr "སྤྱོད་མཁན་ལ་བརྙན་མཛོད་youtube ཡོད་མེད་གཏན་འཁེལ་བྱོས།"

msgid ""
"Upload a handout to accompany this video. Students can download the handout "
"by clicking Download Handout under the video."
msgstr ""
"བརྙན་དང་ལྷན་དུ་སློབ་ཁྲིད་རྒྱུ་ཆ་ཡར་འཇུག་བྱོས། "
"སློབ་ཕྲུག་གིས་བརྙན་གྱི་གཤམ་དེར་སློབ་ཁྲིད་རྒྱུ་ཆ་ཟེར་བར་བསྣུན་ཏེ་རྒྱུ་ཆ་དེ་ཕབ་ལེན་བྱ་ཆོག"

msgid "Upload Handout"
msgstr "སློབ་ཁྲིད་རྒྱུ་ཆ་ནང་འཇུག"

msgid ""
"Specify whether access to this video is limited to browsers only, or if it "
"can be accessed from other applications including mobile apps."
msgstr ""
"བརྙན་འདི་བཤེར་ཆས་ཁོ་ནའི་ནང་སྟོན་དགོས་པའི་ཚད་བཀད་དང་། "
"ཡང་ན་ཁ་པར་གྱི་མཉེན་ཆས་ཁག་འདུས་པའི་མཉེན་ཆས་གཞན་གྱི་ནང་ཡང་སྟོན་ཐུབ་མིན་གསལ་བཤད་བྱོས།"

msgid "Video Available on Web Only"
msgstr "བརྙན་དྲ་ཚིགས་ཁོ་ནའི་ནང་སྤྱོད།"

msgid ""
"If you were assigned a Video ID by edX for the video to play in this "
"component, enter the ID here. In this case, do not enter values in the "
"Default Video URL, the Video File URLs, and the YouTube ID fields. If you "
"were not assigned a Video ID, enter values in those other fields and ignore "
"this field."
msgstr ""
"If you were assigned a Video ID by edX for the video to play in this "
"component, enter the ID here. In this case, do not enter values in the "
"Default Video URL, the Video File URLs, and the YouTube ID fields. If you "
"were not assigned a Video ID, enter values in those other fields and ignore "
"this field."

msgid "Date of the last view of the bumper"
msgstr "བཤེར་རིས་ལ་ཆེས་མཐའ་མར་བལྟས་དུས་ཀྱི་ཟླ་ཚེས།"

msgid "Do not show bumper again"
msgstr "བཤེར་རིས་བསྐྱར་ཏུ་མ་སྟོན།"

msgid "Specify whether the video can be accessed publicly by learners."
msgstr ""
"བརྙན་དེ་སློབ་སྦྱོང་བྱེད་མཁན་གྱིས་ཡོངས་གྲགས་སུ་ལྟ་ཐུབ་མིན་གསལ་བཤད་བྱོས།"

msgid "Public Access"
msgstr "སྤྱི་སྤྱོད་ཀྱི་ཆོག་མཆན་ཡོད།"

msgid "Add a specific thumbnail for learners to see before playing the video."
msgstr ""
"བརྙན་དེ་མ་སྟོན་གོང་སློབ་གཉེར་བས་མཐོང་ཐུབ་པའི་དམིགས་བསལ་གྱི་Thumbnail ཞིག་ཞོག"

msgid "Thumbnail"
msgstr "Thumbnail"

msgid "Instructions"
msgstr "སློབ་སྟོན།"

msgid ""
"Add instructions to help learners understand how to use the word cloud. "
"Clear instructions are important, especially for learners who have "
"accessibility requirements."
msgstr ""
"སློབ་གཉེར་བ་རྣམས་ཀྱིས་སྤྲིན་སྟེགས་ཀྱི་ཐ་སྙད་བཀོལ་སྤྱོད་བྱེད་ཚུལ་ཤེས་ཕྱིར་མཛུབ་སྟོན་ཁ་སྣོན་བྱོས།"
" མཛུབ་སྟོན་གསལ་བོ་བྱེད་རྒྱུ་ནི་གལ་འགངས་ཤིན་ཏུ་ཆེ་ཞིང་། "
"ཁྱད་པར་དུ་སློབ་སྤྱོང་གི་མཁོ་ཆས་རིགས་བཀོལ་སྤྱོད་ཀྱི་ཆོག་མཆན་ཡོད་པའི་གཉེར་བའི་རིགས་ལ་ལྷག་པར་དུ་མཁོ།"

msgid "Inputs"
msgstr "ནང་འཇུག་ཁག"

msgid ""
"The number of text boxes available for learners to add words and sentences."
msgstr "སློབ་གཉེར་བས་ཚིག་དང་ཚིག་གྲུབ་རེ་ཟུང་འབྲི་སའི་འབྲི་སྒམ་འགའ་ཤས་བཞག་ཡོད།"

msgid "Maximum Words"
msgstr "ཡིག་འབྲུའི་མང་མཐའ།"

msgid "The maximum number of words displayed in the generated word cloud."
msgstr ""
"ད་ལྟ་བཟོས་པའི་ཡིག་འབྲུ་སྤྲིན་ཕུང་ནང་སྟོན་རྒྱུའི་ཆེས་མང་མཐའི་ཡིག་འབྲུའི་གྲངས།"

msgid "Show Percents"
msgstr "བརྒྱ་ཆ་སྟོན།"

msgid "Statistics are shown for entered words near that word."
msgstr "ནང་འཇུག་བྱས་པའི་ཡིག་འབྲུ་དེའི་འགྲམ་ལ་དེའི་བསྡོམས་རྩིས་ཀྱི་གྲངས་སྟོན།"

msgid "Whether this learner has posted words to the cloud."
msgstr "སློབ་གཉེར་བས་སྤྲིན་མཛོད་དེའི་ནང་མིག་སྔར་ཡིག་འབྲུ་ནང་འཇུག་བྱས་འདུག་གམ།"

msgid "Student answer."
msgstr "སློབ་མའི་དྲི་ལན།"

msgid "All possible words from all learners."
msgstr "སློབ་གཉེར་བ་ཡོངས་ཀྱིས་བཀོལ་སྲིད་པའི་ཡིག་འབྲུ་ཁག"

msgid "Top num_top_words words for word cloud."
msgstr "ཡིག་འབྲུ་སྤྲིན་མཛོད་ཀྱི་ཡིག་འབྲུ་རྣམས་ Top num_top_words"

msgid ""
"{display_name} is only accessible to enrolled learners. Sign in or register,"
" and enroll in this course to view it."
msgstr ""
"{display_name} ནི་ཞུགས་ཐོ་བཀོད་ཟིན་པའི་སློབ་གཉེར་བ་ཁོ་ནས་མཐོང་ཐུབ། "
"འདི་མཐོང་ཐུབ་པར་ནང་འཛུལ་དང་ཡང་ན་ཐོ་འགོད། "
"ཡང་ན་སློབ་ཚན་འདིར་ཞུགས་ཐོ་འགོད་དགོས།"

msgid "created"
msgstr "བཟོས་ཟིན།"

msgid "Wiki notifications"
msgstr "ཝེ་ཁེའི་གསར་བརྡ།"

msgid "Wiki images"
msgstr "ཝེ་ཁེའི་འདྲ་པར།"

msgid "Wiki attachments"
msgstr "ཝེ་ཁེའི་ཟུར་སྦྱར་ཡིག་ཆ།"

msgid "Only localhost... muahahaha"
msgstr "Only localhost... muahahaha"

msgid "Initial title of the article. May be overridden with revision titles."
msgstr ""
"རྩོམ་ཡིག་དེའི་ཐོག་མའི་མཚན་བྱང་དེ་བཟོ་བཅོས་པར་གཞིའི་མཚན་བྱང་གིས་བརྗེ་བསྒྱུར་བྱ་ཆོག"

msgid "Type in some contents"
msgstr "ནང་དོན་འགའ་ཤས་ཕྲིས།"

msgid ""
"This is just the initial contents of your article. After creating it, you "
"can use more complex features like adding plugins, meta data, related "
"articles etc..."
msgstr ""
"འདི་ནི་ཁྱེད་ཀྱི་རྩོམ་ཡིག་གི་ཐོག་མའི་མཚན་བྱང་དེ་རེད། "
"དེ་བཟོས་རྗེས་སུ་ཁྱེད་ཀྱིས་སྤྱོད་སྒོ་ཆེ་བའི་མཁོ་ཆས་མང་པོ་ཞིག་བཀོལ་ཆོག་སྟེ། "
"དཔེར་ན། plugins དང་གཞི་གྲངས་རྒྱས་པ། "
"འབྲེལ་ཡོད་ཀྱི་རྩོམ་ཡིག་སོགས་གསར་སྣོན་བྱེད་ཆོག་པ་ཡིན།"

msgid "Contents"
msgstr "ནང་དོན།"

msgid "Summary"
msgstr "སྙིང་བསྡུས།"

msgid ""
"Give a short reason for your edit, which will be stated in the revision log."
msgstr ""
"རྩོམ་སྒྲིག་བྱེད་དགོས་པའི་རྒྱུ་རྐྱེན་ཐུང་ངུ་ཞིག་འགོད་རོགས། "
"དེ་བཟོ་བཅོས་དྲ་ངོས་སུ་འཆར་ཡོང་།"

msgid ""
"While you were editing, someone else changed the revision. Your contents "
"have been automatically merged with the new contents. Please review the text"
" below."
msgstr ""
"ཁྱེད་ཀྱིས་རྩོམ་སྒྲིག་བྱེད་བཞིན་པའི་སྐབས་མི་གཞན་ཞིག་གིས་བཟོ་བཅོས་པར་གཞི་དེ་འགྱུར་བ་བཏང་བ་ཡིན་ན།"
" ཁྱེད་ཀྱི་ནང་དོན་དེ་རང་འགུལ་གྱིས་ནང་དོན་གསར་པ་དེ་དང་ཟླ་སྒྲིལ་བྱེད་འགྲོ། "
"གཤམ་གསལ་གྱི་ཡིག་ཆ་ལ་བསྐྱར་ཞིབ་ཅིག་བྱ་རོགས།"

msgid "No changes made. Nothing to save."
msgstr "བསྒྱུར་བཅོས་གང་ཡང་བྱས་མི་འདུག་པས་གསར་དུ་ཉར་རྒྱུ་མི་འདུག"

msgid "Slug"
msgstr "Slug"

msgid ""
"This will be the address where your article can be found. Use only "
"alphanumeric characters and - or _. Note that you cannot change the slug "
"after creating the article."
msgstr ""
"འདི་ནི་ཁྱེད་ཀྱི་རྩོམ་ཡིག་འཇོག་གནས་ཀྱི་ཁ་བྱང་ཡིན། "
"འཇོག་སྟངས་དེ་གསལ་བྱེད་དང་ཨང་གྲངས་གཉིས་ཀྱི་གོ་རིམ་A ནས་ Z དང་ཡང་ན་ 0 ནས་ 9 "
"བཞིན་འཇོག་དགོས། ངེས་དགོས་པ་ཞིག་ལ་ཁྱེད་ཀྱིས་རྩོམ་ཡིག་དེ་སྤེལ་ཟིན་རྗེས་slug "
"འགྱུར་བ་གཏོང་མི་ཐུབ།"

msgid "Write a brief message for the article's history log."
msgstr "རྩོམ་ཡིག་དེའི་ལོ་རྒྱུས་ཤོག་ངོས་སུ་འགོད་རྒྱུའི་འཕྲིན་ཐུང་ཞིག་ཕྲིས།"

msgid "A slug may not begin with an underscore."
msgstr "ཕལ་ཆེར་ slug ཞིག་གི་འགོ་རུ་underscore བཞག་མེད་པ་འདྲ།"

msgid "A deleted article with slug \"%s\" already exists."
msgstr "བསུབ་ཟིན་པའི་རྩོམ་ཡིག་ཅིག་གི་ slug \"%s\" ད་དུང་ལྷག་འདུག"

msgid "A slug named \"%s\" already exists."
msgstr "མིང་འདི་ཡོད་པའི་slug \"%s\" ད་དུང་ལྷག་འདུག"

msgid "Yes, I am sure"
msgstr "འགྲིག གཏན་འཁེལ་ཡིན།"

msgid "Purge"
msgstr "གཙང་བཤེར།"

msgid ""
"Purge the article: Completely remove it (and all its contents) with no undo."
" Purging is a good idea if you want to free the slug such that users can "
"create new articles in its place."
msgstr ""
"རྩོམ་ཡིག་གཙང་སེལ་ནི། ཕྱིར་འཐེན་མེད་པར་ཆ་ཚང་གཙང་སེལ་ (ནང་དོན་ཆ་ཚང་།) བྱེད་ན། "
"གཙང་སེལ་ནི་slug དང་བཅས་པ་གཙང་སེལ་བྱེད་པའི་ཐབས་ཤེས་ཡག་ཤོས་དེ་རེད། "
"དེ་ལྟར་བྱས་ན་ད་གཟོད་སྤྱོད་མཁན་རྣམས་ཀྱིས་ས་ཆ་དེར་རྩོམ་ཡིག་གསར་པ་སྤེལ་ཐུབ་པ་ཡིན།"

msgid "You are not sure enough!"
msgstr "ཁྱེད་ཀྱིས་གཏན་འཁེལ་བྱེད་ཐུབ་མི་འདུག"

msgid "While you tried to delete this article, it was modified. TAKE CARE!"
msgstr ""
"ཁྱེད་ཀྱིས་རྩོམ་ཡིག་འདི་བསུབ་རྩིས་བྱེད་སྐབས་བཟོ་བཅོས་བརྒྱབ་འདུག "
"ཐུགས་སྣང་གནང་རོགས།!"

msgid "Lock article"
msgstr "རྩོམ་ཡིག་ལ་ཟྭ་རྒྱོབས།"

msgid "Deny all users access to edit this article."
msgstr "སྤྱོད་མཁན་ཡོངས་ལ་རྩོམ་ཡིག་འདི་རྩོམ་སྒྲིག་བྱེད་པའི་ཆོག་མཆན་མེད།"

msgid "Permissions"
msgstr "ཆོག་མཆན།"

msgid "Owner"
msgstr "བདག་པོ།"

msgid "Enter the username of the owner."
msgstr "བདག་པའི་སྤྱོད་མིང་ནང་འཇུག་བྱོས།"

msgid "(none)"
msgstr "(none)"

msgid "Inherit permissions"
msgstr "ཆོག་མཆན་ཐོབ་པ།"

msgid ""
"Check here to apply the above permissions recursively to articles under this"
" one."
msgstr ""
"གཤམ་བཀོད་ཀྱི་རྩོམ་ཡིག་ལ་གོང་མཚུངས་ཀྱི་ཆོག་མཆན་ཞུ་ན་འདིར་འགྲིག་རྟགས་རྒྱོབས།"

msgid "Permission settings for the article were updated."
msgstr "སྤེལ་ཟིན་པའི་རྩོམ་ཡིག་རྣམས་ཀྱི་ཆོག་མཆན་སྒྲིག་འགོད།"

