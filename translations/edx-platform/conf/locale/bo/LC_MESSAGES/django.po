msgstr "ཡིག་ཆའི་མ་གཞིའི་མིང་།"

msgid "attachment"
msgstr "ཟུར་སྦྱར་མ།"

msgid "attachments"
msgstr "ཟུར་སྦྱར་མ།"

msgid "file"
msgstr "ཡིག་ཆ།"

