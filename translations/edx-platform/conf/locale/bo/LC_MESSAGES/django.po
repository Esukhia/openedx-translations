msgid "The article \"%s\" and its children are now restored."
msgstr "མ་རྩོམ་ \"%s\" དེ་དང་དེའི་བུ་རྩོམ་དང་བཅས་པ་སླར་གསོ་བྱས་ཡོད།"

msgid ""
"The article %(title)s is now set to display revision #%(revision_number)d"
msgstr ""
"ད་སྐབས་རྩོམ་ཡིག་དེ %(title)sའི་བཟོ་བཅོས་པར་གཞི་ #%(revision_number)d "
"སྟོན་རྒྱུར་བསྒྲིགས་ཡོད།"

msgid "New title"
msgstr "མཚན་བྱང་གསར་པ།"

msgid "Merge between Revision #%(r1)d and Revision #%(r2)d"
msgstr "བཟོ་བཅོས་པར་གཞི་ #%(r1)d འདི་དང་ #%(r2)d འདི་གཉིས་ཟླ་སྒྲིལ་བྱེད།"

msgid ""
"A new revision was created: Merge between Revision #%(r1)d and Revision "
"#%(r2)d"
msgstr ""
"བཟོ་བཅོས་པར་གཞི་གསར་པ་ཞིག་བཟོས་པའི་པར་གཞི་ #%(r1)d འདི་དང་ #%(r2)d "
"འདི་གཉིས་ཟླ་སྒྲིལ་བྱེད།"

msgid "Page Not Found"
msgstr "ཤོག་ངོས་རྙེད་མ་སོང་།"

msgid "Page not found"
msgstr "ཤོག་ངོས་རྙེད་མ་སོང་།"

msgid "The page that you were looking for was not found."
msgstr "ཁྱེད་ཀྱིས་འཚོལ་བཞིན་པའི་ཤོག་ངོས་དེ་རྙེད་མ་སོང་།"

msgid "Go back to the {homepage}."
msgstr "{homepage} ལ་ལོག་ཤོག"

msgid "{studio_name} Server Error"
msgstr "{studio_name} ཞབས་ཞུའི་ནོར་འཁྲུལ།"

msgid "The {em_start}{studio_name}{em_end} servers encountered an error"
msgstr "{em_start} {studio_name} {em_end} སར་བར་ལ་ནོར་འཁྲུལ་བྱུང་ཡོད།"

msgid ""
"An error occurred in {studio_name} and the page could not be loaded. Please "
"try again in a few moments."
msgstr ""
"{studio_name} ནང་དུ་ནོར་འཁྲུལ་བྱུང་བས་ཤོག་ངོས་དེ་མངོན་འགྱུར་བྱེད་མ་ཐུབ། "
"སྐར་མ་འགའི་རྗེས་སུ་ཡང་བསྐྱར་ཚོད་ལྟ་གནང་རོགས།"

msgid ""
"We've logged the error and our staff is currently working to resolve this "
"error as soon as possible."
msgstr ""
"ང་ཚོས་གནད་དོན་དེ་ཐོ་འགོད་བྱས་ཟིན་པ་དང་། "
"ང་ཚོའི་ལས་བྱེད་ཚོས་ད་ལྟ་གང་མགྱོགས་ཀྱིས་གནད་དོན་དེ་བསལ་ཐབས་ལ་འབད་བརྩོན་བྱེད་བཞིན་ཡོད།"

msgid "Studio Accessibility Policy"
msgstr "གློག་བརྙན་ཁང་དུ་འཛུལ་ཐུབ་པའི་སྲིད་ཇུས།"

msgid "Files"
msgstr "ཡིག་ཆ།"

msgid "Content"
msgstr "ནང་དོན།"

msgid "Course Certificates"
msgstr "སློབ་ཐོན་ལག་ཁྱེར་ཁག"

msgid "This module is not enabled."
msgstr "ཚད་གཞི་འདི་ལག་བསྟར་བྱས་མེད།"

msgid "This course does not use a mode that offers certificates."
msgstr "སློབ་ཚན་འདིས་ལག་འཁྱེར་སྤྲོད་པའི་ཐབས་ལམ་བཀོལ་སྤྱོད་བྱེད་ཀྱི་མེད།"

msgid "Working with Certificates"
msgstr "ལག་འཁྱེར་ཐོག་ལས་ཀ་བྱེད་པ།"

msgid ""
"Specify a course title to use on the certificate if the course's official "
"title is too long to be displayed well."
msgstr ""
"གལ་ཏེ་སློབ་ཚན་གྱི་གཞུང་འབྲེལ་ཁ་བྱང་རིང་དྲགས་པས་ལེགས་པར་སྟོན་མི་ཐུབ་ན་ལག་འཁྱེར་ཐོག་བེད་སྤྱོད་གཏོང་རྒྱུའི་སློབ་ཚན་གྱི་ཁ་བྱང་གཏན་འཁེལ་བྱེད།"

msgid ""
"For verified certificates, specify between one and four signatories and "
"upload the associated images."
msgstr ""
"བདེན་དཔང་བྱས་པའི་ལག་ཁྱེར་ཆེད་དུ་མིང་རྟགས་བཀོད་མཁན་གཅིག་ནས་བཞི་བར་གཏན་འཁེལ་བྱས་ནས་འབྲེལ་ཡོད་པར་རིས་ཡར་བསྐུར་དགོས།"

msgid ""
"To edit or delete a certificate before it is activated, hover over the top "
"right corner of the form and select {em_start}Edit{em_end} or the delete "
"icon."
msgstr ""
"ལག་ཁྱེར་དེ་ཤུགས་ལྡན་མ་བཟོས་སྔོན་ལ་རྩོམ་སྒྲིག་ཡང་ན་སུབ་པའི་ཆེད་དུ་འབྲི་ཤོག་གི་གཡས་ཕྱོགས་ཀྱི་སྟེང་དུ་མཛུབ་མོ་བཙུགས་ནས་"
" {em_start} རྩོམ་སྒྲིག་ {em_end} ཡང་ན་སུབ་པའི་མཚོན་རྟགས་འདེམས།"

msgid ""
"To view a sample certificate, choose a course mode and select "
"{em_start}Preview Certificate{em_end}."
msgstr ""
"དཔེ་ཚད་ཀྱི་ལག་ཁྱེར་ལྟ་བར་སློབ་ཚན་གྱི་ཐབས་ལམ་འདེམས་ནས་ {em_start} "
"སྔོན་ལྟའི་ལག་ཁྱེར་ {em_end} འདེམས།"

msgid "Issuing Certificates to Learners"
msgstr "སློབ་མར་ལག་འཁྱེར་སྤྲོད་པ།"

msgid ""
"To begin issuing course certificates, a course team member with either the "
"Staff or Admin role selects {em_start}Activate{em_end}. Only course team "
"members with these roles can edit or delete an activated certificate."
msgstr ""
"སློབ་ཚན་གྱི་ལག་ཁྱེར་སྤྲོད་འགོ་ཚུགས་པར་སློབ་ཚན་གྱི་རུ་ཁག་གི་ཚོགས་མི་ཞིག་གིས་ལས་བྱེད་པའམ་འཛིན་སྐྱོང་འགན་འཁུར་ཡོད་ན་"
" {em_start} འདེམས་སྒྲུག་བྱེད། {em_end} . "
"ལས་འགན་འདི་དག་ཡོད་པའི་སློབ་ཚན་གྱི་རུ་ཁག་གི་ཚོགས་མི་ཁོ་ནར་ཤུགས་སྣོན་བྱས་པའི་ལག་ཁྱེར་རྩོམ་སྒྲིག་ཡང་ན་སུབ་ཐུབ།"

msgid ""
"{em_start}Do not{em_end} delete certificates after a course has started; "
"learners who have already earned certificates will no longer be able to "
"access them."
msgstr ""
"{em_start} སློབ་ཚན་འགོ་འཛུགས་རྗེས་ {em_end} ལག་ཁྱེར་མེད་པར་མ་བཟོས། "
"ལག་འཁྱེར་ཐོབ་ཟིན་པའི་སློབ་མ ༢༤ ལ་ད་ནས་བཟུང་ལག་འཁྱེར་ཐོབ་མི་ཐུབ།"

msgid "Learn more about certificates"
msgstr "ལག་ཁྱེར་གྱི་སྐོར་ལ་རྒྱུས་ལོན་བྱེད་པ།"

msgid "Details & Schedule"
msgstr "ཞིབ་ཕྲ་དང་དུས་ཚོད།"

msgid "Grading"
msgstr "རིམ་པ་བཞིན།"

msgid "Course Team"
msgstr "སློབ་ཚན་དཔུང་སྡེ།"

msgid "Proctored Exam Settings"
msgstr "Proctored ཡིག་རྒྱུགས་སྒྲིག་སྟངས།"

msgid "Checklists"
msgstr "ཞིབ་བཤེར་ཐོ་གཞུང་།"

msgid "Tools"
msgstr "ལག་ཆ་ཁག"

msgid "Duplicate"
msgstr "འདྲ་བཤུས།"

msgid "Duplicate this component"
msgstr "ཆ་ཤས་འདི་འདྲ་བཤུས།"

msgid "Move"
msgstr "འགུལ"

msgid "Delete this component"
msgstr "ཆ་ཤས་འདི་སུབ་པ།"

msgid "Drag to reorder"
msgstr "གོ་རིམ་བསྐྱར་དུ་འདྲུད།"

msgid "Page Actions"
msgstr "ཤོག་ངོས་ཀྱི་ལས་ཀ་ཁག"

msgid "Open the courseware in the LMS"
msgstr "LMSནང་གི་སློབ་ཚན་མཉེན་ཆས་ཁ་ཕྱེ།"

msgid "View Live Version"
msgstr "ཐད་གཏོང་ལ་གཟིགས།"

msgid "Preview the courseware in the LMS"
msgstr "LMSནང་སློབ་ཚན་གྱི་མཉེན་ཆས་ལ་སྔོན་ལྟ།"

msgid "Collapse All"
msgstr "ཡོངས་རྫོགས་ལྟེབ།"

msgid "Adding components"
msgstr "ཆ་ཤས་ཁ་སྣོན་བྱེད་པ།"

msgid ""
"Select a component type under {strong_start}Add New Component{strong_end}. "
"Then select a template."
msgstr ""
"{strong_start} འོག་ཆ་ཤས་རིགས་འདེམས། ཆ་ཤས་གསར་པ་ཁ་སྣོན་ {strong_end} . "
"དེ་ནས་དཔེ་སྒྲོམ་འདེམས།"

msgid ""
"The new component is added at the bottom of the page or group. You can then "
"edit and move the component."
msgstr ""
"ཆ་ཤས་གསར་པ་དེ་ཤོག་ངོས་སམ་སྡེ་ཚན་གྱི་མཇུག་ཏུ་ཁ་སྣོན་བྱས་ཡོད། "
"དེ་ནས་ཁྱེད་ཀྱིས་ཆ་ཤས་དེ་རྩོམ་སྒྲིག་དང་སྤོ་བཤུད་བྱེད་ཐུབ།"

msgid "Editing components"
msgstr "རྩོམ་སྒྲིག་གི་གྲུབ་ཆ།"

msgid ""
"Click the {strong_start}Edit{strong_end} icon in a component to edit its "
"content."
msgstr ""
"དེའི་ནང་དོན་རྩོམ་སྒྲིག་བྱེད་པར་ཆ་ཤས་ཤིག་གི་ནང་ {strong_start} རྩོམ་སྒྲིག་ "
"{strong_end} འདྲ་པར་ལ་སྣུན་དགོས།"

msgid "Reorganizing components"
msgstr "གྲུབ་ཆ་བསྐྱར་སྒྲིག་བྱེད་པ།"

msgid "Drag components to new locations within this component."
msgstr "ཆ་ཤས་འདིའི་ནང་དུ་ཆ་ཤས་གནས་ཡུལ་གསར་པར་འདྲུད།"

msgid "For content experiments, you can drag components to other groups."
msgstr "ནང་དོན་ཚོད་ལྟའི་ཆེད་དུ་ཁྱེད་ཀྱིས་ཆ་ཤས་སྡེ་ཚན་གཞན་ལ་འདྲུད་ཐུབ།"

msgid "Working with content experiments"
msgstr "ནང་དོན་ཚོད་ལྟ་དང་ལས་ཀ་བྱེད་པ།"

msgid ""
"Confirm that you have properly configured content in each of your experiment"
" groups."
msgstr ""
"ཁྱེད་རང་གི་ཚོད་ལྟའི་སྡེ་ཚན་རེ་རེའི་ནང་དོན་སྒྲིག་བཀོད་ལེགས་པོ་བྱས་ཡོད་པར་གཏན་འཁེལ་བྱེད་དགོས།"

msgid "Learn more about component containers"
msgstr "ཆ་ཤས་སྣོད་ཆས་སྐོར་ལ་མང་ཙམ་ཤེས་དགོས།"

msgid "Unit Location"
msgstr "སྡེ་ཚན་གྱི་ས་གནས།"

msgid "Location ID"
msgstr "ས་གནས་ཨང་རྟགས།"

msgid ""
"To create a link to this unit from an HTML component in this course, enter "
"{unit_link} as the URL value."
msgstr ""
"སློབ་ཚན་འདིའི་ནང་HTMLཆ་ཤས་ནས་ཆ་ཤས་འདི་ལ་འབྲེལ་མཐུད་གསར་འཛུགས་བྱེད་པར་URLརིན་ཐང་ལྟར་"
" {unit_link} བླུགས།"

msgid "Create a Course Rerun of:"
msgstr "སློབ་ཚན་ཡང་བསྐྱར་སྤེལ་བ།"

msgid "Create a re-run of a course"
msgstr "སློབ་ཚན་ཞིག་བསྐྱར་དུ་སྤེལ་བ་གསར་སྐྲུན་བྱེད་པ།"

msgid "You are creating a re-run from:"
msgstr "ཁྱོད་ཀྱིས་འདི་ནས་བསྐྱར་དུ་རྒྱུག་བཞིན་ཡོད།"

msgid ""
"Provide identifying information for this re-run of the course. The original "
"course is not affected in any way by a re-run."
msgstr ""
"སློབ་ཚན་འདི་བསྐྱར་དུ་སྤེལ་བའི་ཆེད་དུ་ངོས་འཛིན་བྱེད་པའི་ཆ་འཕྲིན་སྤྲོད་དགོས། "
"སློབ་ཚན་ཐོག་མ་དེ་ལ་ཡང་བསྐྱར་རྒྱུག་པའི་ཤུགས་རྐྱེན་གང་ཡང་ཐེབས་མེད།"

msgid ""
"Note: Together, the organization, course number, and course run must "
"uniquely identify this new course instance."
msgstr ""
"མཆན: མཉམ་དུ་སྒྲིག་འཛུགས་དང་། སློབ་ཚན་གྱི་ཨང་གྲངས། "
"སློབ་ཚན་གྱི་འགྲོ་ལམ་བཅས་ཀྱིས་སློབ་ཚན་གསར་པ་འདི་ལ་ཁྱད་པར་ཅན་གྱི་ངོས་འཛིན་བྱེད་དགོས།"

msgid "Required Information to Create a re-run of a course"
msgstr "སློབ་ཚན་ཞིག་བསྐྱར་དུ་སྤེལ་བར་དགོས་མཁོའི་ཆ་འཕྲིན།"

msgid "Course Name"
msgstr "སློབ་ཚན་མིང་།"

msgid "e.g. Introduction to Computer Science"
msgstr "དཔེར་ན། གློག་ཀླད་རིག་པའི་ངོ་སྤྲོད།"

msgid ""
"The public display name for the new course. (This name is often the same as "
"the original course name.)"
msgstr ""
"སློབ་ཚན་གསར་པའི་སྤྱི་ཡོངས་འགྲེམས་སྟོན་མིང་། "
"༼མིང་འདི་ཕལ་ཆེར་ཐོག་མའི་སློབ་ཚན་གྱི་མིང་དང་གཅིག་པ་ཡིན།"

msgid "e.g. UniversityX or OrganizationX"
msgstr "དཔེར་ན། གཙུག་ལག་སློབ་གཉེར་ཁང་X ཡང་ན་ཚོགས་པ་X"

msgid ""
"The name of the organization sponsoring the new course. (This name is often "
"the same as the original organization name.)"
msgstr ""
"སློབ་ཚན་གསར་པར་སྦྱིན་བདག་བྱེད་མཁན་གྱི་ཚོགས་པའི་མིང་། "
"༼མིང་འདི་ཕལ་ཆེར་ཐོག་མའི་ཚོགས་པའི་མིང་དང་གཅིག་མཚུངས་ཡིན།"

msgid "Note: No spaces or special characters are allowed."
msgstr "མཆན: བར་སྟོང་དང་དམིགས་བསལ་གྱི་ཡིག་འབྲུ་གང་ཡང་བཀོད་མི་ཆོག"

msgid "Course Number"
msgstr "སློབ་ཚན་ཨང་།"

msgid "e.g. CS101"
msgstr "དཔེར་ན། CS101"

msgid ""
"The unique number that identifies the new course within the organization.  "
"(This number will be the same as the original course number and cannot be "
"changed.)"
msgstr ""
"སྒྲིག་འཛུགས་ནང་ཁུལ་གྱི་སློབ་ཚན་གསར་པ་ངོས་འཛིན་བྱེད་པའི་ཐུན་མོང་མ་ཡིན་པའི་ཨང་གྲངས་དེ།"
" ༼ཨང་གྲངས་འདི་ཐོག་མའི་སློབ་ཚན་གྱི་ཨང་གྲངས་དང་གཅིག་པ་ཡིན་པས་བསྒྱུར་མི་ཐུབ།༽"

msgid "e.g. 2014_T1"
msgstr "དཔེར་ན། 2014_T1"

msgid ""
"The term in which the new course will run. (This value is often different "
"than the original course run value.)"
msgstr ""
"སློབ་ཚན་གསར་པ་དེ་གང་དུ་སྤེལ་རྒྱུའི་དུས་ཡུན་དེ། "
"(རིན་ཐང་འདི་རྒྱུན་དུ་སློབ་ཚན་ཐོག་མའི་རྒྱུག་པའི་རིན་ཐང་ལས་མི་འདྲ་བ་རེད།)"

msgid "Create Re-run"
msgstr "གསར་སྐྲུན། ཡང་བསྐྱར་རྒྱུག་པ།"

msgid "When will my course re-run start?"
msgstr "ངའི་སློབ་ཚན་བསྐྱར་དུ་ག་དུས་འགོ་འཛུགས་རྒྱུ་ཡིན་ནམ།"

msgid "The new course is set to start on January 1, 2030 at midnight (UTC)."
msgstr ""
"སློབ་ཚན་གསར་པ་དེ་ཕྱི་ལོ་ ༢༠༣༠ ཟླ་ ༡ ཚེས་ ༡ ཉིན་མཚན་གུང་(UTC) "
"ཐོག་འགོ་འཛུགས་རྒྱུ་ཡིན་པ་རེད།"

msgid "What transfers from the original course?"
msgstr "ཐོག་མའི་སློབ་ཚན་ནས་སྤོ་བསྒྱུར་གང་ཡོད་དམ།"

msgid ""
"The new course has the same course outline and content as the original "
"course. All problems, videos, announcements, and other files are duplicated "
"to the new course."
msgstr ""
"སློབ་ཚན་གསར་པ་འདི་ལ་ཐོག་མའི་སློབ་ཚན་དང་འདྲ་བའི་སློབ་ཚན་གྱི་བཀོད་སྒྲིག་དང་ནང་དོན་གཅིག་མཚུངས་ཡིན།"
" དཀའ་ངལ་དང་བརྙན་འཕྲིན། "
"གསལ་བསྒྲགས་སོགས་ཡིག་ཆ་ཚང་མ་སློབ་ཚན་གསར་པར་འདྲ་བཤུས་བྱེད་ཀྱི་ཡོད།"

msgid "What does not transfer from the original course?"
msgstr "ཐོག་མའི་སློབ་ཚན་ནས་གང་ཞིག་སྤོ་མི་ཐུབ་བམ།"

msgid ""
"You are the only member of the new course's staff. No students are enrolled "
"in the course, and there is no student data. There is no content in the "
"discussion topics or wiki."
msgstr ""
"སློབ་ཚན་གསར་པའི་ལས་བྱེད་པའི་ཚོགས་མི་ཁྱོད་གཅིག་པུ་ཡིན། "
"སློབ་མ་གཅིག་ཀྱང་སློབ་ཚན་ནང་ཞུགས་མེད་པ་མ་ཟད་སློབ་མའི་གྲངས་ཐོ་ཡང་མེད། "
"བགྲོ་གླེང་གི་བརྗོད་གཞི་དང་ཝེ་ཀི་ནང་དོན་གང་ཡང་མེད།"

msgid "Learn more about Course Re-runs"
msgstr "སློབ་ཚན་བསྐྱར་དུ་སྤེལ་བའི་སྐོར་ལ་མང་ཙམ་ཤེས་དགོས།"

msgid "Course Updates"
msgstr "སློབ་ཚན་རིམ་སྤར།"

msgid "New Update"
msgstr "རིམ་སྤར་གསར་པ།"

msgid ""
"Use course updates to notify students of important dates or exams, highlight"
" particular discussions in the forums, announce schedule changes, and "
"respond to student questions. You add or edit updates in HTML."
msgstr ""
"སློབ་ཚན་གྱི་གསར་འགྱུར་བེད་སྤྱད་དེ་སློབ་ཕྲུག་ཚོར་ཚེས་གྲངས་གལ་ཆེན་དང་ཡིག་རྒྱུགས་བརྡ་ཐོ་གཏོང་བ་དང་།"
" གྲོས་ཚོགས་ནང་གྲོས་བསྡུར་དམིགས་བསལ་གསལ་སྟོན་བྱེད་པ། "
"དུས་ཚོད་བསྒྱུར་བཅོས་ཁྱབ་བསྒྲགས་བྱེད་པ། སློབ་ཕྲུག་གི་དྲི་བ་ལ་ལན་འདེབས་པ། "
"ཁྱེད་ཀྱིས་HTMLནང་གསར་བརྗེ་ཁ་སྣོན་ཡང་ན་རྩོམ་སྒྲིག་བྱེད།"

msgid "Course Outline"
msgstr "སློབ་ཚན་དཀར་ཆག"

msgid ""
"This course was created as a re-run. Some manual configuration is needed."
msgstr ""
"སློབ་ཚན་འདི་ཡང་བསྐྱར་སྤེལ་བའི་ཆེད་དུ་བཟོས་ཡོད། "
"ལག་ཐོག་སྒྲིག་བཀོད་འགའ་ཤས་དགོས།"

msgid ""
"No course content is currently visible, and no learners are enrolled. Be "
"sure to review and reset all dates, including the Course Start Date; set up "
"the course team; review course updates and other assets for dated material; "
"and seed the discussions and wiki."
msgstr ""
"ད་ལྟའི་ཆར་སློབ་ཚན་གྱི་ནང་དོན་གང་ཡང་མཐོང་མི་ཐུབ་པ་དང་སློབ་སྦྱོང་བྱེད་མཁན་གཅིག་ཀྱང་འཛུལ་ཞུགས་བྱས་མེད།"
" "
"སློབ་ཚན་འགོ་ཚུགས་པའི་ཚེས་གྲངས་ཚུད་པའི་ཚེས་གྲངས་ཚང་མ་བསྐྱར་ཞིབ་དང་བསྐྱར་སྒྲིག་བྱེད་དགོས།"
" སློབ་ཚན་གྱི་རུ་ཁག་བཙུགས་པ་དང་། "
"དུས་ཚོད་བཀོད་པའི་རྒྱུ་ཆའི་ཆེད་དུ་སློབ་ཚན་གྱི་གསར་འགྱུར་དང་རྒྱུ་ནོར་གཞན་དག་ལ་ཞིབ་བཤེར་བྱེད་པ།"
" གྲོས་བསྡུར་དང་ཝི་ཀི་ལ་སོན་བཏབ།"

msgid ""
"This course run is using an upgraded version of edx discussion forum. In "
"order to display the discussions sidebar, discussions xBlocks will no longer"
" be visible to learners."
msgstr ""
"སློབ་ཚན་འདིས་edxགྲོས་བསྡུར་ཚོགས་འདུའི་ཐོན་རིམ་ཡར་རྒྱས་བཏང་བ་བེད་སྤྱོད་བྱེད་ཀྱི་ཡོད།"
" གྲོས་བསྡུར་གྱི་ཟུར་ཕྲ་རིང་དེ་བསྟན་པའི་ཆེད་དུ་གྲོས་བསྡུར་xBlocks "
"དེ་སློབ་སྦྱོང་བྱེད་མཁན་ཚོར་མཐོང་མི་ཐུབ།"

msgid " Learn more"
msgstr " རྒྱས་པ་འདིར་གཟིགས་རོགས་གནང་།"

msgid "Share feedback"
msgstr "བསམ་འཆར་གནོངས་རོགས།"

msgid "This course uses features that are no longer supported."
msgstr ""
"སློབ་ཚན་འདིས་ད་ལྟ་རྒྱབ་སྐྱོར་བྱེད་མི་ཐུབ་པའི་ཁྱད་ཆོས་བེད་སྤྱོད་བྱེད་ཀྱི་ཡོད།"

msgid "You must delete or replace the following components."
msgstr "གཤམ་གསལ་ཆ་ཤས་རྣམས་བསུབས་པའམ་ཡང་ན་བརྗེ་དགོས།"

msgid "Unsupported Components"
msgstr "རྒྱབ་སྐྱོར་མེད་པའི་ཆ་ཤས།"

msgid "Deprecated Component"
msgstr "རྙེད་ཟིན་པའི་ཆ་ཤས།"

msgid ""
"To avoid errors, {platform_name} strongly recommends that you remove "
"unsupported features from the course advanced settings. To do this, go to "
"the {link_start}Advanced Settings page{link_end}, locate the \"Advanced "
"Module List\" setting, and then delete the following modules from the list."
msgstr ""
"ནོར་འཁྲུལ་མི་ཡོང་བའི་ཆེད་དུ་ {platform_name} "
"སློབ་ཚན་གྱི་ཡར་ཐོན་སྒྲིག་སྟངས་ནས་རྒྱབ་སྐྱོར་མེད་པའི་ཁྱད་ཆོས་མེད་པར་བཟོ་དགོས་པའི་བསམ་འཆར་ཤུགས་ཆེན་བྱེད་ཀྱི་ཡོད།"
" དེ་ལྟར་བྱེད་པར་ {link_start} ཡར་ཐོན་སྒྲིག་སྟངས་ཤོག་ངོས་ {link_end} "
"ལ་སོང་ནས་ &quot;ཡར་ཐོན་ཚད་གཞིའི་ཐོ་གཞུང་&quot; "
"སྒྲིག་སྟངས་འཚོལ་ཞིབ་བྱས་ནས་ཐོ་གཞུང་ནས་གཤམ་གྱི་ཚད་གཞི་དེ་དག་བསུབས་དགོས།"

msgid "Unsupported Advance Modules"
msgstr "རྒྱབ་སྐྱོར་མེད་པའི་སྔོན་ཐོན་ཚད་གཞི།"

msgid ""
"This course has proctored exam settings that are incomplete or invalid."
msgstr "སློབ་ཚན་འདི་ལ་ཡིག་རྒྱུགས་སྒྲིག་བཀོད་ཆ་ཚང་མེད་པའམ་ཡང་ན་ནུས་མེད་ཡིན།"

msgid ""
"To update these settings go to the {link_start}Proctored Exam Settings "
"page{link_end}."
msgstr ""
"སྒྲིག་སྟངས་འདི་དག་གསར་བརྗེ་བྱེད་པར་ {link_start} "
"ལྟ་རྟོག་ཡིག་རྒྱུགས་སྒྲིག་སྟངས་ཤོག་ངོས་ {link_end} ལ་འགྲོ།"

msgid ""
"To update these settings go to the {link_start}Advanced Settings "
"page{link_end}."
msgstr ""
"སྒྲིག་སྟངས་འདི་དག་གསར་བརྗེ་བྱེད་པར་ {link_start} ཡར་ཐོན་སྒྲིག་སྟངས་ཤོག་ངོས་ "
"{link_end} ལ་འགྲོ།"

msgid "Proctoring Settings Errors"
msgstr "ལྟ་རྟོག་སྒྲིག་སྟངས་ཀྱི་ནོར་འཁྲུལ།"

msgid "Click to add a new section"
msgstr "དུམ་བུ་གསར་པ་ཁ་སྣོན་བྱེད་པར་གནོན།"

msgid "New Section"
msgstr "ཚན་པ་གསར་པ།"

msgid "Reindex current course"
msgstr "མིག་སྔའི་སློབ་ཚན་ཡང་བསྐྱར་ཟུར་ཐོ།"

msgid "Reindex"
msgstr "ཡང་བསྐྱར་ཟུར་ཐོ།"

msgid "Collapse All Sections"
msgstr "དུམ་བུ་ཚང་མ་བརྡིབས་པ།"

msgid "Expand All Sections"
msgstr "ཚན་པ་ཚང་མ་རྒྱ་བསྐྱེད།"

msgid "Click to open the courseware in the LMS in a new tab"
msgstr "LMSནང་གི་སློབ་ཚན་མཉེན་ཆས་དེ་མཆོང་ལྡེ་གསར་པའི་ནང་ཁ་ཕྱེ་བར་མནན་དགོས།"

msgid "View Live"
msgstr "ཐད་གཏོང་སྟོན།"

msgid "Creating your course organization"
msgstr "རང་གི་སློབ་ཚན་སྒྲིག་འཛུགས་གསར་སྐྲུན་བྱེད་པ།"

msgid "You add sections, subsections, and units directly in the outline."
msgstr ""
"ཁྱོད་ཀྱིས་དུམ་བུ་དང་། དུམ་བུ། "
"དེ་བཞིན་དུམ་བུ་ཐད་ཀར་ཕྱི་ཐིག་ནང་དུ་ཁ་སྣོན་བྱེད།"

msgid ""
"Create a section, then add subsections and units. Open a unit to add course "
"components."
msgstr ""
"དུམ་བུ་ཞིག་གསར་འཛུགས་བྱས་ནས་དུམ་བུ་ཆུང་བ་དང་སྡེ་ཚན་ཁ་སྣོན་བྱེད། "
"སློབ་ཚན་གྱི་ཆ་ཤས་ཁ་སྣོན་བྱེད་པའི་སྡེ་ཚན་ཞིག་ཁ་ཕྱེ།"

msgid "Reorganizing your course"
msgstr "སློབ་ཚན་ཡང་བསྐྱར་སྒྲིག་འཛུགས་བྱེད་པ།"

msgid "Drag sections, subsections, and units to new locations in the outline."
msgstr "ཕྱི་ཐིག་ནང་དུམ་ཚན་དང་།"

msgid "Learn more about the course outline"
msgstr "སློབ་ཚན་གྱི་བཀོད་སྒྲིག་ལ་རྒྱུས་ལོན་བྱེད་པ།"

msgid "Setting release dates and grading policies"
msgstr "འགྲེམ་སྤེལ་ཚེས་གྲངས་དང་རིམ་པ་གཅོད་པའི་སྲིད་ཇུས་གཏན་འབེབས་བྱེད་པ།"

msgid ""
"Select the Configure icon for a section or subsection to set its release "
"date. When you configure a subsection, you can also set the grading policy "
"and due date."
msgstr ""
"དེའི་འགྲེམ་སྤེལ་ཚེས་གྲངས་གཏན་འཁེལ་བྱེད་པར་དུམ་བུའམ་དུམ་ཚན་ཆུང་བ་ཞིག་གི་ཆེད་དུ་སྒྲིག་བཀོད་རིས་རྟགས་འདེམས།"
" "
"ཁྱོད་ཀྱིས་ཡན་ལག་ཅིག་སྒྲིག་བཀོད་བྱེད་སྐབས་ཁྱེད་ཀྱིས་རིམ་སྒྲིག་སྲིད་ཇུས་དང་དུས་ཚོད་གཏན་འཁེལ་བྱེད་ཐུབ།"

msgid "Learn more about grading policy settings"
msgstr "རིམ་སྒྲིག་སྲིད་ཇུས་སྒྲིག་སྟངས་སྐོར་ལ་མང་ཙམ་ཤེས་དགོས།"

msgid "Changing the content learners see"
msgstr "སློབ་སྦྱོང་བྱེད་མཁན་གྱིས་མཐོང་བའི་ནང་དོན་བསྒྱུར་བ།"

msgid ""
"To publish draft content, select the Publish icon for a section, subsection,"
" or unit."
msgstr ""
"འཆར་ཟིན་གྱི་ནང་དོན་པར་སྐྲུན་བྱེད་པར་དུམ་བུའམ་དུམ་བུའམ་ཚན་པ་ཞིག་གི་ཆེད་དུ་པར་སྐྲུན་མཚོན་རྟགས་འདེམས།"

msgid ""
"To make a section, subsection, or unit unavailable to learners, select the "
"Configure icon for that level, then select the appropriate "
"{em_start}Hide{em_end} option. Grades for hidden sections, subsections, and "
"units are not included in grade calculations."
msgstr ""
"སློབ་མ་ཚོར་ {em_start} {em_end} ། གསང་བའི་དུམ་བུ་དང་། དུམ་བུ་ཆུང་བ། "
"དེ་བཞིན་ཚད་གཞི་བཅས་ཀྱི་གྲངས་ཐོ་རྣམས་གྲངས་ཐོའི་རྩིས་རྒྱག་ནང་ཚུད་མེད།"

msgid ""
"To hide the content of a subsection from learners after the subsection due "
"date has passed, select the Configure icon for a subsection, then select "
"{em_start}Hide content after due date{em_end}. Grades for the subsection "
"remain included in grade calculations."
msgstr ""
"དོན་ཚན་ཆུང་བའི་ནང་དོན་དེ་སློབ་མ་ཚོའི་མདུན་དུ་སྦས་ཆེད་དུ་དོན་ཚན་ཆུང་བའི་ཆེད་དུ་སྒྲིག་བཀོད་ཀྱི་རྟགས་མཚན་འདེམས།"
" དེ་ནས་ {em_start} འདེམས་ནས་ཚེས་གྲངས་རྗེས་སུ་ནང་དོན་སྦས་དགོས། {em_end} "
"དོན་ཚན་ཆུང་བའི་སྐར་གྲངས་དེ་ད་དུང་ཡང་སྐར་གྲངས་རྩིས་རྒྱག་ནང་ཚུད་ཡོད།"

msgid "Learn more about content visibility settings"
msgstr "ནང་དོན་མཐོང་ཐུབ་པའི་སྒྲིག་སྟངས་སྐོར་ལ་རྒྱུས་ལོན་བྱེད་པ།"

msgid "Pages & Resources"
msgstr "ཤོག་ངོས་དང་ཐོན་ཁུངས།"

msgid "Pages"
msgstr "ཤོག་ངོས།"

msgid "New Page"
msgstr "ཤོག་ངོས་གསར་པ།"

msgid ""
"Note: Pages are publicly visible. If users know the URL of a page, they can "
"view the page even if they are not registered for or logged in to your "
"course."
msgstr ""
"དྲན་ཐོ། ཤོག་ངོས་ཡོངས་ལ་མཐོང་ཐུབ། "
"གལ་ཏེ་སྤྱོད་མཁན་གྱིས་ཤོག་ངོས་ཤིག་གི་URLཤེས་ན་ཁོང་ཚོས་ཁྱེད་ཀྱི་སློབ་ཚན་ལ་ཐོ་འགོད་བྱས་པའམ་ཡང་ན་ནང་འཇུག་བྱས་མེད་ཀྱང་ཤོག་ངོས་དེ་ལྟ་ཐུབ།"

msgid "Show this page"
msgstr "ཤོག་ངོས་འདི་སྟོན།"

msgid "Show/hide page"
msgstr "ཤོག་ངོས/སྦས་པ།"

msgid "This page cannot be reordered"
msgstr "ཤོག་ངོས་འདི་བསྐྱར་དུ་གོ་སྒྲིག་བྱེད་མི་ཐུབ།"

msgid "You can add additional custom pages to your course."
msgstr "ཁྱེད་རང་གི་སློབ་ཚན་ལ་སྒེར་གྱི་ཤོག་ངོས་ཁ་སྣོན་བྱེད་ཐུབ།"

msgid "Add a New Page"
msgstr "ཤོག་ངོས་གསར་པ་ཁ་སྣོན་བྱེད་པ།"

msgid "What are pages?"
msgstr "ཤོག་ངོས་གང་ཡིན་ནམ།"

msgid ""
"Pages are listed horizontally at the top of your course. Default pages "
"(Home, Course, Discussion, Wiki, and Progress) are followed by textbooks and"
" custom pages that you create."
msgstr ""
"ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་མགོ་ལ་ཤོག་ངོས་འཕྲེད་ལ་ཐོ་འགོད་བྱས་ཡོད། "
"སྔོན་སྒྲིག་ཤོག་ངོས་(ཁྱིམ་གཞིས་དང་། སློབ་ཚན། གྲོས་བསྡུར། ཝི་ཀི། ཡར་རྒྱས་) "
"དེའི་རྗེས་སུ་ཁྱེད་ཀྱིས་བཟོས་པའི་སློབ་དེབ་དང་སྒེར་གྱི་ཤོག་ངོས་ཡོད།"

msgid ""
"You can create and edit custom pages to provide students with additional "
"course content. For example, you can create pages for the grading policy, "
"course slides, and a course calendar. "
msgstr ""
"ཁྱེད་ཀྱིས་སློབ་མ་ཚོར་སློབ་ཚན་གྱི་ནང་དོན་ཁ་སྣོན་སྤྲོད་ཆེད་དུ་སྒེར་གྱི་ཤོག་ངོས་གསར་བཟོ་དང་རྩོམ་སྒྲིག་བྱེད་ཐུབ།"
" "
"དཔེར་ན་ཁྱེད་ཀྱིས་ཨང་རིམ་སྲིད་ཇུས་དང་སློབ་ཚན་གྱི་བཤུད་ཕྲ་དང་སློབ་ཚན་གྱི་ཟླ་ཐོའི་ཆེད་དུ་ཤོག་ངོས་གསར་འཛུགས་བྱེད་ཐུབ།"
" "

msgid "How do pages look to students in my course?"
msgstr "ངའི་སློབ་ཚན་གྱི་སློབ་མ་ཚོར་ཤོག་ངོས་ཇི་ལྟར་མཐོང་གི་ཡོད་དམ།"

msgid ""
"Students see the default and custom pages at the top of your course and use "
"these links to navigate."
msgstr ""
"སློབ་ཕྲུག་ཚོས་ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་མགོ་ལ་སྔོན་སྒྲིག་དང་སྒེར་གྱི་ཤོག་ངོས་མཐོང་ནས་འབྲེལ་མཐུད་འདི་དག་བེད་སྤྱད་ནས་འགྲུལ་བཞུད་བྱེད།"

msgid "See an example"
msgstr "དཔེར་མཚོན་ལ་གཟིགས།"

msgid "What are custom pages?"
msgstr "སྲོལ་རྒྱུན་གྱི་ཤོག་ངོས་གང་ཡིན་ནམ།"

msgid ""
"You can create and edit custom pages to provide students with additional "
"course content. For example, you can create pages for the grading policy, "
"course syllabus, and a course calendar. "
msgstr ""
"ཁྱེད་ཀྱིས་སློབ་མ་ཚོར་སློབ་ཚན་གྱི་ནང་དོན་ཁ་སྣོན་སྤྲོད་ཆེད་དུ་སྒེར་གྱི་ཤོག་ངོས་གསར་བཟོ་དང་རྩོམ་སྒྲིག་བྱེད་ཐུབ།"
" "
