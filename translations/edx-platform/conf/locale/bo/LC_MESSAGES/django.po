msgstr "ཁྱེད་ཀྱི་ཡིག་ཆ་ཉར་ཚགས་བྱེད་ཐུབ་ས་མ་རེད་ %s"

msgid ""
"Your file could not be saved, probably because of a permission error on the "
"web server."
msgstr ""
"ཁྱེད་ཀྱི་ཡིག་ཆ་ཉར་ཚགས་བྱེད་ཐུབ་ས་མ་རེད། "
"ཕལ་ཆེར་དྲ་ཚིགས་དེའི་གསོག་མཛོད་ཀྱི་ཆོག་མཆན་ཐད་ཀྱི་གནད་དོན་ཞིག་ཡིན་པ་འདྲ།"

