msgid "Learn About Verified Certificates"
msgstr "ཁུངས་སྐྱེལ་བྱས་པའི་ལག་ཁྱེར་གྱི་སྐོར་ལ་རྒྱུས་ལོན་མང་ཙམ་བྱོས།"

msgid "{platform_name} Verified Certificate"
msgstr "{platform_name} ཁུངས་སྐྱེལ་ཡོད་པའི་ལག་ཁྱེར།"

