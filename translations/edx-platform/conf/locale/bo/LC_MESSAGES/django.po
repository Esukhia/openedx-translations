msgstr ""
"བཟོ་བཅོས་པར་གཞི་དེ་རྩོམ་ཡིག་འདིའི་ཐད་འཆར་ཡོང་། "
"གལ་སྲིད་ཕྱིར་ལྡོག་དགོས་ན་གཤམ་གྱི་ཚན་པའི་ནང་གི་རིན་ཐང་འགྱུར་བ་ཐོངས།"

msgid "modified"
msgstr "བཅོས་སྒྲིག་ཟིན་པ།"

