"ཁྱེད་རང་གིས་ཁྱེད་རང་གི་དཔེ་མཛོད་ནང་དུ་ཡོད་པའི་XMLདེ་ {studio_name} "
"ལས་ཕྱི་རོལ་དུ་ཐད་ཀར་རྩོམ་སྒྲིག་བྱེད་འདོད་ཡོད་སྲིད། "
"ཁྱེད་རང་གི་དཔེ་མཛོད་ཀྱི་རྒྱབ་སྣོན་འདྲ་བཤུས་བཟོ་འདོད་ཡོད་སྲིད། "
"ཡང་ན་ཁྱེད་ཀྱིས་དཔེ་མཛོད་ཀྱི་འདྲ་བཤུས་ཤིག་གསར་འཛུགས་བྱེད་དགོས་ཤིང་། "
"དེ་རྗེས་སུ་དཔེ་མཛོད་གཞན་ཞིག་ལ་ནང་འདྲེན་བྱེད་ཐུབ་པ་དང་སྒྲིག་བཀོད་བྱེད་ཐུབ།"

msgid "Opening the downloaded file"
msgstr "ཕབ་ལེན་བྱས་པའི་ཡིག་ཆ་དེ་ཁ་འབྱེད་བཞིན་ཡོད།"

msgid ""
"Use an archive program to extract the data from the .tar.gz file. Extracted "
"data includes the library.xml file, as well as subfolders that contain "
"library content."
msgstr ""
".tar.gz ཡིག་ཆའི་ནང་ནས་གཞི་གྲངས་ཕྱིར་འདོན་བྱེད་པར་ཡིག་ཚགས་ལས་རིམ་སྤྱད་དེ། "
"ཕྱིར་འཐེན་བྱས་པའི་གཞི་གྲངས་ནང་ library.xml "
"ཡིག་ཆ་དང་དེ་བཞིན་དཔེ་མཛོད་ཀྱི་ནང་དོན་ཡོད་པའི་ཡན་ལག་སྣོད་ཐོ་ཚུད་ཡོད།"

msgid "Learn more about exporting a library"
msgstr "དཔེ་མཛོད་ཁང་ཕྱིར་གཏོང་བྱེད་པའི་སྐོར་ལ་རྒྱུས་ལོན་བྱེད་པ།"

msgid "Why export a course?"
msgstr "སློབ་ཚན་ཕྱིར་འདྲེན་བྱེད་དོན་ཅི་ཡིན།"

msgid ""
"You may want to edit the XML in your course directly, outside of "
"{studio_name}. You may want to create a backup copy of your course. Or, you "
"may want to create a copy of your course that you can later import into "
"another course instance and customize."
msgstr ""
"ཁྱེད་རང་གིས་ཁྱེད་རང་གི་སློབ་ཚན་གྱི་XMLདེ་ཐད་ཀར་ {studio_name} "
"ལས་ཕྱི་རོལ་དུ་རྩོམ་སྒྲིག་བྱེད་འདོད་ཡོད་སྲིད། "
"ཁྱེད་རང་གིས་ཁྱེད་རང་གི་སློབ་ཚན་གྱི་རྒྱབ་སྣོན་འདྲ་བཤུས་བཟོ་འདོད་ཡོད་སྲིད། "
"ཡང་ན་ཁྱེད་རང་གིས་ཁྱེད་རང་གི་སློབ་ཚན་གྱི་འདྲ་བཤུས་ཤིག་བཟོས་ནས་སློབ་ཚན་གཞན་ཞིག་ལ་ནང་འདྲེན་བྱེད་ཐུབ་པ་དང་སྒྲིག་བཀོད་བྱེད་ཐུབ།"

msgid "What content is exported?"
msgstr "ནང་དོན་གང་ཞིག་ཕྱིར་འདྲེན་བྱེད་པ་ཡིན།"

msgid "The following content is exported."
msgstr "གཤམ་གྱི་ནང་དོན་ཕྱིར་འཚོང་བྱས་ཡོད།"

msgid "Course content and structure"
msgstr "སློབ་ཚན་གྱི་ནང་དོན་དང་སྒྲིག་གཞི།"

msgid "Course dates"
msgstr "སློབ་ཚན་གྱི་དུས་ཚོད།"

msgid "Grading policy"
msgstr "རིམ་སྒྲིག་སྲིད་ཇུས།"

msgid "Any group configurations"
msgstr "སྡེ་ཚན་སྒྲིག་བཀོད་གང་རུང་།"

msgid ""
"Settings on the Advanced Settings page, including MATLAB API keys and LTI "
"passports"
msgstr ""
"MATLAB API ལྡེ་མིག་དང་LTI "
"ཕྱི་སྐྱོད་ལག་ཁྱེར་ཚུད་པའི་ཡར་ཐོན་སྒྲིག་བཀོད་ཤོག་ངོས་སྟེང་གི་སྒྲིག་སྟངས།"

msgid "The following content is not exported."
msgstr "གཤམ་གྱི་ནང་དོན་ཕྱིར་འཚོང་བྱས་མེད།"

msgid ""
"Learner-specific content, such as learner grades and discussion forum data"
msgstr ""
"སློབ་མའི་དམིགས་འབེན་གྱི་ནང་དོན་དཔེར་ན་སློབ་མའི་སྐར་གྲངས་དང་གྲོས་བསྡུར་གླེང་སྟེགས་ཀྱི་གྲངས་ཐོ།"

msgid "The course team"
msgstr "སློབ་ཚན་དཔུང་སྡེ།"

msgid ""
"Use an archive program to extract the data from the .tar.gz file. Extracted "
"data includes the course.xml file, as well as subfolders that contain course"
" content."
msgstr ""
".tar.gz ཡིག་ཆའི་ནང་ནས་གཞི་གྲངས་ཕྱིར་འདོན་བྱེད་པར་ཡིག་ཚགས་ལས་རིམ་སྤྱད་དེ། "
"འདོན་སྤེལ་བྱས་པའི་གཞི་གྲངས་ནང་ course.xml "
"ཡིག་ཆ་དང་དེ་བཞིན་སློབ་ཚན་གྱི་ནང་དོན་ཡོད་པའི་སྣོད་ཆུང་ཚུད་ཡོད།"

msgid "Learn more about exporting a course"
msgstr "སློབ་ཚན་ཞིག་ཕྱིར་གཏོང་བྱེད་པའི་སྐོར་ལ་རྒྱུས་ལོན་བྱེད་པ།"

msgid "Export Course to Git"
msgstr "Git ལ་སློབ་ཚན་ཕྱིར་གཏོང་།"

msgid "Export to Git"
msgstr "Git ལ་ཕྱིར་གཏོང་།"

msgid "About Export to Git"
msgstr "Git ལ་ཕྱིར་གཏོང་སྐོར།"

msgid "Use this to export your course to its git repository."
msgstr ""
"ཁྱེད་རང་གི་སློབ་ཚན་དེ་git མཛོད་ཁང་ལ་ཕྱིར་གཏོང་བྱེད་པར་འདི་བེད་སྤྱོད་བྱོས།"

msgid ""
"This will then trigger an automatic update of the main LMS site and update "
"the contents of your course visible there to students if automatic git "
"imports are configured."
msgstr ""
"དེ་ནས་དེས་LMSདྲ་ཚིགས་གཙོ་བོའི་རང་འགུལ་གྱིས་ཁ་སྐོང་བྱེད་པ་དང་གལ་ཏེ་རང་འགུལ་གྱི་gitནང་འདྲེན་སྒྲིག་བཀོད་བྱས་ཡོད་ན།"
" ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་ནང་དོན་དེ་སློབ་མ་ཚོར་མཐོང་རྒྱུ་ཡོད།"

msgid "Export Course to Git:"
msgstr "Git ལ་ཕྱིར་གཏོང་སློབ་ཚན།"

msgid ""
"giturl must be defined in your course settings before you can export to git."
msgstr ""
"ཁྱེད་རང་གིས་git "
"ལ་ཕྱིར་གཏོང་མ་བྱེད་གོང་ཁྱེད་རང་གི་སློབ་ཚན་གྱི་སྒྲིག་བཀོད་ནང་ལ་giturl "
"ངེས་ཚིག་བཀོད་དགོས།"

msgid "Export Failed"
msgstr "ཕྱིར་གཏོང་འཐུས་ཤོར་བྱུང་བ།"

msgid "Export Succeeded"
msgstr "ཕྱིར་གཏོང་ལེགས་འགྲུབ་བྱུང་།"

msgid "Your course:"
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན།"

msgid "Course git url:"
msgstr "སློབ་ཚན་git url:"

msgid "Experiment Group Configurations"
msgstr "ཚོད་ལྟའི་སྡེ་ཚན་གྱི་སྒྲིག་བཀོད།"

msgid "This module is disabled at the moment."
msgstr "ད་ལྟའི་ཆར་ཚད་གཞི་འདི་ལྕོགས་མིན་བཟོས་ཡོད།"

msgid ""
"Enrollment track groups allow you to offer different course content to "
"learners in each enrollment track. Learners enrolled in each enrollment "
"track in your course are automatically included in the corresponding "
"enrollment track group."
msgstr ""
"ཐོ་འགོད་ལམ་ཐིག་སྡེ་ཚན་གྱིས་ཁྱེད་ལ་ཐོ་འགོད་ལམ་ཐིག་རེ་རེའི་ནང་སློབ་མ་ཚོར་སློབ་ཚན་གྱི་ནང་དོན་མི་འདྲ་བ་སྤྲོད་ཐུབ།"
" "
"ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་ཐོ་འགོད་ལམ་ཐིག་རེ་རེའི་ནང་ཐོ་འགོད་བྱས་པའི་སློབ་མ་རྣམས་རང་འགུལ་གྱིས་ཐོ་འགོད་ལམ་ཐིག་སྡེ་ཚན་དེའི་ནང་དུ་ཚུད་ཡོད།"

msgid ""
"On unit pages in the course outline, you can restrict access to components "
"to learners based on their enrollment track."
msgstr ""
"སློབ་ཚན་གྱི་བཀོད་སྒྲིག་ནང་དུ་ཡོད་པའི་སློབ་ཚན་གྱི་ཤོག་ངོས་སྟེང་ལ་ཁྱེད་ཀྱིས་སློབ་མ་ཚོའི་ཐོ་འགོད་ལམ་ལུགས་ལ་གཞི་བཅོལ་ནས་ཆ་ཤས་ལ་འཛུལ་ཞུགས་བྱེད་པར་ཚད་བཀག་བྱེད་ཐུབ།"

msgid ""
"You cannot edit enrollment track groups, but you can expand each group to "
"view details of the course content that is designated for learners in the "
"group."
msgstr ""
"ཁྱེད་ཀྱིས་ཐོ་འགོད་ལམ་ཐིག་སྡེ་ཚན་རྩོམ་སྒྲིག་བྱེད་མི་ཐུབ། "
"འོན་ཀྱང་ཁྱེད་ཀྱིས་སྡེ་ཚན་རེ་རེ་བཞིན་རྒྱ་བསྐྱེད་ནས་སྡེ་ཚན་ནང་སློབ་སྦྱོང་བྱེད་མཁན་གྱི་ཆེད་དུ་བཀོད་སྒྲིག་བྱས་པའི་སློབ་ཚན་གྱི་ནང་དོན་གྱི་ཞིབ་ཕྲ་ལྟ་ཐུབ།"

msgid ""
"If you have cohorts enabled in your course, you can use content groups to "
"create cohort-specific courseware. In other words, you can customize the "
"content that particular cohorts see in your course."
msgstr ""
"གལ་ཏེ་ཁྱེད་ཀྱི་སློབ་ཚན་ནང་ལ་སྡེ་ཚན་ལྕོགས་ཅན་བཟོས་ཡོད་ན། "
"ཁྱེད་ཀྱིས་སྡེ་ཚན་དམིགས་བསལ་གྱི་སློབ་ཚན་མཉེན་ཆས་བཟོ་བར་ནང་དོན་སྡེ་ཚན་བེད་སྤྱོད་བྱེད་ཐུབ།"
" ཚིག་གཞན་ཞིག་གིས་བཤད་ན། "
"ཁྱེད་རང་གི་སློབ་ཚན་ནང་ལ་སྡེ་ཚན་གཅིག་གིས་མཐོང་བའི་ནང་དོན་དེ་སྒྲིག་བཀོད་བྱེད་ཐུབ།"

msgid ""
"Each content group that you create can be associated with one or more "
"cohorts. In addition to making course content available to all learners, you"
" can restrict access to some content to learners in specific content groups."
" Only learners in the cohorts that are associated with the specified content"
" groups see the additional content."
msgstr ""
"ཁྱེད་ཀྱིས་བཟོས་པའི་ནང་དོན་སྡེ་ཚན་རེ་རེ་བཞིན་སྡེ་ཚན་གཅིག་དང་ཡང་ན་དེ་ལས་མང་བ་དང་འབྲེལ་བ་བྱེད་ཐུབ།"
" "
"སློབ་ཚན་གྱི་ནང་དོན་སློབ་མ་ཚང་མར་མཁོ་སྤྲོད་བྱེད་པའི་ཁར་ཁྱེད་ཀྱིས་ནང་དོན་སྡེ་ཚན་ཁག་ཅིག་གི་སློབ་མ་ཚོར་ནང་དོན་ཁ་ཤས་ལ་འཛུལ་ཞུགས་བྱེད་པར་ཚད་བཀག་བྱེད་ཐུབ།"
" "
"བཀོད་སྒྲིག་བྱས་པའི་ནང་དོན་སྡེ་ཚན་དང་འབྲེལ་བ་ཡོད་པའི་སྡེ་ཚན་གྱི་སློབ་མ་ཁོ་ནར་ནང་དོན་ཁ་སྣོན་མཐོང་ཐུབ།"

msgid ""
"Click {em_start}New content group{em_end} to add a new content group. To "
"edit the name of a content group, hover over its box and click "
"{em_start}Edit{em_end}. You can delete a content group only if it is not in "
"use by a unit. To delete a content group, hover over its box and click the "
"delete icon."
msgstr ""
"{em_start} ནང་དོན་སྡེ་ཚན་གསར་པ་ {em_end} "
"ལ་སྣུན་ནས་ནང་དོན་སྡེ་ཚན་གསར་པ་ཁ་སྣོན་བྱེད། "
"ནང་དོན་སྡེ་ཚན་གྱི་མིང་རྩོམ་སྒྲིག་བྱེད་པར་དེའི་སྒྲོམ་གྱི་སྟེང་ལ་མཛུབ་མོ་བཞག་ནས་"
" {em_start} རྩོམ་སྒྲིག་ {em_end} ལ་སྣུན་དགོས། "
"ཁྱེད་ཀྱིས་ནང་དོན་སྡེ་ཚན་ཞིག་སྡེ་ཚན་གཅིག་གིས་བེད་སྤྱོད་བྱེད་ཀྱི་མེད་ན་རྐྱངམ་གཅིག་སུབ་ཐུབ།"
" "
"ནང་དོན་སྡེ་ཚན་ཞིག་བསུབས་ན་དེའི་སྒྲོམ་གྱི་སྟེང་དུ་མཛུབ་གནོན་བྱས་ནས་བསུབས་རྟགས་ལ་སྣུན་དགོས།"

msgid ""
"Use experiment group configurations if you are conducting content "
"experiments, also known as A/B testing, in your course. Experiment group "
"configurations define how many groups of learners are in a content "
"experiment. When you create a content experiment for a course, you select "
"the group configuration to use."
msgstr ""
"གལ་ཏེ་ཁྱེད་རང་གིས་ཁྱེད་རང་གི་སློབ་ཚན་ནང་ལ་ནང་དོན་ཚོད་ལྟ་བྱེད་བཞིན་ཡོད་ན། "
"ཚོད་ལྟའི་སྡེ་ཚན་གྱི་སྒྲིག་བཀོད་ཀྱིས་ནང་དོན་ཚོད་ལྟའི་ནང་སློབ་སྦྱོང་བྱེད་མཁན་གྱི་སྡེ་ཚན་ག་ཚོད་ཡོད་མེད་གསལ་བཤད་བྱེད།"
" "
"ཁྱེད་ཀྱིས་སློབ་ཚན་ཞིག་གི་ནང་དོན་ཚོད་ལྟ་གསར་འཛུགས་བྱེད་སྐབས་ཁྱེད་ཀྱིས་བེད་སྤྱོད་གཏོང་བའི་སྡེ་ཚན་སྒྲིག་བཀོད་འདེམས།"

msgid ""
"Click {em_start}New Group Configuration{em_end} to add a new configuration. "
"To edit a configuration, hover over its box and click "
"{em_start}Edit{em_end}. You can delete a group configuration only if it is "
"not in use in an experiment. To delete a configuration, hover over its box "
"and click the delete icon."
msgstr ""
"{em_start} སྡེ་ཚན་གསར་པའི་སྒྲིག་བཀོད་ {em_end} "
"ལ་སྣུན་ནས་སྒྲིག་བཀོད་གསར་པ་ཁ་སྣོན་བྱེད། "
"རིམ་སྒྲིག་རྩོམ་སྒྲིག་བྱེད་པར་དེའི་སྒྲོམ་གྱི་སྟེང་ལ་མཛུབ་མོ་བཞག་ནས་ "
"{em_start} རྩོམ་སྒྲིག་ {em_end} ལ་སྣུན་དགོས། "
"ཁྱེད་ཀྱིས་སྡེ་ཚན་སྒྲིག་བཀོད་ཅིག་ཚོད་ལྟའི་ནང་བེད་སྤྱོད་མེད་ན་རྐྱངམ་གཅིག་སུབ་ཐུབ།"
" "
"སྒྲིག་བཀོད་ཅིག་བསུབས་ན་དེའི་སྒྲོམ་གྱི་སྟེང་དུ་མཛུབ་མོ་བཞག་ནས་བསུབ་པའི་རྟགས་མཚན་ལ་སྣུན་དགོས།"

msgid "Welcome"
msgstr "དགའ་བསུ་ཞུ།"

msgid "Welcome to {studio_name}"
msgstr "{studio_name} ལ་དགའ་བསུ་ཞུ།"

msgid ""
"{studio_name} helps manage your online courses, so you can focus on teaching"
" them"
msgstr ""
"{studio_name} ཁྱེད་ཀྱི་དྲ་ཐོག་སློབ་ཚན་དོ་དམ་བྱེད་པར་ཕན་ཐོགས། "
"དེར་བརྟེན་ཁྱེད་ཀྱིས་དེ་དག་སློབ་ཁྲིད་ལ་དོ་སྣང་བྱེད་ཐུབ།"

msgid "{studio_name}'s Many Features"
msgstr "{studio_name} ཞེས་པའི་ཁྱད་ཆོས་མང་པོ།"

msgid "{studio_name} Helps You Keep Your Courses Organized"
msgstr "{studio_name} ཁྱེད་ཀྱི་སློབ་ཚན་སྒྲིག་འཛུགས་བྱེད་པར་ཕན་ཐོགས།"

msgid "Enlarge image"
msgstr "པར་རིས་ཆེ་རུ་གཏོང་བ།"

msgid "Keeping Your Course Organized"
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན་གྲལ་འགྲིག་པོ་ཞིག་ཉར་བཞིན་ཡོད།"

msgid ""
"The backbone of your course is how it is organized. {studio_name} offers an "
"{strong_start}Outline{strong_end} editor, providing a simple hierarchy and "
"easy drag and drop to help you and your students stay organized."
msgstr ""
"ཁྱེད་རང་གི་སློབ་ཚན་གྱི་སྒལ་ཚིགས་ནི་ཇི་ལྟར་སྒྲིག་འཛུགས་བྱས་པ་དེ་རེད། "
"{studio_name} ཡིས་ {strong_start} Outline {strong_end} "
"རྩོམ་སྒྲིག་པ་མཁོ་སྤྲོད་བྱེད་ཀྱི་ཡོད།"

msgid "Simple Organization For Content"
msgstr "ནང་དོན་དེའི་ཚོགས་པ་སྟབས་བདེ་ཞིག"

msgid ""
"{studio_name} uses a simple hierarchy of {strong_start}sections{strong_end} "
"and {strong_start}subsections{strong_end} to organize your content."
msgstr ""
"ཁྱེད་ཀྱི་ནང་དོན་སྒྲིག་འཛུགས་བྱེད་པར་ {studio_name} དུམ་བུ་ {strong_start} "
"དང་ {strong_start} {strong_end} {strong_end} "
"རིམ་པ་སྟབས་བདེ་ཞིག་བེད་སྤྱོད་བྱེད་ཀྱི་ཡོད།"

msgid "Change Your Mind Anytime"
msgstr "ནམ་ཡིན་རུང་བསྒྱུར་བཅོས་བྱེད་ཆོག"

msgid ""
"Draft your outline and build content anywhere. Simple drag and drop tools "
"let you reorganize quickly."
msgstr ""
"ཁྱེད་རང་གི་བཀོད་སྒྲིག་དང་ནང་དོན་གང་དུ་ཡང་བཟོས། "
"འདྲུད་འཐེན་ལག་ཆ་ལས་སླ་པོ་དེས་ཁྱེད་ལ་མགྱོགས་པོ་སྒྲིག་འཛུགས་བྱེད་ཐུབ།"

msgid "Go A Week Or A Semester At A Time"
msgstr "བདུན་ཕྲག་གཅིག ཡང་ན་སློབ་དུས་གཅིག་ལ་འགྲོ།"

msgid ""
"Build and release {strong_start}sections{strong_end} to your students "
"incrementally. You don't have to have it all done at once."
msgstr ""
"ཁྱེད་རང་གི་སློབ་ཕྲུག་ཚོར་ {strong_start} དུམ་བུ་ {strong_end} "
"བཟོ་སྐྲུན་དང་འགྲེམ་སྤེལ་བྱེད་དགོས། ཚང་མ་ཐེངས་གཅིག་ལ་སྒྲུབ་དགོས་དོན་མེད།"

msgid "Learning is More than Just Lectures"
msgstr "སློབ་གཉེར་བྱེད་པ་ནི་ལེགས་འཆར་ཤོད་པ་ཙམ་ལས་ལྷག"

msgid ""
"{studio_name} lets you weave your content together in a way that reinforces "
"learning. Insert videos, discussions, and a wide variety of exercises with "
"just a few clicks."
msgstr ""
"{studio_name} "
"གིས་ཁྱེད་ཀྱི་ནང་དོན་དེ་སློབ་སྦྱོང་ལ་ཤུགས་སྣོན་གཏོང་བའི་ཐབས་ལམ་ཐོག་ནས་མཉམ་དུ་འཐག་ཐུབ།"
" བརྙན་འཕྲིན་དང་། གྲོས་བསྡུར། "
"དེ་བཞིན་སྦྱོང་བརྡར་སྣ་ཚོགས་ཤིག་སྣུན་ཐེངས་འགའ་ཤས་ཀྱིས་བཙུགས་ཐུབ།"

msgid "Create Learning Pathways"
msgstr "སློབ་གཉེར་གྱི་བརྒྱུད་ལམ་གསར་བཟོ་བྱོས།"

msgid ""
"Help your students understand one concept at a time with multimedia, HTML, "
"and exercises."
msgstr ""
"ཁྱེད་རང་གི་སློབ་ཕྲུག་ཚོར་བརྡ་འཕྲིན་སྣ་ཚོགས་དང་། HTML "
"དེ་བཞིན་སྦྱོང་བརྡར་བཅས་ཀྱི་ཐོག་ནས་བསམ་གཞིག་གཅིག་ལ་གོ་བ་ལེན་པར་རོགས་རམ་བྱེད།"

msgid "Work Visually, Organize Quickly"
msgstr "རྣམ་པ་འཆར་བཞིན་དུ་ལས་ཀ་བྱེད། གྲ་སྒྲིག་མྱུར་པོར་བྱེད།"

msgid ""
"Work visually and see exactly what your students will see. Reorganize all "
"your content with drag and drop."
msgstr ""
"རྗེས་ཕྱོགས་སློབ་ཕྲུག་གིས་ཇི་ལྟར་མཐོང་རྣམ་པ་དེར་རང་གིས་ཁྱེད་ཀྱིས་ལྟ་བཞིན་དུ་དེའི་ཐོག་ལས་ཀ་བྱེད་ཐུབ།"

msgid "A Broad Library of Problem Types"
msgstr "དོགས་འདྲིའི་རིགས་ཀྱི་དཔེ་མཛོད་རྒྱ་ཆེན་ཞིག"

msgid ""
"It's more than just multiple choice. {studio_name} supports more than a "
"dozen types of problems to challenge your learners."
msgstr ""
"དེ་ནི་གདམ་ག་སྣ་ཚོགས་ལས་ལྷག་པ་ཞིག་རེད། {studio_name} "
"ཁྱེད་ཀྱི་སློབ་སྦྱོང་བྱེད་མཁན་ཚོར་འགྲན་སློང་བྱེད་པའི་དཀའ་ངལ་རིགས་བཅུ་ལྷག་ལ་རྒྱབ་སྐྱོར་བྱེད་ཀྱི་ཡོད།"

msgid ""
"{studio_name} Gives You Simple, Fast, and Incremental Publishing. With "
"Friends."
msgstr ""
"{studio_name} གིས་ཁྱེད་ལ་དཔེ་སྐྲུན་སྟབས་བདེ་བ་དང་། མགྱོགས་པོ། "
"ཡར་འཕར་གྱི་པར་སྐྲུན་སྤྲོད་ཀྱི་ཡོད། གྲོགས་པོ་དང་མཉམ་དུ།"

msgid "Simple, Fast, and Incremental Publishing. With Friends."
msgstr ""
"གྲོགས་པོ་ཚོ་དང་ལྷན་དུ་སྟབས་བདེ་དང་མགྱོགས་པ། སྤེལ་སྟངས་སྣ་ཁ་མང་བ་བཅས་ཡོད།"

msgid ""
"{studio_name} works like web applications you already know, yet understands "
"how you build curriculum. Instant publishing to the web when you want it, "
"incremental release when it makes sense. And with co-authors, you can have a"
" whole team building a course, together."
msgstr ""
"{studio_name} ཁྱེད་ཀྱིས་ཤེས་ཟིན་པའི་དྲ་རྒྱའི་མཉེན་ཆས་ལྟར་ལས་ཀ་བྱེད་ཀྱི་ཡོད། "
"འོན་ཀྱང་ཁྱེད་ཀྱིས་སློབ་ཚན་ཇི་ལྟར་བཟོ་དགོས་མིན་ཤེས་ཀྱི་ཡོད། "
"ཁྱེད་ལ་དགོས་དུས་དྲ་རྒྱའི་ཐོག་ལ་འཕྲལ་མར་པར་སྐྲུན་བྱེད་པ་དང་། "
"རྩོམ་པ་པོ་མཉམ་འབྲེལ་པ་ཚོ་དང་མཉམ་དུ་ཁྱེད་རང་གིས་རུ་ཁག་ཧྲིལ་པོ་ཞིག་གིས་མཉམ་དུ་སློབ་ཚན་ཞིག་བཟོ་ཐུབ།"

msgid "Instant Changes"
msgstr "འཕྲལ་འཕྲལ་གྱི་བསྒྱུར་བཅོས།"

msgid ""
"Caught a bug? No problem. When you want, your changes go live when you click"
" Save."
msgstr ""
"འབུ་ཞིག་བཟུང་སོང་ངམ། གནད་དོན་མེད་པ། "
"ཁྱེད་རང་དགོས་དུས་ཁྱེད་རང་གི་བསྒྱུར་བཅོས་དེ་ཚོ་ཉར་ཚགས་ལ་སྣུན་སྐབས་ཐད་གཏོང་བྱེད།"

msgid "Release-On Date Publishing"
msgstr "Release-On Date Publishing"

msgid ""
"When you've finished a {strong_start}section{strong_end}, pick when you want"
" it to go live and {studio_name} takes care of the rest. Build your course "
"incrementally."
msgstr ""
"ཁྱེད་རང་གིས་ {strong_start} ཚན་པ་ {strong_end} མཇུག་སྒྲིལ་རྗེས། "
"ཁྱེད་རང་གིས་དེ་ག་དུས་ཐད་གཏོང་བྱེད་འདོད་ཡོད་མེད་འདེམས་ནས་ {studio_name} "
"གིས་གཞན་ཚང་མ་ལྟ་རྟོག་བྱེད། ཁྱེད་རང་གི་སློབ་ཚན་རིམ་བཞིན་བཟོས།"

msgid "Work in Teams"
msgstr "ཚོགས་ཆུང་དང་མཉམ་ལས།"

msgid ""
"Co-authors have full access to all the same authoring tools. Make your "
"course better through a team effort."
msgstr ""
"རྩོམ་གྲོགས་རྣམས་ལ་དབང་ཚད་ཀྱི་ལག་ཆ་ཡོངས་རྫོགས་བཀོལ་བའི་ཆོག་མཆན་ཡོད། "
"ཚོགས་ཆུང་གི་ནུས་པ་ལ་བརྟེན་ནས་རང་ཉིད་ཀྱི་སློབ་ཚན་སྔར་ལས་ཇེ་ལེགས་སུ་གཏོང་ཐུབ་པ་བཟོས།"

msgid "Sign Up for {studio_name} Today!"
msgstr "དེ་རིང་ {studio_name} ལ་ཐོ་འགོད་བྱོས།"

msgid "Sign Up & Start Making Your {platform_name} Course"
msgstr "ཐོ་འགོད་བྱས་ནས་ཁྱེད་ཀྱི་ {platform_name} སློབ་ཚན་བཟོ་འགོ་ཚུགས།"

msgid "Already have a {studio_name} Account? Sign In"
msgstr "ད་ལྟ་ {studio_name} རྩིས་ཁྲ་ཡོད་དམ། ནང་འཇུག་བྱེད་པ།"

msgid "Outlining Your Course"
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན་ནང་དོན་གྱི་དཀར་ཆག"

msgid ""
"Simple two-level outline to organize your course. Drag and drop, and see "
"your course at a glance."
msgstr ""
"ཁྱེད་རང་གི་སློབ་ཚན་སྒྲིག་འཛུགས་བྱེད་པར་རིམ་པ་གཉིས་ཀྱི་བཀོད་སྒྲིག་འཇམ་པོ། "
"འདྲུད་ནས་བཀོག་ནས་ཁྱེད་རང་གི་སློབ་ཚན་དེ་མིག་གཅིག་གིས་མཐོང་ཐུབ།"

msgid "More than Just Lectures"
msgstr "ལེགས་འཆར་ཙམ་ལས་མང་བ།"

msgid ""
"Quickly create videos, text snippets, inline discussions, and a variety of "
"problem types."
msgstr ""
"བརྙན་མགྱོགས་བཟོ་དང་། སྤྱོད་བདེའི་ཚིག་དུམ། འབྲེལ་ཡོད་གླེང་གཞི། "
"དེ་བཞིན་དྲི་བའི་རིགས་འདྲ་མིན་བཅས།"

msgid "Publishing on Date"
msgstr "ཚེས་19ཉིན་པར་སྐྲུན།"

msgid ""
"Simply set the date of a section or subsection, and {studio_name} will "
"publish it to your students for you."
msgstr ""
"དོན་ཚན་ཞིག་གི་ཚེས་གྲངས་ཡང་ན་དོན་ཚན་ཆུང་བ་ཞིག་གཏན་འཁེལ་བྱས་ན་ {studio_name} "
"ཡིས་ཁྱེད་ཀྱི་ཆེད་དུ་སློབ་ཕྲུག་ཚོར་པར་སྐྲུན་བྱེད།"

msgid "We're having trouble rendering your component"
msgstr "ཁྱེད་ཀྱི་གྲུབ་ཆ་འཆར་སྟོན་བྱེད་པར་ང་ཚོར་དཀའ་ངལ་ཞིག་འདུག"

msgid ""
"Students will not be able to access this component. Re-edit your component "
"to fix the error."
msgstr ""
"སློབ་ཕྲུག་གིས་མ་འོངས་པར་ཁྱེད་ཀྱི་གྲུབ་ཆ་འདི་བལྟ་ཀློག་བྱེད་མི་ཐུབ་པས། "
"གནད་དོན་དེ་གཙང་སེལ་བྱེད་པར་བསྐྱར་དུ་རྩོམ་སྒྲིག་བྱོས།"

msgid "Error:"
msgstr "གནད་དོན།"

msgid "Library Import"
msgstr "དཔེ་མཛོད་ནང་འདྲེན།"

msgid "Course Import"
msgstr "སློབ་ཚན་ནང་འདྲེན།"

msgid ""
"Be sure you want to import a library before continuing. The contents of the "
"imported library will replace the contents of the existing library. "
"{em_start}You cannot undo a library import{em_end}. Before you proceed, we "
"recommend that you export the current library, so that you have a backup "
"copy of it."
msgstr ""
"མུ་མཐུད་དུ་མ་བསྐྱོད་གོང་དུ་དཔེ་མཛོད་ཅིག་ནང་འདྲེན་བྱེད་འདོད་ཡོད་མེད་ངེས་གཏན་བཟོས།"
" "
"ནང་འདྲེན་བྱས་པའི་དཔེ་མཛོད་ཀྱི་ནང་དོན་གྱིས་ད་ཡོད་ཀྱི་དཔེ་མཛོད་ཀྱི་ནང་དོན་གྱི་ཚབ་བྱེད་པ་དང་།"
" {em_start} ཁྱེད་ཀྱིས་དཔེ་མཛོད་ནང་འདྲེན་ {em_end} ཕྱིར་འཐེན་བྱེད་མི་ཐུབ། "
"ཁྱེད་རང་མུ་མཐུད་དུ་མ་འགྲོ་གོང་ང་ཚོས་ཁྱེད་རང་ལ་ད་ལྟའི་དཔེ་མཛོད་དེ་ཕྱིར་གཏོང་བྱེད་དགོས་པའི་བསམ་འཆར་འདོན་གྱི་ཡོད།"

msgid ""
"The library that you import must be in a .tar.gz file (that is, a .tar file "
"compressed with GNU Zip). This .tar.gz file must contain a library.xml file."
" It may also contain other files."
msgstr ""
"ཁྱེད་ཀྱིས་ནང་འདྲེན་བྱེད་པའི་དཔེ་མཛོད་དེ་ .tar.gz ཡིག་ཆའི་ནང་དུ་ཡོད་དགོས། "
".tar.gz ཡིག་ཆ་འདིའི་ནང་ library.xml ཡིག་ཆ་ཡོད་དགོས། "
"དེའི་ནང་དུ་ཡིག་ཆ་གཞན་ཡང་ཡོད་སྲིད།"

msgid ""
"The import process has five stages. During the first two stages, you must "
"stay on this page. You can leave this page after the Unpacking stage has "
"completed. We recommend, however, that you don't make important changes to "
"your library until the import operation has completed."
msgstr ""
"ནང་འདྲེན་བརྒྱུད་རིམ་ལ་རིམ་པ་ལྔ་ཡོད་ཅིང་། "
"དུས་རིམ་དང་པོ་གཉིས་ལ་ངེས་པར་དུ་ཤོག་ངོས་འདིའི་སྟེང་དུ་བསྡད་དགོས། "
"ཁྱེད་ཀྱིས་ཐུམ་སྒྲིལ་ཕྱེ་བའི་རིམ་པ་མཇུག་སྒྲིལ་རྗེས་ཤོག་ངོས་འདི་བཞག་ཆོག "
"ཡིན་ནའང་། "
"ནང་འདྲེན་བཀོལ་སྤྱོད་མཇུག་མ་བསྒྲིལ་བར་ཁྱེད་ཀྱི་དཔེ་མཛོད་ལ་བསྒྱུར་བཅོས་གལ་ཆེན་མ་གཏོང་བའི་བསམ་འཆར་འདོན་གྱི་ཡོད།"

msgid ""
"Be sure you want to import a course before continuing. The contents of the "
"imported course will replace the contents of the existing course. "
"{em_start}You cannot undo a course import{em_end}. Before you proceed, we "
"recommend that you export the current course, so that you have a backup copy"
" of it."
msgstr ""
"མུ་མཐུད་དུ་སློབ་ཚན་ཞིག་ནང་འདྲེན་བྱེད་འདོད་ཡོད་མེད་ངེས་པར་དུ་ཤེས་དགོས། "
"ནང་འདྲེན་བྱས་པའི་སློབ་ཚན་གྱི་ནང་དོན་གྱིས་སྔར་ཡོད་ཀྱི་སློབ་ཚན་གྱི་ནང་དོན་གྱི་ཚབ་བྱེད་པ་དང་།"
" {em_start} ཁྱེད་ཀྱིས་སློབ་ཚན་ནང་འདྲེན་ {em_end} ཕྱིར་འཐེན་བྱེད་མི་ཐུབ། "
"ཁྱེད་རང་མུ་མཐུད་དུ་མ་འགྲོ་གོང་ང་ཚོས་ཁྱེད་རང་ལ་ད་ལྟའི་སློབ་ཚན་དེ་ཕྱིར་གཏོང་བྱེད་དགོས་པའི་བསམ་འཆར་འདོན་གྱི་ཡོད།"

msgid ""
"The course that you import must be in a .tar.gz file (that is, a .tar file "
"compressed with GNU Zip) or .zip (that is a compressed file). This .tar.gz "
"or .zip file must contain a course.xml file. It may also contain other "
"files."
msgstr ""
"ཁྱེད་ཀྱིས་ནང་འདྲེན་བྱེད་པའི་སློབ་ཚན་དེ་ .tar.gz ཡིག་ཆའི་ནང་དུ་ཡོད་དགོས། "
".tar.gz ཡང་ན་ .zip ཡིག་ཆ་འདིའི་ནང་དུ་ངེས་པར་དུ་ course.xml ཡིག་ཆ། "
"དེའི་ནང་དུ་ཡིག་ཆ་གཞན་ཡང་ཡོད་སྲིད།"

msgid ""
"The import process has five stages. During the first two stages, you must "
"stay on this page. You can leave this page after the Unpacking stage has "
"completed. We recommend, however, that you don't make important changes to "
"your course until the import operation has completed."
msgstr ""
"ནང་འདྲེན་བརྒྱུད་རིམ་ལ་རིམ་པ་ལྔ་ཡོད་ཅིང་། "
"དུས་རིམ་དང་པོ་གཉིས་ལ་ངེས་པར་དུ་ཤོག་ངོས་འདིའི་སྟེང་དུ་བསྡད་དགོས། "
"ཁྱེད་ཀྱིས་ཐུམ་སྒྲིལ་ཕྱེ་བའི་རིམ་པ་མཇུག་སྒྲིལ་རྗེས་ཤོག་ངོས་འདི་བཞག་ཆོག "
"ཡིན་ནའང་ང་ཚོས་ཁྱེད་རང་གིས་ནང་འདྲེན་ལས་དོན་མཇུག་མ་བསྒྲིལ་བར་དུ་ཁྱེད་རང་གི་སློབ་ཚན་ལ་འགྱུར་བ་གལ་ཆེན་མ་གཏོང་བའི་བསམ་འཆར་འདོན་གྱི་ཡོད།"

msgid "Select a .tar.gz File to Replace Your Library Content"
msgstr "ཁྱེད་ཀྱི་དཔེ་མཛོད་ཀྱི་ནང་དོན་བརྗེ་སྒྱུར་བྱེད་པར་ .tar.gz ཡིག་ཆ་འདེམས།"

msgid "Select a .tar.gz or .zip File to Replace Your Course Content"
msgstr ""
"ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་ནང་དོན་བརྗེ་སྒྱུར་བྱེད་པར་ .tar.gz ཡང་ན་ .zip "
"ཡིག་ཆ་འདེམས།"

msgid "Choose a File to Import"
msgstr "ནང་འདྲེན་བྱ་རྒྱུའི་ཡིག་ཆ་ཞིག་འདེམ།"

msgid "File Chosen:"
msgstr "བདམས་ཟིན་པའི་ཡིག་ཆ་ནི་"

msgid "Replace my library with the selected file"
msgstr "ངའི་དཔེ་མཛོད་དེ་བདམས་ཟིན་པའི་ཡིག་ཆ་དེ་བརྗེ་དགོས།"

msgid "Replace my course with the selected file"
msgstr "ངའི་སློབ་ཚན་བདམས་ཟིན་པའི་ཡིག་ཆ་དེ་བརྗེ་དགོས།"

msgid "Library Import Status"
msgstr "དཔེ་མཛོད་ནང་འདྲེན་གནས་ཚུལ།"

msgid "Course Import Status"
msgstr "སློབ་ཚན་ནང་འདྲེན་གྱི་གནས་བབ།"

msgid "Transferring your file to our servers"
msgstr "ཁྱེད་ཀྱི་ཡིག་ཆ་ང་ཚོའི་གསོག་མཛོད་ནང་འཇོག་བཞིན་ཡོད།"

msgid "Unpacking"
msgstr "ནང་དོན་སྔོག་བཞིན་ཡོད།"

msgid ""
"Expanding and preparing folder/file structure (You can now leave this page "
"safely, but avoid making drastic changes to content until this import is "
"complete)"
msgstr ""
"སྣོད་ཐོག/ཡིག་ཆའི་སྒྲིག་བཀོད་རྒྱ་བསྐྱེད་དང་གྲ་སྒྲིག་བྱེད་པ། "
"(ཁྱེད་ཀྱིས་ད་ལྟ་ཤོག་ངོས་འདི་བདེ་འཇགས་ངང་བཞག་ཆོག "
"འོན་ཀྱང་ནང་འདྲེན་འདི་མ་ཚར་བར་དུ་ནང་དོན་ལ་འགྱུར་བ་ཆེན་པོ་གཏོང་རྒྱུ་སྤོང་དགོས།)"

msgid "Verifying"
msgstr "གཏན་འཁེལ་བྱེད་བཞིན་ཡོད།"

msgid "Reviewing semantics, syntax, and required data"
msgstr ""
"ནང་དོན་ཁག་དང་བརྡ་སྤྲོད་དེ་བཞིན་དགོས་ངེས་ཀྱི་གནས་ཚུལ་བཅས་ལ་བསྐྱར་ཞིབ་བྱེད་བཞིན་ཡོད།"

msgid "Updating Library"
msgstr "དཔེ་མཛོད་གསར་བཅོས་བྱེད་པ།"

msgid "Updating Course"
msgstr "སློབ་ཚན་ནང་འཇུག་བྱེད་བཞིན་ཡོད།"

msgid ""
"Integrating your imported content into this library. This process might take"
" longer with larger libraries."
msgstr ""
"ཁྱེད་ཀྱིས་ནང་འདྲེན་བྱས་པའི་ནང་དོན་དཔེ་མཛོད་འདིའི་ནང་དུ་མཉམ་བསྲེས་བྱེད་པ། "
"དཔེ་མཛོད་ཆེ་བ་དང་མཉམ་དུ་བྱ་རིམ་འདི་དུས་ཡུན་རིང་བོ་འགོར་སྲིད།"

msgid ""
"Integrating your imported content into this course. This process might take "
"longer with larger courses."
msgstr ""
"ཁྱེད་རང་གི་ནང་འདྲེན་བྱས་པའི་ནང་དོན་སློབ་ཚན་འདིའི་ནང་དུ་མཉམ་བསྲེས་བྱེད་པ། "
"སློབ་ཚན་ཆེ་བ་དང་མཉམ་དུ་བྱ་རིམ་འདིས་དུས་ཡུན་རིང་བོ་འགོར་སྲིད།"

msgid "Your imported content has now been integrated into this library"
msgstr ""
"ཁྱེད་ཀྱིས་ནང་འདྲེན་བྱས་པའི་ནང་དོན་ད་ལྟ་དཔེ་མཛོད་འདིའི་ནང་དུ་མཉམ་བསྲེས་བྱས་ཟིན།"

msgid "Your imported content has now been integrated into this course"
msgstr ""
"ཁྱེད་ཀྱིས་ནང་འདྲེན་བྱས་པའི་ནང་དོན་དེ་ད་ལྟ་སློབ་ཚན་འདིའི་ནང་མཉམ་སྦྱར་བྱས་ཡོད།"

msgid "View Updated Library"
msgstr "གསར་བཅོས་བྱས་པའི་དཔེ་མཛོད་ལ་གཟིགས།"

msgid "View Updated Outline"
msgstr "རིམ་སྤར་བྱས་ཟིན་པའི་ནང་དོན་དཀར་ཆག་སྟོན།"

msgid "Why import a library?"
msgstr "ཅིའི་ཕྱིར་དཔེ་མཛོད་ནང་འདྲེན་བྱེད་དགོས་སམ།"

msgid ""
"You might want to update an existing library to a new version, or replace an"
" existing library entirely. You might also have developed a library outside "
"of {studio_name}."
msgstr ""
"ཁྱེད་ཀྱིས་ད་ཡོད་ཀྱི་དཔེ་མཛོད་ཅིག་ཐོན་རིམ་གསར་པར་ཁ་སྐོང་བྱེད་འདོད་ཡོད་སྲིད། "
"ཡང་ན་ད་ཡོད་ཀྱི་དཔེ་མཛོད་ཅིག་ཡོངས་སུ་བརྗེ་དགོས། ཁྱེད་རང་གིས་ {studio_name} "
"ཡི་ཕྱི་རོལ་དུ་དཔེ་མཛོད་ཅིག་བཟོས་ཡོད་སྲིད།"

msgid "Note: Library content is not automatically updated in courses"
msgstr ""
"མཆན: དཔེ་མཛོད་ཀྱི་ནང་དོན་སློབ་ཚན་ནང་རང་འགུལ་གྱིས་གསར་བརྗེ་བྱེད་ཀྱི་མེད།"

msgid ""
"If you change and import a library that is referenced by randomized content "
"blocks in one or more courses, those courses do not automatically use the "
"updated content. You must manually refresh the randomized content blocks to "
"bring them up to date with the latest library content."
msgstr ""
"གལ་ཏེ་ཁྱེད་ཀྱིས་སློབ་ཚན་གཅིག་ཡང་ན་མང་པོའི་ནང་གང་བྱུང་ནང་དོན་བཀག་སྡོམ་གྱིས་གཞི་བསྟུན་བྱས་པའི་དཔེ་མཛོད་ཅིག་བསྒྱུར་ནས་ནང་འདྲེན་བྱས་ན།"
" སློབ་ཚན་དེ་དག་གིས་རང་འགུལ་གྱིས་གསར་བརྗེ་བྱས་པའི་ནང་དོན་བེད་སྤྱོད་མི་བྱེད། "
"ཁྱེད་ཀྱིས་གང་བྱུང་ནང་དོན་བཀག་སྡོམ་དེ་དག་དཔེ་མཛོད་ཀྱི་ནང་དོན་གསར་ཤོས་དང་མཉམ་དུ་དུས་བསྟུན་བཟོ་བར་ལག་ཐོག་ནས་གསར་བརྗེ་བྱེད་དགོས།"

msgid "Learn more about importing a library"
msgstr "དཔེ་མཛོད་ཁང་ནང་འདྲེན་བྱེད་པའི་སྐོར་ལ་རྒྱུས་ལོན་བྱེད་པ།"

msgid "Why import a course?"
msgstr "སློབ་ཚན་ནང་འདྲེན་བྱེད་དོན་ཅི་ཡིན།"

msgid ""
"You may want to run a new version of an existing course, or replace an "
"existing course altogether. Or, you may have developed a course outside "
"{studio_name}."
msgstr ""
"ཁྱེད་རང་གིས་ད་ཡོད་ཀྱི་སློབ་ཚན་གྱི་ཐོན་རིམ་གསར་པ་ཞིག་བཀོལ་སྤྱོད་བྱེད་འདོད་ཡོད་སྲིད།"
" ཡང་ན་ཁྱེད་ཀྱིས་ {studio_name} ཕྱི་རོལ་དུ་སློབ་ཚན་ཞིག་བཟོས་ཡོད་སྲིད།"

msgid "What content is imported?"
msgstr "ནང་དོན་གང་ཞིག་ནང་འདྲེན་བྱས་འདུག"

msgid "The following content is imported."
msgstr "གཤམ་གྱི་ནང་དོན་ནང་འདྲེན་བྱས་ཡོད།"

msgid "The following content is not imported."
msgstr "གཤམ་གྱི་ནང་དོན་ནང་འདྲེན་བྱས་མེད།"

msgid "Warning: Importing while a course is running"
msgstr ""
"ཉེན་བརྡ། སློབ་ཚན་ཞིག་འགྲོ་བཞིན་པའི་སྐབས་སུ་འདི་ནང་འདྲེན་བྱེད་བཞིན་འདུག"

msgid ""
"If you perform an import while your course is running, and you change the "
"URL names (or url_name nodes) of any Problem components, the student data "
"associated with those Problem components may be lost. This data includes "
"students' problem scores."
msgstr ""
"གལ་ཏེ་ཁྱེད་ཀྱིས་སློབ་ཚན་འགྲོ་བཞིན་པའི་སྐབས་ནང་འདྲེན་བྱེད་པ་དང་ཁྱེད་ཀྱིས་དཀའ་ངལ་ཆ་ཤས་གང་རུང་གི་URLམིང་(ཡང་ན་url_name"
" nodes)བསྒྱུར་ན། "
"དཀའ་ངལ་ཆ་ཤས་དེ་དག་དང་འབྲེལ་བའི་སློབ་ཕྲུག་གི་གནས་སྡུད་དེ་བརླག་འགྲོ་སྲིད། "
"གཞི་གྲངས་འདིའི་ནང་སློབ་མའི་དཀའ་ངལ་གྱི་སྐར་གྲངས་ཚུད་ཡོད།"

msgid "Learn more about importing a course"
msgstr "སློབ་ཚན་ནང་འདྲེན་བྱེད་པའི་སྐོར་ལ་རྒྱུས་ལོན་བྱེད་པ།"

msgid "{studio_name} Home"
msgstr "{studio_name} །"

msgid "New Course"
msgstr "སློབ་ཚན་གསར་པ།"

msgid "Email staff to create course"
msgstr "སློབ་ཚན་བཟོ་ཆེད་ལས་བྱེད་ལ་གློག་འཕྲིན་གཏོང་བ།"

msgid "New Library"
msgstr "དཔེ་མཛོད་ཁང་གསར་པ།"

msgid "Please correct the highlighted fields below."
msgstr "གཤམ་དུ་འབུར་དུ་ཐོན་པའི་ས་ཁོངས་རྣམས་དག་བཅོས་གནང་རོགས།"

msgid "Create a New Course"
msgstr "སློབ་ཚན་གསར་པ་གསར་སྐྲུན་བྱེད་པ།"

msgid "Required Information to Create a New Course"
msgstr "སློབ་ཚན་གསར་བཟོ་བྱེད་པར་དགོས་མཁོའི་ཆ་འཕྲིན།"

msgid ""
"The public display name for your course. This cannot be changed, but you can"
" set a different display name in Advanced Settings later."
msgstr ""
"ཁྱེད་རང་གི་སློབ་ཚན་གྱི་སྤྱི་དམངས་འགྲེམས་སྟོན་མིང་། "
"འདི་བསྒྱུར་མི་ཐུབ་ཀྱང་ཁྱེད་ཀྱིས་རྗེས་སུ་ཡར་ཐོན་སྒྲིག་སྟངས་ནང་བཀྲམ་སྟོན་མིང་གཞན་ཞིག་སྒྲིག་ཆོག"

msgid ""
"The name of the organization sponsoring the course. {strong_start}Note: The "
"organization name is part of the course URL.{strong_end} This cannot be "
"changed, but you can set a different display name in Advanced Settings "
"later."
msgstr ""
"སློབ་ཚན་ལ་སྦྱིན་བདག་གནང་མཁན་གྱི་ཚོགས་པའི་མིང་། {strong_start} དྲན་ཐོ། "
"སྒྲིག་འཛུགས་ཀྱི་མིང་དེ་སློབ་ཚན་གྱི་ཁ་བྱང་གི་ཆ་ཤས་ཤིག་རེད། {strong_end} "
"འདི་བསྒྱུར་མི་ཐུབ་ཀྱང་རྗེས་སུ་ཁྱེད་ཀྱིས་ཡར་ཐོན་སྒྲིག་སྟངས་ནང་མངོན་མིང་མི་འདྲ་བ་སྒྲིག་ཆོག"

msgid ""
"The unique number that identifies your course within your organization. "
"{strong_start}Note: This is part of your course URL, so no spaces or special"
" characters are allowed and it cannot be changed.{strong_end}"
msgstr ""
"ཁྱེད་རང་གི་ཚོགས་པའི་ནང་དུ་ཁྱེད་རང་གི་སློབ་ཚན་ངོས་འཛིན་བྱེད་པའི་ཨང་གྲངས་ཁྱད་པར་ཅན་དེ་རེད།"
" {strong_start} དྲན་ཐོ། "
"འདི་ནི་ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་URLཡི་ཆ་ཤས་ཤིག་ཡིན་པས་བར་སྟོང་དང་དམིགས་བསལ་གྱི་ཡིག་འབྲུ་གང་ཡང་བཀོད་མི་ཆོག"
" དེ་བསྒྱུར་མི་ཐུབ། {strong_end}"

msgid ""
"The term in which your course will run. {strong_start}Note: This is part of "
"your course URL, so no spaces or special characters are allowed and it "
"cannot be changed.{strong_end}"
msgstr ""
"ཁྱེད་རང་གི་སློབ་ཚན་དེ་གང་དུ་སྤེལ་རྒྱུའི་དུས་ཡུན་དེ། {strong_start} དྲན་ཐོ། "
"འདི་ནི་ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་URLཡི་ཆ་ཤས་ཤིག་ཡིན་པས་བར་སྟོང་དང་དམིགས་བསལ་གྱི་ཡིག་འབྲུ་གང་ཡང་བཀོད་མི་ཆོག"
" དེ་བསྒྱུར་མི་ཐུབ། {strong_end}"

msgid "Create"
msgstr "བཟོ།"

msgid "Create a New Library"
msgstr "དཔེ་མཛོད་ཁང་གསར་པ་གསར་སྐྲུན་བྱེད་པ།"

msgid "Required Information to Create a New Library"
msgstr "དཔེ་མཛོད་ཁང་གསར་པ་གསར་འཛུགས་བྱེད་པར་དགོས་མཁོའི་ཆ་འཕྲིན།"

msgid "Library Name"
msgstr "དཔེ་མཛོད་ཁང་གི་མིང་།"

msgid "e.g. Computer Science Problems"
msgstr "དཔེར་ན། གློག་ཀླད་ཚན་རིག་གི་དཀའ་ངལ།"

msgid "The public display name for your library."
msgstr "ཁྱེད་ཀྱི་དཔེ་མཛོད་ཀྱི་སྤྱི་སྤྱོད་འགྲེམས་སྟོན་མིང་།"

msgid "The public organization name for your library."
msgstr "ཁྱེད་ཀྱི་དཔེ་མཛོད་ཁང་གི་སྤྱི་པའི་ཚོགས་པའི་མིང་།"

msgid "This cannot be changed."
msgstr "འདི་ལ་འགྱུར་བ་གཏོང་མི་ཐུབ།"

msgid "Library Code"
msgstr "དཔེ་མཛོད་ཁང་གི་ཨང་རྟགས།"

msgid "e.g. CSPROB"
msgstr "དཔེར་ན། CSPROB"

msgid ""
"The unique code that identifies this library. {strong_start}Note: This is "
"part of your library URL, so no spaces or special characters are "
"allowed.{strong_end} This cannot be changed."
msgstr ""
"དཔེ་མཛོད་འདི་ངོས་འཛིན་བྱེད་པའི་ཐུན་མོང་མ་ཡིན་པའི་ཨང་རྟགས། {strong_start} "
"དྲན་ཐོ། འདི་ནི་ཁྱེད་ཀྱི་དཔེ་མཛོད་URL "
"ཡི་ཆ་ཤས་ཤིག་ཡིན་པས་བར་སྟོང་དང་དམིགས་བསལ་གྱི་ཡིག་འབྲུ་གང་ཡང་བཀོད་མི་ཆོག "
"{strong_end} འདི་བསྒྱུར་མི་ཐུབ།"

msgid "Organization and Library Settings"
msgstr "སྒྲིག་འཛུགས་དང་དཔེ་མཛོད་ཁང་གི་སྒྲིག་སྟངས།"

msgid "Show all courses in organization:"
msgstr "རྩ་འཛུགས་ཀྱི་སློབ་ཚན་ཚང་མ་སྟོན།"

msgid "For example, MITx"
msgstr "དཔེར་ན་ MITx དང་།"

msgid "Courses Being Processed"
msgstr "སློབ་ཚན་ལས་སྣོན་བྱེད་བཞིན་པ།"

msgid "Organization:"
msgstr "སྒྲིག་འཛུགས་ཁག"

msgid "Course Number:"
msgstr "སློབ་ཚན་ཨང་།"

msgid "Course Run:"
msgstr "སློབ་ཚན་འགྲོ་བཞིན་པ།"

msgid "This course run is currently being created."
msgstr "སློབ་ཚན་འདི་ད་ལྟ་བཟོ་བཞིན་ཡོད།"

msgid "Configuring as re-run"
msgstr "ཡང་བསྐྱར་འཁོར་རྒྱུག་ལྟར་སྒྲིག་བཀོད་བྱེད་པ།"

msgid ""
"The new course will be added to your course list in 5-10 minutes. Return to "
"this page or {link_start}refresh it{link_end} to update the course list. The"
" new course will need some manual configuration."
msgstr ""
"སློབ་ཚན་གསར་པ་དེ་སྐར་མ་ ༥ ནས་ ༡༠ "
"ནང་ཁྱེད་ཀྱི་སློབ་ཚན་ཐོ་གཞུང་ནང་ཁ་སྣོན་བྱ་རྒྱུ་རེད། "
"ཤོག་ངོས་འདི་ལ་ལོག་པའམ་ཡང་ན་ {link_start} དེ་ {link_end} "
"བརྗེ་བྱས་ནས་སློབ་ཚན་གྱི་ཐོ་གཞུང་གསར་བརྗེ་བྱེད་དགོས། "
"སློབ་ཚན་གསར་པར་ལག་ཐོག་སྒྲིག་བཀོད་འགའ་ཤས་དགོས།"

msgid "This re-run processing status:"
msgstr "འདི་བསྐྱར་དུ་གཡོག་པའི་ལས་སྣོན་གནས་སྟངས།"

msgid "Configuration Error"
msgstr "སྒྲིག་བཀོད་ཀྱི་ནོར་འཁྲུལ།"

msgid ""
"A system error occurred while your course was being processed. Please go to "
"the original course to try the re-run again, or contact your PM for "
"assistance."
msgstr ""
"ཁྱེད་རང་གི་སློབ་ཚན་དེ་ལས་སྣོན་བྱེད་པའི་སྐབས་མ་ལག་གི་ནོར་འཁྲུལ་ཞིག་བྱུང་ཡོད། "
"བསྐྱར་དུ་སློབ་ཚན་ཐོག་མ་དེ་ལ་ཕེབས་ནས་རོགས་རམ་བྱེད་རོགས། "
"ཡང་ན་རོགས་རམ་ཆེད་ཁྱེད་རང་གི་སྲིད་བློན་ལ་འབྲེལ་བ་གནང་རོགས།"

msgid "Archived Courses"
msgstr "ཡིག་ཚགས་སུ་བཞག་པའི་སློབ་ཚན།"

msgid "Libraries"
msgstr "དཔེ་མཛོད་ཁང་།"

msgid "Taxonomies"
msgstr "རིགས་དབྱེ།"

msgid "Are you staff on an existing {studio_name} course?"
msgstr "ཁྱེད་རང་ད་ལྟའི་ {studio_name} སློབ་ཚན་གྱི་ལས་བྱེད་པ་ཡིན་ནམ།"

msgid ""
"The course creator must give you access to the course. Contact the course "
"creator or administrator for the course you are helping to author."
msgstr ""
"སློབ་ཚན་བཟོ་མཁན་གྱིས་ཁྱེད་ལ་སློབ་ཚན་ལ་འཛུལ་ཞུགས་སྤྲོད་དགོས། "
"ཁྱེད་ཀྱིས་རྩོམ་སྒྲིག་བྱེད་པར་རོགས་རམ་བྱེད་བཞིན་པའི་སློབ་ཚན་གྱི་སློབ་ཚན་བཟོ་མཁན་ཡང་ན་འཛིན་སྐྱོང་པར་འབྲེལ་བ་བྱོས།"

msgid "Create Your First Course"
msgstr "སློབ་ཚན་དང་པོ་བཟོས།"

msgid "Your new course is just a click away!"
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན་གསར་པ་དེ་སྣུན་ཐེངས་གཅིག་ལས་མེད།"

msgid "Becoming a Course Creator in {studio_name}"
msgstr "{studio_name} ནང་སློབ་ཚན་བཟོ་མཁན་ཞིག་ཏུ་འགྱུར་བ།"

msgid ""
"{studio_name} is a hosted solution for our xConsortium partners and selected"
" guests. Courses for which you are a team member appear above for you to "
"edit, while course creator privileges are granted by {platform_name}. Our "
"team will evaluate your request and provide you feedback within 24 hours "
"during the work week."
msgstr ""
"{studio_name} "
"ནི་ང་ཚོའི་xConsortiumམཉམ་ལས་རོགས་ཟླ་དང་འདེམས་སྒྲུག་བྱས་པའི་མགྲོན་པོ་ཚོའི་ཆེད་དུ་གཙོ་སྐྱོང་བྱེད་པའི་ཐབས་ཤེས་ཤིག་རེད།"
" "
"ཁྱེད་རང་རུ་ཁག་གི་ཚོགས་མི་ཡིན་པའི་སློབ་ཚན་དེ་ཚོ་ཁྱེད་རང་གིས་རྩོམ་སྒྲིག་བྱེད་པར་གོང་དུ་མངོན་ཡོད།"
" སློབ་ཚན་བཟོ་མཁན་གྱི་ཐོབ་ཐང་དེ་ {platform_name} གིས་སྤྲོད་ཀྱི་ཡོད། "
"ང་ཚོའི་རུ་ཁག་གིས་ཁྱེད་ཀྱི་རེ་འདུན་ལ་དཔྱད་ཞིབ་བྱས་ནས་ལས་ཀའི་བདུན་ཕྲག་ནང་ཆུ་ཚོད་"
" ༢༤ ནང་ཚུན་ཁྱེད་ལ་བསམ་འཆར་སྤྲོད་རྒྱུ་རེད།"

msgid "Your Course Creator Request Status:"
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན་བཟོ་མཁན་གྱི་འབོད་སྐུལ་གནས་ཚུལ།"

msgid "Request the Ability to Create Courses"
msgstr "སློབ་ཚན་བཟོ་བའི་ནུས་པ་རེ་ཞུ་བྱེད་པ།"

msgid "Your Course Creator Request Status"
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན་བཟོ་མཁན་གྱི་འབོད་སྐུལ་གནས་ཚུལ།"

msgid ""
"{studio_name} is a hosted solution for our xConsortium partners and selected"
" guests. Courses for which you are a team member appear above for you to "
"edit, while course creator privileges are granted by {platform_name}. Our "
"team is has completed evaluating your request."
msgstr ""
"{studio_name} "
"ནི་ང་ཚོའི་xConsortiumམཉམ་ལས་རོགས་ཟླ་དང་འདེམས་སྒྲུག་བྱས་པའི་མགྲོན་པོ་ཚོའི་ཆེད་དུ་གཙོ་སྐྱོང་བྱེད་པའི་ཐབས་ཤེས་ཤིག་རེད།"
" "
"ཁྱེད་རང་རུ་ཁག་གི་ཚོགས་མི་ཡིན་པའི་སློབ་ཚན་དེ་ཚོ་ཁྱེད་རང་གིས་རྩོམ་སྒྲིག་བྱེད་པར་གོང་དུ་མངོན་ཡོད།"
" སློབ་ཚན་བཟོ་མཁན་གྱི་ཐོབ་ཐང་དེ་ {platform_name} གིས་སྤྲོད་ཀྱི་ཡོད། "
"ང་ཚོའི་རུ་ཁག་གིས་ཁྱེད་ཀྱི་རེ་འདུན་ལ་དཔྱད་ཞིབ་མཇུག་སྒྲིལ་ཟིན།"

msgid "Your Course Creator request is:"
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན་བཟོ་མཁན་གྱི་རེ་འདུན་ནི།"

msgid ""
"Your request did not meet the criteria/guidelines specified by "
"{platform_name} Staff."
msgstr ""
"ཁྱེད་ཀྱི་རེ་འདུན་དེ་ {platform_name} "
"ལས་བྱེད་པས་གཏན་འབེབས་བྱས་པའི་ཚད་གཞི་དང་ལམ་སྟོན་ལ་མ་མཐུན་པ་རེད།"

msgid ""
"{studio_name} is a hosted solution for our xConsortium partners and selected"
" guests. Courses for which you are a team member appear above for you to "
"edit, while course creator privileges are granted by {platform_name}. Our "
"team is currently  evaluating your request."
msgstr ""
"{studio_name} "
"ནི་ང་ཚོའི་xConsortiumམཉམ་ལས་རོགས་ཟླ་དང་འདེམས་སྒྲུག་བྱས་པའི་མགྲོན་པོ་ཚོའི་ཆེད་དུ་གཙོ་སྐྱོང་བྱེད་པའི་ཐབས་ཤེས་ཤིག་རེད།"
" "
"ཁྱེད་རང་རུ་ཁག་གི་ཚོགས་མི་ཡིན་པའི་སློབ་ཚན་དེ་ཚོ་ཁྱེད་རང་གིས་རྩོམ་སྒྲིག་བྱེད་པར་གོང་དུ་མངོན་ཡོད།"
" སློབ་ཚན་བཟོ་མཁན་གྱི་ཐོབ་ཐང་དེ་ {platform_name} གིས་སྤྲོད་ཀྱི་ཡོད། "
"ང་ཚོའི་རུ་ཁག་གིས་ད་ལྟ་ཁྱེད་ཀྱི་རེ་འདུན་ལ་དཔྱད་ཞིབ་བྱེད་བཞིན་ཡོད།"

msgid ""
"Your request is currently being reviewed by {platform_name} staff and should"
" be updated shortly."
msgstr ""
"ཁྱེད་ཀྱི་རེ་འདུན་དེ་ད་ལྟ་ {platform_name} "
"ལས་བྱེད་པས་བསྐྱར་ཞིབ་བྱེད་བཞིན་ཡོད་པས་མགྱོགས་པོ་ཁ་སྐོང་བྱེད་དགོས།"

msgid "Were you expecting to see a particular library here?"
msgstr "ཁྱེད་རང་འདིར་དཔེ་མཛོད་ཁང་ཞིག་མཐོང་རྒྱུའི་རེ་བ་བྱེད་ཀྱི་ཡོད་དམ།"

msgid ""
"The library creator must give you access to the library. Contact the library"
" creator or administrator for the library you are helping to author."
msgstr ""
"དཔེ་མཛོད་བཟོ་མཁན་གྱིས་ཁྱེད་ལ་དཔེ་མཛོད་ཁང་ལ་འཛུལ་ཞུགས་སྤྲོད་དགོས། "
"ཁྱེད་ཀྱིས་རྩོམ་སྒྲིག་བྱེད་པར་རོགས་རམ་བྱེད་བཞིན་པའི་དཔེ་མཛོད་ཀྱི་དཔེ་མཛོད་བཟོ་མཁན་ཡང་ན་དོ་དམ་པར་འབྲེལ་བ་བྱོས།"

msgid "Create Your First Library"
msgstr "རང་གི་དཔེ་མཛོད་དང་པོ་བཟོས།"

msgid ""
"Libraries hold a pool of components that can be re-used across multiple "
"courses. Create your first library with the click of a button!"
msgstr ""
"དཔེ་མཛོད་ཁང་གིས་སློབ་ཚན་སྣ་ཚོགས་ནང་བསྐྱར་དུ་བེད་སྤྱོད་གཏོང་ཐུབ་པའི་ཆ་ཤས་མང་པོ་ཡོད།"
" ཁྱེད་རང་གི་དཔེ་མཛོད་ཐོག་མ་དེ་མཐེབ་གཅིག་གིས་བཟོས།"

msgid "New to {studio_name}?"
msgstr "{studio_name} ལ་གསར་པ་རེད་དམ།"

msgid ""
"Click Help in the upper-right corner to get more information about the "
"{studio_name} page you are viewing. You can also use the links at the bottom"
" of the page to access our continually updated documentation and other "
"{studio_name} resources."
msgstr ""
"ཁྱེད་ཀྱིས་ལྟ་བཞིན་པའི་ {studio_name} "
"ཤོག་ངོས་དེའི་སྐོར་གྱི་གནས་ཚུལ་མང་ཙམ་ཐོབ་ཆེད་གཡས་ཕྱོགས་སྟེང་ཟུར་དུ་རོགས་རམ་ལ་སྣུན་དགོས།"
" "
"ཁྱེད་ཀྱིས་ཤོག་ངོས་མཇུག་ཏུ་ཡོད་པའི་འབྲེལ་མཐུད་དེ་བེད་སྤྱད་ནས་ང་ཚོའི་མུ་མཐུད་དུ་ཁ་སྐོང་བྱེད་པའི་ཡིག་ཆ་དང་"
" {studio_name} ཐོན་ཁུངས་གཞན་དག་ལ་འཛུལ་ཐུབ།"

msgid "Getting Started with {studio_name}"
msgstr "{studio_name} དང་མཉམ་དུ་འགོ་འཛུགས།"

msgid "Can I create courses in {studio_name}?"
msgstr "ངས་ {studio_name} ནང་སློབ་ཚན་བཟོ་ཐུབ་བམ།"

msgid ""
"In order to create courses in {studio_name}, you must {link_start}contact "
"{platform_name} staff to help you create a course{link_end}."
msgstr ""
"{link_end} {studio_name} ནང་སློབ་ཚན་བཟོ་ཆེད་ཁྱེད་ཀྱིས་ {link_start} "
"ལས་བྱེད་པར་འབྲེལ་བ་བྱས་ནས་སློབ་ཚན་ {platform_name} "
"བཟོ་བར་རོགས་སྐྱོར་བྱེད་དགོས།"

msgid ""
"In order to create courses in {studio_name}, you must have course creator "
"privileges to create your own course."
msgstr ""
"{studio_name} ནང་སློབ་ཚན་བཟོ་ཆེད་ཁྱེད་ལ་སློབ་ཚན་བཟོ་མཁན་གྱི་ཐོབ་ཐང་ཡོད་དགོས།"

msgid ""
"Your request to author courses in {studio_name} has been denied. Please "
"{link_start}contact {platform_name} Staff with further questions{link_end}."
msgstr ""
"ཁྱེད་ཀྱི་ {studio_name} "
"ནང་སློབ་ཚན་རྩོམ་སྒྲིག་བྱེད་པའི་རེ་འདུན་དེ་ཁས་མ་བླངས་པ་རེད། དྲི་བ་གཞན་ཡོད་ན་ "
"{link_start} {platform_name} ལས་བྱེད་པར་འབྲེལ་བ་གནང་རོགས {link_end}"

msgid "Thanks for signing up, {name}!"
msgstr "མིང་ཐོ་བཀོད་པར་ཐུགས་རྗེ་ཆེ། {name} !"

msgid "We need to verify your email address"
msgstr "ང་ཚོས་ཁྱེད་ཀྱི་གློག་འཕྲིན་ཁ་བྱང་བདེན་དཔང་བྱེད་དགོས།"

msgid ""
"Almost there! In order to complete your sign up we need you to verify your "
"email address ({email}). An activation message and next steps should be "
"waiting for you there."
msgstr ""
"ཧ་ལམ་དེར་ཡོད། "
"ཁྱེད་རང་གི་ཐོ་འགོད་མཇུག་སྒྲིལ་ཆེད་ང་ཚོས་ཁྱེད་རང་གི་གློག་འཕྲིན་ཁ་བྱང་ ( "
"{email} ) བདེན་དཔང་བྱེད་དགོས། "
"ཤུགས་སྣོན་བརྡ་འཕྲིན་དང་གོམ་པ་རྗེས་མ་དེ་གར་ཁྱེད་ལ་སྒུག་དགོས།"

msgid "Need help?"
msgstr "རོགས་རམ་དགོས་སམ།"

msgid ""
"Please check your Junk or Spam folders in case our email isn't in your "
"INBOX. Still can't find the verification email? Request help via the link "
"below."
msgstr ""
"གལ་ཏེ་ང་ཚོའི་གློག་འཕྲིན་ཁྱེད་ཀྱི་INBOXནང་མེད་ན་ཁྱེད་ཀྱི་Runk "
"ཡང་ན་Spamསྣོད་ཐོ་ལ་ལྟ་ཞིབ་གནང་རོགས། ད་དུང་བདེན་དཔང་གློག་འཕྲིན་རྙེད་མ་སོང་ངམ།"
" གཤམ་གྱི་དྲ་ཐག་བརྒྱུད་ནས་རོགས་རམ་རེ་འདུན་ཞུ།"

msgid "Content Library"
msgstr "ནང་དོན་དཔེ་མཛོད་ཁང་།"

msgid "Add Component"
msgstr "ཆ་ཤས་ཁ་སྣོན་བྱེད་པ།"

msgid "Adding content to your library"
msgstr "རང་གི་དཔེ་མཛོད་ལ་ནང་དོན་ཁ་སྣོན་བྱེད་པ།"

msgid ""
"Add components to your library for use in courses, using Add New Component "
"at the bottom of this page."
msgstr ""
"སློབ་ཚན་ནང་བེད་སྤྱོད་ཆེད་དུ་ཁྱེད་ཀྱི་དཔེ་མཛོད་ལ་ཆ་ཤས་ཁ་སྣོན་བྱེད་ "
"ཤོག་ངོས་འདིའི་མཇུག་ཏུ་ཆ་ཤས་གསར་པ་ཁ་སྣོན་བྱེད་ བེད་སྤྱོད་བྱེད།"

msgid ""
"Components are listed in the order in which they are added, with the most "
"recently added at the bottom. Use the pagination arrows to navigate from "
"page to page if you have more than one page of components in your library."
msgstr ""
"ཆ་ཤས་རྣམས་ཁ་སྣོན་བྱེད་པའི་གོ་རིམ་ལྟར་ཐོ་འགོད་བྱས་ཡོད་ཅིང་། "
"ཉེ་ཆར་ཁ་སྣོན་བྱས་པ་དེ་མཇུག་ཏུ་ཡོད། "
"ཁྱེད་རང་གི་དཔེ་མཛོད་ནང་ཆ་ཤས་ཤོག་ངོས་གཅིག་ལས་མང་བ་ཡོད་ན་ཤོག་ངོས་ནས་ཤོག་ངོས་གཞན་ཞིག་ལ་འགྲོ་བསྐྱོད་བྱེད་པར་ཤོག་ངོས་བཟོ་བའི་མདའ་རྟགས་བེད་སྤྱོད་བྱེད།"

msgid "Using library content in courses"
msgstr "སློབ་ཚན་ནང་དཔེ་མཛོད་ཀྱི་ནང་དོན་བཀོལ་སྤྱོད་བྱེད་པ།"

msgid ""
"Use library content in courses by adding the "
"{em_start}library_content{em_end} policy key to the Advanced Module List in "
"the course's Advanced Settings, then adding a Randomized Content Block to "
"your courseware. In the settings for each Randomized Content Block, select "
"this library as the source library, and specify the number of problems to be"
" randomly selected and displayed to each student."
msgstr ""
"སློབ་ཚན་གྱི་ཡར་ཐོན་སྒྲིག་སྟངས་ནང་ {em_start} library_content {em_end} "
"སྲིད་ཇུས་ལྡེ་མིག་ཁ་སྣོན་བྱས་ནས་སློབ་ཚན་གྱི་ནང་དོན་བཀོལ་སྤྱོད་བྱེད་དགོས། "
"གང་བྱུང་ནང་དོན་བཀག་སྡོམ་རེ་རེའི་སྒྲིག་སྟངས་ནང་དཔེ་མཛོད་འདི་འབྱུང་ཁུངས་དཔེ་མཛོད་དུ་འདེམས་ནས་སློབ་མ་རེ་རེར་གང་བྱུང་འདེམས་སྒྲུག་དང་བཀྲམ་སྟོན་བྱེད་པའི་དཀའ་ངལ་གྱི་གྲངས་གསལ་བཀོད་བྱེད།"

msgid "Learn more about content libraries"
msgstr "ནང་དོན་དཔེ་མཛོད་ཀྱི་སྐོར་ལ་རྒྱུས་ལོན་བྱེད་པ།"

msgid "Course Team Settings"
msgstr "སློབ་ཚན་སྡེ་ཚན་སྒྲིག་སྟངས།"

msgid "New Team Member"
msgstr "རུ་ཁག་གསར་པ།"

msgid "Add a User to Your Course's Team"
msgstr "སློབ་ཚན་གྱི་རུ་ཁག་ལ་སྤྱོད་མཁན་ཁ་སྣོན་བྱེད་པ།"

msgid "New Team Member Information"
msgstr "རུ་ཁག་གསར་པའི་ཚོགས་མིའི་ཆ་འཕྲིན།"

msgid "User's Email Address"
msgstr "སྤྱོད་མཁན་གྱི་གློག་འཕྲིན་ཁ་བྱང་།"

msgid "example: username@domain.com"
msgstr "དཔེ་མཚོན།: username@domain.com"

msgid "Provide the email address of the user you want to add as Staff"
msgstr ""
"ཁྱེད་ཀྱིས་ལས་བྱེད་དུ་ཁ་སྣོན་བྱེད་འདོད་པའི་སྤྱོད་མཁན་གྱི་གློག་འཕྲིན་ཁ་བྱང་སྤྲོད་དགོས།"

msgid "Add User"
msgstr "སྤྱོད་མཁན་ཁ་སྣོན་བྱེད་པ།"

msgid "Add Team Members to This Course"
msgstr "སློབ་ཚན་འདིར་རུ་ཁག་གི་ཁོངས་མི་ཁ་སྣོན་བྱེད་པ།"

msgid ""
"Adding team members makes course authoring collaborative. Users must be "
"signed up for {studio_name} and have an active account."
msgstr ""
"རུ་ཁག་གི་ཚོགས་མི་ཁ་སྣོན་བྱེད་པ་དེས་སློབ་ཚན་རྩོམ་སྒྲིག་མཉམ་ལས་བྱེད་ཐུབ། "
"སྤྱོད་མཁན་ཚོས་ {studio_name} "
"ཐོག་མིང་ཐོ་འགོད་དགོས་པ་དང་ཁ་བྱང་ཤུགས་ལྡན་ཞིག་དགོས།"

msgid "Add a New Team Member"
msgstr "ཚོགས་མི་གསར་པ་ཁ་སྣོན་བྱེད་པ།"

msgid "Course Team Roles"
msgstr "སློབ་ཚན་སྡེ་ཚན་གྱི་ལས་འགན།"

msgid ""
"Course team members with the Staff role are course co-authors. They have "
"full writing and editing privileges on all course content."
msgstr ""
"ལས་བྱེད་པའི་འགན་འཁུར་བའི་སློབ་ཚན་གྱི་རུ་ཁག་གི་ཚོགས་མི་རྣམས་སློབ་ཚན་གྱི་རྩོམ་སྒྲིག་མཉམ་འབྲེལ་པ་ཡིན།"
" "
"ཁོང་ཚོར་སློབ་ཚན་གྱི་ནང་དོན་ཚང་མར་རྩོམ་སྒྲིག་དང་རྩོམ་སྒྲིག་བྱེད་པའི་ཐོབ་ཐང་ཆ་ཚང་ཡོད།"

msgid ""
"Admins are course team members who can add and remove other course team "
"members."
msgstr ""
"འཛིན་སྐྱོང་པ་ནི་སློབ་ཚན་གྱི་རུ་ཁག་གི་ཚོགས་མི་ཡིན་ཞིང་། "
"ཁོང་ཚོས་སློབ་ཚན་གྱི་རུ་ཁག་གི་ཚོགས་མི་གཞན་པ་ཁ་སྣོན་དང་མེད་པར་བཟོ་ཐུབ།"

msgid ""
"All course team members can access content in Studio, the LMS, and Insights,"
" and they are automatically enrolled in the course."
msgstr ""
"སློབ་ཚན་གྱི་རུ་ཁག་གི་ཚོགས་མི་ཚང་མས་སྒྲིག་ཆས་དང་། LMS "
"དེ་བཞིན་ཤེས་རྟོགས་བཅས་ཀྱི་ནང་དོན་ལ་ལྟ་ཐུབ་པ་དང་། "
"ཁོང་ཚོ་རང་འགུལ་གྱིས་སློབ་ཚན་ནང་ཐོ་འགོད་བྱེད་ཀྱི་ཡོད།"

msgid "Transferring Ownership"
msgstr "བདག་དབང་སྤོ་སྒྱུར།"

msgid ""
"Every course must have an Admin. If you are the Admin and you want to "
"transfer ownership of the course, click <strong>Add admin access</strong> to"
" make another user the Admin, then ask that user to remove you from the "
"Course Team list."
msgstr ""
"སློབ་ཚན་ཚང་མར་ Admin ཡོད་དགོས། "
"གལ་ཏེ་ཁྱེད་རང་འཛིན་སྐྱོང་པ་ཡིན་པ་དང་སློབ་ཚན་གྱི་བདག་དབང་སྤྲོད་འདོད་ཡོད་ན། "
"<strong>འཛིན་སྐྱོང་པའི་ཐོབ་ཐང་ཁ་སྣོན་བྱེད་པར་</strong> "
"སྣུན་ནས་སྤྱོད་མཁན་གཞན་ཞིག་ལ་འཛིན་སྐྱོང་པ་བཟོ་དགོས། "
"དེ་ནས་སྤྱོད་མཁན་དེ་ལ་སློབ་ཚན་གྱི་རུ་ཁག་གི་ཐོ་གཞུང་ནས་ཁྱེད་རང་མེད་པར་བཟོ་དགོས།"

msgid "Library User Access"
msgstr "དཔེ་མཛོད་ཁང་སྤྱོད་མཁན་གྱི་ཐོབ་ཐང་།"

msgid "User Access"
msgstr "སྤྱོད་མཁན་གྱི་ཐོབ་ཐང་།"

msgid "Grant Access to This Library"
msgstr "དཔེ་མཛོད་ཁང་འདི་ལ་འཛུལ་ཞུགས་ཆོག་མཆན།"

msgid "Provide the email address of the user you want to add"
msgstr "ཁ་སྣོན་བྱེད་འདོད་པའི་སྤྱོད་མཁན་གྱི་གློག་འཕྲིན་ཁ་བྱང་སྤྲོད་པ།"

msgid "Add More Users to This Library"
msgstr "དཔེ་མཛོད་འདིར་སྤྱོད་མཁན་མང་བ་ཁ་སྣོན་བྱེད་པ།"

msgid ""
"Grant other members of your course team access to this library. New library "
"users must have an active {studio_name} account."
msgstr ""
"ཁྱེད་རང་གི་སློབ་ཚན་རུ་ཁག་གི་ཚོགས་མི་གཞན་དག་ལ་དཔེ་མཛོད་འདིར་འཛུལ་ཆོག་པའི་དབང་ཆ་སྤྲོད་དགོས།"
" དཔེ་མཛོད་སྤྱོད་མཁན་གསར་པར་ {studio_name} རྩིས་ཁྲ་ཤུགས་ལྡན་ཡོད་དགོས།"

msgid "Add a New User"
msgstr "སྤྱོད་མཁན་གསར་པ་ཁ་སྣོན་བྱེད་པ།"

msgid "Library Access Roles"
msgstr "དཔེ་མཛོད་ཁང་དུ་འཛུལ་ཞུགས་ཀྱི་ལས་འགན།"

msgid "There are three access roles for libraries: User, Staff, and Admin."
msgstr ""
"དཔེ་མཛོད་ཁང་ལ་འཛུལ་སྤྱོད་ཀྱི་ལས་འགན་གསུམ་ཡོད་དེ། སྤྱོད་མཁན་དང་། ལས་བྱེད་པ། "
"འཛིན་སྐྱོང་པ།"

msgid ""
"Library Users can view library content and can reference or use library "
"components in their courses, but they cannot edit the contents of a library."
msgstr ""
"དཔེ་མཛོད་སྤྱོད་མཁན་གྱིས་དཔེ་མཛོད་ཀྱི་ནང་དོན་ལྟ་ཐུབ་པ་དང་སློབ་ཚན་ནང་དཔེ་མཛོད་ཀྱི་ཆ་ཤས་ལ་གཞི་བཅོལ་བའམ་ཡང་ན་བེད་སྤྱོད་གཏོང་ཐུབ།"
" འོན་ཀྱང་ཁོང་ཚོས་དཔེ་མཛོད་ཀྱི་ནང་དོན་རྩོམ་སྒྲིག་བྱེད་མི་ཐུབ།"

msgid ""
"Library Staff are content co-authors. They have full editing privileges on "
"the contents of a library."
msgstr ""
"དཔེ་མཛོད་ཁང་གི་ལས་བྱེད་པ་ནི་ནང་དོན་གྱི་རྩོམ་སྒྲིག་མཉམ་འབྲེལ་པ་ཡིན། "
"ཁོང་ཚོར་དཔེ་མཛོད་ཀྱི་ནང་དོན་རྩོམ་སྒྲིག་བྱེད་པའི་ཐོབ་ཐང་ཆ་ཚང་ཡོད།"

msgid ""
"Library Admins have full editing privileges and can also add and remove "
"other team members. There must be at least one user with the Admin role in a"
" library."
msgstr ""
"དཔེ་མཛོད་འཛིན་སྐྱོང་པར་རྩོམ་སྒྲིག་བྱེད་པའི་ཐོབ་ཐང་ཆ་ཚང་ཡོད་པ་དང་། "
"རུ་ཁག་གི་ཚོགས་མི་གཞན་པ་ཁ་སྣོན་དང་མེད་པར་བཟོ་ཐུབ། "
"དཔེ་མཛོད་ཁང་ཞིག་གི་ནང་དུ་འཛིན་སྐྱོང་འགན་འཁུར་བའི་སྤྱོད་མཁན་ཉུང་མཐར་ཡང་གཅིག་དགོས།"

msgid "Schedule & Details Settings"
msgstr "དུས་ཚོད་དང་ཞིབ་ཕྲའི་སྒྲིག་སྟངས།"

msgid "Schedule & Details"
msgstr "དུས་ཚོད་དང་ཞིབ་ཕྲ།"

msgid "Basic Information"
msgstr "གཞི་རྩའི་གནས་ཚུལ།"

msgid "The nuts and bolts of your course"
msgstr "རང་གི་སློབ་ཚན་གྱི་སྲིན་བུ་དང་།"

msgid "This field is disabled: this information cannot be changed."
msgstr "ས་ཁོངས་འདི་ལྕོགས་མིན་འདུག ཆ་འཕྲིན་འདི་བསྒྱུར་མི་ཐུབ།"

msgid "Course Summary Page"
msgstr "སློབ་ཚན་ཕྱོགས་བསྡུས་ཤོག་ངོས།"

msgid "(for student enrollment and access)"
msgstr "（སློབ་མ་བསྡུ་ལེན་དང་འཛུལ་ཞུགས་ཆེད་དུ།"

msgid "Enroll in {course_display_name}"
msgstr "{course_display_name} ནང་ཐོ་འགོད་བྱས།"

msgid ""
"The course \"{course_display_name}\", provided by {platform_name}, is open "
"for enrollment. Please navigate to this course at {link_for_about_page} to "
"enroll."
msgstr ""
"སློབ་ཚན་&quot; {course_display_name} &quot; དེ་ {platform_name} "
"གིས་མཁོ་སྤྲོད་བྱས་པ་དང་། སློབ་ཚན་འདི་ {link_for_about_page} "
"ལ་འགྲོ་ནས་ཐོ་འགོད་བྱེད་རོགས།"

msgid "Send a note to students via email"
msgstr "གློག་འཕྲིན་བརྒྱུད་ནས་སློབ་ཕྲུག་ཚོར་ཟིན་ཐོ་ཞིག་བསྐུར།"

msgid "Invite your students"
msgstr "སློབ་མ་གདན་འདྲེན་ཞུས།"

msgid "Promoting Your Course with {platform_name}"
msgstr "{platform_name} དང་མཉམ་དུ་སློབ་ཚན་ཁྱབ་སྤེལ་བྱེད་པ།"

msgid ""
"Your course summary page will not be viewable until your course has been "
"announced. To provide content for the page and preview it, follow the "
"instructions provided by your Program Manager."
msgstr ""
"ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་ཕྱོགས་བསྡུས་ཤོག་ངོས་དེ་ཁྱེད་ཀྱི་སློབ་ཚན་ཁྱབ་བསྒྲགས་མ་བྱས་བར་དུ་ལྟ་ཐུབ་ཀྱི་མ་རེད།"
" "
"ཤོག་ངོས་ཀྱི་ནང་དོན་མཁོ་སྤྲོད་དང་སྔོན་ལྟ་བྱེད་པར་ཁྱེད་རང་གི་ལས་རིམ་འགན་འཛིན་གྱིས་སྤྲད་པའི་བཀའ་སློབ་ལྟར་བྱེད་དགོས།"

msgid ""
"Please note that changes here may take up to a business day to appear on "
"your course summary page."
msgstr ""
"ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་སྙིང་བསྡུས་ཤོག་ངོས་སྟེང་ལ་འགྱུར་བ་གཏོང་བར་ཚོང་ལས་ཉིན་གཅིག་འགོར་རྒྱུ་ཡིན་པ་དྲན་དགོས།"

msgid "Course Credit Requirements"
msgstr "སློབ་ཚན་གྱི་སྐར་གྲངས་ཆ་རྐྱེན།"

msgid "Steps required to earn course credit"
msgstr "སློབ་ཚན་གྱི་བུ་ལོན་ལེན་པར་དགོས་པའི་གོམ་སྟབས།"

msgid "Minimum Grade"
msgstr "མ་མཐའི་འཛིན་གྲྭ།"

msgid "Successful Proctored Exam"
msgstr "Proctored ཡིག་རྒྱུགས་ལམ་ལྷོང་བྱུང་བ།"

msgid "Proctored Exam {number}"
msgstr "བརྟག་དཔྱད་ཡིག་རྒྱུགས་ {number}"

msgid "ID Verification"
msgstr "ཐོབ་ཐང་བདེན་དཔང་།"

msgid "In-Course Reverification {number}"
msgstr "སློབ་ཚན་ནང་བསྐྱར་ཞིབ {number}"

msgid "Course Pacing"
msgstr "སློབ་ཚན་གྱི་གོམ་སྟབས།"

msgid "Set the pacing for this course"
msgstr "སློབ་ཚན་འདིའི་གོམ་སྟབས་སྒྲིག་པ།"

msgid "Instructor-Paced"
msgstr "སློབ་སྟོན་པས་འགྲོས་མཐུན།"

msgid ""
"Instructor-paced courses progress at the pace that the course author sets. "
"You can configure release dates for course content and due dates for "
"assignments."
msgstr ""
"སློབ་སྟོན་པས་བཀོད་སྒྲིག་བྱས་པའི་སློབ་ཚན་དེ་སློབ་ཚན་རྩོམ་པ་པོས་བཀོད་སྒྲིག་བྱས་པའི་མགྱོགས་ཚད་ལྟར་འཕེལ་རྒྱས་འགྲོ་གི་ཡོད།"
" "
"ཁྱེད་ཀྱིས་སློབ་ཚན་གྱི་ནང་དོན་དང་ལས་འགན་གྱི་དུས་ཚོད་ལ་འགྲེམ་སྤེལ་ཚེས་གྲངས་སྒྲིག་བཀོད་བྱེད་ཐུབ།"

msgid "Self-Paced"
msgstr "རང་འགུལ་ངང་།"

msgid ""
"Self-paced courses offer suggested due dates for assignments or exams based "
"on the learner’s enrollment date and the expected course duration. These "
"courses offer learners flexibility to modify the assignment dates as needed."
msgstr ""
"རང་འགུལ་གྱི་སློབ་ཚན་གྱིས་སློབ་མའི་ཐོ་འགོད་ཚེས་གྲངས་དང་སློབ་ཚན་གྱི་དུས་ཡུན་ཚོད་དཔག་ལ་གཞི་བཅོལ་ནས་ལས་འགན་དང་ཡིག་རྒྱུགས་ཀྱི་དུས་ཚོད་བསམ་འཆར་སྤྲོད་ཀྱི་ཡོད།"
" "
"སློབ་ཚན་འདི་དག་གིས་སློབ་ཕྲུག་ཚོར་དགོས་མཁོ་ལྟར་ལས་འགན་གྱི་ཚེས་གྲངས་བསྒྱུར་བཅོས་གཏོང་བའི་མཉེན་ཆས་སྤྲོད་ཀྱི་ཡོད།"

msgid "Course Schedule"
msgstr "སློབ་ཚན་དུས་རིམ།"

msgid "Dates that control when your course can be viewed"
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན་ག་དུས་བལྟ་ཐུབ་མིན་ཚོད་འཛིན་བྱེད་པའི་ཚེས་གྲངས།"

msgid "First day the course begins"
msgstr "སློབ་ཚན་འགོ་ཚུགས་པའི་ཉིན་དང་པོ།"

msgid "Course Start Time"
msgstr "སློབ་ཚན་འགོ་འཛུགས་དུས་ཚོད།"

msgid "(UTC)"
msgstr "(UTC)"

msgid "Last day your course is active"
msgstr "ཉིན་མཐའ་མ་ཁྱེད་ཀྱི་སློབ་ཚན་དེ་འགུལ་སྐྱོད་ལྡན་པ།"

msgid "Course End Time"
msgstr "སློབ་ཚན་མཇུག་སྒྲིལ་བའི་དུས་ཚོད།"

msgid "Immediately upon passing"
msgstr "དེ་མ་ཐག་འདས་སྐབས།"

msgid "End date of course"
msgstr "སློབ་ཚན་མཇུག་སྒྲིལ་བའི་དུས་ཚོད།"

msgid "A date after the course end date"
msgstr "སློབ་ཚན་མཇུག་སྒྲིལ་བའི་རྗེས་ཀྱི་ཚེས་གྲངས།"

msgid "Certificates are awarded at the end of a course run"
msgstr "སློབ་ཚན་མཇུག་སྒྲིལ་རྗེས་ལག་འཁྱེར་སྤྲོད་ཀྱི་ཡོད།"

msgid "Read more about this setting"
msgstr "སྒྲིག་སྟངས་འདིའི་སྐོར་ལ་མང་ཙམ་ཀློག་རོགས།"

msgid ""
"In all configurations of this setting, certificates are generated for "
"learners as soon as they achieve the passing threshold in the course (which "
"can occur before a final assignment based on course design)"
msgstr ""
"སྒྲིག་བཀོད་འདིའི་སྒྲིག་བཀོད་ཚང་མའི་ནང་། "
"སློབ་མ་ཚོས་སློབ་ཚན་ནང་རྒྱུགས་ཚད་ལ་སླེབས་མ་ཐག་ལག་ཁྱེར་བཟོས་པ་རེད།"

msgid ""
"Learners can access their certificate as soon as they achieve a passing "
"grade above the course grade threshold. Note: learners can achieve a passing"
" grade before encountering all assignments in some course configurations."
msgstr ""
"སློབ་མ་ཚོས་སློབ་ཚན་གྱི་ཚད་གཞི་ལས་མཐོ་བའི་གྲུབ་འབྲས་ཐོབ་རྗེས་ལག་འཁྱེར་ཐོབ་ཐུབ།"
" དྲན་ཐོ། "
"སློབ་མ་ཚོས་སློབ་ཚན་གྱི་སྒྲིག་བཀོད་ཁ་ཤས་ནང་ལས་འགན་ཚང་མ་མ་འཕྲད་གོང་ལ་རྒྱུགས་འཕྲོད་པའི་གྲུབ་འབྲས་ཐོབ་ཐུབ།"

msgid "On course end date"
msgstr "སློབ་ཚན་མཇུག་སྒྲིལ་བའི་ཉིན་མོར།"

msgid ""
"Learners with passing grades can access their certificate once the end date "
"of the course has elapsed."
msgstr ""
"སློབ་ཚན་མཇུག་སྒྲིལ་བའི་དུས་ཚོད་རྫོགས་རྗེས་གྲུབ་འབྲས་ཐོབ་པའི་སློབ་མ་ཚོས་ལག་འཁྱེར་ཐོབ་ཐུབ།"

msgid ""
"Learners with passing grades can access their certificate after the date "
"that you set has elapsed."
msgstr ""
"ཁྱེད་ཀྱིས་གཏན་འཁེལ་བྱས་པའི་ཚེས་གྲངས་འདས་རྗེས་གྲུབ་འབྲས་ཐོབ་པའི་སློབ་མ་ཚོས་ཁོང་ཚོའི་ལག་ཁྱེར་ལ་འཛུལ་ཐུབ།"

msgid "Certificates Available Date"
msgstr "ལག་འཁྱེར་ཐོབ་པའི་ཚེས་གྲངས།"

msgid "Enrollment Start Date"
msgstr "སློབ་ཞུགས་འགོ་ཚུགས་པའི་དུས་ཚོད།"

msgid "First day students can enroll"
msgstr "ཉིན་དང་པོའི་སློབ་མས་སློབ་ཞུགས་བྱེད་ཆོག"

msgid "Enrollment Start Time"
msgstr "སློབ་ཞུགས་འགོ་ཚུགས་པའི་དུས་ཚོད།"

msgid "Enrollment End Date"
msgstr "སློབ་ཞུགས་མཇུག་སྒྲིལ་བའི་དུས་ཚོད།"

msgid "Last day students can enroll."
msgstr "ཉིན་མཐའ་མའི་སློབ་མས་ཐོ་འགོད་བྱེད་ཆོག"

msgid "Contact your {platform_name} partner manager to update these settings."
msgstr ""
"ཁྱེད་རང་གི་ {platform_name} "
"མཉམ་ལས་འགན་འཛིན་ལ་འབྲེལ་བ་བྱས་ནས་སྒྲིག་སྟངས་འདི་དག་གསར་བརྗེ་བྱེད་དགོས།"

msgid "Enrollment End Time"
msgstr "སློབ་བསྡུའི་དུས་ཚོད།"

msgid "Upgrade Deadline Date"
msgstr "རིམ་སྤོར་དུས་ཚོད།"

msgid "Last day students can upgrade to a verified enrollment."
msgstr "ཉིན་མཐའ་མའི་སློབ་མ་ཚོས་བདེན་དཔང་བྱས་པའི་ཐོ་འགོད་ལ་རིམ་སྤོར་བྱེད་ཐུབ།"

msgid "Upgrade Deadline Time"
msgstr "རིམ་སྤོར་དུས་བཀག་དུས་ཚོད།"

msgid "Course Details"
msgstr "སློབ་ཚན་ཞིབ་ཕྲ།"

msgid "Provide useful information about your course"
msgstr "རང་གི་སློབ་ཚན་སྐོར་གྱི་ཕན་ནུས་ལྡན་པའི་ཆ་འཕྲིན་མཁོ་འདོན་བྱེད་པ།"

msgid ""
"Identify the course language here. This is used to assist users find courses"
" that are taught in a specific language. It is also used to localize the "
"'From:' field in bulk emails."
msgstr ""
"འདིར་སློབ་ཚན་གྱི་སྐད་ཡིག་ངོས་འཛིན། "
"འདི་ནི་སྤྱོད་མཁན་ཚོར་སྐད་ཡིག་ངེས་ཅན་ཞིག་གི་ནང་སློབ་ཁྲིད་བྱེད་པའི་སློབ་ཚན་འཚོལ་བར་རོགས་རམ་བྱེད་པར་བེད་སྤྱོད་བྱེད་ཀྱི་ཡོད།"
" དེ་ཡང་གློག་འཕྲིན་མང་པོའི་ནང་ &#39;From:&#39; "
"ཡིག་དུམ་དེ་ས་གནས་ཅན་དུ་བསྒྱུར་བར་ཡང་བེད་སྤྱོད་བྱེད་ཀྱི་ཡོད།"

msgid "Introducing Your Course"
msgstr "སློབ་ཚན་ངོ་སྤྲོད།"

msgid "Information for prospective students"
msgstr "འབྱུང་འགྱུར་སློབ་མའི་ཆ་འཕྲིན།"

msgid "Course Title"
msgstr "སློབ་ཚན་གྱི་ཁ་བྱང་།"

msgid "Displayed as title on the course details page. Limit to 50 characters."
msgstr ""
"སློབ་ཚན་གྱི་ཞིབ་ཕྲའི་ཤོག་ངོས་སྟེང་ཁ་བྱང་ལྟར་མངོན་ཡོད། "
"ཡིག་འབྲུ་50ལ་ཚད་བཀག་བྱེད།"

msgid "Course Subtitle"
msgstr "སློབ་ཚན་གྱི་ཁ་བྱང་།"

msgid ""
"Displayed as subtitle on the course details page. Limit to 150 characters."
msgstr ""
"སློབ་ཚན་གྱི་ཞིབ་ཕྲའི་ཤོག་ངོས་སྟེང་དུ་མགོ་བརྗོད་འོག་མ་ལྟར་མངོན་ཡོད། "
"ཡིག་འབྲུ་150ལ་ཚད་བཀག་བྱེད།"

msgid "Course Duration"
msgstr "སློབ་ཚན་དུས་ཡུན།"

msgid "Displayed on the course details page. Limit to 50 characters."
