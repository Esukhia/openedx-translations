msgid ""
"Unable to commit changes. This is usually because there are no changes to be"
" committed"
msgstr ""
"བསྒྱུར་བཅོས་འབུལ་སྤྲོད་བྱེད་མི་ཐུབ། འདི་ནི་རྒྱུན་ལྡན་ཞིག་རེད། "
"རྒྱུ་མཚན་འབུལ་སྤྲོད་བྱ་རྒྱུའི་བསྒྱུར་བཅོས་གང་ཡང་མི་འདུག"

#: cms/djangoapps/contentstore/git_export_utils.py:50
msgid ""
"Unable to push changes.  This is usually because the remote repository "
"cannot be contacted"
msgstr ""
"བསྒྱུར་བཅོས་འབུལ་སྤྲོད་བྱེད་མི་ཐུབ། འདི་ནི་རྒྱུན་ལྡན་ཞིག་རེད། "
"རྒྱུ་མཚན་འབུལ་སྤྲོད་བྱ་སའི་འབྲེལ་མཐུད་ཡིག་མཛོད་དེར་མཐུད་ཐུབ་ཀྱི་མི་འདུག"

