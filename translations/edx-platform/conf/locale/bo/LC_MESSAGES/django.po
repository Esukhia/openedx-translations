"སློབ་མ་རྣམས་ཀྱིས་སློབ་ཚན་གསར་པ་འདེམས་པའི་ཆེད་དུ་ཤོག་ངོས་སྐོར་བེད་སྤྱོད་བྱེད་ཀྱི་ཡོད།"

msgid ""
"You will be unable to make changes until the errors are resolved. To update "
"these settings go to the {link_start}Proctored Exam Settings page{link_end}."
msgstr ""
"ནོར་འཁྲུལ་དེ་དག་སེལ་མ་ཐུབ་བར་དུ་བསྒྱུར་བཅོས་གཏོང་མི་ཐུབ། "
"སྒྲིག་སྟངས་འདི་དག་གསར་བརྗེ་བྱེད་པར་ {link_start} "
"ལྟ་རྟོག་ཡིག་རྒྱུགས་སྒྲིག་སྟངས་ཤོག་ངོས་ {link_end} ལ་འགྲོ།"

msgid ""
"You will be unable to make changes until the following settings are updated "
"on the page below."
msgstr ""
"གཤམ་གྱི་ཤོག་ངོས་སྟེང་དུ་གཤམ་གྱི་སྒྲིག་སྟངས་གསར་བཅོས་མ་བྱས་བར་དུ་ཁྱེད་ཀྱིས་བསྒྱུར་བཅོས་གཏོང་མི་ཐུབ།"

msgid "Your policy changes have been saved."
msgstr "ཁྱེད་ཀྱི་གསང་རྒྱའི་སྲིད་བྱུས་བསྒྱུར་བཅོས་བྱས་པ་རྣམས་ཉར་ཚགས་བྱས་ཡོད།"

msgid "There was an error saving your information. Please see below."
msgstr ""
"ཁྱེད་ཀྱི་ཆ་འཕྲིན་ཉར་ཚགས་བྱེད་སྐབས་ནོར་འཁྲུལ་བྱུང་ཡོད། གཤམ་དུ་གཟིགས་རོགས།"

msgid "Manual Policy Definition"
msgstr "ལག་ཐོག་སྲིད་ཇུས་ངེས་ཚིག།"

msgid ""
"{strong_start}Warning{strong_end}: Do not modify these policies unless you "
"are familiar with their purpose."
msgstr ""
"{strong_start} ཉེན་བརྡ་ {strong_end} : "
"ཁྱེད་ཀྱིས་དེའི་དམིགས་ཡུལ་ལ་རྒྱུས་མངའ་མེད་ན་སྲིད་ཇུས་འདི་དག་བསྒྱུར་བཅོས་མ་བྱེད།"

msgid "Show Deprecated Settings"
msgstr "བེད་སྤྱོད་མེད་པའི་སྒྲིག་སྟངས་སྟོན།"

msgid "What do advanced settings do?"
msgstr "ཡར་ཐོན་ཅན་གྱི་སྒྲིག་སྟངས་ཀྱིས་ཅི་ཞིག་བྱེད་ཀྱི་ཡོད་དམ།"

msgid ""
"Advanced settings control specific course functionality. On this page, you "
"can edit manual policies, which are JSON-based key and value pairs that "
"control specific course settings."
msgstr ""
"ཡར་ཐོན་ཅན་གྱི་སྒྲིག་བཀོད་ཀྱིས་སློབ་ཚན་གྱི་བྱེད་ནུས་ལ་ཚོད་འཛིན་བྱེད། "
"ཤོག་ངོས་འདིའི་སྟེང་དུ་ཁྱེད་ཀྱིས་ལག་ཐོག་སྲིད་ཇུས་རྩོམ་སྒྲིག་བྱེད་ཐུབ། "
"དེ་ནི་JSONལ་གཞི་བཅོལ་བའི་ལྡེ་མིག་དང་རིན་ཐང་ཆ་གཅིག་ཡིན།"

msgid ""
"Any policies you modify here override all other information you've defined "
"elsewhere in {studio_name}. Do not edit policies unless you are familiar "
"with both their purpose and syntax."
msgstr ""
"ཁྱེད་ཀྱིས་འདིར་བསྒྱུར་བཅོས་བྱེད་པའི་སྲིད་ཇུས་གང་རུང་གིས་ཁྱེད་ཀྱིས་ "
"{studio_name} ནང་གསལ་བཀོད་བྱས་པའི་གནས་ཚུལ་གཞན་ཚང་མ་བཀག་འགོག་བྱེད། "
"ཁྱེད་ཀྱིས་དེའི་དམིགས་ཡུལ་དང་ཚིག་སྦྱོར་གཉིས་ཀར་རྒྱུས་མངའ་མེད་ན་སྲིད་ཇུས་ལ་རྩོམ་སྒྲིག་མ་བྱེད།"

msgid ""
"{em_start}Note:{em_end} When you enter strings as policy values, ensure that"
" you use double quotation marks (\") around the string. Do not use single "
"quotation marks (')."
msgstr ""
"{em_start} མཆན: {em_end} "
"ཁྱོད་ཀྱིས་ཡིག་རྒྱུན་དེ་སྲིད་ཇུས་ཀྱི་རིན་ཐང་ལྟར་ནང་འཇུག་བྱེད་སྐབས་ཡིག་རྒྱུན་གྱི་མཐའ་འཁོར་དུ་འདྲེན་རྟགས་གཉིས་ལྡན་(&quot;)བེད་སྤྱོད་གཏོང་དགོས།"

msgid "Grading Settings"
msgstr "རིམ་སྒྲིག་སྒྲིག་སྟངས།"

msgid "Overall Grade Range"
msgstr "སྤྱིའི་འཛིན་རིམ་ཁྱབ་ཁོངས།"

msgid "Your overall grading scale for student final grades"
msgstr "ཁྱེད་ཀྱི་སློབ་མའི་མཐའ་མའི་སྐར་གྲངས་ཀྱི་སྤྱིའི་ཚད་གཞི།"

msgid "Add grade"
msgstr "འཛིན་གྲྭ་ཁ་སྣོན་བྱེད་པ།"

msgid "Credit Eligibility"
msgstr "བུ་ལོན་ཐོབ་ཐང་།"

msgid "Settings for course credit eligibility"
msgstr "སློབ་ཚན་གྱི་བུན་འཛིན་ཐོབ་ཐང་སྒྲིག་སྟངས།"

msgid "Minimum Credit-Eligible Grade:"
msgstr "དམའ་མཐའི་སློབ་ཡོན་ཐོབ་ཐང་གི་འཛིན་གྲྭ།"

msgid "Must be greater than or equal to the course passing grade"
msgstr "སློབ་ཚན་རྒྱུགས་འཕྲོད་པའི་སྐར་གྲངས་ལས་ཆེ་བའམ་མཉམ་དགོས།"

msgid "Grading Rules & Policies"
msgstr "རིམ་སྒྲིག་སྒྲིག་གཞི་དང་སྲིད་ཇུས།"

msgid "Deadlines, requirements, and logistics around grading student work"
msgstr "དུས་ཚོད།དགོས་མཁོ། སློབ་མའི་ལས་ཀར་རིམ་པ་བགར་བའི་མཁོ་ཆས།"

msgid "Grace Period on Deadline:"
msgstr "དུས་བཀག་ལྟར་ཆོག་མཆན་དུས་ཡུན།"

msgid "Leeway on due dates"
msgstr "ལི་ཝེ་ཡིས་དུས་ཚོད་གཏན་འཁེལ་བྱས།"

msgid "Assignment Types"
msgstr "ལས་འགན་གྱི་རིགས།"

msgid "Categories and labels for any exercises that are gradable"
msgstr "རིམ་སྒྲིག་ཐུབ་པའི་སྦྱོང་བརྡར་གང་རུང་ཞིག་གི་སྡེ་ཚན་དང་མིང་བྱང་།"

msgid "New Assignment Type"
msgstr "ལས་འགན་གསར་པའི་རིགས།"

msgid "What can I do on this page?"
msgstr "ཤོག་ངོས་འདིར་ངས་ཅི་ཞིག་བསྒྲུབ་ཆོག་གམ།"

msgid ""
"You can use the slider under Overall Grade Range to specify whether your "
"course is pass/fail or graded by letter, and to establish the thresholds for"
" each grade."
msgstr ""
"ཁྱེད་ཀྱིས་སྤྱིར་བཏང་གི་སློབ་ཚན་ཁྱབ་ཁོངས་འོག་གི་བཤུད་སྒྲིལ་དེ་བེད་སྤྱད་ནས་ཁྱེད་ཀྱི་སློབ་ཚན་དེ་རྒྱུགས་འཕྲོད་པའམ་ཡང་ན་ཡི་གེའི་ཐོག་ནས་གྲངས་ཐོ་བཀོད་ཡོད་མེད་གསལ་བཀོད་བྱེད་ཐུབ།"

msgid ""
"You can specify whether your course offers students a grace period for late "
"assignments."
msgstr ""
"ཁྱེད་རང་གི་སློབ་ཚན་གྱིས་སློབ་ཕྲུག་ཚོར་ལས་འགན་རྗེས་ལུས་ཐེབས་པའི་དུས་ཡུན་སྤྲོད་ཀྱི་ཡོད་མེད་གསལ་བཤད་བྱེད་ཐུབ།"

msgid ""
"You can also create assignment types, such as homework, labs, quizzes, and "
"exams, and specify how much of a student's grade each assignment type is "
"worth."
msgstr ""
"ཁྱེད་ཀྱིས་ལས་འགན་རིགས་བཟོ་ཐུབ། དཔེར་ན་ནང་སྦྱོང་དང་། བརྟག་དཔྱད་ཁང་། "
"དྲི་བ་དྲིས་ལན། ཡིག་རྒྱུགས་བཅས་ཡིན།"

msgid "Importing components"
msgstr "གྲུབ་ཆ་ནང་འདྲེན་བྱེད་པ།"

msgid "Expand or Collapse"
msgstr "རྒྱས་པའམ་བརྡབ་པ།"

msgid "Select this problem"
msgstr "དཀའ་ངལ་འདི་འདེམས།"

msgid "Update available"
msgstr "དུས་མཐུན་བཟོ་ཡོད།"

msgid "Manage Access"
msgstr "འཛུལ་ཞུགས་དོ་དམ་བྱེད་པ།"

msgid "Manage Tags"
msgstr "ཁ་བྱང་དོ་དམ་བྱེད་པ།"

msgid "Copy to Clipboard"
msgstr "བཤུབ་སྟེགས་སུ་བཤུས།"

msgid "Details"
msgstr "ཞིབ་ཕྲ།"

msgid "This block contains multiple components."
msgstr "བཀག་སྡོམ་འདིའི་ནང་དུ་ཆ་ཤས་སྣ་ཚོགས་ཡོད།"

msgid "New Textbook"
msgstr "སློབ་དེབ་གསར་པ།"

msgid "Why should I break my textbook into chapters?"
msgstr "ངས་སློབ་དེབ་དེ་ལེའུ་ཁག་དུ་བགོས་དགོས་དོན་གང་ཡིན་ནམ།"

msgid ""
"Breaking your textbook into multiple chapters reduces loading times for "
"students, especially those with slow Internet connections. Breaking up "
"textbooks into chapters can also help students more easily find topic-based "
"information."
msgstr ""
"ཁྱེད་རང་གི་སློབ་དེབ་དེ་སློབ་ཚན་སྣ་ཚོགས་ལ་བགོས་ན་སློབ་ཕྲུག་ཚོར་མངོན་པའི་དུས་ཚོད་ཉུང་དུ་འགྲོ་གི་ཡོད།"
" "
"སློབ་དེབ་ཁག་ལ་དབྱེ་ན་སློབ་མ་ཚོས་བརྗོད་གཞི་གཞིར་བཟུང་བའི་གནས་ཚུལ་འཚོལ་སླ་བར་ཕན་ཐོགས་ཡོད།"

msgid "What if my book isn't divided into chapters?"
msgstr "གལ་ཏེ་ངའི་དེབ་དེ་ལེའུ་ཁག་ཏུ་མ་བགོས་ན་གང་འདྲ་རེད།"

msgid ""
"If your textbook doesn't have individual chapters, you can upload the entire"
" text as a single chapter and enter a name of your choice in the Chapter "
"Name field."
msgstr ""
"གལ་ཏེ་ཁྱེད་ཀྱི་སློབ་དེབ་ལ་ལེའུ་རེ་རེ་མེད་ན་སློབ་ཚན་ཆ་ཚང་ལེའུ་གཅིག་ཏུ་ཡར་བསྐུར་ནས་ལེའུ་མིང་ཡིག་དུམ་ནང་རང་ཉིད་ཀྱི་འདོད་པའི་མིང་ཞིག་བླུགས་ཆོག"

msgid "Learn more about textbooks"
msgstr "སློབ་དེབ་ཀྱི་སྐོར་ལ་རྒྱུས་ལོན་བྱེད་པ།"

msgid "Video Uploads"
msgstr "བརྙན་ཕབ།"

msgid "Course Video Settings"
msgstr "སློབ་ཚན་བརྙན་འཕྲིན་སྒྲིག་སྟངས།"

msgid "Changing.."
msgstr "འགྱུར་བ།"

msgid "Videos per page:"
msgstr "ཤོག་ངོས་རེར་བརྙན་འཕྲིན།"

msgid "Access is not restricted"
msgstr "འཛུལ་ཞུགས་ལ་ཚད་བཀག་མེད་པ།"

msgid ""
"Access to this unit is not restricted, but visibility might be affected by "
"inherited settings."
msgstr ""
"འདི་ལ་འཛུལ་ཞུགས་བྱེད་པར་ཚད་བཀག་མེད་ཀྱང་། "
"ཤུལ་འཛིན་སྒྲིག་སྟངས་ཀྱིས་མཐོང་ཐུབ་ཚད་ལ་ཤུགས་རྐྱེན་ཐེབས་སྲིད།"

msgid ""
"Access to this component is not restricted, but visibility might be affected"
" by inherited settings."
msgstr ""
"ཆ་ཤས་འདི་ལ་འཛུལ་ཞུགས་བྱེད་པར་ཚད་བཀག་མེད་ཀྱང་། "
