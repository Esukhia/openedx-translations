msgstr "%s འདི་ཙམ་ནང་འཇུག་བྱས་ཟིན་པ་དང་ཟུར་སྦྱར་རྙིང་པ་བསྐྱར་བརྗེ་བྱེད་འགྲོ།"

msgid ""
"Your new file will automatically be renamed to match the file already "
"present. Files with different extensions are not allowed."
msgstr ""
"ཁྱེད་ཀྱི་ཡིག་ཆ་གསར་པ་དེ་ལ་ད་སྔ་ཡོད་བསྡད་པའི་ཡིག་དེ་དང་མཐུན་པར་རང་འགུལ་གྱིས་མིང་འདོགས་འགྲོ་བ་དང་།"
"  ཡིག་ཆའི་རྣམ་སྒྲིག་མི་འདྲ་བ་རྣམས་ངོས་ལེན་མི་བྱེད་པ་ཡིན།"

msgid "Current revision changed for %s."
