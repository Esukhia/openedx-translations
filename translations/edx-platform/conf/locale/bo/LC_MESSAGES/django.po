msgstr "གནས་རིམ་ལ་གཟིགས།"

msgid "Course details"
msgstr "སློབ་ཚན་གྱི་ཞིབ་ཕྲའི་གནས་ཚུལ།"

msgid "{course_number} {course_name} Home Page"
msgstr "{course_number} {course_name} གཙོ་ངོས།"

msgid "{course_number} {course_name} Cover Image"
msgstr "{course_number} {course_name} མདུན་པར།"

msgid "Enrolled as: "
msgstr "འདི་ལྟར་ཞུགས་ཐོ་བཀོད་ཡོད།"

msgid "Coming Soon"
msgstr "མི་འགྱངས་པར་སླེབ་ཡོང་།"

msgid "Ended - {date}"
msgstr "མཇུག་བསྡུ་བའི་དུས།- {date}"

msgid "Started - {date}"
msgstr "འགོ་བརྩམས་པའི་དུས། - {date}"

msgid "Starts - {date}"
msgstr "འགོ་འཛུགས་ - {date}"

msgid "for {course_display_name}"
msgstr "འདིའི་ {course_display_name}"

msgid "You must select a session by {expiration_date} to access the course."
msgstr ""
"སློབ་ཚན་དེ་བལྟ་ཀློག་བྱེད་པ་ལ་ཁྱེད་ཀྱིས་ {expiration_date} "
"འདི་ནས་སློབ་ཐུན་ཞིག་ལ་ངེས་པར་དུ་འདེམ་རྟགས་འགོད་དགོས།"

msgid "You must select a session to access the course."
msgstr "སློབ་ཚན་བསྔོག་པར་ཁྱེད་ཀྱིས་སྡེ་ཚན་ཞིག་ངེས་པར་འདེམ་དགོས།"

msgid "Change or Leave Session"
msgstr "བསྒྱུར་བཅོས་བྱ་རྒྱུ་ཡིན་ནམ་ཡང་ན་སློབ་ཐུན་འཇོག་རྒྱུ་ཡིན།"

msgid "You can no longer change sessions."
msgstr "ཁྱེད་ཀྱིས་སློབ་ཐུན་འགྱུར་བ་གཏོང་མི་ཐུབ།"

msgid "You can change sessions until {entitlement_expiration_date}."
msgstr ""
"ཁྱེད་ཀྱིས་ {entitlement_expiration_date} "
"འདི་བར་དུ་སློབ་ཐུན་འགྱུར་བ་གཏོང་ཐུབ།"

msgid "I'm taking {course_name} online with {facebook_brand}. Check it out!"
msgstr ""
"ངས་དྲ་ཐོག་ནས་ {course_name} ངོ་དེབ་ {facebook_brand} བརྒྱུད་དེ་ལེན་བཞིན་ཡོད།"
" དེར་ཞིབ་བཤེར་ཞིག་བྱོས།"

msgid "Share {course_name} on Facebook"
msgstr "{course_name} འདི་ངོ་དེབ་ནང་བརྒྱུད་སྐུར་བྱོས།"

msgid "Share on Facebook"
msgstr "ངོ་དེབ་ནང་བརྒྱུད་སྐུར་བྱོས།"

msgid "I'm taking {course_name} online with {twitter_brand}. Check it out!"
msgstr ""
"ངས་དྲ་ཐོག་ནས་ {course_name} འདི་twitter {twitter_brand} "
"བརྒྱུད་དེ་ལེན་བཞིན་ཡོད། དེར་ཞིབ་བཤེར་ཞིག་བྱོས།"

msgid "Share {course_name} on Twitter"
msgstr "{course_name} འདི་ Twitter ནང་བརྒྱུད་སྐུར་བྱོས།"

msgid "Course options for"
msgstr "འདིའི་སློབ་ཚན་གྱི་བསལ་འདེམ།"

msgid "Available Actions"
msgstr "ཡོད་བསྡད་པའི་བྱ་འགུལ་ཁག"

msgid ""
"You are enrolled by your institution and you should reach out to your "
"institution to drop this course."
msgstr ""
"ཁྱེད་རང་ཁྱེད་ཀྱི་སློབ་གླིང་བརྒྱུད་ནས་ཞུགས་ཐོ་བཀོད་འདུག་པས། "
"ཁྱེད་ཀྱིས་སློབ་ཚན་འདི་མཚམས་འཇོག་བྱེད་པར་རང་གི་སློབ་གླིང་ལ་བཅར་དགོས།"

msgid "Email Settings"
msgstr "གློག་འཕྲིན་སྒྲིག་འགོད་ཁག"

msgid "View Archived Course"
msgstr "ཡིག་ཚགས་བྱས་པའི་སློབ་ཚན་སྟོན།"

msgid "Related Programs"
msgstr "འབྲེལ་ཡོད་ལས་རིམ་ཁག"

msgid ""
"{start_bold}Get the most out of your course!{end_bold} Upgrade to get full "
"access to the course material, unlock both graded and non-graded "
"assignments, and earn a {link_start}verified certificate{link_end} to "
"showcase on your resumé."
msgstr ""
"{start_bold}ཁྱེད་ཀྱི་སློབ་ཚན་རྣམས་ལས་མང་ཆེ་ཤོས་ཐོབ་པ་དང་།{end_bold} "
"སློབ་ཚན་རྒྱུ་ཆ་ཡོངས་དང་གནས་རིམ་ཅན་དང་གནས་རིམ་མེད་པ་གཉིས་ཆའི་ལས་འགན་ཁག་སྒོ་འབྱེད་པ་དང་།"
" "
"དེ་བཞིན་ཁྱེད་ཀྱི་ལོ་རྒྱུས་སྙིང་བསྡུས་སྟོན་ཆས་སྟེང་{link_start}ཁུངས་སྐྱེལ་བྱས་པའི་ལག་ཁྱེར་{link_end}"
" ཞིག་ཀྱང་ཐོབ་ཐབས་བཅས་ལ་རིམ་སྤར་བྱེད་དགོས།"

msgid ""
"{start_bold}Get the most out of your course!{end_bold} Upgrade to earn a "
"{link_start}verified certificate{link_end} to showcase on your resumé."
msgstr ""
"start_bold}ཁྱེད་ཀྱི་སློབ་ཚན་རྣམས་ལས་མང་ཆེ་ཤོས་ཐོབ་པ་དང་།{end_bold} "
"དེ་བཞིན་ཁྱེད་ཀྱི་ལོ་རྒྱུས་སྙིང་བསྡུས་སྟོན་ཆས་སྟེང་{link_start}ཁུངས་སྐྱེལ་བྱས་པའི་ལག་ཁྱེར་{link_end}"
" ཞིག་ཐོབ་ཐབས་ལ་རིམ་སྤར་བྱེད་དགོས།"

msgid "Upgrade"
msgstr "རིམ་སྤར།"

msgid "Resume Course"
msgstr "སློབ་ཚན་མུ་མཐུད་ནས་ལེན།"

msgid ""
"You have completed this course and are eligible to purchase course credit. "
"Select {strong_start}Get Credit{strong_end} to get started."
msgstr ""
"ཁྱེད་ཀྱིས་སློབ་ཚན་འདི་ཡོངས་སུ་ལོངས་དང་། སློབ་ཚན་གྱི་ credit "
"ཉོ་བའི་འོས་ཆོས་ཚང་བ་ཡིན། འགོ་རྩོམ་པ་ལ་{strong_start}Credit "
"ཐོབ་ཕྱིར་{strong_end} འདེམ་རྟགས་འགོད་དགོས།"

msgid "You are now eligible for credit from {provider}. Congratulations!"
msgstr ""
"ད་ནས་ཁྱེད་ལ་{provider} བརྒྱུད་ནས་credit ཐོབ་པའི་ཐོབ་ཐང་འདུག  རྟེན་འབྲེལ་ཞུ།"

msgid "Get Credit"
msgstr "Credit ཐོབ་པ།"

msgid ""
"Thank you for your payment. To receive course credit, you must now request "
"credit at the {link_to_provider_site} website. Select {start_bold}Request "
"Credit{end_bold} to get started."
msgstr ""
"ཁྱེད་ཀྱིས་རིན་འབབ་སྤྲད་པ་ལ་བཀའ་དྲིན་ཆེ། སློབ་ཚན་གྱི་ credit "
"འབྱོར་བ་ལ་ཁྱེད་ཀྱིས་ངེས་པར་དུ་དྲ་ཚིགས་ཀྱི་དྲ་ཐག་ {link_to_provider_site} "
"འདི་ནས་ credit ཡི་རེ་ཞུ་བྱ་དགོས། འགོ་རྩོམ་པ་ལ་ {start_bold}Credit "
"རེ་ཞུ་{end_bold} འདེམ་དགོས།"

msgid "Request Credit"
msgstr "Credit ཐོབ་པའི་རེ་ཞུ།"

msgid ""
"{provider_name} has received your course credit request. We will update you "
"when credit processing is complete."
msgstr ""
"{provider_name} ལ་ཁྱེད་ཀྱི་credit སློབ་ཚན་གྱི་རེ་ཞུ་འབྱོར་སོང་། ཁྱེད་ཀྱིས་ "
"credit ཡི་བརྒྱུད་རིམ་ཆ་ཚང་གྲུབ་དུས་ང་ཚོས་ཁྱེད་རང་ཁ་སྣོན་བྱེད།"

msgid ""
"{start_bold}Congratulations!{end_bold} {provider_name} has approved your "
"request for course credit. To see your course credit, visit the "
"{link_to_provider_site} website."
msgstr ""
"{start_bold}རྟེན་འབྲེལ་ཞུ།{end_bold} {provider_name} ཡི་སློབ་ཚན་གྱི་ credit "
"རེ་ཞུ་ངོས་ལེན་བྱས་སོང་། ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་ credit ལ་གཟིགས་ན། "
"དྲ་ཚིགས་ཀྱི་དྲ་ཐག་ {link_to_provider_site} འདི་ནས་གཟིགས་རོགས།"

msgid "View Credit"
msgstr "Credit ལ་གཟིགས།"

msgid ""
"{provider_name} did not approve your request for course credit. For more "
"information, contact {link_to_provider_site} directly."
msgstr ""
"{provider_name} ཡིས་ཁྱེད་ཀྱི་credit སློབ་ཚན་གྱི་རེ་ཞུ་ངོས་ལེན་བྱས་མི་འདུག "
"གནས་ཚུལ་ཞིབ་ཕྲའི་རིགས་ {link_to_provider_site} འདི་ནས་ཐད་ཀར་འབྲེལ་བ་བྱོས།"

msgid ""
"An error occurred with this transaction. For help, contact {support_email}."
msgstr ""
"བརྒྱུད་རིམ་འདིར་གནད་དོན་ཞིག་བྱུང་སོང་བས། གློག་འཕྲིན་འདིའི་ཐོག་འབྲེལ་བ་བྱོས། "
"{support_email}"

msgid "Course options for {courseName}"
msgstr "{courseName} འདིའི་སློབ་ཚན་བསལ་འདེམ།"

msgid "Consent to share your data"
msgstr "ཁྱེད་ཀྱི་གཞི་གྲངས་བརྒྱུར་སྐུར་བྱེད་པའི་བཀའ་འཁྲོལ།"

msgid ""
"To access this course, you must first consent to share your learning "
"achievements with {enterprise_customer_name}."
msgstr ""
"སློབ་ཚན་འདི་ཆ་ཚང་བལྟ་ཀློག་བྱེད་པ་ལ། "
"ཐོག་མར་{enterprise_customer_name}འདི་དང་ལྷན་དུ་ཁྱེད་ཀྱི་བསླབ་འབྲས་བརྒྱུད་སྐུར་བྱེད་ཆོག་པའི་བཀའ་འཁྲོལ་ངེས་པར་དུ་སྤྲོད་དགོས།"

msgid "View Consent"
msgstr "བཀའ་འཁྲོལ་ལ་གཟིགས།"

msgid "Could Not Link Accounts"
msgstr "སྦྲེལ་མཐུད་མི་ཐུབ་པའི་ཁ་བྱང་ཁག"

msgid ""
"The {provider_name} account you selected is already linked to another "
"{platform_name} account."
msgstr ""
"ཁྱེད་ཀྱིས་བདམས་ཡོད་པའི་{provider_name} ཁ་བྱང་དེ་སྟེགས་བུ་གཞན་{platform_name}"
" ལ་མཐུད་འདུག"

msgid ""
"We're sorry to see you go! Read the following statements and rate your level"
" of agreement."
msgstr ""
"ང་ཚོས་ཁྱེད་རང་ཐོན་འགྲོ་བ་མཐོང་བས་དགོངས་དག་ཞུ། "
"གཤམ་གསལ་གྱི་གསལ་བསྒྲགས་བཀླགས་ཏེ་ཁྱེད་ཀྱི་མུས་མཐུན་གྱི་ཚད་གཞིའི་ཐད་རིམ་པ་ཞིག་སྤྲོད་རོགས།"

msgid "Price is too high for me"
msgstr "གོང་ཚད་འདི་ང་ལ་མཚོན་ན་ཧ་ཅང་མཐོ་བོ་འདུག"

msgid "I was not satisfied with my experience taking the courses"
msgstr "སློབ་ཚན་འདི་བླངས་པའི་གོ་རྟོགས་ལ་འདོད་པ་ཚིམ་མ་སོང་།"

msgid "Content of the courses was too difficult"
msgstr "སློབ་ཚན་དེའི་ནང་དོན་ཧ་ཅང་དཀའ་མོ་འདུག"

msgid "I did not have enough time to complete the courses"
msgstr "ང་ལ་སློབ་ཚན་འདི་དག་ཆ་ཚང་ལེན་པའི་དུས་ཚོད་འདང་ངེས་ཤིག་མི་འདུག"

msgid "The content was not available when I wanted to start"
