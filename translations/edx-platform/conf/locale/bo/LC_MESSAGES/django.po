msgstr "གསལ་བརྡ་མཉེན་ཆས།"

msgid "Notification Type"
msgstr "གསལ་བརྡའི་རིགས།"

msgid ""
"Search by username, course_id. Specify fields with username: or course_id: prefixes. If no prefix is specified, search will be done on username. \n"
"Examples: \n"
" - testuser (default username search) \n"
" - username:testuser (username keyword search) \n"
" - course_id:course-v1:edX+DemoX+Demo_Course (course_id keyword search) \n"
" - username:testuser, course_id:course-v1:edX+DemoX+Demo_Course (combined keyword search) \n"
msgstr ""
"སྤྱོད་མཁན་གྱི་མིང་། སློབ་ཚན། སྤྱོད་མཁན་གྱི་མིང་: ཡང་ན་ course_id: སྔོན་འཇུག་ཡོད་པའི་ཡིག་དུམ་གཏན་འཁེལ་བྱེད། གལ་ཏེ་སྔོན་འཇུག་གཏན་འཁེལ་བྱས་མེད་ན་སྤྱོད་མཁན་གྱི་མིང་ཐོག་འཚོལ་ཞིབ་བྱེད།\n"
" དཔེར་ན།\n"
" - testuser (སྔོན་སྒྲིག་སྤྱོད་མཁན་གྱི་མིང་འཚོལ་ཞིབ།)\n"
" - username:stuser (སྤྱོད་མཁན་གྱི་མིང་ཚིག་འཚོལ་ཞིབ།)\n"
" - སློབ་ཚན་གྱི་ཨང་རྟགས་:སློབ་ཚན་-v1:edX+DemoX+དཔེ་སྟོན་_སློབ་ཚན། (སློབ་ཚན་གྱི་ཨང་རྟགས་གཙོ་ཚིག་འཚོལ་ཞིབ།)\n"
" - སྤྱོད་མཁན་གྱི་མིང་།:བརྟག་དཔྱད་བྱེད་མཁན། སློབ་ཚན་གྱི་ཨང་རྟགས་:སློབ་ཚན་-v1:edX+DemoX+དཔེ་སྟོན་_སློབ་ཚན། (མཉམ་སྡེབ་གཙོ་ཚིག་འཚོལ་ཞིབ།)\n"

