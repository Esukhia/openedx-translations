msgid ""
"This course is configured to generate PDF certificates and this certificate "
"type is no longer supported. Example certificates cannot be generated."
msgstr ""
"སློབ་ཚན་འདིའི་ལག་ཁྱེར་ནི་PDF ཡི་རྣམ་པ་ཅན་རེད། "
"ལག་ཁྱེར་འདིའི་རིགས་ནི་ད་ལྟ་མི་འདུག ལག་ཁྱེར་གྱི་དཔེ་མཚོན་བཟོ་མི་ཐུབ།"

msgid "Generate Example Certificates"
msgstr "ལག་ཁྱེར་གྱི་དཔེ་མཚོན་བཟོ།"

msgid "Status:"
msgstr "གནས་བབས།"

msgid "Generating example {name} certificate"
msgstr "ལག་ཁྱེར་དཔེ་མཚོན་ {name} བཟོ་བཞིན་ཡོད།"

msgid "Error generating example {name} certificate: {error}"
msgstr "Error generating example {name} certificate: {error}"

msgid "View {name} certificate"
msgstr "ལག་ཁྱེར་ {name} སྟོན།"

msgid "Refresh Status"
msgstr "གནས་བབས་བསྐྱར་སྐོར་བྱོས།"

msgid "Student-Generated Certificates"
msgstr "བཟོས་ཟིན་པའི་སློབ་ཕྲུག་གི་ལག་ཁྱེར།"

msgid "Disable Student-Generated Certificates"
msgstr "བཟོས་ཟིན་པའི་སློབ་ཕྲུག་གི་ལག་ཁྱེར་ནུས་མེད་བྱེད།"

msgid "Enable Student-Generated Certificates"
msgstr "བཟོས་ཟིན་པའི་སློབ་ཕྲུག་གི་ལག་ཁྱེར་ནུས་ལྡན་བྱེད།"

msgid ""
"You must successfully generate example certificates before you enable "
"student-generated certificates."
msgstr ""
"བཟོས་ཟིན་པའི་སློབ་ཕྲུག་གི་ལག་ཁྱེར་ནུས་ལྡན་མ་བྱས་གོང་ཁྱེད་ཀྱིས་དཔེ་མཚོན་ལག་ཁྱེར་ངེས་པར་དུ་བཟོ་གྲུབ་དགོས།"

msgid "Generate Certificates"
msgstr "ལག་ཁྱེར་བཟོ།"

msgid ""
"Course certificate generation requires an activated web certificate "
"configuration."
msgstr ""
"སློབ་ཚན་ལག་ཁྱེར་བཟོ་བར་ནུས་ལྡན་བྱས་ཟིན་པའི་དྲ་ཚིགས་ནང་གི་ལག་ཁྱེར་སྒྲིག་བཀོད་ཅིག་ངེས་པར་དགོས།"

msgid ""
"When you are ready to generate certificates for your course, click Generate "
"Certificates. You do not need to do this if you have set the certificate "
"mode to on-demand generation."
msgstr ""
"ཁྱེད་ཀྱི་སློབ་ཚན་ལ་ལག་ཁྱེར་བཟོ་བའི་དུས་ལ་སླེབས་དུས་ལག་ཁྱེར་བཟོ་ཟེར་བ་ལ་སྣུན།"
" གལ་ཏེ་ཁྱེད་ཀྱིས་on-demand generation "
"ལ་ལག་ཁྱེར་གྱི་རྣམ་པ་བསྒྲིགས་ཟིན་ཡོད་ན་དེ་ལྟར་བྱེད་མི་དགོས།"

msgid "Pending Tasks"
msgstr "ལས་འགན་ཁག་ངང་སྒུག་གི་སྐབས་ཡིན།"

msgid "The status for any active tasks appears in a table below."
msgstr ""
"བསྒྲུབ་དགོས་པའི་ལས་འགན་གང་ཡོད་ཀྱི་གནས་བབ་དེ་གཤམ་དུ་རེའུ་མིག་ཅིག་གི་ནང་འཆར་ཡོད།"

msgid "Regenerate Certificates"
msgstr "ལག་ཁྱེར་བསྐྱར་བཟོ།"

msgid ""
"To regenerate certificates for your course, choose the learners who will "
"receive regenerated certificates and click Regenerate Certificates."
msgstr ""
"ཁྱེད་ཀྱི་སློབ་ཚན་གྱི་ལག་ཁྱེར་བསྐྱར་བཟོ་བྱེད་པ་ལ། "
"མ་འོངས་པར་བསྐྱར་བཟོ་བྱས་པའི་ལག་ཁྱེར་ཐོབ་མཁན་གྱི་སློབ་གཉེར་བ་རྣམས་བདམས་ཏེ། "
"ལག་ཁྱེར་བསྐྱར་བཟོ་ཟེར་བ་དེའི་སྒང་ལ་སྣུན། "

msgid "Choose learner types for regeneration"
msgstr "བསྐྱར་བཟོ་བྱེད་པ་ལ་སློབ་གཉེར་བའི་རིགས་འདེམ།"

msgid ""
"Regenerate for learners who have already received certificates. ({count})"
