msgstr "སློབ་ཚན་འདི་ཁྱེད་གནས་སའི་རྒྱལ་ཁབ་དེའི་ནང་བལྟ་མི་ཐུབ།"

msgid ""
"Our system indicates that you are trying to access this {platform_name} "
"course from a country or region in which it is not currently available."
msgstr ""
"ང་ཚོས་མ་ལག་གིས་བརྡ་བསྟན་པ་ལྟར་ན་ཁྱེད་ཀྱིས་{platform_name} "
"སློབ་ཚན་འདི་ད་སྔ་མེད་སའི་རྒྱལ་ཁབ་དང་ཡང་ན་ས་ཁུལ་ག་གེ་མོ་ཞིག་ནས་བལྟ་ཐབས་བྱེད་བཞིན་འདུག"

msgid ""
"Our system indicates that you are trying to enroll in this {platform_name} "
"course from a country or region in which it is not currently available."
msgstr ""
"ང་ཚོས་མ་ལག་གིས་བརྡ་བསྟན་པ་ལྟར་ན་ཁྱེད་ཀྱིས་{platform_name} "
"སློབ་ཚན་འདི་ད་སྔ་མེད་སའི་རྒྱལ་ཁབ་དང་ཡང་ན་ས་ཁུལ་ག་གེ་མོ་ཞིག་ནས་ཞུགས་ཐོ་འགོད་ཐབས་བྱེད་བཞིན་འདུག"

msgid "Enrollment Successful"
msgstr "ཞུགས་ཐོ་ལེགས་གྲུབ་བྱུང་།"

msgid ""
"Thank you for enrolling in {course_names}. We hope you enjoy the course."
msgstr ""
"{course_names} འདིའི་ནང་ཞུགས་ཐོ་བཀོད་པར་བཀའ་དྲིན་ཆེ་ཞུ། "
"ང་ཚོས་ཁྱེད་རང་སློབ་ཚན་འདིའི་ནང་སྤྲོ་བོ་ཡོང་བའི་རེ་བ་བྱེད་བཞིན་ཡོད།"

msgid "Thank you for enrolling in:"
msgstr "ནང་ཞུགས་ཐོ་བཀོད་པར་བཀའ་དྲིན་ཆེ་ཞུ།"

msgid "We hope you enjoy the course."
msgstr "ང་ཚོས་ཁྱེད་རང་སློབ་ཚན་འདིའི་ནང་སྤྲོ་བོ་ཡོང་བའི་རེ་བ་བྱེད་བཞིན་ཡོད།"

msgid "Financial Assistance Application"
msgstr "དཔལ་འབྱོར་རོགས་སྐྱོར་སྙན་ཞུ།"

msgid "A Note to Learners"
msgstr "སློབ་གཉེར་བ་ཚོར་གསལ་འདེབས་ཤོག"

msgid "Dear edX Learner,"
msgstr "བརྩེ་བའི་edX སློབ་གཉེར་བ་"

msgid ""
"EdX Financial Assistance is a program we created to give learners in all "
"financial circumstances a chance to earn a Verified Certificate upon "
"successful completion of an edX course."
msgstr ""
"EdX དཔལ་འབྱོར་རོགས་སྐྱོར་ནི་ལས་གཞི་ཞིག་སྟེ། "
"ང་ཚོས་དཔལ་འབྱོར་གྱི་གནས་སྟངས་གང་ཅིའི་འོག་སློབ་གཉེར་བྱེད་མཁན་རྣམས་ལ་EdXཡི་སློབ་ཚན་ཆ་ཚང་ཞིག་ལེགས་པར་བླངས་པའི་ཁུངས་སྐྱེལ་ཡོད་པའི་ལག་ཁྱེར་ཞིག་ལེན་པའི་གོ་སྐབས་ཤིག་བསྐྲུན་ཕྱིར་གཙོ་གཉེར་བྱས་པ་ཞིག་ཡིན།"

msgid ""
"If you are interested in working toward a Verified Certificate, but cannot "
"afford to pay the fee, please apply now. Please note that financial "
"assistance is limited and may not be awarded to all eligible candidates."
msgstr ""
"གལ་སྲིད་ཁྱེད་ཀྱིས་ཁུངས་སྐྱེལ་ཡོད་པའི་ལག་ཁྱེར་ཞིག་ལོན་པར་དང་དོད་དང་འབད་བརྩོན་བྱེད་བཞིན་ཡོད་ན་ཡང་།"
" འགྲོ་སོང་གཏོང་མ་ཐུབ་པར་ལྷག་ཡོད་ན་མྱུར་དུ་ཐོ་འགོད་བྱོས། "
"ངེས་དགོས་པ་ཞིག་ལ་དཔལ་འབྱོར་གྱི་རོགས་སྐྱོར་དེ་ནི་ཚད་ངེས་ཅན་དང་འདིར་ཐོན་པ་ཆ་ཚང་ལ་འབུལ་ཐུབ་པ་ཞིག་ཀྱང་མ་ཡིན་པས་དེ་མཁྱེན་པར་མཛོད།"

msgid ""
"If your application is approved, we'll give you instructions for verifying "
"your identity on edx.org so you can start working toward completing your edX"
" course."
msgstr ""
"གལ་སྲིད་ཁྱེད་ཀྱི་སྙན་ཞུ་དེ་ངོས་ལེན་བྱས་སོང་ན། ང་ཚོས་ཁྱེད་ལ་edx.org "
"ཡི་སྒང་ལ་ཁྱེད་ཀྱི་ཐོབ་ཐང་དཔང་ཡིག་ཁུངས་སྐྱེལ་བྱེད་ཚུལ་ཐད་ཀྱི་མཛུབ་སྟོན་བྱེད་ཡོང་།"
" དེ་ནས་ཁྱེད་ཀྱིས་རང་ཉིད་ཀྱི་ edX ཡི་སློབ་ཚན་དེ་ལེན་ཆོག་པ་ཡིན།"

msgid ""
"EdX is committed to making it possible for you to take high quality courses "
"from leading institutions regardless of your financial situation, earn a "
"Verified Certificate, and share your success with others."
msgstr ""
"EdX "
"ནི་ཁྱེད་ལ་རྒྱུ་འབྱོར་ཡོད་མེད་ལ་མ་ལྟོས་པར་སློབ་གླིང་རྩེ་ཕུད་རྣམས་ཀྱིས་ཆེད་སྒྲིག་བྱས་པའི་སློབ་ཚན་སྤུས་ལེགས་རྣམས་ལོངས་སུ་སྤྱོད་པའི་གོ་སྐབས་བསྐྲུན་ས་ཞིག་ཏུ་བསྒྱུར་ཡོད།"
" དེ་བཞིན་ཁུངས་ཐུབ་ཀྱི་ལག་ཁྱེར་འཐོབ་ཐུབ་པར་མ་ཟད། "
"རང་ཉིད་ཀྱི་རྒྱལ་ཁ་གཞན་ལ་ཐུན་མོང་བྱེད་ས་ཞིག་ཀྱང་ཡིན།"

