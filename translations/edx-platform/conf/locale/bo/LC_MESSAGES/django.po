msgid ""
"We recommend sending learners no more than one email message per week. "
"Before you send your email, review the text carefully and send it to "
"yourself first, so that you can preview the formatting and make sure "
"embedded images and links work correctly."
msgstr ""
"ང་ཚོས་ནན་བཤད་བྱེད་རྒྱུ་ཞིག་ནི་སློབ་གཉེར་བ་ལ་བདུན་ཕྲག་རེའི་ནང་འཕྲིན་ཡིག་གཅིག་ལ་མང་བ་མི་གཏོང་བ་དང་།"
" "
"ཁྱེད་ཀྱིས་འཕྲིན་ཡིག་དེ་མ་བཏང་སྔོན་དེའི་ནང་དོན་སོགས་ལ་བསྐྱར་ཞིབ་གཟབ་ནན་བྱས་ཏེ་ཐོག་མར་རང་ཉིད་ལ་ཐོངས།"
" དེ་ནས་ཁྱེད་ཀྱིས་དེའི་རྣམ་པ་སྒྲིག་ཚུལ་དང་། "
"དེ་བཞིན་འདྲ་པར་དང་དྲ་ཐག་འཇོག་ཚུལ་བཅས་ལ་སྔོན་ལྟ་དང་ལེགས་སྒྲིག་ཚད་ལྡན་བྱ་ཐུབ་པ་ཡིན།"

msgid ""
"You can include keywords in your messages. For list of available keywords "
"see the {start_link}documentation{end_link}."
msgstr ""
"ཁྱེད་ཀྱིས་བརྡ་འཕྲིན་ནང་གཙོ་ཚིག་བཀོད་ཆོག མིང་ཚིག་གཙོ་བོའི་ཐོ་གཞུང་ལ་ "
"{start_link} ཡིག་ཆ་ {end_link} ལ་གཟིགས།"

msgid "CAUTION!"
msgstr "ཉེན་བརྡ།"

msgid ""
"When you select Send Email, your email message is added to the queue for "
"sending, and cannot be cancelled."
msgstr ""
"ཁྱེད་ཀྱིས་གློག་འཕྲིན་གཏོང་བ་འདེམས་སྐབས་ཁྱེད་ཀྱི་གློག་འཕྲིན་འཕྲིན་ཡིག་དེ་གཏོང་བའི་གྲལ་རིམ་དུ་བསྣན་ཡོད་པས་ཆ་མེད་གཏོང་མི་ཐུབ།"

msgid "Send Email"
msgstr "གླག་འཕྲིན་ཐོངས།"

msgid ""
"Email actions run in the background. The status for any active tasks - "
"including email tasks - appears in a table below."
msgstr ""
"གློག་འཕྲིན་བྱ་སྤྱོད་རྒྱབ་ལྗོངས་སུ་རྒྱུག་བཞིན་ཡོད། "
"གློག་འཕྲིན་ལས་འགན་ཚུད་པའི་ལས་འགན་གང་རུང་གི་གནས་ཚུལ་གཤམ་གྱི་རེའུ་མིག་ནང་མངོན་ཡོད།"

msgid "To see the content of previously sent emails, click this button:"
msgstr ""
"སྔོན་མར་བཏང་བའི་གློག་འཕྲིན་གྱི་ནང་དོན་དེ་དག་ལ་གཟིགས་པ་ལ། "
"གནོན་ཐེབས་འདིར་སྣུན།"

msgid ""
"For the specified problem, rescore the learner's responses. The 'Rescore "
"Only If Score Improves' option updates the learner's score only if it "
"improves in the learner's favor."
msgstr ""
"གཏན་འཁེལ་བྱས་པའི་དཀའ་ངལ་ལ་སློབ་སྦྱོང་བྱེད་མཁན་གྱི་ལན་འདེབས་ལ་ཡང་བསྐྱར་གྲངས་ཀ་སྤྲོད་དགོས།"
" &#39;གལ་ཏེ་གྲངས་ཀ་ཡར་རྒྱས་ཕྱིན་ན་ཁོ་ནར་གྲངས་ཀ་བསྐྱར་དུ་སྤྲོད་&#39; "
"གདམ་ཁ་དེས་སློབ་མའི་གྲུབ་འབྲས་དེ་སློབ་མའི་ཕྱོགས་ལ་ཡར་རྒྱས་ཕྱིན་ན་རྐྱངམ་གཅིག་གསར་བརྗེ་བྱེད།"

msgid "Score Override"
msgstr "Score Override"

msgid "Override Learner's Score"
msgstr "སློབ་མའི་སྐར་གྲངས་བརྒལ་བ།"

msgid ""
"Rescore any responses that have been submitted. The 'Rescore All Problems "
"Only If Score Improves' option updates the learner's scores only if it "
"improves in the learner's favor."
msgstr ""
"ལན་འདེབས་གང་རུང་ཕུལ་ཟིན་པ་དེ་དག་ལ་བསྐྱར་དུ་ཨང་གྲངས་སྤྲོད་དགོས། "
"&#39;གལ་ཏེ་གྲངས་ཀ་ཡར་རྒྱས་ཕྱིན་ན་རྐྱངམ་གཅིག་དཀའ་ངལ་ཚང་མ་བསྐྱར་དུ་རྩིས་རྒྱག་&#39;"
" "
"གདམ་ཁ་དེས་སློབ་མའི་གྲུབ་འབྲས་དེ་སློབ་མའི་ཕྱོགས་ལ་ཡར་རྒྱས་ཕྱིན་ན་རྐྱངམ་གཅིག་གསར་བརྗེ་བྱེད།"

msgid ""
"Show the status for the rescoring tasks that you submitted for this learner "
"and entrance exam."
msgstr ""
"ཁྱེད་ཀྱིས་སློབ་གཉེར་བ་འདི་དང་ཚུད་རྒྱུགས་ལ་སྤྲད་པའི་ལས་འགན་དག་གི་ཐོབ་སྐར་བསྐྱར་འགོད་བྱས་པ་དེའི་གནས་བབ་སྟོན།"

msgid "Adjust all enrolled learners' grades for a specific problem"
msgstr ""
"ཞུགས་ཐོ་བཀོད་ཟིན་པའི་སློབ་གཉེར་བའི་དམིགས་བསལ་གྱི་དྲི་བ་ཞིག་གི་གནས་རིམ་ཡོངས་རྫོགས་ལེགས་སྒྲིག་བྱོས།"

msgid "Allows all learners to work on the problem again."
msgstr "སློབ་གཉེར་བ་ཡོངས་ལ་དྲི་བ་དེའི་སྒང་ལ་བསྐྱར་ལས་བྱེད་དུ་ཆུགས།"

msgid ""
"Rescore submitted responses. The 'Rescore Only If Scores Improve' option "
"updates a learner's score only if it improves in the learner's favor."
msgstr ""
"ཕུལ་བའི་ལན་འདེབས་ལ་བསྐྱར་དུ་སྐར་གྲངས་སྤྲོད་དགོས། "
"&#39;གལ་ཏེ་གྲངས་ཀ་ཡར་རྒྱས་ཕྱིན་ན་ཁོ་ནར་གྲངས་ཀ་བསྐྱར་དུ་སྤྲོད་&#39; "
"གདམ་ཁ་དེས་སློབ་ཕྲུག་གི་གྲངས་ཀ་དེ་སློབ་མའི་ཕྱོགས་ལ་ཡར་རྒྱས་ཕྱིན་ན་རྐྱངམ་གཅིག་གསར་བརྗེ་བྱེད།"

msgid "Rescore All Learners' Submissions"
msgstr "སློབ་གཉེར་བའི་འབུལ་སྤྲོད་ཡོངས་ཀྱི་ཐོབ་སྐར་བསྐྱར་སྐོར་བྱོས།"

msgid "Rescore Only If Scores Improve"
msgstr "སྐར་གྲངས་ཡར་རྒྱས་སོང་ན་ད་གཟོད་སླར་ཡང་སྐར་གྲངས་བླངས།"

msgid "Show the status for the tasks that you submitted for this problem."
msgstr ""
"ཁྱེད་ཀྱིས་དྲི་བ་འདིའི་ཆེད་དུ་འབུལ་སྤྲོད་བྱས་པའི་ལས་འགན་དེའི་གནས་བབ་སྟོན།"

msgid "Note"
msgstr "གསལ་འདེབས།"

msgid ""
"Select a problem to generate a CSV         file that lists all student "
"answers to the problem. You also select a section or chapter to include"
"         results of all problems in that section or chapter."
msgstr ""
"དཀའ་ངལ་འདེམས་ནས་དཀའ་ངལ་དེའི་སློབ་མའི་ལན་ཚང་མ་ཐོ་འགོད་བྱེད་པའི་CSVཡིག་ཆ་ཞིག་བསྐྲུན་ཐུབ།"
" "
"ཁྱེད་ཀྱིས་དུམ་བུ་ཡང་ན་ལེའུ་དེའི་ནང་དཀའ་ངལ་ཚང་མའི་གྲུབ་འབྲས་ཚུད་པའི་དུམ་བུའམ་ལེའུ་ཞིག་འདེམས་དགོས།"

msgid ""
"Click to display the grading configuration for the                 course. "
"The grading configuration is the breakdown of graded subsections of the "
"course                 (such as exams and problem sets), and can be changed "
"on the 'Grading'                 page (under 'Settings') in Studio."
msgstr ""
"སློབ་ཚན་གྱི་རིམ་པ་བཀོད་སྒྲིག་མངོན་པར་སྣུན་རོགས། "
"རིམ་པ་བཀོད་སྒྲིག་ནི་སློབ་ཚན་གྱི་ཚད་གཞི་ཅན་གྱི་སྡེ་ཚན་ཆུང་བ་(དཔེར་ན་ཡིག་རྒྱུགས་དང་དཀའ་ངལ་ཆ་ཚན་ལྟ་བུ)བགོ་བཤའ་ཡིན།"

msgid "Click to download a CSV of                 anonymized student IDs:"
msgstr ""
"CSV ཞིག་ཕབ་ལེན་བྱེད་ན་འདིར་སྣུན།                 "
"མིང་ཁ་གསལ་མེད་པའི་སློབ་ཕྲུག་གི་ IDs:"

msgid ""
"For large courses, generating some reports can take                 several "
"hours. When report generation is complete, a                 link that "
"includes the date and time of generation appears in the table below. These "
"reports are                 generated in the background, meaning it is OK to"
" navigate away from this page while your report is                 "
"generating."
msgstr ""
"སློབ་ཚན་ཆེན་པོའི་ཆེད་དུ་སྙན་ཞུ་འགའ་ཤས་བཟོ་བར་ཆུ་ཚོད་འགའ་ཤས་འགོར་གྱི་ཡོད། "
"སྙན་ཞུ་བཟོ་སྐྲུན་མཇུག་སྒྲིལ་རྗེས་བཟོ་སྐྲུན་གྱི་ཚེས་གྲངས་དང་དུས་ཚོད་ཚུད་པའི་འབྲེལ་མཐུད་དེ་གཤམ་གྱི་རེའུ་མིག་ནང་མངོན་ཡོད།"
" སྙན་ཞུ་འདི་དག་རྒྱབ་ལྗོངས་སུ་བཟོས་ཡོད། "
"དེའི་གོ་དོན་ནི་ཁྱེད་ཀྱི་སྙན་ཞུ་བཟོ་བཞིན་པའི་སྐབས་ཤོག་ངོས་འདི་ནས་ཐག་རིང་དུ་བསྐྱོད་ན་འགྲིག་གི་ཡོད།"

msgid ""
"Please be patient and do not click these buttons                 multiple "
"times. Clicking these buttons multiple times will significantly slow the "
"generation                 process."
msgstr ""
"གནོན་ཐེབས་འདི་དག་གི་སྒང་ལ་བསྐྱར་གནོན་ཡང་གནོན་བྱེད་མི་རུང་། "
"འདི་དག་གི་སྒང་ལ་བསྐྱར་གནོན་ཡང་གནོན་བྱས་ན་གསར་སྒྲིག་གི་བརྒྱུད་རིམ་རྣམས་ཐད་ཀར་ཇེ་དལ་དུ་གཏོང་འགྲོ་བ་ཡིན།"
" བཟོ་སེམས་ཀྱིས་སྒུག་རོགས།"

msgid ""
"For smaller courses, click to list                 profile information for "
"enrolled students directly on this page:"
msgstr ""
"ཅུང་ཆུང་བའི་སློབ་ཚན་ཁག་གི་ཆེད་དུ་ཤོག་ངོས་འདིའི་སྟེང་ལ་ཐད་ཀར་བསྣུན་ཏེ་ཞུགས་ཐོ་བཀོད་ཟིན་པའི་སློབ་མ་རྣམས་ཀྱི་སྙིང་བསྡུས་གནས་ཚུལ་གྱི་ཐོ་གཞུང་ལ་སྣུན།"

msgid ""
"Click to generate a CSV file of                 all students enrolled in "
"this course, along with profile information such as email address and"
"                 username:"
msgstr ""
"སློབ་ཚན་འདིར་ཞུགས་ཐོ་བཀོད་ཟིན་པའི་སློབ་མ་ཡོངས་ཀྱི་ CSV "
"ཡིག་ཆ་བཟོ་བར་འདིར་སྣུན། འདི་ནས་སྙིང་བསྡུས་གནས་ཚུལ་དཔེར་ན། "
"གློག་འཕྲིན་ཁ་བྱང་དང་སྤྱོད་མིང་བཅས་ནི་"

msgid ""
"Click to generate a CSV file                 that lists learners who can "
"enroll in the course but have not yet done so."
msgstr ""
"སློབ་ཚན་འདིར་ཞུགས་ཐོ་འགོད་ཆོག་ཀྱང་ད་དུང་བཀོད་མེད་པའི་སློབ་གཉེར་བ་རྣམས་ཀྱི་ཐོ་གཞུང་"
" CSV ཡིག་ཆ་བཟོ་བར་འདིར་སྣུན།"

msgid ""
"Click to generate a CSV file                 of all proctored exam results "
"in this course."
msgstr ""
"སློབ་ཚན་འདིའི་ལྟ་རྟོག་ཡོད་པའི་རྒྱུགས་གྲུབ་འབྲས་ཆ་ཚང་གི་ CSV "
"ཡིག་ཆ་བཟོ་བར་འདིར་སྣུན།"

msgid ""
"Click to generate a CSV file of                 survey results for this "
"course."
msgstr "སློབ་ཚན་འདིའི་བརྟག་དཔྱད་གྲུབ་འབྲས་ཀྱི་ CSV ཡིག་ཆ་བཟོ་བར་འདིར་སྣུན།"

msgid ""
"Click to generate a CSV                 ORA grade report for all currently "
"enrolled students."
msgstr ""
"ཉེ་ཆར་ཞུགས་ཐོ་བཀོད་པའི་སློབ་ཕྲུག་ཡོངས་ཀྱི་ CSV ཡི་ORA "
"གནས་རིམ་གྱི་སྙན་སྡོམ་བཟོ་བར་འདིར་སྣུན།"

msgid ""
"Click to generate a CSV                 problem grade report for all "
"currently enrolled students."
msgstr ""
"ཉེ་ཆར་ཞུགས་ཐོ་བཀོད་པའི་སློབ་ཕྲུག་ཡོངས་ཀྱི་ CSV "
"ཡི་དྲི་བའི་གནས་རིམ་སྙན་སྡོམ་བཟོ་བར་འདིར་སྣུན།"

msgid "There was an error when loading this module!"
msgstr "ཚད་གཞི་འདི་མངོན་སྐབས་ནོར་འཁྲུལ་བྱུང་འདུག"

