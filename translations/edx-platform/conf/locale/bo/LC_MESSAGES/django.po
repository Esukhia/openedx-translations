msgstr "གཏོང་ཡུལ།"

msgid "Staff and Administrators"
msgstr "ལས་བྱེད་དང་འཛིན་སྐྱོང་བ།"

msgid "All Learners"
msgstr "སློབ་གཉེར་བ་ཡོངས།"

msgid "Cohort: "
msgstr "རིགས་དབྱེ།"

