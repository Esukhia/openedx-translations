msgstr "ཁྱེད་ཀྱི་གློག་འཕྲིན་སྒྲིག་ཆས་ཀྱིས་ URL དེ་དུམ་བུ་གཉིས་ལ་བགོས་འདུག་གམ།"

msgid "The keys are valid for a limited amount of time. Has the key expired?"
msgstr ""
"ལྡེ་མིག་དེ་དག་གི་ཚུལ་མཐུན་དུས་ཡུན་ནི་ཚད་བཀག་ཅན་ཞིག་ཡིན། "
"ལྡེ་མིག་དེ་དུས་ཚོད་ཡོལ་འདུག་གམ།"

msgid "External resource"
msgstr "ཕྱི་རོལ་གྱི་ཐོན་ཁུངས།"

msgid "{points} / {total_points} points"
msgstr "{points} / {total_points} ཐོབ་སྐར།"

msgid "{total_points} points possible"
msgstr "{total_points} སྲིད་པའི་སྐར་གྲངས།"

