msgstr "ཟུར་སྦྱར་མའི་བཟོ་བཅོས་པར་གཞི་ཁག"

msgid "%s was successfully added."
msgstr "%s ནི་བདེ་ལེགས་ངང་བསྣན་སོང་།"

