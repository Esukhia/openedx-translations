msgid "Your {platform_name} ID verification photos have been approved."
msgstr "ཁྱེད་ཀྱི་ {platform_name} ID ཡི་ཁུངས་སྐྱེལ་འདྲ་པར་ངོས་ལེན་བྱས་སོང་།"

