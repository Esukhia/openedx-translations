"This module is available only for users who are signed into {platform}. "
"Kindly sign in and refresh this page to load the content."
msgstr ""
"ཚད་གཞི་འདི་ {platform} ནང་དུ་འཛུལ་བའི་སྤྱོད་མཁན་ཁོ་ནར་ཐོབ་ཐུབ། "
"ནང་དོན་མངོན་ཆེད་ཤོག་ངོས་འདི་ནང་འཇུག་དང་གསར་བརྗེ་གནང་རོགས།"

msgid "NOTE:"
msgstr "དྲན་ཐོ:"

msgid ""
"The email used to sign into this platform and {platform} should be the same."
msgstr ""
"སྟེགས་བུ་འདིའི་ནང་དུ་འཛུལ་བའི་གློག་འཕྲིན་དང་ {platform} དེ་གཅིག་པ་ཡིན་དགོས།"

msgid "Change Preferred Language"
msgstr "བདམས་ཟིན་པའི་སྐད་ཡིག་བརྗེ།"

msgid "Please choose your preferred language"
msgstr "ཁྱེད་ལ་མཁོ་བའི་སྐད་ཡིག་དེ་འདེམ་རོགས།"

msgid "Save Language Settings"
msgstr "སྐད་ཡིག་གི་སྒྲིག་འགོད་ཉར་ཚགས།"

msgid ""
"Don't see your preferred language? {link_start}Volunteer to become a "
"translator!{link_end}"
msgstr ""
"ཁྱེད་ལ་མཁོ་བའི་སྐད་ཡིག་དེ་མི་འདུག་གམ། "
"{link_start}རང་མོས་ལོ་ཙཱ་བ་ཞིག་འགྱུར་ཐབས་བྱོས།{link_end}"

msgid "Explore Courses"
msgstr "སློབ་ཚན་འཚོལ་ཞིབ།"

msgid "Global"
msgstr "རྒྱལ་སྤྱིའི།"

msgid ""
"\n"
"{p_tag}You currently do not have any peer grading to do.  In order to have peer grading to do:\n"
"{ul_tag}\n"
"{li_tag}You need to have submitted a response to a peer grading problem.{end_li_tag}\n"
"{li_tag}The course team needs to score the essays that are used to help you better understand the grading\n"
"criteria.{end_li_tag}\n"
"{li_tag}There must be submissions that are waiting for grading.{end_li_tag}\n"
"{end_ul_tag}\n"
"{end_p_tag}\n"
msgstr ""
"\n"
"{p_tag}མིག་སྔར་ཁྱེད་ལ་རིགས་མཚུངས་གནས་རིམ་དབྱེ་རྒྱུ་གང་ཡང་མི་འདུག རིགས་མཚུངས་གནས་རིམ་དབྱེ་རྒྱུ་ཡོད་དགོས་ན་\n"
"{ul_tag}\n"
"{li_tag}ཁྱེད་ཀྱིས་ངེས་པར་དུ་རིགས་མཚུངས་གནས་རིམ་དབྱེ་རྒྱུའི་དྲི་བ་ཞིག་ལ་ལན་འདེབས་དགོས།{end_li_tag}\n"
"{li_tag}སློབ་ཚན་ཚོགས་ཆུང་གིས་ཁྱེད་ཀྱིས་གནས་རིམ་སྤྲོད་ཚུལ་གྱི་ཚད་གཞི་ལ་གོ་རྟོགས་གང་ལེགས་ཐོབ་ཕྱིར་བཀོལ་བའི་རྩོམ་ཡིག་དེར་སྐར་མ་སྤྲོད་དགོས།\n"
"{end_li_tag}\n"
"{li_tag}གནས་རིམ་དབྱེ་རྒྱུར་སྒུག་ཡོད་པའི་འབུལ་སྤྲོད་བྱས་པ་ངེས་པར་དུ་ཡོད་དགོས།{end_li_tag}\n"
"{end_ul_tag}\n"
"{end_p_tag}\n"

msgid "Peer Grading"
msgstr "རིགས་མཚུངས་གནས་རིམ་དབྱེ་བ།"

msgid ""
"Here is a list of problems that need to be peer graded for this course."
msgstr ""
"འདི་ནི་སློབ་ཚན་འདིའི་གནས་རིམ་ཕྱེས་པ་དང་འདྲ་མཉམ་ཡོང་དགོས་པའི་དྲི་བའི་ཐོ་གཞུང་ཞིག་ཡིན།"

msgid "Problem Name"
msgstr "དྲི་བའི་མིང་།"

msgid "Due date"
msgstr "དུས་བཀག་ཟླ་ཚེས།"

msgid "Graded"
msgstr "གནས་རིམ་བྱས་ཟིན་པ།"

msgid "Available"
msgstr "ཡོད་པ།"

msgid "Required"
msgstr "ཆ་རྐྱེན་བཏོན་པ།"

msgid "No due date"
msgstr "དུས་བཀག་ཟླ་ཚེས་མི་འདུག"

msgid ""
"The due date has passed, and peer grading for this problem is closed at this"
" time."
msgstr ""
"དུས་བཀག་དེ་ཡོལ་ཟིན་འདུག "
"དུས་ཚོད་དེ་དང་ལྷན་དུ་དྲི་བ་འདིར་ཕན་ཚུན་བལྟ་རིས་ཀྱིས་གནས་རིམ་བྱེད་པ་དེ་ཡང་སྒོ་བརྒྱབ་འདུག"

msgid "The due date has passed, and peer grading is closed at this time."
msgstr ""
"དུས་བཀག་དེ་ཡོལ་ཟིན་འདུག "
"དེ་དང་ལྷན་དུ་ཕན་ཚུན་བལྟ་རིས་ཀྱིས་གནས་རིམ་བྱེད་པ་དེ་ཡང་སྒོ་བརྒྱབ་འདུག"

msgid "Learning to Grade"
msgstr "གནས་རིམ་ཅན་སློབ་སྦྱོང་བྱེད།"

msgid "Hide Question"
msgstr "དྲི་བ་སྐུང་།"

msgid "Student Response"
msgstr "སློབ་ཕྲུག་གི་ལན་འདེབས།"

msgid "Written Feedback"
msgstr "ཡིག་ཐོག་བསམ་འཆར།"

msgid "Please include some written feedback as well."
msgstr "ཡིག་ཐོག་བསམ་འཆར་འགའ་ཡང་འདུས་དགོས། ཐུགས་རྗེ་གཟིགས།"

msgid ""
"This submission has explicit, offensive, or (I suspect) plagiarized content."
" "
msgstr ""
"འབུལ་སྤྲོད་བྱས་པ་འདིའི་ནང་དུ་མངོན་གསལ་དོད་པོ། ཁྲིམས་མཐུན་མ་ཡིན་པ། ཡང་ན་(I "
"suspect)རྐུ་བཤུས་བྱས་པའི་ནང་དོན་འདུག"

msgid "How did I do?"
msgstr "ངས་ཇི་ལྟར་བྱས་པ་རེད།"

msgid "Ready to grade!"
msgstr "གནས་རིམ་ཅན་གྲ་སྒྲིག་ཡིན།"

msgid ""
"You have finished learning to grade, which means that you are now ready to "
"start grading."
msgstr ""
"ཁྱེད་ཀྱིས་གནས་རིམ་ཅན་སློབ་གཉེར་གྲུབ་སོང་། "
"དེའི་དོན་ནི་འདི་ལྟར་ཏེ་ཁྱེད་རང་ད་ལྟ་གནས་རིམ་བགོ་བའི་ལས་འགོ་རྩོམ་ཆོག་ཅེས་པའི་དོན་ཡིན།"

msgid "Start Grading!"
msgstr "གནས་རིམ་བྱེད་འགོ་རྩོམ།"

msgid "Learning to grade"
msgstr "གནས་རིམ་ཅན་ལ་སློབ་སྦྱོང་བྱེད།"

msgid "You have not yet finished learning to grade this problem."
msgstr "ཁྱེད་ཀྱིས་དྲི་བ་འདིའི་གནས་རིམ་བྱེད་པའི་སློབ་སྦྱོང་ད་དུང་ཚར་མི་འདུག"

msgid ""
"You will now be shown a series of instructor-scored essays, and will be "
"asked to score them yourself."
msgstr ""
"ད་ལྟ་ཁྱེད་ལ་སློབ་སྟོན་པས་གནས་རིམ་ཕྱེས་པའི་རྩོམ་ཡིག་རིམ་པ་ཅན་ཞིག་སྟོན་ཡོང་བ་དང་ཁྱེད་ཀྱིས་དེ་དག་ལ་ཐོབ་སྐར་སྤྲད་རྒྱུའི་རེ་བ་བྱེད།"

msgid ""
"Once you can score the essays similarly to an instructor, you will be ready "
"to grade your peers."
msgstr ""
"ཁྱེད་ཀྱིས་ཐེངས་གཅིག་རྩོམ་ཡིག་དེར་སློབ་སྟོན་པ་ནང་བཞིན་སྐར་མ་སྤྲོད་ཐུབ་སོང་ན། "
"ཁྱེད་ཀྱིས་རང་ཉིད་དང་རིགས་མཚུངས་པ་རྣམས་ལ་གནས་རིམ་སྤྲད་ཆོག"

msgid "Start learning to grade"
msgstr "གནས་རིམ་ཅན་གྱི་སྦྱོང་འགོ་རྩོམ།"

msgid "Are you sure that you want to flag this submission?"
msgstr "ཁྱེད་ཀྱིས་འབུལ་སྤྲོད་འདི་ལ་དར་རྟགས་འཛུགས་གཏན་འཁེལ་ཡིན་ནམ།"

msgid ""
"You are about to flag a submission. You should only flag a submission that "
"contains explicit, offensive, or  (suspected) plagiarized content. If the "
"submission is not addressed to the question or is incorrect, you should give"
" it a score of zero and accompanying feedback instead of flagging it."
msgstr ""
"ཁྱེད་རང་འབུལ་སྤྲོད་ལ་དར་རྟགས་འགོད་འཚམས་སུ་སླེབས་ཡོད། "
"འབུལ་སྤྲོད་བྱས་པ་དེ་དག་གི་ནང་ཁྲིམས་མཐུན་མ་ཡིན་པ་དང་བཙན་ཤེད་རིགས། ཡང་ན་  "
"(suspected) རྐུ་བཤུས་བྱས་པའི་ནང་དོན་རིགས་ཡོད་ཚེ་དར་རྟགས་ཁོ་ན་འགོད་དགོས། "
"འབུལ་སྤྲོད་བྱས་པ་དེ་དྲི་བ་དེ་དང་འབྲེལ་བ་མེད་པ་དང་ཡང་ན་འགྲིག་མེད་ཚེ། "
"དེར་དར་རྟགས་འགོད་པའི་ཚབ་ལ་ངེས་པར་དུ་ཐོབ་སྐར་ཀླད་ཀོར་སྤྲད་དེ་བསམ་འཆར་དང་མཉམ་སྦྱོར་བྱ་དགོས།"

msgid "Account Settings"
msgstr "ཁ་བྱང་གི་སྒྲིག་འགོད་ཁག"

msgid ""
" and access to private sites offered by MIT Open Learning, Wharton Executive"
" Education, and Harvard Medical School"
msgstr ""
" དེ་བཞིན་MIT ཡི་སློབ་གཉེར་སྤྱི་སྟེགས་དང་། ཝར་ཁྲོན་འཛིན་སྐྱོང་སློབ་གསོ། "
"Wharton Executive Education. "
"ཧ་ཝར་ཌི་སྨན་སློབ་བཅས་ཀྱིས་མཁོ་སྤྲོད་བྱས་པའི་སྒེར་གཉེར་དྲ་ཚིགས་ཁག་ལ་བལྟ་ཀློག་བྱེད་ཐུབ།"

msgid ""
"You can begin your course as soon as you complete the following form. "
"Required fields are marked with an asterisk (*). This information is for the"
" use of {platform_name} only. It will not be linked to your public profile "
"in any way."
msgstr ""
"ཁྱེད་ཀྱིས་གཤམ་གསལ་གྱི་འགེང་ཤོག་དེ་ཆ་ཚང་བཀང་རྗེས་རང་གི་སློབ་ཚན་འགོ་འཛུགས་བྱ་ཆོག"
" དགོས་ངེས་ཀྱི་ཚན་པ་ཁག་ལ་སྐར་རྟགས་ (*)འདི་བཀོད་ཡོད། གནས་ཚུལ་འདི་ནི་ "
"{platform_name} འདི་བཀོལ་སྟངས་ཁོ་ན་ཡིན་པ་ལས། "
"ཁྱེད་ཀྱི་སྤྱི་སྤྱོད་དྲ་གནས་གང་ལ་ཡང་སྤྲེལ་མཐུད་མི་བྱེད།"

msgid ""
"Please make sure your browser is updated to the {strong_start}{a_start}most "
"recent version possible{a_end}{strong_end}. Also, please make sure your "
"{strong_start}webcam is plugged in, turned on, and allowed to function in "
"your web browser (commonly adjustable in your browser settings).{strong_end}"
msgstr ""
"ཁྱེད་ཀྱི་བལྟ་བཤེར་དྲ་ཚིགས་དེའི་ཐོན་རིམ་ "
"{strong_start}{a_start}འདི་ལ་རིམ་སྤར་བྱས་ཡོད་མེད་གཏན་འཁེལ་བྱོས།{a_end}{strong_end}མིང་སྔའི་ཐོན་གསར་ཤོས།"
" མ་ཟད་ཁྱེད་ཀྱི་ "
"{strong_start}བརྙན་མིག་དེ་ཏག་ཏག་མཐུད་ཡོད་མེད་དང་སྒོ་ཕྱེས་ཡོད་མེད། "
"དེ་བཞིན་དེའི་ཁྱད་ཆོས་ཁག་ཁྱེད་ཀྱི་བལྟ་བཤེར་དྲ་ཚིགས་ (commonly adjustable in "
