msgstr ""
"ཁྱེད་རང་ངོས་ལེན་བྱས་པའི་གནས་བབས་དེ་ལོ་གཉིས་རིང་ཚུལ་མཐུན་རང་བཞིན་གྱིས་གནས་ཐུབ་ཅིང་།"
" དུས་ཚོད་ཡོལ་དུས་ནི་ {expiration_datetime} ཉིན་ཡིན།"

msgid "Hi {full_name},"
msgstr "བཀྲ་ཤིས་བདེ་ལེགས། {full_name}"

msgid "Thanks for submitting your photos!"
msgstr "འདྲ་པར་འབུལ་སྤྲོད་བྱས་པར་བཀའ་དྲིན་ཆེ།"

msgid ""
"We've received your information and the ID verification process has "
"begun.Check for an email from us in the next few days to confirm whether "
"your verification was successful.You can also check the status of the "
"verification process on your dashboard."
msgstr ""
"ཁྱེད་ལ་རང་ཉིད་ཀྱི་གནས་ཚུལ་འབྱོར་ཡོད་པ་དང་ ID "
"དེའི་ཁུངས་སྐྱེལ་གྱི་བརྒྱུད་རིམ་རྣམས་འགོ་བརྩམས་ཡོད། "
"གཞུག་གི་ཉིན་ཤེས་ནང་ང་ཚོས་ཁྱེད་ལ་ཁྱེད་ཀྱིས་ཁུངས་སྐྱེལ་བྱས་པ་དེ་ལེགས་འགྲུབ་བྱུང་ཡོད་མེད་གཏན་འཁེལ་གྱི་གློག་འཕྲིན་ཞིག་འབྱོར་ཡོང་བས་དེ་ལ་བརྟག་དཔྱད་བྱ་རོགས།"
" "
"ཁྱེད་ཀྱིས་རང་ཉིད་ཀྱི་གཙོ་ངོས་སྒང་ནས་ཀྱང་ཁུངས་སྐྱེལ་བརྒྱུད་རིམ་གྱི་གནས་བབ་ལ་གཟིགས་ཞིབ་བྱེད་ཐུབ་པ་ཡིན།"

msgid ""
"We are sorry. Our course staff did not approve your request to change your "
"name from {old_name} to {new_name}. If you need further assistance, please "
"e-mail the course staff at {email}."
msgstr ""
"ང་ཚོས་ཁྱེད་ལ་དགོངས་དག་ཞུ། ང་ཚོའི་ལས་བྱེད་ཀྱིས་ཁྱེད་ཀྱི་མིང་{old_name} "
"འདི་ནས་ {new_name} འདི་ལ་བསྒྱུར་བ་ངོས་ལེན་བྱས་མ་སོང་། "
"ཁྱེད་ཀྱིས་དེ་ལས་ཞིབ་ཕྲ་མཁྱེན་འདོད་ཚེ་ {email} "
"འདི་བརྒྱུད་ནས་ང་ཚོའི་ལས་བྱེད་ལ་འབྲེལ་བ་བྱ་རོགས།"

msgid ""
"We have successfully verified your identity for the {assessment} assessment "
"in the {course_name} course."
msgstr ""
"སློབ་ཚན་{course_name} འདིའི་ནང་གི་བརྟག་དཔྱད་{assessment} "
"འདིའི་ཆེད་དུ་ང་ཚོས་ཁྱེད་ཀྱི་ID ཁུངས་སྐྱེལ་ལེགས་པར་བྱས་ཡོད།"

msgid ""
"We could not verify your identity for the {assessment} assessment in the "
"{course_name} course. You have used {used_attempts} out of "
"{allowed_attempts} attempts to verify your identity."
msgstr ""
"སློབ་ཚན་{course_name} འདིའི་ནང་གི་བརྟག་དཔྱད་{assessment} "
"འདིའི་ཆེད་དུ་ང་ཚོས་ཁྱེད་ཀྱི་ID ཁུངས་སྐྱེལ་བྱེད་ཐུབ་མ་སོང་། "
"ཁྱེད་ཀྱིས་IDཁུངས་སྐྱེལ་ཚོད་ལྟ་{used_attempts} ཚད་བཀག་ {allowed_attempts} "
"ལས་བརྒལ་བ་བྱས་འདུག"

