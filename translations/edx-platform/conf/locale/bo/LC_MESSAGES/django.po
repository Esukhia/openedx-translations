msgstr "ཕྱི་རོལ་ཀྱི་ར་སྤྲོད་ཁུངས་སྐྱེལ་དེ་ལེགས་འགྲུབ་བྱུང་མ་སོང་།"

msgid "organization logo"
msgstr "སྒྲིག་འཛུགས་ཀྱི་ལས་རྟགས།"

msgid "Password Reset"
msgstr "གསང་གྲངས་བསྐྱར་སྒྲིག"

msgid ""
"Please enter your e-mail address below, and we will e-mail instructions for "
"setting a new password."
msgstr ""
"གཤམ་ལ་ཁྱེད་ཀྱི་གློག་འཕྲིན་ཞོག་དང་། "
"ང་ཚོས་གསང་གྲངས་གསར་པ་ཞིག་གི་སྒྲིག་འགོད་ཀྱི་གློག་འཕྲིན་ལམ་སྟོན་གཏོང་ཡོང་།"

msgid "Required Information"
msgstr "ཆ་རྐྱེན་ལྟར་བཏོན་པའི་གནས་ཚུལ།"

msgid "Your E-mail Address"
msgstr "ཁྱེད་ཀྱི་གློག་འཕྲིན།"

msgid "This is the e-mail address you used to register with {platform}"
msgstr "འདི་ནི་ཁྱེད་ཀྱིས་ {platform} འདིའི་ནང་ཐོ་འགོད་བྱས་པའི་གློག་འཕྲིན་ཡིན།"

msgid "Reset My Password"
msgstr "ངའི་གསང་ཚིག་བསྐྱར་སྒྲིག"

msgid "Email is incorrect."
msgstr "གློག་འཕྲིན་འདི་ཚུལ་མཐུན་ཞིག་མ་རེད།"

msgid "The course has ended."
msgstr "སློབ་ཚན་དེ་མཇུག་བསྡུས་འདུག"

msgid "The due date for this assignment has passed."
msgstr "ལས་འགན་འདིའི་དུས་བཀག་ཟིན་ཚར་འདུག"

msgid ""
"Because the course has ended, this assignment is no longer "
"available.{line_break}If you have completed this assignment, your grade is "
"available on the {link_start}progress page{link_end}."
msgstr ""
"སློབ་ཚན་དེ་མཚམས་བཞག་ཟིན་པས་ལས་འགན་དེ་ཡང་ཡུན་གནས་མི་ཐུབ་པ་ཡིན། "
"{line_break}གལ་སྲིད་ཁྱེད་ཀྱིས་ལས་འགན་འདི་ཆ་ཚང་བསྒྲུབས་ཟིན་ཡོད་ན། "
"ཁྱེད་ཀྱི་གནས་རིམ་ནི་འཁྲིས་ཀྱི་དྲ་ཐག་དེའི་སྒང་གནས་ཡོད། "
"{link_start}ཡར་རྒྱས་ཀྱི་ཤོག་ངོས།{link_end}"

msgid ""
"Because the due date has passed, this assignment is no longer "
"available.{line_break}If you have completed this assignment, your grade is "
"available on the {link_start}progress page{link_end}."
msgstr ""
"དུས་བཀག་དེ་ཡོལ་ཟིན་པས་ལས་འགན་དེ་ཡང་ཡུན་གནས་མི་ཐུབ་པ་ཡིན། "
"{line_break}གལ་སྲིད་ཁྱེད་ཀྱིས་ལས་འགན་འདི་ཆ་ཚང་བསྒྲུབས་ཟིན་ཡོད་ན། "
"ཁྱེད་ཀྱི་གནས་རིམ་ནི་འཁྲིས་ཀྱི་དྲ་ཐག་དེའི་སྒང་གནས་ཡོད། "
"{link_start}ཡར་རྒྱས་ཀྱི་ཤོག་ངོས།{link_end}"

msgid "Search for a course"
msgstr "སློབ་ཚན་ཞིག་ཚོལ།"

msgid "Welcome to {platform_name}"
msgstr "འདིར་ {platform_name} ཕེབས་པར་དགའ་བསུ་ཞུ།"

msgid "It works! Powered by the Open edX{registered_trademark} Platform"
msgstr ""
"འདི་ལས་ཀ་བྱེད་ཀྱི་འདུག ཁ་ཕྱེ་བའི་ཨེ་ཌི་ཨེགསི་ {registered_trademark} "
"སྟེགས་བུ་ཡིས་ཤུགས་སྣོན་བྱས།"

msgid "Invalid email change key"
msgstr "ཚུལ་མཐུན་མིན་པའི་གློག་འཕྲིན་བརྗེ་བསྒྱུར་གྱི་ལྡེ་མིག"

msgid "This e-mail key is not valid. Please check:"
msgstr "གློག་འཕྲིན་ལྡེ་མིག་འདི་ཚུལ་མཐུན་ཞིག་རེད་མི་འདུག ཞིབ་འཇུག་བྱ་རོགས།"

msgid ""
"Was this key already used? Check whether the e-mail change has already "
"happened."
msgstr ""
"ལྡེ་མིག་འདི་སྔ་མོ་ནས་བཀོལ་སྤྱོད་བྱས་འདུག་གམ། "
"གློག་འཕྲིན་བརྗེ་བསྒྱུར་བྱས་ཟིན་ཡོད་མེད་ཞིབ་འཇུག་བྱོས།"

