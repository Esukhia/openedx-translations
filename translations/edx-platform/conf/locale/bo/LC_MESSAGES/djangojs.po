"\n"
" རྣམ་གྲངས་འདི་ལ་འབྲེལ་མཐུད་བྱེད་པའི་ནང་དོན་གང་རུང་གིས་ལས་ཀ་བྱེད་མི་ཐུབ། (དཔེར་ན། པར་རིས་ཆག་པ་དང་/ཡང་ན་འབྲེལ་མཐུད་)"


msgid "Your file has been deleted."
msgstr "ཁྱེད་ཀྱི་ཡིག་ཆ་བསུབ་ཚར་འདུག"

msgid "Name"
msgstr "མིང་།"

msgid "Date Added"
msgstr "ཟླ་ཚེས་བསྣན་འདུག"

msgid "Type"
msgstr "རིགས།"

msgid "File {filename} exceeds maximum size of {maxFileSizeInMBs} MB"
msgstr "ཡིག་ཚགས་ {filename} ནི་ {maxFileSizeInMBs} ལས་བརྒལ་བ།"

msgid "Please follow the instructions here to upload a file elsewhere and link to it: {maxFileSizeRedirectUrl}"
msgstr "འདིར་བཀོད་པའི་ལམ་སྟོན་ལྟར་ཡིག་ཆ་ཞིག་ས་ཆ་གཞན་དུ་ཡར་བསྐུར་དང་སྦྲེལ་མཐུད་གནང་རོགས། {maxFileSizeRedirectUrl}"

msgid "Max file size exceeded"
msgstr "ཆེས་མཐོ་བའི་ཡིག་ཆའི་ཆེ་ཆུང་ལས་བརྒལ་བ།"

msgid "Choose File"
msgstr "ཡིག་ཆ་འདེམ།"

msgid "Upload New File"
msgstr "ཡིག་ཆ་གསར་པ་ཡར་བསྐུར།"

msgid "Load Another File"
msgstr "ཡིག་ཆ་གཞན་ཞིག་བླུགས།"

msgid "Add library content"
msgstr "དཔེ་མཛོད་ནང་དོན་བསྒྱུར་རོགས་"

msgid "Adding"
msgstr "ཁ་སྣོན་བྱེད་པ།"

msgid "{startTag}{requestToken}{endTag}{selector}"
msgstr "{startTag} {requestToken} {endTag} {selector}"

msgid "Are you sure you want to delete this update?"
msgstr "རིམ་སྤར་འདི་ངོ་མ་བསུབ་རྒྱུ་ཡིན་ནམ།"

msgid "OK"
msgstr "འགྲིག"

msgid "Copying"
msgstr "འདྲ་བཤུས་བྱེད་པ།"

msgid "Copy of '{componentDisplayName}'"
msgstr "&#39;{ཆ་ཤས་མངོན་མིང་}&#39; འདྲ་བཤུས།"

msgid "Pasting"
msgstr "སྦྱར་བ།"

msgid "Some errors occurred"
msgstr "ནོར་འཁྲུལ་འགའ་བྱུང་།"

msgid "The following required files could not be added to the course:"
msgstr "གཤམ་གསལ་དགོས་མཁོའི་ཡིག་ཆ་རྣམས་སློབ་ཚན་ནང་ཁ་སྣོན་བྱེད་མ་ཐུབ།"

msgid "You may need to update a file(s) manually"
msgstr "ཁྱོད་ཀྱིས་ཡིག་ཆ་ཞིག་ལག་ཐོག་ནས་གསར་བརྗེ་བྱེད་དགོས་སྲིད།"

msgid "The following files already exist in this course but don't match the version used by the component you pasted:"
msgstr "གཤམ་གྱི་ཡིག་ཆ་རྣམས་སློབ་ཚན་འདིའི་ནང་དུ་ཡོད་ཀྱང་ཁྱེད་ཀྱིས་སྦྱར་བའི་ཆ་ཤས་ཀྱིས་བེད་སྤྱོད་བྱས་པའི་ཐོན་རིམ་དང་མཐུན་མི་ཐུབ།"

msgid "New file(s) added to Files & Uploads."
msgstr "ཡིག་ཆ་དང་ཡར་བསྐུར་ལ་ཡིག་ཆ་གསར་པ་ཁ་སྣོན་བྱས།"

msgid "The following required files were imported to this course:"
msgstr "སློབ་ཚན་འདིར་གཤམ་གསལ་དགོས་མཁོའི་ཡིག་ཆ་ཁག་ནང་འདྲེན་བྱས་ཡོད།"

msgid "View files"
msgstr "ཡིག་ཆ་ལྟ་བ།"

msgid "Dismiss"
msgstr "ཕྱིར་ལྡོག"

msgid "Create Re-run"
msgstr "གསར་སྐྲུན། ཡང་བསྐྱར་རྒྱུག་པ།"

msgid "Processing Re-run Request"
msgstr "བསྐྱར་དུ་གཉེར་བའི་རེ་འདུན་ལ་ལས་སྣོན་བྱེད་པ།"

msgid "An error has occurred. Wait a few minutes, and then try again."
msgstr "ནོར་འཁྲུལ་ཞིག་བྱུང་ཡོད། སྐར་མ་འགའ་ཤས་སྒུག་རྗེས་ཡང་བསྐྱར་ཚོད་ལྟ་བྱོས།"

msgid "None"
msgstr "མེད།"

msgid "Select turnaround"
msgstr "འཁོར་རྒྱུག་འདེམས།"

msgid "Select fidelity"
msgstr "དྲང་བདེན་འདེམས།"

msgid "Select language"
msgstr "སྐད་ཡིག་འདེམས་པ།"

msgid "Remove"
msgstr "སུབ།"

msgid "Press Remove to remove language"
msgstr "སྐད་ཡིག་རྩ་མེད་གཏོང་བའི་ཆེད་དུ་རྩ་བསྐྲད་གནོན་དགོས།"

msgid "Settings updated"
msgstr "སྒྲིག་སྟངས་གསར་བཅོས་བྱས།"

msgid "Last updated"
msgstr "མཐའ་མཇུག་ཏུ་ཁ་གསབ་བྱས་པ།"

msgid "Required"
msgstr "ཆ་རྐྱེན་བཏོན་པ།"

msgid "Automatic transcripts are disabled."
msgstr "རང་འགུལ་ཡིག་བསྒྱུར་ལྕོགས་མིན་བཟོས་ཡོད།"

msgid "{selectedProvider} credentials saved"
msgstr "{selectedProvider} ཆོག་མཆན་ཉར་ཚགས་བྱས།"

msgid "Upload a new PDF to “<%- name %>”"
msgstr "“&lt;%- name %&gt;” ལ་PDFགསར་པ་ཞིག་ཡར་བསྐུར་དགོས།"

msgid "Please select a PDF file to upload."
msgstr "ཡར་བསྐུར་ཆེད་PDFཡིག་ཆ་ཞིག་འདེམས་རོགས།"

msgid "There has been an error while exporting."
msgstr "ཕྱིར་གཏོང་བྱེད་སྐབས་ནོར་འཁྲུལ་བྱུང་ཡོད།"

msgid "There has been a failure to export to XML at least one component. It is recommended that you go to the edit page and repair the error before attempting another export. Please check that all components on the page are valid and do not display any error messages."
msgstr "ཉུང་མཐར་ཡང་ཆ་ཤས་གཅིག་XMLལ་ཕྱིར་གཏོང་བྱེད་པར་འཐུས་ཤོར་བྱུང་ཡོད། ཕྱིར་གཏོང་གཞན་ཞིག་མ་འབད་གོང་རྩོམ་སྒྲིག་ཤོག་ངོས་ལ་སོང་ནས་ནོར་འཁྲུལ་བཟོ་བཅོས་བྱེད་དགོས་པའི་བསམ་འཆར་ཡོད། ཤོག་ངོས་སྟེང་གི་ཆ་ཤས་ཚང་མ་ནུས་ལྡན་ཡིན་མིན་དང་ནོར་འཁྲུལ་གྱི་བརྡ་འཕྲིན་གང་ཡང་མ་སྟོན་པར་ཞིབ་བཤེར་གནང་རོགས།"

msgid "Correct failed component"
msgstr "འཐུས་ཤོར་བྱུང་བའི་ཆ་ཤས་ཡོ་བསྲང་།"

msgid "Return to Export"
msgstr "ཕྱིར་གཏོང་ལ་ཕྱིར་ལོག་བྱེད་པ།"

msgid "Your library could not be exported to XML. There is not enough information to identify the failed component. Inspect your library to identify any problematic components and try again."
msgstr "ཁྱེད་ཀྱི་དཔེ་མཛོད་དེ་XMLལ་ཕྱིར་འདྲེན་བྱེད་མ་ཐུབ། འཐུས་ཤོར་བྱུང་བའི་ཆ་ཤས་ངོས་འཛིན་བྱེད་པའི་ཆ་འཕྲིན་འདང་ངེས་ཤིག་མེད་པ་རེད། ཁྱེད་རང་གི་དཔེ་མཛོད་ལ་ཞིབ་བཤེར་བྱས་ནས་དཀའ་ངལ་ཡོད་པའི་ཆ་ཤས་གང་རུང་ངོས་འཛིན་བྱས་ནས་བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Take me to the main library page"
msgstr "དཔེ་མཛོད་གཙོ་བོའི་ཤོག་ངོས་སུ་འཁྲིད་རོགས།"

msgid "Your course could not be exported to XML. There is not enough information to identify the failed component. Inspect your course to identify any problematic components and try again."
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན་དེ་XMLལ་ཕྱིར་གཏོང་བྱེད་མ་ཐུབ། འཐུས་ཤོར་བྱུང་བའི་ཆ་ཤས་ངོས་འཛིན་བྱེད་པའི་ཆ་འཕྲིན་འདང་ངེས་ཤིག་མེད་པ་རེད། ཁྱེད་རང་གི་སློབ་ཚན་ལ་ཞིབ་བཤེར་བྱས་ནས་དཀའ་ངལ་ཡོད་པའི་ཆ་ཤས་གང་རུང་ངོས་འཛིན་བྱས་ནས་བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Take me to the main course page"
msgstr "ང་རང་ཟ་མ་གཙོ་བོའི་ཤོག་ངོས་སུ་འཁྲིད་རོགས།"

msgid "The raw error message is:"
msgstr "ནོར་འཁྲུལ་བརྡ་འཕྲིན་གཙོ་བོ་ནི།"

msgid "There has been an error with your export."
msgstr "ཁྱེད་ཀྱི་ཕྱིར་གཏོང་ལ་ནོར་འཁྲུལ་བྱུང་ཡོད།"

msgid "Not in Use"
msgstr "བེད་སྤྱོད་མེད་པ།"

msgid "group configuration"
msgstr "སྡེ་ཚན་སྒྲིག་བཀོད།"

msgid "Add your first group configuration"
msgstr "རང་གི་སྡེ་ཚན་དང་པོའི་སྒྲིག་བཀོད་ཁ་སྣོན་བྱེད་པ།"

msgid "You have not created any group configurations yet."
msgstr "ཁྱེད་ཀྱིས་ད་དུང་ཚོགས་པའི་སྒྲིག་བཀོད་གང་ཡང་གསར་བཟོ་བྱས་མེད།"

msgid "Upload instructor image."
msgstr "སློབ་སྟོན་པའི་པར་རིས་ཡར་བསྐུར།"

msgid "Files must be in JPEG or PNG format."
msgstr "འདྲ་པར་གྱི་རྣམ་སྒྲིག་JPEG དང་ཡང་ན་ PNG གང་རུང་ཞིག་ཡིན་དགོས།"

msgid "All Rights Reserved"
msgstr "ཆ་ཚང་ལ་བདག་དབང་བཞག་ཡོད།"

msgid "You reserve all rights for your work"
msgstr "རང་གི་ལས་ཀའི་ཐོབ་ཐང་ཡོད་ཚད་ཉར་ཚགས་བྱས་ཡོད།"

msgid "Creative Commons"
msgstr "གསར་གཏོད་ཐུན་མོང་།"

msgid "You waive some rights for your work, such that others can use it too"
msgstr "ཁྱོད་ཀྱིས་ཁྱོད་ཀྱི་ལས་ཀའི་ཐོབ་ཐང་འགའ་ཤས་སྤོང་། དེ་ལྟར་གཞན་གྱིས་ཀྱང་བེད་སྤྱོད་གཏོང་ཐུབ།"

msgid "Version"
msgstr "པར་གཞི"

msgid "Attribution"
msgstr "Attribution"

msgid "Allow others to copy, distribute, display and perform your copyrighted work but only if they give credit the way you request. Currently, this option is required."
msgstr "ཁྱེད་ཀྱི་དཔེ་སྐྲུན་བདག་དབང་ཡོད་པའི་ལས་ཀ་དེ་གཞན་ལ་འདྲ་བཤུས་དང་། བཀྲམ་སྤེལ། འགྲེམས་སྟོན་བྱེད་ཆོག འོན་ཀྱང་ཁོང་ཚོས་ཁྱེད་ཀྱིས་འབོད་སྐུལ་བྱས་པ་ལྟར་ཡིད་ཆེས་སྤྲོད་ན། ད་ལྟའི་ཆར་གདམ་ག་འདི་དགོས་ངེས་ཡིན།"

msgid "Noncommercial"
msgstr "ཚོང་བསྒྱུར་མ་ཡིན་པ།"

msgid "Allow others to copy, distribute, display and perform your work - and derivative works based upon it - but for noncommercial purposes only."
msgstr "ཁྱེད་ཀྱི་ལས་ཀ་དེ་གཞན་ལ་འདྲ་བཤུས་དང་། བཀྲམ་སྤེལ། འགྲེམས་སྟོན་བྱེད་ཆོག དེ་བཞིན་དེ་ལ་གཞི་བཅོལ་བའི་ལས་ཀ་དེ་དག་ཚོང་ལས་མ་ཡིན་པའི་དམིགས་ཡུལ་ཆེད་དུ་ཡིན།"

msgid "No Derivatives"
msgstr "No Derivatives"

msgid "Allow others to copy, distribute, display and perform only verbatim copies of your work, not derivative works based upon it. This option is incompatible with \"Share Alike\"."
msgstr "ཁྱེད་ཀྱི་ལས་ཀའི་ཚིག་ཕྲད་ཀྱི་འདྲ་བཤུས་ཁོ་ན་གཞན་ལ་འདྲ་བཤུས་དང་། བཀྲམ་སྤེལ། འགྲེམས་སྟོན་བྱེད་ཆོག དེ་ལ་བརྟེན་ནས་བྱུང་བའི་ལས་ཀ་མིན། གདམ་ཁ་འདི་&quot;Share Alike&quot;དང་མི་མཐུན་པ་རེད།"

msgid "Share Alike"
msgstr "Share Alike"

msgid "Allow others to distribute derivative works only under a license identical to the license that governs your work. This option is incompatible with \"No Derivatives\"."
msgstr "ཁྱེད་ཀྱི་ལས་ཀ་ལ་དབང་སྒྱུར་བྱེད་པའི་ཆོག་མཆན་དང་འདྲ་བའི་ཆོག་མཆན་འོག་གཞན་ལ་ལས་བྱུང་བའི་བརྩམས་ཆོས་བཀྲམ་སྤེལ་བྱེད་ཆོག གདམ་ཁ་འདི་&quot;འབྱུང་ཁུངས་མེད་པ&quot;དང་མཐུན་སྒྲིལ་མེད།"

msgid "Delete this %(item_display_name)s?"
msgstr "འདི་ %(item_display_name)s བསུབས་དགོས་སམ།"

msgid "Deleting this %(item_display_name)s is permanent and cannot be undone."
msgstr "%(item_display_name)s འདི་སུབ་པ་ནི་གཏན་འཇགས་ཡིན་པས་ཕྱིར་འཐེན་བྱེད་མི་ཐུབ།"

msgid "Ok"
msgstr "འགྲིག"

msgid "There was an error changing the user's role"
msgstr "སྤྱོད་མཁན་གྱི་ལས་འགན་བསྒྱུར་སྐབས་ནོར་འཁྲུལ་བྱུང་།"

msgid "Unknown"
msgstr "ཁ་མི་གསལ།"

msgid "Error adding user"
msgstr "སྤྱོད་མཁན་ཁ་སྣོན་བྱེད་སྐབས་ནོར་འཁྲུལ།"

msgid "Error removing user"
