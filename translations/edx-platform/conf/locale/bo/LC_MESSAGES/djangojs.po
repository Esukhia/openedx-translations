#: lms/static/js/fixtures/donation.underscore:5
#: lms/templates/dashboard/donation.underscore:5
msgid "Donate"
msgstr "ཞལ་འདེབས།"

msgid "This may be happening because of an error with our server or your internet connection. Try refreshing the page or making sure you are online."
msgstr "འདིའི་འབྱུང་རྐྱེན་ནི་ཕལ་ཆེར་ང་ཚོའི་གསོག་མཛོད་ལ་གནད་དོན་ཡོད་པ་དང་ཡང་ན་ཁྱེད་ཀྱི་དྲ་རྒྱ་ཏག་ཏག་མཐུད་ཡོད་མེད་ཀྱི་གནད་དོན་གང་རུང་ཡིན་སྲིད། ཤོག་ངོས་འདི་བསྐྱར་སྐོར་བྱེད་པ་དང་ཁྱེད་དྲ་རྒྱ་ལ་ཏག་ཏག་མཐུད་ཡོད་མེད་ཞིབ་འཇུག་བྱོས།"

msgid "Studio's having trouble saving your work"
msgstr "གློག་བརྙན་ཁང་ལ་ཁྱེད་ཀྱི་བརྩམས་ཆོས་ཉར་ཚགས་བྱེད་པར་དཀའ་ངལ་འཕྲད་ཀྱིན་འདུག"

msgid "OpenAssessment Save Error"
msgstr "OpenAssessment ཉར་ཚགས་ནོར་འཁྲུལ།"

msgid "Saving"
msgstr "ཉར་ཚགས་བྱེད་མུས།"

msgid "This link will open in a new browser window/tab"
msgstr "འབྲེལ་མཐུད་འདི་དྲ་ངོས་གསར་པའི་སྒེའུ་ཁུང་/མཆོང་ལྡེའི་ནང་དུ་ཁ་ཕྱེ་ཐུབ།"

msgid "This link will open in a modal window"
msgstr "སྦྲེལ་མཐུད་འདི་མོ་ཌལ་སྒེའུ་ཁུང་ནང་ཁ་ཕྱེ་ཐུབ།"

msgid "Certificate name is required."
msgstr "ལག་འཁྱེར་མིང་དགོས་པ།"

msgid "Signatory field(s) has invalid data."
msgstr "མཚན་རྟགས་བཀོད་པའི་ས་ཁོངས་ལ་གྲངས་ཐོ་ནུས་མེད་ཡོད།"

msgid "Edit this certificate?"
msgstr "ལག་འཁྱེར་འདི་རྩོམ་སྒྲིག་བྱེད་དམ།"

msgid "This certificate has already been activated and is live. Are you sure you want to continue editing?"
msgstr "ལག་འཁྱེར་འདི་སྔོན་ནས་འགུལ་སྐྱོད་བྱས་ཟིན་པ་དང་ཐད་གཏོང་བྱེད་བཞིན་ཡོད། མུ་མཐུད་རྩོམ་སྒྲིག་བྱེད་འདོད་པ་གཏན་ཁེལ་ཡིན་ནམ།"

msgid "Yes, allow edits to the active Certificate"
msgstr "རེད། ལག་འཁྱེར་ཤུགས་ལྡན་ལ་བཟོ་བཅོས་བྱེད་ཆོག"

msgid "certificate"
msgstr "ལག་འཁྱེར"

msgid "Deactivating"
msgstr "ནུས་མེད་བཟོ་བ།"

msgid "Set up your certificate"
msgstr "ལག་ཁྱེར་སྒྲིག་འཛུགས་བྱེད་པ།"

msgid "You have not created any certificates yet."
msgstr "ཁྱེད་ཀྱིས་ད་དུང་ལག་འཁྱེར་གང་ཡང་གསར་བཟོ་བྱས་མེད།"

msgid "Delete \"<%- signatoryName %>\" from the list of signatories?"
msgstr "&quot;&lt;%- signatoryName %&gt;&quot; མིང་རྟགས་བཀོད་མཁན་གྱི་ཐོ་གཞུང་ནས་སུབ་དགོས་སམ།"

msgid "This action cannot be undone."
msgstr "ལས་ཀ་འདི་ཕྱིར་སླར་གསོ་བྱ་མི་ཐུབ།"

msgid "Delete"
msgstr "སུབ།"

msgid "Deleting"
msgstr "སུབ་བཞིན་ཡོད།"

msgid "Cancel"
msgstr "ཕྱིར་འཐེན།"

msgid "Upload signature image."
msgstr "མཚན་རྟགས་པར་རིས་ཡར་བསྐུར།"

msgid "Image must be in PNG format."
msgstr "པར་རིས་དེ་PNGཡི་རྣམ་པ་ཡིན་དགོས།"

msgid "Group %s"
msgstr "སྡེ་ཚན་ %s །"

msgid "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
msgstr "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

msgid "Your export has failed."
msgstr "ཁྱེད་ཀྱི་ཕྱིར་གཏོང་འཐུས་ཤོར་བྱུང་།"

msgid "Already a course team member"
msgstr "སློབ་ཚན་རུ་ཁག་གི་ཚོགས་མི་ཡིན་ཟིན།"

msgid "Are you sure you want to delete {email} from the course team for “{container}”?"
msgstr "ཁྱེད་རང་གིས་“ {container} ” ཡི་སློབ་ཚན་རུ་ཁག་ནས་ {email} བསུབས་འདོད་ཡོད་དམ།"

msgid "Staff"
msgstr "ལས་བྱེད།"

msgid "Admin"
msgstr "འཛིན་སྐྱོང་།"

msgid "Already a library team member"
msgstr "དཔེ་མཛོད་རུ་ཁག་གི་ཁོངས་མི་ཡིན་ཟིན།"

msgid "Are you sure you want to delete {email} from the library “{container}”?"
msgstr "ཁྱེད་རང་གིས་དཔེ་མཛོད་ “ {container} ” ནས་ {email} བསུབས་འདོད་ཡོད་དམ།"

msgid "Library User"
msgstr "དཔེ་མཛོད་ཁང་སྤྱོད་མཁན།"

msgid "Hide Deprecated Settings"
msgstr "བེད་སྤྱོད་མེད་པའི་སྒྲིག་སྟངས་སྦ་བ།"

msgid "Show Deprecated Settings"
msgstr "བེད་སྤྱོད་མེད་པའི་སྒྲིག་སྟངས་སྟོན།"

msgid "You have unsaved changes. Do you really want to leave this page?"
msgstr "ཁྱེད་ལ་ཉར་ཚགས་མ་བྱས་པའི་བསྒྱུར་བཅོས་ཡོད། ཁྱེད་རང་དངོས་གནས་ཤོག་ངོས་འདི་དང་ཁ་འབྲལ་འདོད་དམ།"

msgid "There was an error during the upload process."
msgstr "ཡར་བསྐུར་སྐབས་ནོར་འཁྲུལ་ཞིག་བྱུང་སོང་།"

msgid "There was an error while unpacking the file."
msgstr "ཡིག་ཆ་ཁ་ཕྱེ་སྐབས་ནོར་འཁྲུལ་བྱུང་ཡོད།"

msgid "There was an error while verifying the file you submitted."
msgstr "ཁྱེད་ཀྱིས་ཕུལ་བའི་ཡིག་ཆ་དེ་བདེན་དཔང་བྱེད་སྐབས་ནོར་འཁྲུལ་བྱུང་ཡོད།"

msgid "Choose new file"
msgstr "ཡིག་ཆ་གསར་པ་འདེམས།"

msgid "File format not supported. Please upload a file with a {ext} extension."
msgstr "ཡིག་ཆའི་རྣམ་གཞག་ལ་རྒྱབ་སྐྱོར་བྱེད་ཀྱི་མེད། {ext} རྒྱ་བསྐྱེད་ཡོད་པའི་ཡིག་ཆ་ཞིག་ཡར་བསྐུར་རོགས།"

msgid "There was an error while importing the new library to our database."
msgstr "ང་ཚོའི་གཞི་གྲངས་མཛོད་ནང་དཔེ་མཛོད་གསར་པ་ནང་འདྲེན་བྱེད་སྐབས་ནོར་འཁྲུལ་ཞིག་བྱུང་ཡོད།"

msgid "There was an error while importing the new course to our database."
msgstr "ང་ཚོའི་གཞི་གྲངས་མཛོད་ནང་སློབ་ཚན་གསར་པ་ནང་འདྲེན་བྱེད་སྐབས་ནོར་འཁྲུལ་བྱུང་ཡོད།"

msgid "Your import has failed."
msgstr "ཁྱེད་ཀྱི་ནང་འདྲེན་འཐུས་ཤོར་སོང་།"

msgid "Your import is in progress; navigating away will abort it."
msgstr "ཁྱེད་ཀྱི་ནང་འདྲེན་བྱེད་བཞིན་ཡོད། ཕྱིར་འགྲོ་ན་དེ་མཚམས་འཇོག་བྱེད།"

msgid "Error importing course"
msgstr "སློབ་ཚན་ནང་འདྲེན་བྱེད་སྐབས་ནོར་འཁྲུལ།"

msgid "There was an error with the upload"
msgstr "ཡར་བསྐུར་སྐབས་ནོར་འཁྲུལ་བྱུང་།"

msgid "Queued"
msgstr "གྲལ་སྒྲིག་པ།"

msgid "Uploading"
msgstr "ནང་འཇུག་བྱེད་བཞིན་ཡོད།"

msgid "Upload completed"
msgstr "ནང་འཇུག་བྱས་པ་ཆ་ཚང་གྲུབ་སོང་།"

msgid "Upload failed"
msgstr "ཡར་བསྐུར་མ་འགྲུབ་པ།"

msgid "Chapter name and asset_path are both required"
msgstr "ལེའུ་མིང་དང་རྒྱུ་ནོར་གྱི་འགྲོ་ལམ་གཉིས་ཀ་དགོས་ངེས་ཡིན།"

msgid "Chapter name is required"
msgstr "ལེའུ་མིང་དགོས་པ།"

msgid "asset_path is required"
msgstr "asset_path དགོས་པ།"

msgid "You must specify a name"
msgstr "མིང་གཏན་འཁེལ་བྱེད་དགོས།"

msgid "Action required: Enter a valid date."
msgstr "བྱ་སྤྱོད་དགོས་མཁོ། ནུས་ལྡན་ཚེས་གྲངས་བླུགས།"

msgid "Group name is required"
msgstr "སྡེ་ཚན་གྱི་མིང་དགོས་པ།"

msgid "Group A"
msgstr "སྡེ་ཚན་ཀ།"

msgid "Group B"
msgstr "སྡེ་ཚན་ཁ།"

msgid "Group Configuration name is required."
msgstr "སྡེ་ཚན་སྒྲིག་བཀོད་ཀྱི་མིང་དགོས།"

msgid "There must be at least one group."
msgstr "ཉུང་མཐར་ཡང་སྡེ་ཚན་གཅིག་ཡོད་དགོས།"

msgid "All groups must have a name."
msgstr "སྡེ་ཚན་ཚང་མར་མིང་ཡོད་དགོས།"

msgid "All groups must have a unique name."
msgstr "སྡེ་ཚན་ཚང་མར་ཐུན་མོང་མ་ཡིན་པའི་མིང་ཞིག་དགོས།"

msgid "The course must have an assigned start date."
msgstr "སློབ་ཚན་དེ་འགོ་རྩོམ་པའི་ཟླ་ཚེས་ཤིག་ངེས་པར་དུ་འཇོག་དགོས།"

msgid "The course end date must be later than the course start date."
msgstr "སློབ་ཚན་མཇུག་སྒྲིལ་བའི་ཚེས་གྲངས་ནི་སློབ་འགོ་ཚུགས་པའི་ཚེས་གྲངས་ལས་ཕྱི་བ་ཡིན་དགོས།"

msgid "The course start date must be later than the enrollment start date."
msgstr "སློབ་འགོ་ཚུགས་པའི་དུས་ཚོད་ནི་མིང་ཐོ་འགོད་འགོ་ཚུགས་པའི་དུས་ཚོད་ལས་ཕྱི་བ་ཡིན་དགོས།"

msgid "The enrollment start date cannot be after the enrollment end date."
msgstr "ཞུགས་ཐོ་འགོ་རྩོམ་པའི་ཟླ་ཚེས་དེ་ཞུགས་ཐོ་མཇུག་རྫོགས་པའི་ཟླ་ཚེས་ཀྱི་རྗེས་སུ་ཡོང་རུང་།"

msgid "The enrollment end date cannot be after the course end date."
msgstr "ཞུགས་ཐོ་མཇུག་རྫོགས་པའི་ཟླ་ཚེས་དེ་སློབ་ཚན་མཇུག་རྫོགས་པའི་ཟླ་ཚེས་ཀྱི་རྗེས་སུ་ཡོང་རུང་།"

msgid "The certificate available date must be later than the course end date."
msgstr "ལག་འཁྱེར་ཐོབ་པའི་དུས་ཚོད་དེ་སློབ་ཚན་མཇུག་སྒྲིལ་བའི་ཚེས་གྲངས་ལས་ཕྱི་བ་ཡིན་དགོས།"

msgid "The certificate display behavior must be one of: {behavior_options}"
msgstr "ལག་ཁྱེར་སྟོན་པའི་བྱ་སྤྱོད་དེ་གཅིག་ཡིན་དགོས། {behavior_options}"

msgid "The certificates display behavior must be {valid_option} if certificate available date is set."
msgstr "གལ་ཏེ་ལག་ཁྱེར་ཡོད་པའི་ཚེས་གྲངས་སྒྲིག་ཡོད་ན་ལག་ཁྱེར་བཀྲམ་པའི་སྤྱོད་ཚུལ་དེ་ {valid_option} ཡིན་དགོས།"

msgid "Key should only contain letters, numbers, _, or -"
msgstr "ལྡེ་མིག་ནང་ཡོང་ཆོག་པ་ནི་ཡིག་འབྲུ་, གྲངས་ཀ _, ཡང་ན་ -"

msgid "Please enter an integer between %(min)s and %(max)s."
msgstr "%(min)s དང་ %(max)s བར་ཧྲིལ་གྲངས་བླུགས་རོགས།"

msgid "The assignment type must have a name."
msgstr "ལས་འགན་རིགས་ལ་མིང་ཡོད་དགོས།"

msgid "There's already another assignment type with this name."
msgstr "འདིར་མིང་འདིའི་ཐོག་ལས་བགོས་རིགས་གཞན་ཞིག་སྤྲད་ཟིན་འདུག"

msgid "Please enter an integer between 0 and 100."
msgstr "0 ནས་ 100 བར་གྱི་ཧྲིལ་གྲངས་ཤིག་ཞོག"

msgid "Please enter an integer greater than 0."
msgstr "0 ལས་མང་བའི་ཧྲིལ་གྲངས་ཤིག་ཞོག"

msgid "Please enter non-negative integer."
msgstr "དགག་ཚིག་མེད་པའི་ཧྲིལ་གྲངས་ཤིག་ཞོག"

msgid "You must have at least one undroppable <%- types %> assignment."
msgstr "ཁྱེད་ལ་ཉུང་མཐར་ཡང་བཞག་མི་ཐུབ་པའི་ &lt;%-རིགས་ %&gt; ལས་འགན་གཅིག་དགོས།"

msgid "Grace period must be specified in HH:MM format."
msgstr "ཆོག་མཆན་དུས་ཡུན་དེ་HH:MMརྩ་སྒྲིག་ནང་གསལ་བཀོད་བྱེད་དགོས།"

msgid "Not able to set passing grade to less than %(minimum_grade_cutoff)s%."
msgstr "རྒྱུགས་འཕྲོད་ཚད་ %(minimum_grade_cutoff)s %ལས་ཉུང་བར་སྒྲིག་མི་ཐུབ།"

msgid "Textbook name is required"
msgstr "སློབ་དེབ་ཀྱི་མིང་དགོས་པ།"

msgid "Please add at least one chapter"
msgstr "མ་མཐའ་ཡང་ལེའུ་གཅིག་ཁ་སྣོན་གནང་རོགས།"

msgid "All chapters must have a name and asset"
msgstr "ལེའུ་ཚང་མར་མིང་དང་རྒྱུ་ནོར་ཡོད་དགོས།"

msgid "Only <%- fileTypes %> files can be uploaded. Please select a file ending in <%- (fileExtensions) %> to upload."
msgstr "&lt;%- fileTypes %&gt; ཡིག་ཆ་ཁོ་ན་ཡར་བསྐུར་ཐུབ། &lt;%- (fileExtensions) %&gt; ལ་མཇུག་སྒྲིལ་བའི་ཡིག་ཆ་འདེམས་ནས་ཡར་བསྐུར་རོགས།"

msgid "or"
msgstr "ཡང་ན་"

msgid "This unit has validation issues."
msgstr "སྡེ་ཚན་འདི་ལ་བདེན་དཔང་བྱེད་པའི་གནད་དོན་ཡོད།"

msgid "This component has validation issues."
msgstr "ཆ་ཤས་འདི་ལ་བདེན་དཔང་བྱེད་པའི་གནད་དོན་ཡོད།"

msgid "Copied"
msgstr "འདྲ་བཤུས།"

msgid "Your file could not be uploaded"
msgstr "ཁྱེད་ཀྱི་ཡིག་ཆ་ཡར་བསྐུར་མ་ཐུབ།"

msgid "Close"
msgstr "སྒོ་རྒྱོབས།"

msgid "Upload Videos"
msgstr "བརྙན་འཕྲིན་ཡར་བསྐུལ།"

msgid "Drag and drop or {spanStart}browse your computer{spanEnd}."
msgstr "འདྲུད་ནས་བཀོག་བའམ་ {spanStart} ཁྱེད་ཀྱི་གློག་ཀླད་ལ་ལྟ་ཞིབ་བྱོས། {spanEnd} ."

msgid "Maximum file size: {maxFileSize} GB"
msgstr "ཆེས་མཐོའི་ཡིག་ཆའི་ཚད། {maxFileSize} GB"

msgid "Supported file types: {supportedVideoTypes}"
msgstr "རྒྱབ་སྐྱོར་ཡོད་པའི་ཡིག་ཆའི་རིགས་: {supportedVideoTypes}"

msgid "Your video uploads are not complete."
msgstr "ཁྱེད་ཀྱི་བརྙན་པར་ཡར་བསྐུར་བ་ཆ་ཚང་མ་རེད།"

msgid "Upload completed for video {fileName}"
msgstr "བརྙན་ཐུང་ {fileName} ལ་ཡར་བསྐུར་ཚར་ཡོད།"

msgid "Upload failed for video {fileName}"
msgstr "བརྙན་ཐུང་ {fileName} ལ་ཡར་བསྐུར་བྱེད་མ་ཐུབ།"

msgid "{filename} is not in a supported file format. Supported file formats are {supportedFileFormats}."
msgstr "{filename} ནི་རྒྱབ་སྐྱོར་ཡོད་པའི་ཡིག་ཆའི་རྣམ་གཞག་ནང་མེད། རྒྱབ་སྐྱོར་བྱེད་པའི་ཡིག་ཆའི་རྩ་སྒྲིག་ནི་ {supportedFileFormats} ཡིན།"

msgid "{filename} exceeds maximum size of {maxFileSizeInGB} GB."
msgstr "{filename} ནི་ {maxFileSizeInGB} GB ལས་བརྒལ་ཡོད།"

msgid ": video upload complete."
msgstr ": བརྙན་འཕྲིན་ཡར་བསྐུར་ཚར་སོང་།"

msgid "Previous Uploads table has been updated."
msgstr "སྔོན་མའི་ཡར་བསྐུར་རེའུ་མིག་གསར་བཅོས་བྱས་ཟིན།"

msgid "Delete File Confirmation"
msgstr "ཡིག་ཆ་བསུབ་གཏན་འཁེལ་བའི་གསལ་བརྡ།"

