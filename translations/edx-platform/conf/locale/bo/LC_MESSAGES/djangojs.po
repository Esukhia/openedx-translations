msgstr "<%- user %> ་བདེ་ལེགས་ངང་དམིགས་བསལ་ཐོ་གཞུང་ནང་བཅུགས་ཡོད། ལག་ཁྱེར་གཏོང་བ་ལ་གཤམ་བཀོད་ཀྱི་དམིགས་བསལ་ལག་ཁྱེར་བཟོ་ཟེར་བར་སྣུན།"

msgid " learners were successfully added to exception list"
msgstr "སློབ་གཉེར་བ་རྣམས་བདེ་ལེགས་ངང་དམིགས་བསལ་ཐོ་གཞུང་ནང་བཅུགས་ཡོད།"

msgid " learner was successfully added to the exception list"
msgstr "སློབ་གཉེར་བ་རྣམས་བདེ་ལེགས་ངང་དམིགས་བསལ་ཐོ་གཞུང་ནང་བཅུགས་ཡོད།"

