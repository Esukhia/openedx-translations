msgid "Student username/email field is required and can not be empty. Kindly fill in username/email and then press \"Add to Exception List\" button."
msgstr "སློབ་མའི་སྤྱོད་མིང་/གློག་འཕྲིན་གྱི་སྒམ་དེ་ངེས་པར་དགོས་པས་སྟོང་བར་འཇོག་མི་ཉན། སྤྱོད་མིང་/གློག་འཕྲིན་གཉིས་ཚུལ་མཐུན་གྱིས་བསྐངས་ཏེ། \"དམིགས་བསལ་ཐོ་གཞུང་ལ་ཞོག་\" ཟེར་བའི་མཐེབ་ལ་སྣུན།"

msgid "Student username/email field is required and can not be empty. Kindly fill in username/email and then press \"Invalidate Certificate\" button."
msgstr "སློབ་མའི་སྤྱོད་མིང་/གློག་འཕྲིན་གྱི་སྒམ་དེ་ངེས་པར་དགོས་པས་སྟོང་བར་འཇོག་མི་ཉན། སྤྱོད་མིང་/གློག་འཕྲིན་གཉིས་ཚུལ་མཐུན་གྱིས་བསྐངས་ཏེ། \"ཚུལ་མཐུན་མིན་པའི་ལག་ཁྱེར་\" ཟེར་བའི་མཐེབ་ལ་སྣུན།"

msgid "Student Removed from certificate allowlist successfully."
msgstr "སློབ་མ་ལག་ཁྱེར་ཡོད་པའི་ཐོ་གཞུང་ཞེས་པ་ནས་བསུབ་ཡོད།"

msgid "Could not find Certificate Exception in the allowlist. Please refresh the page and try again"
msgstr "ཡོད་པའི་ཐོ་གཞུང་ནང་ལག་ཁྱེར་དམིགས་བསལ་ཟེར་བ་ཞིག་རྙེད་མ་སོང་། ཤོག་ངོས་དེ་བསྐྱར་ལེན་བྱས་ནས་བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Server Error, Please refresh the page and try again."
msgstr "གསོག་མཛོད་ཀྱི་གནད་དོན། ཤོག་ངོས་དེ་བསྐྱར་ལེན་བྱས་ནས་བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "<%- user %> already in exception list."
msgstr "<%- user %> ་ད་སྔ་ནས་དམིགས་བསལ་ཐོ་གཞུང་ནང་འདུག"

