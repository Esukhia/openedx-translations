msgstr "ཁྱེད་ཀྱིས་གལ་ཆེའི་བསྒྱུར་བཅོས་བྱེད་ན་ཚོགས་མི་རྣམས་ལ་ངེས་པར་དུ་སྔོན་བརྡ་གཏོང་དགོས།"

msgid "Membership"
msgstr "ཚོགས་མིའི་གོ་གནས།"

