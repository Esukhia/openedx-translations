msgstr "ཁྱེད་ཀྱིས་སྤྲད་པའི་དངུལ་གྲངས་དེ་ཕྱིར་སློག་མེད།"

msgid "Are you sure you want to unenroll from the purchased course {courseName} ({courseNumber})?"
msgstr "ཁྱེད་རང་ཁྱེད་ཀྱིས་ཉོས་ཟིན་པའི་སློབ་ཚན་ {courseName} ({courseNumber}) དེའི་ཞུགས་ཐོ་ནས་ཕྱིར་འཐེན་བྱ་རྒྱུ་ཡིན་ནམ།"

msgid "Are you sure you want to unenroll from {courseName} ({courseNumber})?"
msgstr "ཁྱེད་རང་{courseName} ({courseNumber}) ནས་ཞུགས་ཐོ་ཕྱིར་འཐེན་བྱེད་གཏན་འཁེལ་ཡིན་ནམ།"

msgid "Are you sure you want to unenroll from the verified {certNameLong}  track of {courseName}  ({courseNumber})?"
msgstr "Are you sure you want to unenroll from the verified {certNameLong}  track of {courseName}  ({courseNumber})?"

msgid "Are you sure you want to unenroll from the verified {certNameLong} track of {courseName} ({courseNumber})?"
msgstr "Are you sure you want to unenroll from the verified {certNameLong} track of {courseName} ({courseNumber})?"

msgid "The refund deadline for this course has passed, so you will not receive a refund."
msgstr "སློབ་ཚན་འདིའི་གླ་ཆ་ཕྱིར་སློག་པའི་དུས་བཅད་ལས་བརྒལ་ཟིན་པས་ཁྱེད་ལ་སྒོར་མོ་ཕྱིར་སློག་མི་སྲིད།"

msgid "Unable to determine whether we should give you a refund because of System Error. Please try again later."
msgstr "མ་ལག་ལ་གནད་དོན་བྱུང་བའི་རྐྱེན་གྱིས་ང་ཚོས་ཁྱོད་ལ་སྒོར་མོ་ཕྱིར་སློག་དགོས་མིན་ཐག་གཅོད་བྱེད་ཐབས་བྲལ། རྗེས་སུ་ཡང་བསྐྱར་ཚོད་ལྟ་ཞིག་བྱེད་རོགས།"

msgid "We couldn't find any results for \"%s\"."
msgstr "ང་ཚོས་%sཡི་གྲུབ་འབྲས་གང་རྙེད་ཐུབ་མ་སོང་།"

msgid "There was an error, try searching again."
msgstr "འདིར་གནད་དོན་ཞིག་འདུག བསྐྱར་འཚོལ་བྱས་ནས་ཚོད་ལྟ་བྱོས།"

msgid "Not divided"
msgstr "བགོ་བཤའ་བརྒྱབ་མི་འདུག"

msgid "Discussions are unified; all learners interact with posts from other learners, regardless of the group they are in."
msgstr "བགྲོ་གླེང་ཁག་ནི་གཅིག་གྱུར་ཡིན་ཏེ། སློབ་གཉེར་བ་ཡོངས་ཀྱིས་རང་ཁུངས་ཀྱི་ཚོགས་ཆུང་ཡིན་མིན་ལ་མ་ལྟོས་པར་ཕན་ཚུན་གྱི་རྩོམ་ཡིག་གི་ལམ་ནས་གཅིག་ཕན་གཅིག་གྲོགས་བྱེད་བཞིན་ཡོད།"

msgid "Enrollment Tracks"
msgstr "ཐོ་འགོད་ཀྱི་རྟགས།"

msgid "Use enrollment tracks as the basis for dividing discussions. All learners, regardless of their enrollment track, see the same discussion topics, but within divided topics, only learners who are in the same enrollment track see and respond to each others’ posts."
msgstr "Use enrollment tracks as the basis for dividing discussions. All learners, regardless of their enrollment track, see the same discussion topics, but within divided topics, only learners who are in the same enrollment track see and respond to each others’ posts."

msgid "Cohorts"
msgstr "ཚོགས་སྡེ།"

msgid "Use cohorts as the basis for dividing discussions. All learners, regardless of cohort, see the same discussion topics, but within divided topics, only members of the same cohort see and respond to each others’ posts. "
msgstr "Use cohorts as the basis for dividing discussions. All learners, regardless of cohort, see the same discussion topics, but within divided topics, only members of the same cohort see and respond to each others’ posts. "

msgid "Discussion topics in the course are not divided."
msgstr "སློབ་ཚན་ནང་གི་བགྲོ་གླེང་བརྗོད་གཞི་དག་བགོ་བཤའ་བརྒྱབ་མི་འདུག"

msgid "Any divided discussion topics are divided based on enrollment track."
msgstr "ཁག་བགོ་བྱས་པའི་བགྲོ་གླེང་བརྗོད་གཞི་གང་ཡིན་རུང་ཞུགས་ཐོའི་མཚམས་རྟགས་ལ་གཞིགས་ནས་བགོས་ཡོད།"

msgid "Any divided discussion topics are divided based on cohort."
msgstr "ཁག་བགོ་བྱས་པའི་བགྲོ་གླེང་བརྗོད་གཞི་གང་ཡིན་རུང་ཚོགས་སྡེ་ལ་གཞིགས་ནས་བགོས་ཡོད།"

msgid "Your changes have been saved. {details}"
msgstr "ཁྱེད་ཀྱི་བསྒྱུར་བཅོས་རྣམས་ཉར་ཡོད། {details}"

msgid "We have encountered an error. Refresh your browser and then try again."
msgstr "ང་ཚོར་གནད་དོན་ཞིག་བྱུང་སོང་། ཁྱེད་ཀྱི་བལྟ་ཆས་བསྐྱར་ལེན་བྱས་ནས་བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "We've encountered an error. Refresh your browser and then try again."
msgstr "ང་ཚོར་གནད་དོན་ཞིག་བྱུང་སོང་། ཁྱེད་ཀྱི་བལྟ་ཆས་བསྐྱར་ལེན་བྱས་ནས་བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "An error has occurred. Make sure that you are connected to the Internet, and then try refreshing the page."
msgstr "གནད་དོན་ཞིག་བྱུང་སོང་། དྲ་རྒྱར་མཐུད་ཡོད་མེད་གཏན་འཁེལ་བྱས་ཏེ། དྲ་ངོས་བསྐྱར་ལེན་བྱས་ནས་ཚོད་ལྟ་བྱོས།"

msgid "Hide notes"
msgstr "གསལ་བཤད་སྐུང་།"

msgid "Notes visible"
msgstr "གསལ་བཤད་མངོན།"

msgid "Show notes"
msgstr "གསལ་བཤད་སྟོན།"

msgid "Notes hidden"
msgstr "བསྐུང་བའི་གསལ་བཤད།"

