msgstr "སློབ་ཚན་ནང་གི་ས་གནས།"

msgid "Recent Activity"
msgstr "ཉེ་སྔོན་གྱི་བྱེད་སྒོ།"

msgid "No results found for \"{query_string}\". Please try searching again."
msgstr "\"{query_string}\" འདིའི་བཙལ་འབྲས་རྙེད་མ་སོང་། བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Search Results"
msgstr "བཙལ་འབྲས།"

msgid "[no tags]"
msgstr "[no tags]"

msgid "Tags"
msgstr "སྒམ།"

msgid "Unable to submit application"
msgstr "སྙན་ཞུ་སྤྲོད་ཐུབ་མ་སོང་།"

msgid "An error has occurred. Check your Internet connection and try again."
msgstr "གནད་དོན་ཞིག་བྱུང་སོང་། ཁྱེད་ཀྱི་དྲ་རྒྱར་གནད་དོན་ཡོད་མེད་བལྟས་རྗེས། བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Choose one"
msgstr "གཅོག་འདེམ།"

msgid "Selected tab"
msgstr "སྒམ་ཞིག་འདེམ།"

msgid "Saved cohort"
msgstr "ཚོགས་པ་ཉར་ཚགས་བྱས་ཡོད།"

msgid "Error adding learners."
msgstr "སློབ་གཉེར་པ་སྣོན་པའི་དཀའ་ངལ།"

msgid "Enter a username or email."
msgstr "སྤྱོད་མིང་དང་གློག་འཕྲིན་གང་རུང་ཞོག"

msgid "{email}"
msgstr "{email}"

msgid "Unknown username: {user}"
msgstr "གསལ་ཁ་མེད་པའི་སྤྱོད་མིང་།: {user}"

msgid "Invalid email address: {email}"
msgstr "ཚུལ་མཐུན་མིན་པའི་གློག་འཕྲིན།: {email}"

msgid "Cohort assignment not allowed: {email_or_username}"
msgstr "སྡེ་ཚན་གྱི་ལས་འགན་སྤྲོད་མི་ཆོག {email_or_username}"

msgid "View all errors"
msgstr "གནད་དོན་ཆ་ཚང་སྟོན།"

msgid "You must specify a name for the cohort"
msgstr "ཚོགས་པ་དེའི་ཆེད་ཁྱེད་ཀྱིས་མིང་ཞིག་གསལ་ཁ་ངེས་པར་འདོན་དགོས།"

msgid "You did not select a content group"
msgstr "ཁྱེད་ཀྱིས་ནང་དོན་གྱི་ཚོགས་ཤིག་བདམས་མི་འདུག"

msgid "The selected content group does not exist"
msgstr "བདམས་ཟིན་པའི་ནང་དོན་གྱི་ཚོགས་དེ་མི་འདུག"

msgid "The cohort cannot be saved"
msgstr "ཚོགས་སྡེ་དེ་ཉར་ཚགས་བྱ་ཐུབ་ས་མ་རེད།"

msgid "The cohort cannot be added"
msgstr "ཚོགས་སྡེ་དེ་སྣོན་ཐུབ་མ་སོང་།"

msgid "You currently have no cohorts configured"
msgstr "ད་སྔ་ཁྱེད་ལ་འགྲེལ་བརྗོད་བྱས་པའི་ཚོགས་སྡེ་མི་འདུག"

msgid "Add Cohort"
msgstr "ཚོགས་སྡེ་སྣོན།"

msgid "The {cohortGroupName} cohort has been created. You can manually add students to this cohort below."
msgstr "{cohortGroupName} རིགས་དབྱེའི་ཚོགས་ཆུང་བཟོས་ཡོད། ཁྱེད་ཀྱིས་སློབ་ཕྲུག་རེ་རེ་བྱས་ཏེ་གཤམ་གྱི་རིགས་དབྱེའི་ནང་སྣོན།"

msgid "Assign students to cohorts by uploading a CSV file."
msgstr "CSV ཡིག་ཆ་ནང་འཇུག་བྱས་ཏེ་སློབ་མ་ཚོར་ཚོགས་སྡེའི་ནང་གི་ལས་འགན་རེ་སྤྲོད།"

msgid "Choose a .csv file"
msgstr "csv ཡིག་ཆ་ཞིག་འདེམ།"

msgid "Only properly formatted .csv files will be accepted."
msgstr "csv ཡིག་ཆ་རྣམ་སྒྲིག་ཚད་ལྡན་ཡོད་པ་ཁོ་ན་མ་གཏོགས་ངོས་ལེན་མི་བྱེད།"

msgid "Upload File and Assign Students"
msgstr "ཡིག་ཆ་ནང་འཇུག་དང་སློབ་མར་ལས་འགན་སྤྲོད།"

msgid "Your file '{file}' has been uploaded. Allow a few minutes for processing."
msgstr "ཁྱེད་ཀྱི་ཡིག་ཆ་ '{file}' ནང་འཇུག་བྱས་ཟིན། སྐར་མ་འགའི་རིང་དག་སྒྲིག་བྱེད་ཆུག"

msgid "Cohorts Enabled"
msgstr "ཚོགས་སྡེའི་བྱེད་ནུས་སྒོ་ཕྱེ།"

msgid "Cohorts Disabled"
msgstr "ཚོགས་སྡེའི་བྱེད་ནུས་མེད་པ་བྱོས།"

msgid "Allow students to generate certificates for this course?"
msgstr "སློབ་མར་སློབ་ཚན་འདིའི་ལག་ཁྱེར་བཟོ་ཆོག་པ་བྱོས།"

msgid "Prevent students from generating certificates in this course?"
msgstr "སློབ་མར་སློབ་ཚན་འདིའི་ལག་ཁྱེར་བཟོ་མི་ཆོག་པ་བྱོས།"

msgid "Start generating certificates for all students in this course?"
msgstr "སློབ་ཚན་འདིའི་སློབ་མ་ཡོངས་ལ་ལག་ཁྱེར་བཟོ་འགོ་བརྩམས་ཡོད།"

msgid "Error while generating certificates. Please try again."
msgstr "ལག་ཁྱེར་བཟོ་སྐབས་གནད་དོན་ཞིག་བྱུང་སོང་། བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Start regenerating certificates for students in this course?"
msgstr "སློབ་ཚན་འདིའི་སློབ་མ་ཡོངས་ལ་ལག་ཁྱེར་བཟོ་འགོ་བརྩམས་ཡོད།"

msgid "Error while regenerating certificates. Please try again."
msgstr "ལག་ཁྱེར་བཟོ་སྐབས་གནད་དོན་ཞིག་བྱུང་སོང་། བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Loading data..."
msgstr "གཞི་གྲངས་ལེན་བཞིན་ཡོད།"

msgid "Error getting issued certificates list."
msgstr "ལག་ཁྱེར་ཐོ་གཞུང་གི་གནད་དོན་ཞུ་འབུལ་བྱས་ཡོད།"

msgid "Error generating anonymous IDs. Please try again."
msgstr "མིང་སྨྲོས་མེད་པའི་IDs ཁག་ལ་བཟོ་བར་གནད་དོན་བྱུང་སོོང་།"

msgid "Error generating proctored exam results. Please try again."
msgstr "དྲ་ལམ་ཡིག་རྒྱུགས་ཀྱི་གྲུབ་འབྲས་བཟོ་བར་གནད་དོན་ཞིག་བྱུང་སོང་། བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Error generating survey results. Please try again."
msgstr "བརྟག་དཔྱད་མཇུག་འབྲས་བཟོ་བར་གནད་དོན་བྱུང་སོང་། བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Error generating student profile information. Please try again."
msgstr "སློབ་མའི་ཐོ་གཞུང་གནས་ཚུལ་བཟོ་བར་གནད་དོན་བྱུང་སོང་། བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Loading"
msgstr "འཇུག་བཞིན་ཡོད།"

msgid "Error getting student list."
msgstr "སློབ་མའི་ཐོ་གཞུང་ལ་ལེན་པར་གནད་དོན་བྱུང་སོང་།"

msgid "Error generating list of students who may enroll. Please try again."
msgstr "ཕལ་ཆེར་ཞུགས་ཐོ་བཀོད་པའི་སློབ་མའི་ཐོ་གཞུང་བཟོ་བར་གནད་དོན་བྱུང་སོང་། བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Error retrieving grading configuration."
msgstr "གནས་རིམ་བསྒྲིག་ཕྱོགས་འབྱོར་བར་གནད་དོན་བྱུང་སོང་། "

msgid "Error generating grades. Please try again."
msgstr "གནས་རིམ་བསྒྲིག་པར་གནད་དོན་བྱུང་སོང་། བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Error generating problem grade report. Please try again."
msgstr "དཀའ་ངལ་གྱི་གནས་རིམ་སྙན་བསྡོམས་བཟོ་བར་གནད་དོན་བྱུང་སོང་། བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Error generating ORA data report. Please try again."
msgstr "ORA ཡི་གཞི་གྲངས་སྙན་ཞུ་བཟོ་བར་གནད་དོན་བྱུང་སོང་། བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "There was a problem creating the report. Select \"Create Executive Summary\" to try again."
msgstr "སྙན་ཞུ་བཟོ་བར་དཀའ་ངལ་ཞིག་འདུག བསྐྱར་དུ་ཚོད་ལྟ་བྱེད་པར་ \"Create Executive Summary\" འདི་འདེམ།"

msgid "Enter the enrollment code."
msgstr "ཞུགས་ཐོའི་ཨང་བརྡ་ནང་འཇུག་བྱོས།"

msgid "Cancel enrollment code"
msgstr "ཞུགས་ཐོའི་ཨང་བརྡ་ཕྱིར་འཐེན་བྱོས།"

msgid "Restore enrollment code"
msgstr "ཞུགས་ཐོའི་ཨང་བརྡ་སོར་འཇོག་བྱོས།"

msgid "Mark enrollment code as unused"
msgstr "ཞུགས་ཐོའི་ཨང་བརྡ་སྤྱད་མེད་པའི་རྟགས་རྒྱོབས།"

msgid "Username"
msgstr "སྤྱོད་མཁན་གྱི་མིང་"

msgid "Email"
msgstr "གློག་འཕྲིན།"

msgid "Revoke access"
msgstr "ཆོག་མཆན་ཕྱིར་བསྡུ།"

msgid "Group"
msgstr "ཚོགས་པ།"

msgid "Enter username or email"
msgstr "སྤྱོད་མཁན་གྱི་མིང་དང་གློག་འཕྲིན་གང་རུང་ནང་འཇུག་བྱོས།"

msgid "Please enter a username or email."
msgstr "སྤྱོད་མཁན་གྱི་མིང་ཞིག་དང་ཡང་ན་གློག་འཕྲིན་ནང་འཇུག་བྱོས།"

msgid "This role requires a divided discussions scheme."
msgstr "བྱེད་སྒོ་འདི་ལ་ཁག་བགོ་བྱས་པའི་བགྲོ་གླེང་འཆར་གཞི་ཞིག་དགོས་འདུག"

msgid "Error changing user's permissions."
msgstr "སྤྱོད་མཁན་གྱི་ཆོག་མཆན་འགྱུར་བ་གཏོང་བའི་གནད་དོན།"

msgid "Could not find a user with username or email address '<%- identifier %>'."
msgstr "སྤྱོད་མཁན་འདི་སྤྱོད་མིང་དང་ཡང་ན་གློག་འཕྲིན་ '<%- identifier %>' འདིའི་ཐོག་ནས་རྙེད་ས་མ་རེད།"

msgid "Error: User '<%- username %>' has not yet activated their account. Users must create and activate their accounts before they can be assigned a role."
msgstr "གནད་དོན་བྱུང་སོང་། སྤྱོད་མཁན་ '<%- username %>' ཁོང་གིས་ད་དུང་ཁོང་ཚོའི་ཁ་བྱང་གི་བྱེད་ནུས་སྤེལ་མི་འདུག  སྤྱོད་མཁན་ཚོས་ལས་འགན་དངོས་སུ་བསྒྲུབ་པ་ལ་ཐོག་མར་ཁོང་ཚོས་རང་རང་གི་ཁ་བྱང་རེ་ངེས་པར་དུ་བཟོ་དགོས་པ་དང་དེའི་བྱེད་ནུས་ཀྱང་སྤེལ་དགོས་པ་ཡིན།"

msgid "Error: You cannot remove yourself from the Instructor group!"
msgstr "གནད་དོན།: ཁྱེད་ཀྱིས་རང་ཉིད་སློབ་ཁྲིད་མཁན་གྱི་ཚོགས་པ་ནས་ཕུད་མི་ཐུབ།"

msgid "Errors"
msgstr "གནད་དོན་འགའ།"

msgid "The following errors were generated:"
msgstr "གཤམ་གྱི་གནད་དོན་ཁག་བྱུང་སོང་།"

msgid "Warnings"
msgstr "ཉེན་བརྡ།"

msgid "The following warnings were generated:"
msgstr "གཤམ་གྱི་ཉེན་བརྡ་དག་འབྱོར་སོང་།"

msgid "Success"
msgstr "ལམ་ལྷོངས།"

msgid "All accounts were created successfully."
msgstr "ཁ་བྱང་ཚང་མ་བདེ་ལེགས་ངང་བཟོ་གྲུབ་སོང་།"

msgid "Error adding/removing users as beta testers."
msgstr "སྤྱོད་མཁན་དག་beta testers ངོ་བོའི་ཐོག་ནས་ཡར་སྣོན་མར་ཕུད་ལ་གནད་དོན་ཞིག་འདུག"

msgid "This field must not be blank"
msgstr "ཡིག་དུམ་འདི་སྟོང་པར་མི་རུང་།"

msgid "These users were successfully added as beta testers:"
msgstr "སྤྱོད་མཁན་དེ་དག་ beta testers ངོ་བོའི་ཐོག་ནས་བདེ་ལེགས་ངང་ཡར་སྣོན་བྱས་ཡོད།"

msgid "These users could not be added as beta testers because their accounts are not yet activated:"
msgstr "སྤྱོད་མཁན་འདི་ཚོ་སྔོན་འགྲོའི་ཚོད་ལྟ་བྱེད་མཁན་གྱི་ངོ་བོར་སྣོན་ཐུབ་ས་མི་འདུག རྒྱུ་མཚན་ཁོང་ཚོའི་ཁ་བྱང་གི་བྱེད་ནུས་ད་དུང་སྤེལ་མི་འདུག"

msgid "These users were successfully removed as beta testers:"
msgstr "སྤྱོད་མཁན་དེ་དག་beta testers ངོ་བོའི་ཐོག་ནས་ཕུད་ཟིན་པ་ཡིན།"

msgid "These users were not added as beta testers:"
msgstr "སྤྱོད་མཁན་དེ་དག་ beta testers ངོ་བོའི་ཐོག་ནས་ཡར་སྣོན་བྱས་མེད།"

msgid "These users were not removed as beta testers:"
msgstr "སྤྱོད་མཁན་དེ་དག་ beta testers ངོ་བོའི་ཐོག་ནས་མར་ཕུད་བྱས་མེད།"

msgid "Could not find users associated with the following identifiers:"
msgstr "གཤམ་གྱི་ངོས་འཛིན་ཆས་དག་དང་མཉམ་འབྲེལ་བྱས་པའི་སྤྱོད་མཁན་རྣམས་རྙེད་ཐུབ་མ་སོང་།"

msgid "Users must create and activate their account before they can be promoted to beta tester."
msgstr "སྤྱོད་མཁན་འདི་ཚོ་སྔོན་འགྲོའི་ཚོད་ལྟ་བྱེད་མཁན་ལ་མ་ཞུགས་སྔོན་ཁོང་ཚོས་ངེས་པར་དུ་ཁ་བྱང་བཟོས་ཏེ་དེའི་བྱེད་ནུས་ཀྱང་སྤེལ་དགོས་པ་ཡིན།"

msgid "Reason field should not be left blank."
msgstr "རྒྱུ་མཚན་སྡེ་ཚན་སྟོང་བར་རྩ་བ་ནས་འཇོག་མི་རུང་།"

msgid "Error enrolling/unenrolling users."
msgstr "ཞུགས་ཐོ་འགོད་པ་དང་མི་འགོད་མཁན་གྱི་གནད་དོན།"

msgid "The following email addresses and/or usernames are invalid:"
msgstr "གཤམ་གྱི་གློག་འཕྲིན་ཁག་དང་སྤྱོད་མཁན་གྱི་མིང་གང་རུང་ཚུལ་མཐུན་མ་རེད།"

msgid "Successfully enrolled and sent email to the following users:"
msgstr "གཤམ་གྱི་སྤྱོད་མཁན་དེ་ཞུགས་ཐོར་བཀོད་ནས་ཕྱིར་གློག་འཕྲིན་བཏང་ཡོད།"

msgid "Successfully enrolled the following users:"
msgstr "གཤམ་གྱི་སྤྱོད་མཁན་རྣམས་བདེ་ལེགས་ངང་ཐོ་འགོད་བྱས་ཡོད།"

msgid "Email cannot be sent to the following users via batch enrollment. They will be allowed to enroll once they register:"
msgstr "གློག་འཕྲིན་དེ་སྡེ་ཚན་ཐོ་འགོད་བརྒྱུད་ནས་གཤམ་གྱི་སྤྱོད་མཁན་ལ་གཏོང་མི་ཐུབ། ཁོ་ཚོས་ཐོ་འགོད་ཐེངས་གཅིག་བྱེད་ཆོག་གི་རེད།"

msgid "These users will be allowed to enroll once they register:"
msgstr "སྤྱོད་མཁན་འདི་ཚོས་ཐོ་འགོད་ཐེངས་གཅིག་བྱས་རྗེས་ཞུགས་ཐོ་འགོད་ཆོག"

msgid "Email cannot be sent to the following users via batch enrollment. They will be enrolled once they register:"
msgstr "གློག་འཕྲིན་དེ་སྡེ་ཚན་ཐོ་འགོད་བརྒྱུད་ནས་གཤམ་གྱི་སྤྱོད་མཁན་ལ་གཏོང་མི་ཐུབ། ཁོ་ཚོས་མིང་ཐོ་འགོད་རྗེས་མིང་ཐོ་འགོད་རྒྱུ་རེད།"

msgid "These users will be enrolled once they register:"
msgstr "སྤྱོད་མཁན་འདི་ཚོས་ཐོ་འགོད་ཐེངས་གཅིག་བྱས་རྗེས་ཞུགས་ཐོ་འགོད་ཆོག"

msgid "Emails successfully sent. The following users are no longer enrolled in the course:"
msgstr "གློག་འཕྲིན་བཏང་ཚར་ཡོད། གཤམ་གྱི་སྤྱོད་མཁན་ཚོ་ཏོག་ཙམ་རྗེས་ནས་སློབ་ཚན་དེའི་ཞུགས་ཐོའི་ནང་མེད།"

msgid "The following users are no longer enrolled in the course:"
msgstr "གཤམ་གྱི་སྤྱོད་མཁན་ཚོ་ཏོག་ཙམ་རྗེས་ནས་སློབ་ཚན་དེའི་ཞུགས་ཐོའི་ནང་མེད།"

msgid "These users were not affiliated with the course so could not be unenrolled:"
msgstr "གཤམ་གྱི་སྤྱོད་མཁན་དག་སློབ་ཚན་དེའི་ཁོངས་གཏོགས་མ་རེད། དེའི་ཕྱིར་ཞུགས་ཐོ་འགོད་མི་ཐུབ།"

msgid "Your message must have a subject."
msgstr "ཁྱེད་ཀྱི་འཕྲིན་འཕྲིན་ཐུང་ལ་མགོ་བརྗོད་ངེས་པར་འཇོག་དགོས།"

msgid "Your message cannot be blank."
msgstr "འཕྲིན་ཐུང་གི་སྒམ་སྟོང་བར་འཇོག་མི་རུང་།"

msgid "Your message must have at least one target."
msgstr "ཁྱེད་ཀྱི་འཕྲིན་ཐུང་ལ་ཉུང་མཐར་དམིགས་འབེན་ཞིག་ཡོད་དགོས།"

msgid "There are invalid keywords in your email. Check the following keywords and try again."
msgstr "ཁྱེད་ཀྱི་གློག་འཕྲིན་ནང་ཚུལ་མཐུན་མིན་པའི་ཚིག་གནད་ཅིག་འདུག གཤམ་བཀོད་ཀྱི་ཚིག་གནད་རྣམས་ལ་ཞིབ་བཤེར་བྱས་ཏེ་བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Yourself"
msgstr "ཁྱེད་རང་ཉིད།"

msgid "Everyone who has staff privileges in this course"
msgstr "སློབ་ཚན་འདིའི་ནང་ལས་བྱེད་ཀྱི་དམིགས་བསལ་ཡོད་པ་ཡོངས།"

msgid "All learners who are enrolled in this course"
msgstr "སློབ་ཚན་འདིའི་ནང་ཞུགས་ཐོར་བཀོད་པའི་སློབ་གཉེར་བ་ཡོངས།"

msgid "All learners in the {cohort_name} cohort"
msgstr "རིག་ཚན་{cohort_name} དེའི་ནང་གི་སློབ་གཉེར་བ་ཡོངས།"

msgid "All learners in the {track_name} track"
msgstr "ཤར་མ་ {track_name} དེའི་ནང་གི་སློབ་གཉེར་བ་ཡོངས།"

msgid "Your email message was successfully queued for sending. In courses with a large number of learners, email messages to learners might take up to an hour to be sent."
msgstr "ཁྱེད་ཀྱི་འཕྲིན་ཐུང་དེ་རིམ་པས་གཏོང་རྒྱུའི་བང་རིམ་ནང་བདེ་ལེགས་ངང་བཞག་ཡོད།འཛིན་གྲྭ་རེ་རེའི་ནང་སློབ་གཉེར་བ་འབོར་ཆེན་རེ་ཡོད་རེད། དེའི་ཕྱིར་སློབ་གཉེར་བ་ཡོངས་ལ་གློག་འཕྲིན་རེ་རེ་བྱས་ནས་གཏོང་དགོས་པས་དེ་གཏོང་བར་ཕལ་ཆེར་ཆུ་ཚོད་རེ་འགོར་སྲིད།"

msgid "You are sending an email message with the subject {subject} to the following recipients."
msgstr "ཁྱེད་ཀྱིས་བསྒྲུབ་བྱ་{subject} འདི་དང་འབྲེལ་བའི་འཕྲིན་ཐུང་ཞིག་གཤམ་གསལ་གྱི་བསྐུར་ཡུལ་རྣམས་ལ་སྐུར་བཞིན་འདུག"

msgid "Is this OK?"
msgstr "འདི་འགྲིག་གམ།"

msgid "Error sending email."
msgstr "གློག་འཕྲིན་གཏོང་བར་གནད་དོན།"

msgid "There is no email history for this course."
msgstr "སློབ་ཚན་འདིའི་གློག་འཕྲིན་ལོ་རྒྱུས་ཤིག་མི་འདུག"

msgid "There was an error obtaining email task history for this course."
msgstr "སློབ་ཚན་འདི་ལ་གློག་འཕྲིན་ལས་ཀ་འབྱོར་བར་གནད་དོན་ཞིག་འདུག"

msgid "There was an error obtaining email content history for this course."
msgstr "སློབ་ཚན་འདིའི་ཆེད་དུ་གློག་འཕྲིན་ནང་དོན་གྱི་ལོ་རྒྱུས་འབྱོར་བར་གནད་དོན་ཞིག་འདུག"

msgid "Send to:"
msgstr "གཏོང་ཡུལ།"

msgid "Please enter a student email address or username."
msgstr "སློབ་མའི་སྤྱོད་མིང་དང་གློག་འཕྲིན་གང་རུང་ཞིག་འཇོག་རོགས།"

msgid "Error getting enrollment status for '<%- student_id %>'. Make sure that the student identifier is spelled correctly."
msgstr "'<%- student_id %>' ཁོང་གི་ཞུགས་ཐོའི་གནས་བབ་འཚོལ་བར་གནད་དོན་བྱུང་སོང་། སློབ་ཕྲུག་དེའི་ངོས་འཛིན་བྱེད་ཀྱི་དག་ཆ་འགྲིག་ཡོད་མེད་ལེགས་པར་རྟོག"

msgid "Retrieving enrollment status..."
msgstr "ཞུགས་ཐོ་འགོད་པའི་གནས་བབ་ལ་འཐོབ་ཐབས།"

msgid "Error getting student progress url for '<%- student_id %>'. Make sure that the student identifier is spelled correctly."
msgstr "'<%- student_id %>' སློབ་ཕྲུག་གི་འཕེལ་རྒྱས་ཀྱི་ url འཚོལ་བར་གནད་དོན་བྱུང་སོང་། སློབ་ཕྲུག་དེའི་ངོས་འཛིན་བྱེད་ཀྱི་དག་ཆ་འགྲིག་ཡོད་མེད་ལེགས་པར་རྟོག"

msgid "Please enter a problem location."
msgstr "དོགས་འདྲིའི་ས་གནས་ཤིག་འཇུག་རོགས།"

msgid "Success! Problem attempts reset for problem '<%- problem_id %>' and student '<%- student_id %>'."
msgstr "དྲི་བ་'<%- problem_id %>' དང་ '<%- student_id %>' སློབ་ཕྲུག་ལ་དྲི་བའི་ཚོད་ལྟ་བསྐྱར་སྒྲིག་ལེགས་འགྲུབ་བྱུང་སོང་།"

msgid "Error resetting problem attempts for problem '<%- problem_id %>' and student '<%- student_id %>'. Make sure that the problem and student identifiers are complete and correct."
msgstr "དྲི་བ་ '<%- problem_id %>' དང་ '<%- student_id %>' སློབ་ཕྲུག་ལ་ཚོད་ལྟ་བསྐྱར་སྒྲིག་བྱེད་པར་གནད་དོན་བྱུང་སོང་། དྲི་བ་དང་སློབ་ཕྲུག་གི་ངོས་འཛིན་བྱེད་རྣམས་ཆ་ཚང་བ་དང་ཡང་དག་ཡིན་མིན་ལེགས་པར་རྟོག"

msgid "Delete student '<%- student_id %>'s state on problem '<%- problem_id %>'?"
msgstr "Delete student '<%- student_id %>'s state on problem '<%- problem_id %>'?"

msgid "Error deleting student '<%- student_id %>'s state on problem '<%- problem_id %>'. Make sure that the problem and student identifiers are complete and correct."
msgstr "Error deleting student '<%- student_id %>'s state on problem '<%- problem_id %>'. Make sure that the problem and student identifiers are complete and correct."

msgid "Module state successfully deleted."
msgstr "མ་དཔེའི་གནས་བབ་བདེ་ལེགས་ངང་བསུབས་སོང་།"

msgid "Error getting task history for problem '<%- problem_id %>' and student '<%- student_id %>'. Make sure that the problem and student identifiers are complete and correct."
msgstr "དྲི་བའི་ '<%- problem_id %>' དང་ '<%- student_id %>' གི་ལས་དོན་ལོ་རྒྱུས་རྙེད་པར་གནད་དོན་བྱུང་སོང་། དྲི་བ་དང་སློབ་ཕྲུག་གི་ངོས་འཛིན་བྱེད་ཆ་ཚང་བ་དང་ཡང་དག་ཡིན་མིན་ལེགས་པར་རྟོག"

msgid "Entrance exam attempts is being reset for student '{student_id}'."
msgstr "སློབ་ཕྲུག་ '{student_id}' ཆེད་དུ་ཚུད་རྒྱུགས་ཚོད་ལྟ་དེ་བསྐྱར་སྒྲིག་བྱས་ཡོད།"

msgid "Error resetting entrance exam attempts for student '{student_id}'. Make sure student identifier is correct."
msgstr "'{student_id}' སློབ་ཕྲུག་ལ་ཚུད་རྒྱུགས་ཚོད་ལྟ་བསྐྱར་སྒྲིག་བྱེད་པར་གནད་དོན་བྱུང་སོང་། སློབ་ཕྲུག་གི་ངོས་འཛིན་བྱེད་དེ་ཡང་དག་པ་ཡིན་མིན་ལེགས་པར་རྟོག"

msgid "Enter a student's username or email address."
msgstr "སློབ་ཕྲུག་གི་སྤྱོད་མིང་དང་ཡང་ན་གློག་འཕྲིན་གང་རུང་ནང་འཇུག་བྱོས།"

msgid "Do you want to allow this student ('{student_id}') to skip the entrance exam?"
msgstr "ཁྱེད་ཀྱིས་སློབ་མ་ ('{student_id}') འདི་ཚུད་རྒྱུགས་གཏོང་མི་དགོས་པར་མངགས་འདོད་ཡོད་དམ།"

msgid "An error occurred. Make sure that the student's username or email address is correct and try again."
msgstr "གནད་དོན་ཞིག་བྱུང་སོང་། སློབ་ཕྲུག་གི་སྤྱོད་མིང་དང་ཡང་ན་གློག་འཕྲིན་ཡང་དག་ཡིན་མིན་ལེགས་པར་བརྟགས་ཏེ་བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

msgid "Entrance exam state is being deleted for student '{student_id}'."
msgstr "སློབ་མ་ '{student_id}' ཆེད་དུ་ཚུད་རྒྱུགས་སྡེ་ཚན་དེ་བསུབ་ཡོད།"

msgid "Error deleting entrance exam state for student '{student_id}'. Make sure student identifier is correct."
msgstr "'{student_id}'. སློབ་ཕྲུག་གི་ཚུད་རྒྱུགས་གནས་བབ་བསུབ་པར་གནད་དོན་བྱུང་སོང་། སློབ་ཕྲུག་གི་ངོས་འཛིན་བྱེད་ཡང་དག་ཡིན་མིན་ལེགས་པར་རྟོག"

msgid "Error getting entrance exam task history for student '{student_id}'. Make sure student identifier is correct."
msgstr "'{student_id}' སློབ་ཕྲུག་གི་ཚུད་རྒྱུགས་ཀྱི་ལས་དོན་ལོ་རྒྱུས་རྙེད་པར་གནད་དོན་བྱུང་སོང་། སློབ་ཕྲུག་གི་ངོས་འཛིན་བྱེད་ཡང་དག་ཡིན་མིན་ལེགས་པར་རྟོག"

msgid "Reset attempts for all students on problem '<%- problem_id %>'?"
msgstr "'<%- problem_id %>' དྲི་བའི་སྒང་གི་སློབ་ཕྲུག་ཡོངས་ལ་ཚོད་ལྟ་བསྐྱར་སྒྲིག་བྱས་ཡོད་དམ།"

msgid "Successfully started task to reset attempts for problem '<%- problem_id %>'. Click the 'Show Task Status' button to see the status of the task."
msgstr "'<%- problem_id %>' དྲི་བའི་ཚོད་ལྟ་བསྐྱར་སྒྲིག་གི་ལས་དོན་བདེ་ལེགས་ངང་འགོ་བརྩམས་སོང་།  ལས་དོན་གྱི་གནས་བབ་ལ་བལྟ་བར་ 'Show Task Status' གནོན་ཐེབས་འདིའི་སྒང་ལ་སྣུན།"

msgid "Error starting a task to reset attempts for all students on problem '<%- problem_id %>'. Make sure that the problem identifier is complete and correct."
msgstr "དྲི་བ་དེའི་སྒང་ '<%- problem_id %>' གི་སློག་ཕྲུག་ཡོངས་ཀྱི་བསྐྱར་སྒྲིག་ཚོད་ལྟའི་ལས་དོན་འགོ་རྩོམ་དུས་གནད་དོན་བྱུང་སོང་། དྲི་བ་དེའི་ངོས་འཛིན་བྱེད་དེ་ཆ་ཚང་བ་དང་ཡང་དག་པ་ཡིན་མིན་ལེགས་པར་རྟོག"

msgid "Error listing task history for this student and problem."
msgstr "སློབ་མ་འདི་དང་དོགས་འདྲིའི་ཆེད་དུ་ལས་འགན་གྱི་ལོ་རྒྱུས་ཐོར་འགོད་པར་གནད་དོན།"

msgid "Started rescore problem task for problem '<%- problem_id %>' and student '<%- student_id %>'. Click the 'Show Task Status' button to see the status of the task."
msgstr "དྲི་བ་ '<%- problem_id %>' རྣམས་དང་སློབ་ཕྲུག་ '<%- student_id %>'. གི་བརྒྱ་ཆ་བསྐྱར་སྐོར་གྱི་ལས་དོན་འགོ་བརྩམས་སོང་། ལས་དོན་གྱི་གནས་བབ་ལ་བལྟ་བར་ 'Show Task Status' གནོན་ཐེབས་འདིའི་སྒང་ལ་སྣུན།"

msgid "Error starting a task to rescore problem '<%- problem_id %>' for student '<%- student_id %>'. Make sure that the the problem and student identifiers are complete and correct."
msgstr "'<%- student_id %>'.  སློབ་ཕྲུག་གི་དྲི་བའི་བརྒྱ་ཆ་བསྐྱར་སྐོར་ '<%- problem_id %>' གྱི་ལས་དོན་འགོ་བརྩམས་དུས་གནད་དོན་བྱུང་སོང་། དྲི་བ་དང་སློབ་ཕྲུག་གི་ངོས་འཛིན་བྱེད་དེ་ཆ་ཚང་བ་དང་ཡང་དག་པ་ཡིན་མིན་ལེགས་པར་རྟོག"

msgid "Please enter a score."
msgstr "ཐོབ་སྐར་ཞིག་འཇོག་རོགས།"

msgid "Started task to override the score for problem '<%- problem_id %>' and student '<%- student_id %>'. Click the 'Show Task Status' button to see the status of the task."
msgstr "Started task to override the score for problem '<%- problem_id %>' and student '<%- student_id %>'. Click the 'Show Task Status' button to see the status of the task."

msgid "Error starting a task to override score for problem '<%- problem_id %>' for student '<%- student_id %>'. Make sure that the the score and the problem and student identifiers are complete and correct."
msgstr "Error starting a task to override score for problem '<%- problem_id %>' for student '<%- student_id %>'. Make sure that the the score and the problem and student identifiers are complete and correct."

msgid "Started entrance exam rescore task for student '{student_id}'. Click the 'Show Task Status' button to see the status of the task."
msgstr "'{student_id}' སློབ་ཕྲུག་གི་ཚུད་རྒྱུགས་བརྒྱ་ཆ་བསྐྱར་སྐོར་གྱི་ལས་དོན་འགོ་བརྩམས་སོང་། ལས་དོན་གྱི་གནས་བབ་ལ་བལྟ་བར་ 'Show Task Status' གནོན་ཐེབས་འདིའི་སྒང་ལ་སྣུན།"

msgid "Error starting a task to rescore entrance exam for student '{student_id}'. Make sure that entrance exam has problems in it and student identifier is correct."
msgstr "'{student_id}' སློབ་ཕྲུག་གི་ཚུད་རྒྱུགས་བརྒྱ་ཆ་བསྐྱར་སྐོར་གྱི་ལས་དོན་འགོ་བརྩམས་སྐབས་གནད་དོན་བྱུང་། ཚུད་རྒྱུགས་ནང་དྲི་བ་ཡོད་མེད་དང་སློབ་ཕྲུག་གི་ངོས་འཛིན་བྱེད་དེ་ཡང་དག་ཡིན་མིན་ལེགས་པར་རྟོག"

