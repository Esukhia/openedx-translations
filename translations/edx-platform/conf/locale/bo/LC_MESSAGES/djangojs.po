msgstr "ལག་ཁྱེར་མིང་རྟགས་འགོད་པའི་སྒྲིག་བཀོད།"

msgid "Name "
msgstr "མིང "

msgid "Name of the signatory"
msgstr "མིང་རྟགས་བཀོད་མཁན་གྱི་མིང་།"

msgid "The name of this signatory as it should appear on certificates."
msgstr "མཚན་རྟགས་བཀོད་མཁན་འདིའི་མིང་ལག་ཁྱེར་སྟེང་དུ་བཀོད་དགོས་པ་ལྟར།"

msgid "Title "
msgstr "མིང་བྱང "

msgid "Title of the signatory"
msgstr "མཚན་རྟགས་བཀོད་མཁན་གྱི་མཚན་ཐོ།"

msgid "Titles more than 100 characters may prevent students from printing their certificate on a single page."
msgstr "ཡིག་འབྲུ་༡༠༠ལས་བརྒལ་བའི་མིང་བྱང་གིས་སློབ་མ་ཚོས་ཤོག་ངོས་གཅིག་ལ་ལག་འཁྱེར་པར་སྐྲུན་བྱེད་པར་བཀག་འགོག་བྱེད་སྲིད།"

msgid "Organization "
msgstr "རྩ་འཛུགས "

msgid "Organization of the signatory"
msgstr "མཚན་རྟགས་བཀོད་མཁན་གྱི་སྒྲིག་འཛུགས།"

msgid "The organization that this signatory belongs to, as it should appear on certificates."
msgstr "མཚན་རྟགས་བཀོད་མཁན་འདི་ལག་ཁྱེར་སྟེང་དུ་བཀོད་དགོས་པ་ལྟར།"

msgid "Path to Signature Image"
msgstr "མཚན་རྟགས་པར་རིས་ལ་ལམ་ཐིག།"

msgid "Image must be in PNG format"
msgstr "པར་རིས་དེ་PNGཡི་རྣམ་པ་ཡིན་དགོས།"

msgid "Upload Signature Image"
msgstr "མཚན་རྟགས་འདྲ་པར་ཡར་བསྐུར།"

msgid "Unit Visibility"
msgstr "ཚད་གཞིའི་མཐོང་ཐུབ་ཚད།"

msgid "Section Visibility"
msgstr "ཚན་པ་མཐོང་ཐུབ་པ།"

msgid "Visible to learners"
msgstr "སློབ་སྦྱོང་བྱེད་མཁན་ལ་མཐོང་ཐུབ་པ།"

msgid "It is visible to learners, ensuring that all learners can view its contents."
msgstr "དེ་ནི་སློབ་སྦྱོང་བྱེད་མཁན་ལ་མཐོང་རྒྱུ་ཡོད་པས་སློབ་མ་ཚང་མས་དེའི་ནང་དོན་ལ་ལྟ་ཐུབ་པར་ཁག་ཐེག་བྱེད་ཀྱི་ཡོད།"

msgid "Hide in Course Outline, accessible via Link"
msgstr "སློབ་ཚན་གྱི་འཆར་གཞིའི་ནང་དུ་སྦས། འབྲེལ་མཐུད་བརྒྱུད་ནས་འཛུལ་ཐུབ།"

msgid "It is intentionally hidden from standard navigation, ensuring that only individuals with the link can view its contents."
msgstr "དེ་ནི་ཚད་ལྡན་གྱི་འགྲུལ་བཞུད་ལས་བསམ་བཞིན་དུ་གསང་བ་བྱས་པས་འབྲེལ་མཐུད་ཡོད་པའི་མི་སྒེར་ཁོ་ནར་དེའི་ནང་དོན་ལྟ་ཐུབ་པར་ཁག་ཐེག་བྱེད་ཀྱི་ཡོད།"

msgid "If you make this section visible in the table of content, learners will be able to see its content."
msgstr "ནང་དོན་རེའུ་མིག་ནང་དུམ་བུ་འདི་མཐོང་ཐུབ་པ་བཟོས་ན་སློབ་མ་ཚོས་དེའི་ནང་དོན་མཐོང་ཐུབ།"

msgid "It is intentionally hidden from learners, ensuring that only the course staff can view its contents."
msgstr "དེ་ནི་སློབ་སྦྱོང་བྱེད་མཁན་ཚོར་བསམ་བཞིན་དུ་གསང་བ་བྱས་ཏེ་སློབ་ཚན་གྱི་ལས་བྱེད་ཁོ་ནར་དེའི་ནང་དོན་ལྟ་ཐུབ་པར་ཁག་ཐེག་བྱེད་ཀྱི་ཡོད།"

msgid "If the unit was previously published and released to learners, any changes you made to the unit when it was hidden will now be visible to learners."
msgstr "གལ་ཏེ་སྔོན་ཆད་སློབ་ཚན་དེ་པར་སྐྲུན་བྱས་ནས་སློབ་མ་ཚོར་གློད་བཀྲོལ་བྱས་ཡོད་ན། ཁྱེད་ཀྱིས་སློབ་ཚན་དེ་གསང་བ་བྱས་པའི་སྐབས་བསྒྱུར་བཅོས་གང་རུང་ཞིག་ད་ལྟ་སློབ་མ་ཚོར་མཐོང་ཐུབ།"

msgid "If you make this %(xblockType)s visible to learners, learners will be able to see its content after the release date has passed and you have published the unit. Only units that are explicitly hidden from learners will remain hidden after you clear this option for the %(xblockType)s."
msgstr "གལ་ཏེ་ཁྱེད་ཀྱིས་ %(xblockType)s འདི་སློབ་མ་ཚོར་མཐོང་ཐུབ་པ་བཟོས་ན། སློབ་མ་ཚོས་དེའི་ནང་དོན་དེ་འགྲེམ་སྤེལ་ཚེས་གྲངས་འདས་རྗེས་ཁྱེད་ཀྱིས་སློབ་ཚན་དེ་པར་སྐྲུན་བྱས་རྗེས་མཐོང་ཐུབ། ཁྱེད་ཀྱིས་ %(xblockType)s ཡི་གདམ་ཁ་འདི་བསལ་རྗེས་སློབ་སྦྱོང་བྱེད་མཁན་ལས་གསལ་པོ་གསང་བའི་ཚད་གཞི་ཁོ་ན་གསང་བར་གནས་རྒྱུ་རེད།"

msgid "Xpert unit summaries"
msgstr "Xpert ཚད་གཞིའི་ཕྱོགས་བསྡུས།"

msgid "Enable summaries"
msgstr "བསྡུས་དོན་ནུས་ལྡན་དུ་གཏོང་བ།"

msgid "Current Role:"
msgstr "ད་ལྟའི་ལས་འགན།"

msgid "You!"
msgstr "ཁྱོད!"

msgid "send an email message to {email}"
msgstr "{email} ལ་གློག་འཕྲིན་གཏོང་བ།"

msgid "Promote another member to Admin to remove your admin rights"
msgstr "ཚོགས་མི་གཞན་ཞིག་ Admin ལ་སྤར་ནས་ཁྱེད་ཀྱི་ Admin ཐོབ་ཐང་མེད་པར་བཟོས།"

msgid "Add {role} Access"
msgstr "{role} ཁ་སྣོན་བྱེད།"

msgid "Remove {role} Access"
msgstr "{role} བསུབ་པ།"

msgid "Delete the user, {username}"
msgstr "སྤྱོད་མཁན་སུབ་པ {username}"

msgid "Set as a Special Exam"
msgstr "དམིགས་བསལ་ཡིག་རྒྱུགས་སུ་གཏན་འཁེལ།"

msgid "Exam Types"
msgstr "ཡིག་རྒྱུགས་ཀྱི་རིགས།"

msgid "This subsection was released to learners as a proctored exam, but was reverted back to a basic or timed exam. You may not configure it as a proctored exam now. Contact edX Support for assistance."
msgstr "དོན་ཚན་ཆུང་བ་འདི་སློབ་ཕྲུག་ཚོར་ལྟ་རྟོག་ཡིག་རྒྱུགས་ལྟར་གློད་ཡོད་ཀྱང་། གཞི་རྩའི་ཡང་ན་དུས་ཚོད་གཏན་འཁེལ་གྱི་ཡིག་རྒྱུགས་ལ་སླར་ཡང་ཕྱིར་ལོག་བྱས། ཁྱེད་ཀྱིས་ད་ལྟ་དེ་ལྟ་རྟོག་ཡིག་རྒྱུགས་ལྟར་སྒྲིག་བཀོད་བྱེད་མི་ཐུབ། རོགས་རམ་ཆེད་edXརྒྱབ་སྐྱོར་ལ་འབྲེལ་བ་བྱོས།"

msgid "This proctored exam has been released to learners. You may not convert it to another type of special exam. You may revert this subsection back to being a basic exam by selecting 'None', or a timed exam, but you will NOT be able to configure it as a proctored exam in the future."
msgstr "འདི་སློབ་སྦྱོང་བྱེད་མཁན་ཚོར་འགྲེམ་སྤེལ་བྱས་ཡོད། ཁྱེད་ཀྱིས་དེ་དམིགས་བསལ་ཡིག་རྒྱུགས་རིགས་གཞན་ཞིག་ལ་བསྒྱུར་མི་ཆོག ཁྱེད་ཀྱིས་དོན་ཚན་ཆུང་བ་འདི་གཞི་རྩའི་ཡིག་རྒྱུགས་ལ་སླར་ཡང་བསྒྱུར་ཆོག ཡང་ན་དུས་ཚོད་གཏན་འཁེལ་གྱི་ཡིག་རྒྱུགས་འདེམས་ནས་ཡིག་རྒྱུགས་ཤིག་ཡིན། འོན་ཀྱང་ཁྱེད་ཀྱིས་མ་འོངས་པར་དེ་ལྟ་རྟོག་ཡིག་རྒྱུགས་ལྟར་སྒྲིག་བཀོད་བྱེད་མི་ཐུབ།"

msgid "Timed"
msgstr "དུས་ལྟར་གྱི།"

msgid "Use a timed exam to limit the time learners can spend on problems in this subsection. Learners must submit answers before the time expires. You can allow additional time for individual learners through the Instructor Dashboard."
msgstr "དུས་ཚོད་གཏན་འཁེལ་གྱི་ཡིག་རྒྱུགས་བེད་སྤྱད་དེ་སློབ་མ་ཚོས་དོན་ཚན་འདིའི་དཀའ་ངལ་ལ་དུས་ཚོད་གཏོང་ཐུབ་པའི་དུས་ཚོད་ཚད་བཀག་བྱེད། སློབ་མ་རྣམས་ཀྱིས་དུས་ཚོད་མ་རྫོགས་གོང་ལན་འབུལ་དགོས། ཁྱེད་ཀྱིས་སློབ་སྟོན་པའི་མཛུབ་ཁྲིད་སྒྲོམ་བརྒྱུད་ནས་སློབ་མ་རེ་རེ་ལ་དུས་ཚོད་ཁ་སྣོན་སྤྲོད་ཐུབ།"

msgid "Proctored"
msgstr "ལྟ་རྟོག་ཡོད་པའི་རྒྱུགས་སྤྲོད།"

msgid "Proctored exams are timed and they record video of each learner taking the exam. The videos are then reviewed to ensure that learners follow all examination rules. Please note that setting this exam as proctored will change the visibility settings to \"Hide content after due date.\""
msgstr "བརྟག་དཔྱད་ཀྱི་ཡིག་རྒྱུགས་དུས་ཚོད་གཏན་འཁེལ་བྱས་པ་དང་། ཁོང་ཚོས་ཡིག་རྒྱུགས་གཏོང་མཁན་གྱི་སློབ་མ་རེ་རེའི་བརྙན་འཕྲིན་སྒྲ་འཇུག་བྱེད་ཀྱི་ཡོད། དེ་ནས་བརྙན་འཕྲིན་དེ་དག་ལ་བསྐྱར་ཞིབ་བྱས་ཏེ་སློབ་མ་རྣམས་ཀྱིས་ཡིག་རྒྱུགས་ཀྱི་སྒྲིག་གཞི་ཚང་མ་ལག་བསྟར་བྱེད་པར་ཁག་ཐེག་བྱེད་ཀྱི་ཡོད། ཡིག་རྒྱུགས་འདི་ལྟ་རྟོག་བྱས་པ་ལྟར་སྒྲིག་ན་མཐོང་ཐུབ་པའི་སྒྲིག་སྟངས་དེ་&quot;ཚེས་གྲངས་རྗེས་སུ་ནང་དོན་སྦས་དགོས།&quot;"

msgid "Onboarding"
msgstr "གྲུ་གཟིངས་ནང་འཛུལ་བ།"

msgid "Use Onboarding to introduce learners to proctoring, verify their identity, and create an onboarding profile. Learners must complete the onboarding profile step prior to taking a proctored exam. Profile reviews take 2+ business days."
msgstr "སློབ་ཕྲུག་ཚོར་ལྟ་རྟོག་བྱེད་པར་ངོ་སྤྲོད་བྱེད་པ་དང་། ཁོང་ཚོའི་ངོ་བོ་བདེན་དཔང་བྱེད་པ། སློབ་ཕྲུག་ཚོས་ལྟ་རྟོག་ཡིག་རྒྱུགས་མ་བཏང་གོང་དུ་སློབ་གྲྭར་འཛུལ་བའི་གནས་ཚུལ་གྱི་གོ་རིམ་དེ་མཇུག་སྒྲིལ་དགོས། གསལ་སྡུད་བསྐྱར་ཞིབ་ལ་ཚོང་ལས་ཉིན་2ལྷག་ཙམ་འགོར་གྱི་ཡོད།"

msgid "Practice Proctored"
msgstr "ལག་ལེན་ལ་ལྟ་རྟོག་བྱས།"

msgid "Use a practice proctored exam to introduce learners to the proctoring tools and processes. Results of a practice exam do not affect a learner's grade."
msgstr "སློབ་སྦྱོང་བྱེད་མཁན་ཚོར་ལྟ་རྟོག་བྱེད་པའི་ལག་ཆ་དང་བྱ་རིམ་ངོ་སྤྲོད་བྱེད་པར་ལག་ལེན་གྱི་ལྟ་རྟོག་ཡིག་རྒྱུགས་བེད་སྤྱོད་བྱེད་དགོས། ལག་ལེན་ཡིག་རྒྱུགས་ཀྱི་གྲུབ་འབྲས་ཀྱིས་སློབ་མའི་སྐར་གྲངས་ལ་ཤུགས་རྐྱེན་ཐེབས་མི་ཐུབ།"

msgid "Time Allotted (HH:MM):"
msgstr "དུས་ཚོད་བཀོད་སྒྲིག་བྱས་པ། (HH:MM):"

msgid "Select a time allotment for the exam. If it is over 24 hours, type in the amount of time. You can grant individual learners extra time to complete the exam through the Instructor Dashboard."
msgstr "ཡིག་རྒྱུགས་ཀྱི་དུས་ཚོད་བདམས་པ། གལ་སྲིད་ཆུ་ཚོད་ ༢༤ ལས་བརྒལ་ན་དུས་ཚོད་ཀྱི་གྲངས་ཀ་བྲིས་དགོས། ཁྱེད་ཀྱིས་སློབ་མ་རེ་རེ་ལ་སློབ་སྟོན་པའི་མཛུབ་ཁྲིད་སྒྲོམ་བརྒྱུད་ནས་ཡིག་རྒྱུགས་མཇུག་སྒྲིལ་བར་དུས་ཚོད་འཕར་མ་སྤྲོད་ཐུབ།"

msgid "Review Rules"
msgstr "བསྐྱར་ཞིབ་སྒྲིག་གཞི།"

msgid "Specify any rules or rule exceptions that the proctoring review team should enforce when reviewing the videos. For example, you could specify that calculators are allowed. These specified rules are visible to learners before the learners start the exam, along with the {linkStart}general proctored exam rules{linkEnd}."
msgstr "བརྙན་འཕྲིན་བསྐྱར་ཞིབ་བྱེད་སྐབས་ལྟ་རྟོག་པའི་བསྐྱར་ཞིབ་ཚོགས་ཆུང་གིས་ལག་བསྟར་བྱེད་དགོས་པའི་ཁྲིམས་ལུགས་དང་ཁྲིམས་ལུགས་ཀྱི་ཁྱད་པར་གང་རུང་གསལ་བཤད་བྱོས། དཔེར་ན། ཁྱེད་ཀྱིས་རྩིས་འཕྲུལ་ཆོག གསལ་བཀོད་བྱེད་ཐུབ། བཀོད་སྒྲིག་བྱས་པའི་ཁྲིམས་ལུགས་འདི་དག་སློབ་མ་ཚོས་ {linkStart} རྒྱུགས་མ་འགོ་ཚུགས་གོང་དུ་མཐོང་རྒྱུ་ཡོད {linkEnd}"

msgid "General Proctored Exam Rules"
msgstr "སྤྱིར་བཏང་རྒྱུགས་སྤྲོད་སྒྲིག་གཞི།"

msgid "Specify any rules or rule exceptions that the proctoring review team should enforce when reviewing the videos. For example, you could specify that calculators are allowed. These specified rules are visible to learners before the learners start the exam."
msgstr "བརྙན་འཕྲིན་བསྐྱར་ཞིབ་བྱེད་སྐབས་ལྟ་རྟོག་པའི་བསྐྱར་ཞིབ་ཚོགས་ཆུང་གིས་ལག་བསྟར་བྱེད་དགོས་པའི་ཁྲིམས་ལུགས་དང་ཁྲིམས་ལུགས་ཀྱི་ཁྱད་པར་གང་རུང་གསལ་བཤད་བྱོས། དཔེར་ན། ཁྱེད་ཀྱིས་རྩིས་འཕྲུལ་ཆོག གསལ་བཀོད་བྱེད་ཐུབ། གཏན་འཁེལ་བྱས་པའི་སྒྲིག་གཞི་འདི་དག་སློབ་མ་ཚོས་རྒྱུགས་མ་འགོ་ཚུགས་གོང་དུ་སློབ་མ་ཚོས་མཐོང་ཐུབ་ཀྱི་ཡོད།"

msgid "Account"
msgstr "ཁ་བྱང་།"

msgid "This action updates the {provider} information for your entire organization."
msgstr "བྱ་སྤྱོད་འདིས་ཁྱེད་ཀྱི་ལས་ཁུངས་ཡོངས་ཀྱི་ {provider} བརྡ་འཕྲིན་ཁ་སྐོང་བྱེད།"

msgid "Enter the account information for your organization."
msgstr "ཁྱེད་རང་གི་ཚོགས་པའི་རྩིས་ཁྲའི་ཆ་འཕྲིན་ནང་འཇུག་བྱེད་དགོས།"

msgid "API Key"
msgstr "APIལྡེ་མིག"

msgid "API Secret"
msgstr "APIགསང་བ།"

msgid "Unit Access"
msgstr "ཚད་གཞིའི་ཐོབ་ཐང་།"

msgid "Restrict access to:"
msgstr "བཀག་སྡོམ་བྱེད་པ།"

msgid "Select a group type"
msgstr "སྡེ་ཚན་རིགས་འདེམས།"

msgid "Select one or more groups:"
msgstr "སྡེ་ཚན་གཅིག་གམ་དེ་ལས་མང་བ་འདེམས།"

msgid "This group no longer exists. Choose another group or do not restrict access to this unit."
msgstr "ཚོགས་པ་འདི་ད་ལྟ་མེད་པ་རེད། སྡེ་ཚན་གཞན་ཞིག་འདེམས་པའམ་ཡང་ན་སྡེ་ཚན་འདི་ལ་ཚད་བཀག་མ་བྱེད།"

msgid "File upload succeeded"
msgstr "ཡིག་ཆ་ཡར་བསྐུར་ལེགས་འགྲུབ་བྱུང་།"

msgid "Please check the following validation feedbacks and reflect them in your course settings:"
msgstr "གཤམ་གྱི་བདེན་དཔང་བསམ་འཆར་ལ་ཞིབ་བཤེར་བྱས་ནས་སློབ་ཚན་གྱི་སྒྲིག་བཀོད་ནང་དུ་མངོན་པར་བྱ་རོགས།"

msgid "Verification Checkpoint"
msgstr "བདེན་དཔང་ཞིབ་བཤེར་ས་ཚིགས།"

msgid "Must complete verification checkpoint"
msgstr "བདེན་དཔང་ཞིབ་བཤེར་ས་ཚིགས་ཡོངས་སུ་རྫོགས་དགོས།"

msgid "Verification checkpoint to be completed"
msgstr "ཞིབ་བཤེར་ས་ཚིགས་ལེགས་འགྲུབ་བྱ་རྒྱུ།"

msgid "Learners who require verification must pass the selected checkpoint to see the content in this unit. Learners who do not require verification see this content by default."
msgstr "བདེན་དཔང་བྱེད་དགོས་པའི་སློབ་མ་ཚོས་སློབ་ཚན་འདིའི་ནང་དོན་མཐོང་ཆེད་འདེམས་སྒྲུག་བྱས་པའི་ཞིབ་བཤེར་ས་ཚིགས་བརྒྱུད་དགོས། བདེན་དཔང་མི་དགོས་པའི་སློབ་མ་ཚོས་ནང་དོན་འདི་སྔོན་སྒྲིག་ལྟར་མཐོང་གི་ཡོད།"

msgid "Recommended image resolution is {imageResolution}, maximum image file size should be {maxFileSize} and format must be one of {supportedImageFormats}."
msgstr "པར་རིས་ཀྱི་ཚད་གཞི་ནི་ {imageResolution} ཡིན། པར་རིས་ཡིག་ཆའི་ཚད་གཞི་ཆེ་ཤོས་ནི་ {maxFileSize} ཡིན་དགོས། རྩ་སྒྲིག་དེ་ {supportedImageFormats} ཡིན་དགོས།"

msgid "No transcript uploaded."
msgstr "ཡིག་ཆ་ཡར་བསྐུར་མེད།"

msgid "Show transcripts ({totalTranscripts})"
msgstr "ཡིག་བསྒྱུར་སྟོན། ( {totalTranscripts} )"

msgid "Set Access"
msgstr "འཛུལ་ཞུགས་སྒྲིག་པ།"

msgid "Edit %(display_name)s (required)"
msgstr "རྩོམ་སྒྲིག་ %(display_name)s (དགོས་མཁོ།)"

msgid "You have done a dry run of force publishing the course. Nothing has changed. Had you run it, the following course versions would have been change."
msgstr "ཁྱེད་ཀྱིས་སློབ་ཚན་དེ་པར་སྐྲུན་བྱེད་པར་ཤུགས་ཆེན་པོ་བརྒྱབ་ཡོད། འགྱུར་བ་གང་ཡང་བྱུང་མེད། གལ་ཏེ་ཁྱེད་ཀྱིས་དེ་བཀོལ་སྤྱོད་བྱས་ཡོད་ན། གཤམ་གྱི་སློབ་ཚན་གྱི་ཐོན་རིམ་དེ་ཚོ་འགྱུར་བ་འགྲོ་རྒྱུ་རེད།"

msgid "The published branch version, {published}, was reset to the draft branch version, {draft}."
msgstr "པར་སྐྲུན་བྱས་པའི་ཡན་ལག་ཐོན་རིམ་ {published} དེ་ཡན་ལག་ཐོན་རིམ་ཟིན་བྲིས་ {draft} ལ་སླར་ཡང་བཙུགས་ཡོད།"

msgid "Add URLs for additional versions"
msgstr "ཐོན་རིམ་ཁ་སྣོན་གྱི་URLཁ་སྣོན་བྱེད་པ།"

msgid "To be sure all students can access the video, we recommend providing both an .mp4 and a .webm version of your video. Click below to add a URL for another version. These URLs cannot be YouTube URLs. The first listed video that's compatible with the student's computer will play."
msgstr "སློབ་ཕྲུག་ཚང་མས་བརྙན་འཕྲིན་དེ་ལ་ལྟ་ཐུབ་པའི་ཆེད་དུ་ང་ཚོས་ཁྱེད་ཀྱི་བརྙན་འཕྲིན་གྱི་ཐོན་རིམ་ .mp4 དང་ .webm གཉིས་ཀ་མཁོ་སྤྲོད་བྱེད་དགོས་པའི་བསམ་འཆར་འདོན་གྱི་ཡོད། ཐོན་རིམ་གཞན་ཞིག་གི་URLཁ་སྣོན་བྱེད་པར་གཤམ་དུ་སྣུན་རོགས། URL འདི་དག་ YouTube URL ཡིན་མི་ཐུབ། སློབ་མའི་གློག་ཀླད་དང་མཐུན་པའི་ཐོ་འགོད་བྱས་པའི་བརྙན་ཐུང་དང་པོ་དེ་གཏོང་རྒྱུ་རེད།"

msgid "Default Timed Transcript"
msgstr "རྨང་གཞིའི་བརྙན་ཡིག"

msgid "Timed Transcript Conflict"
msgstr "དུས་ཐོག་ཡིག་བསྒྱུར་གྱི་འགལ་ཟླ།"

msgid "The timed transcript for the first video file does not appear to be the same as the timed transcript for the second video file."
msgstr "བརྙན་འཕྲིན་ཡིག་ཆ་དང་པོའི་དུས་ཚོད་ཀྱི་ཡིག་བསྒྱུར་དེ་བརྙན་འཕྲིན་ཡིག་ཆ་གཉིས་པའི་དུས་ཚོད་ཀྱི་ཡིག་ཆ་དང་གཅིག་པ་མིན་པ་འདྲ།"

msgid "Which timed transcript would you like to use?"
msgstr "ཁྱེད་རང་གིས་དུས་ཚོད་གཏན་འཁེལ་བྱས་པའི་ཡིག་ཆ་གང་ཞིག་བེད་སྤྱོད་གཏོང་འདོད་དམ།"

msgid "Error."
msgstr "ནོར་འཁྲུལ།"

msgid "Timed Transcript from %(filename)s"
