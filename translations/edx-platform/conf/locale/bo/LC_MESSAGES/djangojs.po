msgstr "སྤྱོད་མཁན་ {user} གྱི་ཐོབ་སྐར་ཡར་རྒྱས་གཏོང་ཕྱིར་དྲི་བའི་ཐོབ་སྐར་བསྐྱར་སྒྲིག་ལེགས་པར་བྱས་ཡོད།"

msgid "Failed to rescore problem to improve score for user."
msgstr "སྤྱོད་མཁན་གྱི་ཐོབ་སྐར་ཡར་རྒྱས་གཏོང་ཕྱིར་དྲི་བའི་ཐོབ་སྐར་བསྐྱར་སྒྲིག་བྱེད་ཐུབ་མ་སོང་།"

msgid "Successfully overrode problem score for {user}"
msgstr "Successfully overrode problem score for {user}"

msgid "Could not override problem score for {user}."
msgstr "Could not override problem score for {user}."

msgid "Enter and confirm your new password."
msgstr "ཁྱེད་ཀྱི་གསང་ཚིག་གསར་པ་བཅུག་ནས་ངེས་གཏན་བཟོས།"

msgid "New Password"
msgstr "གསང་ཚིག་གསར་པ།"

msgid "Confirm Password"
msgstr "གསང་ཚིག་གཏན་འཁེལ།"

msgid "Passwords do not match."
msgstr "གསང་ཚིག་མཚུངས་མ་སོང་།"

msgid "Reset My Password"
msgstr "ངའི་གསང་ཚིག་བསྐྱར་སྒྲིག"

msgid "Reset Your Password"
msgstr "ཁྱེད་ཀྱི་གསང་ཚིག་བསྐྱར་སྒྲིག"

msgid "Error: "
msgstr "གནད་དོན།"

msgid "You may also lose access to verified certificates and other program credentials. You can make a copy of these for your records before proceeding with deletion."
msgstr "ད་དུང་ཁྱེད་ཀྱིས་ཁུངས་སྐྱེལ་བྱས་པའི་ལག་ཁྱེར་དང་ལས་གཞི་གཞན་གྱི་ལག་ཁྱེར་རྣམས་ཀྱང་བརླག་སྲིད། དེའི་ཕྱིར་ཁྱེད་ཀྱིས་དེ་དག་མ་བསུབ་སྔོན་ལ་ཚང་མ་ངོ་བཤུས་བཟོས་ཏེ་རང་གིས་ཉར་ཚགས་བྱ་ཆོག་པ་ཡིན།"

msgid "Before proceeding, please {htmlStart}unlink all social media accounts{htmlEnd}."
msgstr "ལས་རིམ་སོང་སྔོན་ལ་སྤྱི་ཚོགས་བརྒྱུད་ལམ་ {htmlStart} གྱི་ཁ་བྱང་ {htmlEnd} གང་ལ་ཡང་སྦྲེལ་མཐུད་མེད་པར་བཟོ་དགོས།"

msgid "Before proceeding, please {htmlStart}{emailMsg}{htmlEnd}."
msgstr "ལས་རིམ་མ་སོང་སྔོན་འདི་དག་བྱེད་རོགས། {htmlStart}{emailMsg}{htmlEnd}"

msgid "{htmlStart}Want to change your email, name, or password instead?{htmlEnd}"
msgstr "{htmlStart} ཁྱེད་ཀྱི་གློག་འཕྲིན་དང་མིང་ཡང་ན་གསང་གྲངས་གང་རུང་བརྗེ་བསྒྱུར་བྱ་འདོད་ཡོད་དམ།  {htmlEnd}"

msgid "{strongStart}Warning: Account deletion is permanent.{strongEnd} Please read the above carefully before proceeding. This is an irreversible action, and {strongStart}you will no longer be able to use the same email on {platformName}.{strongEnd}"
msgstr "{strongStart}ཉེན་བརྡ།: ཁ་བྱང་བསུབས་ན་གཏན་དུ་བསུབ་འགྲོ་བ་ཡིན། {strongEnd} མ་བསུབ་སྔོན་གོང་གི་ཉེན་བརྡ་དེ་གཟབ་ནན་གྱིས་ཀློག་རོགས། འདི་ནི་བསྐྱར་ལེན་ཐུབ་པའི་བྱ་བ་ཞིག་མིན་པར་མ་ཟད་ {strongStart}ཁྱེད་ཀྱིས་གཞུག་ཕྱོགས་ {platformName}.{strongEnd} འདིའི་ནང་ལ་ཡང་སྔ་མའི་གློག་འཕྲིན་དེ་བཀོལ་སྤྱོད་བྱ་མི་ཐུབ།"

msgid "Please note: Deletion of your account and personal data is permanent and cannot be undone. {platformName} will not be able to recover your account or the data that is deleted."
msgstr "གཟབ་ནན་བྱེད་དགོས་པ་ཞིག་ནི། ཁྱེད་ཀྱི་ཁ་བྱང་དང་སྒེར་གྱི་གཞི་གྲངས་བསུབ་ན་གཏན་དུ་བསུབ་འགྲོ་བས། བསྐྱར་གསོ་བྱ་མི་ཐུབ། {platformName} འདིས་ཁྱེད་ཀྱིས་བསུབས་ཟིན་པའི་ཁྱེད་ཀྱི་ཁ་བྱང་དང་ཡང་ན་གཞི་གྲངས་གང་ཡིན་རུང་བསྐྱར་གསོ་བྱ་མི་ཐུབ།"

msgid "Once your account is deleted, you cannot use it to take courses on the {platformName} app, {siteName}, or any other site hosted by {platformName}."
msgstr "ཁྱེད་ཀྱི་ཁ་བྱང་ཐེངས་གཅིག་བསུབས་པ་ཡིན་ན། ཁྱེད་ཀྱིས་ {platformName} app དང་ {siteName}  ཡང་ན་ {platformName} འདིས་བཟུང་བའི་དྲ་ངོས་གཞན་ཚང་མའི་ནང་ནས་ཁ་བྱང་དེ་བཀོལ་ནས་སློབ་ཚན་ལེན་མི་ཐུབ།"

msgid "This includes access to {siteName} from your employer’s or university’s system{additionalSiteSpecificDeletionText}."
msgstr "འདིའི་ནང་ཁྱེད་ཀྱི་ལས་ཀ་སྤྲོད་མཁན་དང་ཡང་ན་སློག་གླིང་གི་མ་ལག་{additionalSiteSpecificDeletionText} ནས་ {siteName} སྔོག་འདོན་བྱེད་པ་བཅས་འདུས་ཡོད།"

msgid "We’re sorry to see you go!"
msgstr "ཁྱེད་ཐོན་འགྲོ་བ་མཐོང་བས་ང་ཚོའི་སེམས་པ་སྐྱོ།"

msgid "Delete My Account"
msgstr "ངའི་ཁ་བྱང་སུབ།"

msgid "Password is incorrect"
msgstr "གསང་ཚིག་འགྲིག་མ་སོང་།"

msgid "Unable to delete account"
msgstr "ཁ་བྱང་བསུབས་ཐུབ་མ་སོང་།"

msgid "Please re-enter your password."
msgstr "གསང་ཚིག་བསྐྱར་འཇུག་བྱ་རོགས།"

msgid "Sorry, there was an error trying to process your request. Please try again later."
msgstr "དགོངས་དག ཁྱེད་ཀྱི་རེ་སྐུལ་བསྒྲུབ་པའི་སྐབས་དེར་གནད་དོན་ཞིག་འདུག གཞུག་ནས་ཚོད་ལྟ་བྱ་རོགས།"

msgid "A Password is required"
msgstr "གསང་ཚིག་ཅིག་ངེས་པར་དགོས།"

msgid "You have selected “Delete my account.” Deletion of your account and personal data is permanent and cannot be undone. {platformName} will not be able to recover your account or the data that is deleted."
msgstr "ཁྱེད་ཀྱིས་“Delete my account.” བདམས་འདུག ཁྱེད་ཀྱི་ཁ་བྱང་དང་སྒེར་གྱི་གཞི་གྲངས་བསུབ་ན་གཏན་དུ་བསུབ་འགྲོ་བས། བསྐྱར་གསོ་བྱ་མི་ཐུབ། {platformName} འདིས་ཁྱེད་ཀྱིས་བསུབས་ཟིན་པའི་ཁ་བྱང་དང་ཡང་ན་གཞི་གྲངས་གང་ཡིན་རུང་བསྐྱར་གསོ་བྱ་མི་ཐུབ།"

msgid "If you proceed, you will be unable to use this account to take courses on the {platformName} app, {siteName}, or any other site hosted by {platformName}."
msgstr "ཁྱེད་ཀྱིས་བརྒྱུད་རིམ་བརྒྱུད་པ་ཡིན་ན། ཁྱེད་ཀྱིས་ {platformName} app དང་ {siteName} ཡང་ན་ {platformName} འདིས་བཟུང་བའི་དྲ་ངོས་གཞན་ཚང་མའི་ནང་ནས་ཁ་བྱང་དེ་བཀོལ་ནས་སློབ་ཚན་ལེན་མི་ཐུབ།"

msgid "If you still wish to continue and delete your account, please enter your account password:"
msgstr "ཁྱེད་ད་དུང་རྒྱུན་མཐུད་རྒྱུ་དང་ཁྱེད་ཀྱི་ཁ་བྱང་དེ་བསུབ་འདོད་ན། ཁྱེད་ཀྱི་ཁ་བྱང་གི་གསང་ཨང་འཇུག་རོགས།"

msgid "Yes, Delete"
msgstr "གཏན་འཁེལ་ཡིན། སུབ།"

msgid "We're sorry to see you go! Your account will be deleted shortly."
msgstr "ཁྱེད་ཐོན་འགྲོ་བ་མཐོང་བས་ང་ཚོའི་སེམས་པ་སྐྱོ། མི་རིང་བར་ཁྱེད་ཀྱི་ཁ་བྱང་བསུབ་རྒྱུ་ཡིན།"

msgid "Account deletion, including removal from email lists, may take a few weeks to fully process through our system. If you want to opt-out of emails before then, please unsubscribe from the footer of any email."
msgstr "ཁ་བྱང་བསུབ་པ། གློག་འཕྲིན་གྱི་ཐོ་གཞུང་ནས་ཀྱང་བསུབ་དགོས་ན་ང་ཚོའི་མ་ལག་བརྒྱུད་ནས་ལས་རིམ་ཆ་ཚང་འགྲོ་དགོས་པས་འདི་གཟའ་འཁོར་འགར་འགོར་སྲིད། དེའི་སྔོན་གལ་སྲིད་གློག་འཕྲིན་ནང་འཕྲིན་ཐུང་མི་ཡོང་བ་ཙམ་བྱེད་དགོས་ན། དྲ་གཤམ་གྱི་གློག་འཕྲིན་གང་རུང་ནས་སྔོན་མངགས་ཕྱིར་འཐེན་བྱེད་རོགས།"

msgid "Terms of Service and Honor Code"
msgstr "ཞབས་ཞུའི་རྣམ་གྲངས་དང་ཁྲིམས་མཐུན་སྒྲིག་གཞི།"

msgid "Saving your email preference"
msgstr "ཁྱེད་ཀྱི་འགན་ལེན་གློག་འཕྲིན་ཉར་བཞིན་ཡོད།"

msgid "Enrolling you in the selected course"
msgstr "ཁྱེད་རང་བདམས་ཟིན་པའི་སློབ་ཚན་ལ་ཞུགས་ཐོ་འགོད་བཞིན་ཡོད།"

msgid "Adding the selected course to your cart"
msgstr "བདམས་ཟིན་པའི་སློབ་ཚན་དེ་ཁྱེད་ཀྱི་གསོག་སྒམ་ནང་འཇུག་བཞིན་ཡོད།"

msgid "Loading your courses"
msgstr "ཁྱེད་ཀྱི་སློབ་ཚན་ནང་འཇུག་བྱེད་བཞིན་ཡོད།"

msgid "An error occurred."
msgstr "གནད་དོན་ཞིག་བྱུང་སོང་།"

msgid "(optional)"
msgstr "(རང་མོས་ཡིན།)"

msgid "We couldn't sign you in."
msgstr "ང་ཚོས་ཁྱེད་ནང་འཛུལ་བྱ་ཐུབ་མ་སོང་།"

msgid "An error occurred when signing you in to %s."
msgstr "ཁྱེད་%s འདིའི་ནང་ནང་འཛུལ་བྱེད་དུས་གནད་དོན་ཞིག་བྱུང་སོང་།"

msgid "Check Your Email"
msgstr "ཁྱེད་ཀྱི་གློག་འཕྲིན་ནང་གཟིགས།"

msgid "{paragraphStart}You entered {boldStart}{email}{boldEnd}. If this email address is associated with your {platform_name} account, we will send a message with password recovery instructions to this email address.{paragraphEnd}{paragraphStart}If you do not receive a password reset message after 1 minute, verify that you entered the correct email address, or check your spam folder.{paragraphEnd}{paragraphStart}If you need further assistance, {anchorStart}contact technical support{anchorEnd}.{paragraphEnd}"
msgstr "{paragraphStart}You entered {boldStart}{email}{boldEnd}. If this email address is associated with your {platform_name} account, we will send a message with password recovery instructions to this email address.{paragraphEnd}{paragraphStart}If you do not receive a password reset message after 1 minute, verify that you entered the correct email address, or check your spam folder.{paragraphEnd}{paragraphStart}If you need further assistance, {anchorStart}contact technical support{anchorEnd}.{paragraphEnd}"

msgid "An error has occurred. Try refreshing the page, or check your Internet connection."
msgstr "གནད་དོན་ཞིག་བྱུང་འདུག ཤོག་ངོས་དེ་བསྐྱར་ལེན་དང་ཡང་ན་ཁྱེད་ཀྱི་དྲ་རྒྱར་མཐུད་ཡོད་མེད་ལྟོས།"

msgid "In order to sign in, you need to activate your account.{line_break}{line_break}We just sent an activation link to {strong_start} {email} {strong_end}. If  you do not receive an email, check your spam folders or  {anchorStart}contact {platform_name} Support{anchorEnd}."
msgstr "ནང་འཛུལ་བྱེད་པ་ལ་ཁྱེད་ཀྱིས་ངེས་པར་དུ་ཁྱེད་ཀྱི་ཁ་བྱང་{line_break}{line_break}གི་བྱེད་ནུས་སྤེལ་དགོས། ང་ཚོས་ {strong_start} {email} {strong_end} འདིར་བྱེད་ནུས་སྤེལ་སའི་དྲ་ཐག་ཅིག་བཏང་ཡོད། གལ་སྲིད་ཁྱེད་ལ་འཕྲིན་ཐུང་འདི་འབྱོར་མེད་ན་ཁྱེད་ཀྱི་གལ་ཆུང་ཡིག་སྣོད་དམ་spam ནང་གཟིགས་རོགས། ཡང་ན་ {anchorStart}རམ་འདེགས་པར་ {platform_name} འབྲེལ་བ་བྱོས།{anchorEnd}"

msgid "An unexpected error has occurred."
msgstr "མ་བསམ་ས་ནས་གནད་དོན་ཞིག་བྱུང་སོང་།"

msgid "You have successfully signed into %(currentProvider)s, but your %(currentProvider)s account does not have a linked %(platformName)s account. To link your accounts, sign in now using your %(platformName)s password."
msgstr "ཁྱེད་རང་ %(currentProvider)s འདིའི་ནང་བདེ་ལེགས་ངང་ནང་འཛུལ་བྱས་སོང་། ཡིན་ན་ཡང་ %(currentProvider)s འདིའི་སྒང་གི་ཁྱེད་ཀྱི་ཁ་བྱང་དེ་ %(platformName)s འདིའི་ཁ་བྱང་དང་སྦྲེལ་མི་འདུག ཁྱེད་ཀྱི་ཁ་བྱང་དེ་དང་སྤྲེལ་བ་ལ་ཁྱེད་ཀྱི་གསང་གྲངས་ %(platformName)s འདི་བཀོལ་ཏེ་ཐད་ཀར་ནང་འཛུལ་བྱོས།"

msgid "We couldn't create your account."
msgstr "ང་ཚོས་ཁྱེད་ཀྱི་ཁ་བྱང་བཟོ་ཐུབ་མ་སོང་།"

msgid "Create Account"
msgstr "ཁ་བྱང་བཟོས།"

msgid "(required)"
msgstr "(required)"

msgid "You've successfully signed into %(currentProvider)s."
msgstr "ཁྱེད་བདེ་ལེགས་ངང་ %(currentProvider)s འདིའི་ནང་ནང་འཛུལ་བྱས་ཡོད།"

msgid "We just need a little more information before you start learning with %(platformName)s."
msgstr "ཁྱེད་ཀྱིས་%(platformName)s འདི་སློབ་འགོ་མ་བརྩམ་གོང་ང་ཚོར་གནས་ཚུལ་མང་ཙམ་དགོས་ཀྱི་འདུག"

msgid "Your profile settings are managed by {enterprise_name}. Contact your administrator or {link_start}edX Support{link_end} for help."
msgstr "ཁྱེད་ཀྱི་གནས་ཚུལ་སྙིང་བསྡུས་ཀྱི་སྒྲིག་འགོད་ཁག་ {enterprise_name} འདིས་དོ་དམ་བྱས་ཡོད། རམ་འདེགས་དགོས་ཚེ་ཁྱེད་ཀྱི་དོ་དམ་པར་འབྲེལ་གཏུགས་བྱ་རོགས། {link_start}edX Support{link_end}"

msgid "Email Address (Sign In)"
msgstr "གློག་འཕྲིན་ཁ་བྱང་ (Sign In)"

msgid "You receive messages from {platform_name} and course teams at this address."
msgstr "ཁྱེད་ལ་གློག་འཕྲིན་འདིའི་ནང་ {platform_name} འདི་དང་སློབ་ཚན་ཚོགས་པ་གཉིས་ཀྱིས་འཕྲིན་གཏོང་ཡོང་།"

msgid "Recovery Email Address"
msgstr "གློག་འཕྲིན་ཁ་བྱང་བསྐྱར་གསོ།"

msgid "You may access your account with this address if single-sign on or access to your primary email is not available."
msgstr "གལ་སྲིད་ཐེངས་གཅིག་ནང་འཛུལ་བྱས་པ་དང་ཡང་ན་ཁྱེད་ཀྱི་མ་གཞིའི་གློག་འཕྲིན་ཁ་བྱང་མི་རྙེད་ན་ཁྱེད་ཀྱིས་རང་གི་ཁ་བྱང་ནང་འདི་ནང་འཇུག་བྱ་ཆོག"

msgid "Full Name"
msgstr "མིང་ཧྲིལ་བོ།"

msgid "The name that is used for ID verification and that appears on your certificates."
msgstr "མིང་འདི་ནི་ཁྱེད་ཀྱི་ ID ཡི་ཁུངས་སྐྱེལ་ལ་བཀོལ་རྒྱུ་མ་ཟད་ཁྱེད་ཀྱི་ལག་ཁྱེར་གྱི་སྟེང་ལ་ཡང་འགོད་རྒྱུ་ཡིན།"

msgid "Country or Region of Residence"
msgstr "བཅའ་སྡོད་བྱ་སའི་མངའ་ཁུལ་དང་ཡང་ན་རྒྱལ་ཁབ།"

msgid "The country or region where you live."
msgstr "ཁྱེད་རང་གནས་ཡུལ་གྱི་མངའ་ཁུལ་དང་ཡང་ན་རྒྱལ་ཁབ།"

msgid "Basic Account Information"
msgstr "ཁ་བྱང་གི་གཞི་རྩའི་གནས་ཚུལ།"

msgid "These settings include basic information about your account."
msgstr "སྒྲིག་འགོད་འདི་དག་གི་ནང་ཁྱེད་ཀྱི་ཁ་བྱང་གི་སྐོར་གྱི་གཞི་རྩའི་གནས་ཚུལ་འདུས་ཡོད།"

msgid "The name that identifies you on {platform_name}. You cannot change your username."
msgstr "{platform_name} འདིའི་སྒང་ཁྱེད་ངོས་འཛིན་བྱེད་ཀྱི་མིང་སྟེ། ཁྱེད་ཀྱིས་རང་གི་སྤྱོད་མིང་བརྗེ་མི་ཐུབ།"

msgid "Password"
msgstr "གསང་ཨང་།"

msgid "Check your email account for instructions to reset your password."
msgstr "ཁྱེད་ཀྱི་གསང་ཚིག་བསྐྱར་སྒྲིག་བྱེད་ཐབས་ཁྱེད་ཀྱི་གློག་འཕྲིན་ནང་བཏང་ཡོད། དེར་གཟིགས།"

msgid "The language used throughout this site. This site is currently available in a limited number of languages. Changing the value of this field will cause the page to refresh."
msgstr "དྲ་གནས་འདིའི་སྤྱི་ཡོངས་ལ་བཀོལ་བའི་སྐད་ཡིག་དེ། ད་སྐབས་ཀྱི་དྲ་གནས་འདིའི་ནང་སྐད་ཡིག་ཉུང་ཤས་ཤིག་ལས་མི་འདུག སྡེ་ཚན་འདིའི་རིན་ཐང་དེ་བརྗེ་བསྒྱུར་བྱས་ན་ཤོག་ངོས་དེ་བསྐྱར་ལེན་བྱེད་པའི་རྐྱེན་དུ་འགྱུར་འགྲོ།"

msgid "Time Zone"
msgstr "ཆུ་ཚོད་ཀྱི་གནས།"

msgid "Select the time zone for displaying course dates. If you do not specify a time zone, course dates, including assignment deadlines, will be displayed in your browser's local time zone."
msgstr "སློབ་ཚན་གྱི་ཟླ་ཚེས་སྟོན་བྱེད་ཀྱི་མངའ་ཁུལ་གྱི་དུས་ཚོད་དེ་འདེམ། གལ་སྲིད་ཁྱེད་ཀྱིས་མངའ་ཁུལ་གྱི་དུས་ཚོད་ངོས་འཛིན་མ་བྱས་ཚེ། ལས་འགན་གྱི་དུས་བཀག་ཚུད་པའི་སློབ་ཚན་གྱི་ཟླ་ཚེས་དེ་ཁྱེད་ཀྱི་བལྟ་བཤེར་དྲ་ཚིགས་ཀྱི་ས་གནས་དུས་ཚོད་ལྟར་སྟོན་ཡོང་བ་ཡིན།"

msgid "All Time Zones"
msgstr "ཆུ་ཚོད་ཀྱི་གནས་ཆ་ཚང་།"

msgid "Default (Local Time Zone)"
msgstr "མ་གཞིའི་ (Local Time Zone)"

msgid "Additional Information"
msgstr "གནས་ཚུལ་འཕར་མ།"

msgid "Education Completed"
msgstr "སློབ་སྦྱོང་ལེགས་པར་གྲུབ་སོང་།"

msgid "Gender"
msgstr "ཕོ་མོ།"

msgid "Year of Birth"
msgstr "སྐྱེས་ལོ།"

msgid "Preferred Language"
msgstr "བདམས་པའི་སྐད་ཡིག"

msgid "We've sent a confirmation message to {new_secondary_email_address}. Click the link in the message to update your secondary email address."
msgstr "ང་ཚོས་འདིར་ {new_secondary_email_address} ཁྱེད་ལ་གཏན་འཁེལ་འཕྲིན་ཐུང་ཞིག་བཏང་ཡོད། འཕྲིན་ཐུང་ནང་གི་དྲ་ཐག་དེའི་སྟེང་བསྣུན་ཏེ་ཁྱེད་ཀྱི་གློག་འཕྲིན་གཞན་པ་དེ་ཞོག"

msgid "Social Media Links"
msgstr "སྤྱི་ཚོགས་བརྒྱུད་ལམ་གྱི་དྲ་ཐག་ཁག"

msgid "Optionally, link your personal accounts to the social media icons on your edX profile."
msgstr "གདམ་ཁ་ཡིན། རང་ཉིད་ཀྱི་ཁ་བྱང་དེ་ཁྱེད་ཀྱི་edX ཡི་ངོ་སྤྲོད་ཀྱི་སྒང་ལ་གསལ་བའི་སྤྱི་ཚོགས་བརྒྱུད་ལམ་གྱི་མཚོན་རྟགས་ཁག་ལ་སྦྲེལ།"

msgid "{platform_display_name} Link"
msgstr "{platform_display_name} དྲ་ཐག"

msgid "Enter your {platform_display_name} username or the URL to your {platform_display_name} page. Delete the URL to remove the link."
msgstr "ཁྱེད་ཀྱི་ {platform_display_name} སྤྱོད་མིང་དང་ཡང་ན་ URL རྣམས་ཁྱེད་ཀྱི་ {platform_display_name} ཤོག་ངོས་སུ་ཞོག དྲ་ཐག་དེ་ཕྱིར་ཕུད་བྱེད་པར་ URL དེ་བསུབ་དགོས།"

msgid "Linked Accounts"
msgstr "དྲ་ཐག་གིས་སྦྲེལ་བའི་ཁ་བྱང་།"

msgid "You can link your social media accounts to simplify signing in to {platform_name}."
msgstr "ཁྱེད་ཀྱི་སྤྱི་ཚོགས་བརྒྱུད་ལམ་གྱི་ཁ་བྱང་དེ་སྟབས་བདེའི་ངང་ {platform_name} ལ་སྦྲེལ་ཆོག"

msgid "ORDER NAME"
msgstr "མངགས་ཉོའི་མིང་།"

msgid "ORDER PLACED"
msgstr "མངགས་ཉོ་བྱས་ཡོད།"

msgid "TOTAL"
msgstr "ཁྱོན་བསྡོམས།"

msgid "ORDER NUMBER"
msgstr "མངགས་ཉོའི་ཨང་།"

msgid "My Orders"
msgstr "ངའི་མངགས་ཉོ་ཁག"

msgid "This page contains information about orders that you have placed with {platform_name}."
msgstr "ཤོག་ངོས་འདིའི་ནང་ཤོག་ངོས་ {platform_name} འདིའི་ནང་བཞག་ཡོད་པའི་ཁྱེད་ཀྱིས་མངགས་ཉོ་བྱས་པའི་སྐོར་གྱི་གནས་ཚུལ་རྣམས་འདུས་ཡོད།"

msgid "We've sent a confirmation message to {new_email_address}. Click the link in the message to update your email address."
msgstr "ང་ཚོས་འདིར་ {new_email_address} ཁྱེད་ལ་གཏན་འཁེལ་འཕྲིན་ཐུང་ཞིག་བཏང་ཡོད། འཕྲིན་ཐུང་ནང་གི་དྲ་ཐག་དེའི་སྟེང་བསྣུན་ཏེ་ཁྱེད་ཀྱི་གློག་འཕྲིན་ནང་འཇུག་བྱོས།"

msgid "You must sign out and sign back in before your language changes take effect."
msgstr "ཁྱེད་ཀྱིས་སྐད་ཡིག་བརྗེ་བསྒྱུར་གྱི་ཤུགས་རྐྱེན་མ་སླེབ་གོང་ཁྱེད་ངེས་པར་ཕྱིར་ཐོན་བྱས་ཏེ་བསྐྱར་དུ་ནང་འཛུལ་བྱོས།"

msgid "We've sent a message to {email}. Click the link in the message to reset your password. Didn't receive the message? Contact {anchorStart}technical support{anchorEnd}."
