msgstr "འདྲ་པར་ལྷག་འདུག"

msgid "You could not be subscribed to this post. Refresh the page and try again."
msgstr "ཁྱེད་ཀྱིས་རྩོམ་ཡིག་འདི་མངགས་ཉོ་བྱ་མི་ཐུབ། ཤོག་ངོས་དེ་བསྐྱར་ལེན་དང་ཡང་ན་བསྐྱར་དུ་ཚོད་ལྟ་ཞིག་བྱོས།"

msgid "You could not be unsubscribed from this post. Refresh the page and try again."
msgstr "ཁྱེད་ཀྱིས་རྩོམ་ཡིག་འདིའི་མངགས་ཉོ་ཕྱིར་འཐེན་བྱ་མི་ཐུབ། ཤོག་ངོས་དེ་བསྐྱར་ལེན་དང་ཡང་ན་བསྐྱར་དུ་ཚོད་ལྟ་ཞིག་བྱོས།"

msgid "This response could not be marked as an answer. Refresh the page and try again."
msgstr "ལན་འདི་ལ་དྲི་ལན་ནང་བཞིན་གྱི་དཔེ་རྟགས་འགོད་མི་ཐུབ། ཤོག་ངོས་དེ་བསྐྱར་ལེན་དང་ཡང་ན་བསྐྱར་དུ་ཚོད་ལྟ་ཞིག་བྱོས།"

msgid "This response could not be unmarked as an answer. Refresh the page and try again."
msgstr "ལན་འདི་ལ་དྲི་ལན་ནང་བཞིན་གྱི་དཔེ་རྟགས་མེད་པར་བཟོ་མི་ཐུབ། ཤོག་ངོས་དེ་བསྐྱར་ལེན་དང་ཡང་ན་བསྐྱར་དུ་ཚོད་ལྟ་ཞིག་བྱོས།"

msgid "This response could not be marked as endorsed. Refresh the page and try again."
msgstr "དྲི་ལན་འདི་ངོས་ལེན་བྱེད་ཐུབ་པ་ཞིག་མ་བྱུང་བས། ཤོག་ངོས་དེ་བསྐྱར་ལེན་བྱས་ཏེ་བསྐྱར་དུ་ཚོད་ལྟ་བྱ་རོགས།"

msgid "This response could not be unendorsed. Refresh the page and try again."
msgstr "དྲི་ལན་འདི་ངོས་ལེན་བྱེད་མི་ཐུབ་པ་ཞིག་མ་བྱུང་བས། ཤོག་ངོས་དེ་བསྐྱར་ལེན་བྱས་ཏེ་བསྐྱར་དུ་ཚོད་ལྟ་བྱ་རོགས།"

msgid "This vote could not be processed. Refresh the page and try again."
msgstr "འོས་འདི་འཕེན་ཐུབ་མི་འདུག ཤོག་ངོས་དེ་བསྐྱར་ལེན་དང་ཡང་ན་བསྐྱར་དུ་ཚོད་ལྟ་ཞིག་བྱོས།"

msgid "This post could not be pinned. Refresh the page and try again."
msgstr "རྩོམ་ཡིག་འདི་འཛེར་ཐུབ་མ་སོང་། ཤོག་ངོས་དེ་བསྐྱར་ལེན་དང་ཡང་ན་བསྐྱར་དུ་ཚོད་ལྟ་ཞིག་བྱོས།"

msgid "This post could not be unpinned. Refresh the page and try again."
msgstr "རྩོམ་ཡིག་འདི་འཛེར་ས་ནས་ཕྱིར་ལེན་ཐུབ་མ་སོང་། ཤོག་ངོས་དེ་བསྐྱར་ལེན་དང་ཡང་ན་བསྐྱར་དུ་ཚོད་ལྟ་ཞིག་བྱོས།"

msgid "This post could not be flagged for abuse. Refresh the page and try again."
msgstr "རྩོམ་ཡིག་འདི་ལོག་སྤྱོད་བྱས་པའི་ཉེས་དར་འཛུགས་ཐུབ་མ་སོང་། ཤོག་ངོས་དེ་བསྐྱར་ལེན་དང་ཡང་ན་བསྐྱར་དུ་ཚོད་ལྟ་ཞིག་བྱོས།"

msgid "This post could not be unflagged for abuse. Refresh the page and try again."
msgstr "རྩོམ་ཡིག་འདི་ལོག་སྤྱོད་བྱས་པའི་ཉེས་དར་ཕྱིར་འཐེན་བྱ་ཐུབ་མ་སོང་། ཤོག་ངོས་དེ་བསྐྱར་ལེན་དང་ཡང་ན་བསྐྱར་དུ་ཚོད་ལྟ་ཞིག་བྱོས།"

msgid "This post could not be closed. Refresh the page and try again."
msgstr "རྩོམ་ཡིག་འདི་སྒོ་རྒྱག་ཐུབ་མ་སོང་། ཤོག་ངོས་དེ་བསྐྱར་ལེན་དང་ཡང་ན་བསྐྱར་དུ་ཚོད་ལྟ་ཞིག་བྱོས།"

msgid "This post could not be reopened. Refresh the page and try again."
msgstr "རྩོམ་ཡིག་འདིའི་སྒོ་བསྐྱར་འབྱེད་བྱ་ཐུབ་མ་སོང་། ཤོག་ངོས་དེ་བསྐྱར་ལེན་དང་ཡང་ན་བསྐྱར་དུ་ཚོད་ལྟ་ཞིག་བྱོས།"

