msgstr "སློབ་གཉེར་བའི་ཁ་བྱང་རྙེད་ཀྱི་མི་འདུག དམིགས་བསལ་ཐོ་གཞུང་ནང་བཞག་མི་འདུག"

msgid " learner account cannot be found and has not been added to the exception list"
msgstr "སློབ་གཉེར་བའི་ཁ་བྱང་རྙེད་ཀྱི་མི་འདུག དམིགས་བསལ་ཐོ་གཞུང་ནང་བཞག་མི་འདུག"

msgid " learners already appear on the exception list in this course"
msgstr "སློབ་ཚན་འདིའི་ནང་སློབ་གཉེར་བ་རྣམས་དམིགས་བསལ་ཐོ་གཞུང་ནང་ད་སྔ་ནས་ཐོན་འདུག"

msgid " learner already appears on the exception list in this course"
msgstr "སློབ་ཚན་འདིའི་ནང་སློབ་གཉེར་བ་རྣམས་དམིགས་བསལ་ཐོ་གཞུང་ནང་ད་སྔ་ནས་ཐོན་འདུག"

msgid " learners are not enrolled in this course and have not added to the exception list"
msgstr "སློབ་གཉེར་བ་ཚོས་སློབ་ཚན་འདིའི་ནང་ཞུགས་ཐོ་བཀོད་མི་འདུག དམིགས་བསལ་ཐོ་གཞུང་ནང་བཞག་མི་འདུག"

msgid " learner is not enrolled in this course and has not been added to the exception list"
msgstr "སློབ་གཉེར་བས་སློབ་ཚན་འདིའི་ནང་ཞུགས་ཐོ་བཀོད་མི་འདུག དམིགས་བསལ་ཐོ་གཞུང་ནང་བཞག་མི་འདུག"

msgid " learners have an active certificate invalidation in this course and have not been added to the exception list"
msgstr "སློབ་གཉེར་པ་ཚོར་སློབ་ཚན་འདིའི་ནང་ཚུལ་མཐུན་མ་ཡིན་པའི་ལག་ཁྱེར་ལ་འབྲེལ་བ་ཞིག་འདུག དམིགས་བསལ་ཐོ་གཞུང་ནང་བཀོད་མི་འདུག"

msgid " learner has an active certificate invalidation in this course and has not been added to the exception list"
msgstr "སློབ་གཉེར་པར་སློབ་ཚན་འདིའི་ནང་ལག་ཁྱེར་དེ་ཚུལ་མཐུན་མ་ཡིན་པ་ཞིག་ལ་འབྲེལ་འདུག་ཅིང་། དམིགས་བསལ་ཐོ་གཞུང་ནང་བཀོད་མི་འདུག"

msgid " learners encountered unknown errors"
msgstr "སློབ་གཉེར་པ་ཚོ་ཁ་གསལ་མེད་པའི་གནད་དོན་ཞིག་ལ་ཕྲད་སོང་།"

msgid " learner encountered an unknown error"
msgstr "སློབ་གཉེར་པ་གནད་དོན་གསལ་ཁ་མེད་པ་ཞིག་ལ་ཕྲད་འདུག"

msgid "Uploaded file issues. Click on \"+\" to view."
msgstr "ནང་འཇུག་བྱས་པའི་ཡིག་ཆའི་གནད་དོན་ཁག སྟོན་ན་ \"+\" འདིའི་སྒང་ལ་སྣུན།"

msgid "Certificate of <%= user %> has already been invalidated. Please check your spelling and retry."
msgstr "<%= user %> ཡི་ལག་ཁྱེར་ཚུལ་མཐུན་ཞིག་བྱུང་མི་འདུག ཁྱེད་ཀྱི་དག་ཆ་བསྐྱར་ཞིབ་བྱས་ཏེ་བསྐྱར་དུ་ཚོད་ལྟ་བྱ་རོགས།"

msgid "Certificate has been successfully invalidated for <%= user %>."
msgstr "<%= user %> ཡི་ལག་ཁྱེར་ནུས་མེད་བྱས་ཚར་ཡོད།"

msgid "The certificate for this learner has been re-validated and the system is re-running the grade for this learner."
msgstr "སྤྱོད་མཁན་འདིའི་ལག་ཁྱེར་བསྐྱར་དུ་ཚུལ་མཐུན་བཟོས་ཤིང་། མ་ལག་དེ་ཡང་བསྐྱར་སྒྲིག་གིས་སྤྱོད་མཁན་འདིའི་གནས་རིམ་བསྐྱར་སྟོན་བྱས་ཡོད།"

msgid "Could not find Certificate Invalidation in the list. Please refresh the page and try again"
msgstr "ཐོ་གཞུང་ནང་ལག་ཁྱེར་ཚུལ་མཐུན་མ་ཡིན་པ་རྙེད་ས་མ་རེད། ཤོག་ངོས་འདི་བསྐྱར་ལེན་བྱས་ནས་བསྐྱར་དུ་ཚོད་ལྟ་བྱོས།"

