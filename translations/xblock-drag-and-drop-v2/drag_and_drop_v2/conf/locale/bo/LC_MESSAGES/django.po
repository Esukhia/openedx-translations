#: drag_and_drop_v2.py:86
msgid "Drag and Drop"
msgstr "འདིར་ཐད་ཀར་དྲུད་དེ་ཞོག"

#: drag_and_drop_v2.py:91
msgid "Mode"
msgstr "རྣམ་པ།"

#: drag_and_drop_v2.py:153
msgid "Closed"
msgstr "སྒོ་བརྒྱབ་ཟིན།"

#: public/js/drag_and_drop.js:321 public/js/drag_and_drop.js:325
msgid "Feedback"
msgstr "བསམ་འཆར།"

#: public/js/drag_and_drop.js:472
msgid "Reset"
msgstr "བསྐྱར་སྒྲིག"

#: public/js/drag_and_drop.js:662
msgid "Problem"
msgstr "དྲི་བ།"

msgid "An isosceles triangle with three layers of similar height. It is shown upright, so the widest layer is located at the bottom, and the narrowest layer is located at the top."
msgstr "མཐོ་ཚད་འདྲ་མཚུངས་ཀྱི་བང་རིམ་གསུམ་ཡོད་པའི་ཟུར་མཉམ་པའི་ཟུར་གསུམ་མ། དེ་ཡར་ལངས་པར་སྟོན་ཡོད་པས་བང་རིམ་རྒྱ་ཆེ་ཤོས་དེ་མཇུག་ཏུ་གནས་ཤིང་། བང་རིམ་དོག་ཤོས་དེ་མགོ་ལ་གནས་ཡོད།"

msgid "The Top Zone"
msgstr "མཐོ་ཁུལ།"

msgid "The Middle Zone"
msgstr "དབུས་རྒྱུད་ཁུལ།"

msgid "The Bottom Zone"
msgstr "འོག་རིམ་ཁུལ།"

msgid "Use this zone to associate an item with the top layer of the triangle."
msgstr "ས་ཁུལ་འདི་བེད་སྤྱད་ནས་རྣམ་གྲངས་ཤིག་གྲུ་གསུམ་གྱི་མཐོ་རིམ་བང་རིམ་དང་འབྲེལ་མཐུད་བྱེད།"

msgid "Use this zone to associate an item with the middle layer of the triangle."
msgstr "ས་ཁུལ་འདི་བེད་སྤྱད་ནས་རྣམ་གྲངས་ཤིག་གྲུ་གསུམ་གྱི་དཀྱིལ་མའི་བང་རིམ་དང་འབྲེལ་མཐུད་བྱེད།"

msgid "Use this zone to associate an item with the bottom layer of the triangle."
msgstr "ས་ཁུལ་འདི་བེད་སྤྱད་ནས་རྣམ་གྲངས་ཤིག་གྲུ་གསུམ་གྱི་འོག་མའི་བང་རིམ་དང་འབྲེལ་མཐུད་བྱེད།"

msgid "Correct! This one belongs to The Top Zone."
msgstr "ཡང་དག་པ! འདི་ནི་ཆེས་མཐོའི་ས་ཁུལ་ལ་གཏོགས་ཡོད།"

msgid "Correct! This one belongs to The Middle Zone."
msgstr "ཡང་དག་པ! འདི་དཀྱིལ་མའི་ས་ཁུལ་ལ་གཏོགས་ཡོད།"

msgid "Correct! This one belongs to The Bottom Zone."
msgstr "ཡང་དག་པ! འདི་ནི་འོག་མའི་ས་ཁུལ་ལ་གཏོགས་ཡོད།"

msgid "No, this item does not belong here. Try again."
msgstr "མ་རེད། ཅ་ལག་འདི་འདིར་མི་གཏོགས། ཡང་བསྐྱར་ཚོད་ལྟ་བྱོས།"

msgid "You silly, there are no zones for this one."
msgstr "ཁྱོད་གླེན་པ། འདིའི་ཆེད་དུ་ས་ཁུལ་མེད།"

msgid "Of course it goes here! It goes anywhere!"
msgstr "གཏན་ནས་འདིར་འགྲོ་གི་རེད། དེ་གང་དུའང་འགྲོ་སྲིད།"

msgid "Goes to the top"
msgstr "མགོ་ལ་འགྲོ།"

msgid "Goes to the middle"
msgstr "དབུས་སུ་འགྲོ།"

msgid "Goes to the bottom"
msgstr "འོག་ཏུ་འགྲོ།"

msgid "Goes anywhere"
msgstr "གང་དུའང་འགྲོ།"

msgid "I don't belong anywhere"
msgstr "ང་གང་དུའང་མི་གཏོགས།"

msgid "Drag the items onto the image above."
msgstr "རྣམ་གྲངས་རྣམས་གོང་གི་པར་རིས་སྟེང་འདྲུད་དགོས།"

msgid "Good work! You have completed this drag and drop problem."
msgstr "ལས་ཀ་ཡག་པོ་འདུག ཁྱོད་ཀྱིས་འདྲུད་འཇོག་གི་དཀའ་ངལ་འདི་མཇུག་སྒྲིལ་ཟིན།"

msgid "Title"
msgstr "རྩོམ་ཡིག་གི་ཁ་བྱང་།"

msgid "The title of the drag and drop problem. The title is displayed to learners."
msgstr "འདྲུད་འཇོག་གི་དཀའ་ངལ་གྱི་ཁ་བྱང་། ཁ་བྱང་དེ་སློབ་སྦྱོང་བྱེད་མཁན་ཚོར་མངོན་ཡོད།"

msgid "Standard mode: the problem provides immediate feedback each time a learner drops an item on a target zone. Assessment mode: the problem provides feedback only after a learner drops all available items on target zones."
msgstr "ཚད་གཞིའི་ཐབས་ལམ། སློབ་ཕྲུག་གིས་དམིགས་འབེན་གྱི་ས་ཁུལ་ལ་ཅ་ལག་གཅིག་བཏང་སྐབས་དཀའ་ངལ་དེས་འཕྲལ་མར་བསམ་འཆར་སྤྲོད་ཀྱི་ཡོད། བརྟག་དཔྱད་ཐབས་ལམ། སློབ་ཕྲུག་གིས་དམིགས་འབེན་ས་ཁུལ་དུ་ཡོད་པའི་དངོས་པོ་ཚང་མ་བཏང་རྗེས་དཀའ་ངལ་དེས་བསམ་འཆར་སྤྲོད་ཀྱི་ཡོད།"

msgid "Standard"
msgstr "ཚད་ལྡན"

msgid "Assessment"
msgstr "ལྟ་སྟངས"

msgid "Maximum attempts"
msgstr "ཚོད་ལྟ་མང་ཤོས།"

msgid "Defines the number of times a student can try to answer this problem. If the value is not set, infinite attempts are allowed."
msgstr "སློབ་མ་ཞིག་གིས་དཀའ་ངལ་འདི་ལ་ལན་འདེབས་ཐེངས་ག་ཚོད་བྱེད་ཐུབ་མིན་གསལ་བཤད་བྱེད། གལ་ཏེ་རིན་ཐང་དེ་སྒྲིག་མེད་ན་ཚད་མེད་ཀྱི་ཚོད་ལྟ་བྱེད་ཆོག"

msgid "Show title"
msgstr "ཁ་བྱང་སྟོན།"

msgid "Display the title to the learner?"
msgstr "སློབ་སྦྱོང་བྱེད་མཁན་ལ་ཁ་བྱང་སྟོན་དགོས་སམ།"

msgid "Problem text"
msgstr "དཀའ་ངལ་ཡི་གེ།"

msgid "The description of the problem or instructions shown to the learner."
msgstr "དཀའ་ངལ་གྱི་འགྲེལ་བཤད། ཡང་ན་སློབ་སྦྱོང་བྱེད་མཁན་ལ་སྟོན་པའི་བཀའ་སློབ།"

msgid "Show \"Problem\" heading"
msgstr "&quot;དཀའ་རྙོག&quot;མགོ་བརྗོད་སྟོན།"

msgid "Display the heading \"Problem\" above the problem text?"
msgstr "དཀའ་ངལ་ཡིག་ཆའི་སྟེང་དུ་མགོ་བརྗོད་&quot;དཀའ་ངལ་&quot;མངོན་དགོས་སམ།"

msgid "Show answer"
msgstr "ལན་སྟོན།"

msgid "Defines when to show the answer to the problem. A default value can be set in Advanced Settings. To revert setting a custom value, choose the 'Default' option."
msgstr "དཀའ་ངལ་གྱི་ལན་ག་དུས་སྟོན་དགོས་མིན་གསལ་བཀོད་བྱེད། སྔོན་སྒྲིག་གནས་གོང་ཞིག་ཡར་ཐོན་སྒྲིག་སྟངས་ནང་གཞི་སྒྲིག་བྱེད་ཐུབ། སྲོལ་སྒྲིག་རིན་ཐང་སྒྲིག་སྟངས་ཕྱིར་ལོག་བྱེད་པར་ &#39;སྔོན་སྒྲིག་&#39; གདམ་ཁ་འདེམས།"

msgid "Default"
msgstr "ལུགས་འགལ"

msgid "Always"
msgstr "རྒྱུན་དུ"

msgid "Answered"
msgstr "ལན་བཏབ།"

msgid "Attempted or Past Due"
msgstr "ཚོད་ལྟ་བྱས་པའམ་ཡང་ན་དུས་ཚོད་འདས་ཟིན་པ།"

msgid "Finished"
msgstr "མཇུག་སྐྱེལ"

msgid "Correct or Past Due"
msgstr "ནོར་འཁྲུལ་ཡང་ན་འདས་ཟིན་པ།"

msgid "Past Due"
msgstr "འདས་ཟིན་པ།"

msgid "Never"
msgstr "གཏན་ནས"

msgid "After All Attempts"
msgstr "འབད་བརྩོན་ཡོད་ཚད་བྱས་རྗེས།"

msgid "After All Attempts or Correct"
msgstr "ཚོད་ལྟ་ཡོད་ཚད་བྱས་པའམ་ནོར་བཅོས་བྱས་རྗེས།"

msgid "Attempted"
msgstr "ཚོད་ལྟ་བྱས།"

msgid "Problem Weight"
msgstr "དྲི་བའི་བརྒྱ་ཆ།"

msgid "Defines the number of points the problem is worth."
msgstr "དཀའ་ངལ་དེ་ལ་རིན་ཐང་ཡོད་པའི་སྐར་གྲངས་གསལ་བཤད་བྱེད།"

msgid "Item background color"
msgstr "རྣམ་གྲངས་ཀྱི་རྒྱབ་ལྗོངས་ཚོས་གཞི།"

msgid "The background color of draggable items in the problem (example: 'blue' or '#0000ff')."
msgstr "དཀའ་ངལ་ནང་འདྲུད་ཐུབ་པའི་རྣམ་གྲངས་ཀྱི་རྒྱབ་ལྗོངས་ཚོས་གཞི་ (དཔེར་ན་: &#39;སྔོན་པོ་&#39; ཡང་ན་ &#39;#0000ff&#39;)།"

msgid "Item text color"
msgstr "རྣམ་གྲངས་ཡི་གེའི་ཚོས་གཞི།"

msgid "Text color to use for draggable items (example: 'white' or '#ffffff')."
msgstr "འདྲུད་ཐུབ་པའི་རྣམ་གྲངས་ལ་སྤྱོད་པའི་ཚིག་ཡིག་ཚོས་གཞི་(དཔེར་ན་: &#39;དཀར་པོ་&#39; ཡང་ན་ &#39;#ffffff&#39;)།"

msgid "Maximum items per zone"
msgstr "ཁུལ་རེར་རྣམ་གྲངས་མང་ཤོས།"

msgid "This setting limits the number of items that can be dropped into a single zone."
msgstr "སྒྲིག་སྟངས་འདིས་ས་ཁུལ་གཅིག་ལ་འཇོག་ཐུབ་པའི་རྣམ་གྲངས་ཀྱི་གྲངས་ཚད་ཚད་བཀག་བྱེད།"

msgid "Problem data"
msgstr "དཀའ་ངལ་གྱི་གྲངས་ཐོ།"

msgid "Information about zones, items, feedback, explanation and background image for this problem. This information is derived from the input that a course author provides via the interactive editor when configuring the problem."
msgstr "དཀའ་ངལ་འདིའི་ས་ཁུལ་དང་། རྣམ་གྲངས། བསམ་འཆར། འགྲེལ་བཤད། རྒྱབ་ལྗོངས་པར་རིས་བཅས་ཀྱི་སྐོར་གྱི་ཆ་འཕྲིན། བརྡ་འཕྲིན་འདི་སློབ་ཚན་གྱི་རྩོམ་པ་པོ་ཞིག་གིས་དཀའ་ངལ་སྒྲིག་བཀོད་བྱེད་སྐབས་བརྗེ་རེས་རྩོམ་སྒྲིག་པ་བརྒྱུད་ནས་སྤྲོད་པའི་ནང་འཇུག་ལས་བྱུང་བ་རེད།"

msgid "Information about current positions of items that a learner has dropped on the target image."
msgstr "སློབ་མ་ཞིག་གིས་དམིགས་འབེན་གྱི་པར་རིས་སྟེང་ལ་བཞག་པའི་དངོས་པོའི་ད་ལྟའི་གནས་བབ་སྐོར་གྱི་གནས་ཚུལ།"

msgid "Number of attempts learner used"
msgstr "སློབ་སྦྱོང་བྱེད་མཁན་གྱིས་བེད་སྤྱོད་བཏང་བའི་ཚོད་ལྟ་གྲངས་འབོར།"

msgid "Indicates whether a learner has completed the problem at least once"
